#include "keyboard.h"
#include "io.h"

#define KB_PORT 0x60
#define KB_STATUS 0x64

                          
static int shift_pressed = 0;
static int ctrl_pressed = 0;
static int alt_pressed = 0;
static int caps_lock = 0;

                                           
static int esc_seq_state = 0;                                                                            
static int esc_timeout_counter = 0;

                    
static const char kbd_tbl[128] = {
    0, 27, '1','2','3','4','5','6','7','8','9','0','-','=','\b',
    0, 'q','w','e','r','t','y','u','i','o','p','[',']','\n',
    0, 'a','s','d','f','g','h','j','k','l',';','\'','`',
    0, '\\','z','x','c','v','b','n','m',',','.','/', 0, 0, 0, ' '
};

static const char kbd_tbl_shift[128] = {
    0, 27, '!','@','#','$','%','^','&','*','(',')','_','+','\b',
    0, 'Q','W','E','R','T','Y','U','I','O','P','{','}','\n',
    0, 'A','S','D','F','G','H','J','K','L',':','"','~',
    0, '|','Z','X','C','V','B','N','M','<','>','?', 0, 0, 0, ' '
};

                   
#define KB_BUF_SIZE 256
static int kbuf[KB_BUF_SIZE];
static int kh = 0, kt = 0;
static volatile int ctrl_c_pending = 0;

void keyboard_init(void) {
    kh = kt = 0;
    shift_pressed = 0;
    ctrl_pressed = 0;
    alt_pressed = 0;
    caps_lock = 0;
    esc_seq_state = 0;
    ctrl_c_pending = 0;
}

void keyboard_reset_input(void) {
    kh = kt = 0;
    shift_pressed = 0;
    ctrl_pressed = 0;
    alt_pressed = 0;
    esc_seq_state = 0;
    esc_timeout_counter = 0;
    ctrl_c_pending = 0;
}

                          
static void kb_put(int c) {
    kbuf[kt] = c;
    kt = (kt + 1) % KB_BUF_SIZE;
}

                     
static void process_scancode(uint8_t scancode) {
                                                       
    
                                                   
    if (esc_seq_state != 0) {
        if (++esc_timeout_counter > 10) {
            esc_seq_state = 0;
            esc_timeout_counter = 0;
        }
    }

                                             
    if (scancode == 0xE0) {
        esc_seq_state = 1;
        esc_timeout_counter = 0;
        return;
    }

    if (scancode == 0x0F) {
        kb_put('\t');
        return;
    }
    
                                             
    if (esc_seq_state == 1) {
        extern uint32_t* fb;
        extern uint32_t p;
                                                     
        uint32_t* fb_ptr = fb + (0 * 8 * p) + (120 * 8);
        fb_ptr[0] = 0x00FF0000;                    
        fb_ptr[1] = 0x00FF0000;
        fb_ptr[2] = 0x00FF0000;
        fb_ptr[3] = 0x00FF0000;
                                                       
        if (scancode == 0x2A || scancode == 0x36) {
            esc_seq_state = 2;
            return;
        }
        if (scancode == 0xAA || scancode == 0xB6) {
            esc_seq_state = 1;
            return;
        }
        
                            
        switch (scancode) {
            case 0x48: kb_put(KEY_UP);    esc_seq_state = 0; return;
            case 0x50: kb_put(KEY_DOWN);  esc_seq_state = 0; return;
            case 0x4B: kb_put(KEY_LEFT);  esc_seq_state = 0; return;
            case 0x4D: kb_put(KEY_RIGHT); esc_seq_state = 0; return;
            case 0x47: kb_put(KEY_HOME);  esc_seq_state = 0; return;
            case 0x4F: kb_put(KEY_END);   esc_seq_state = 0; return;
            case 0x49: kb_put(KEY_PGUP);  esc_seq_state = 0; return;
            case 0x51: kb_put(KEY_PGDN);  esc_seq_state = 0; return;
            case 0x53: kb_put(KEY_DELETE); esc_seq_state = 0; return;
            case 0x52: kb_put(KEY_INSERT); esc_seq_state = 0; return;
            case 0x1D: ctrl_pressed = 1; esc_seq_state = 1; return;        
            case 0x9D: ctrl_pressed = 0; esc_seq_state = 1; return;
            
                                                                          
            case 0x37: kb_put(KEY_HOME);  esc_seq_state = 0; return;                          
            case 0x4E: kb_put(KEY_END);   esc_seq_state = 0; return;                         
        }
        
                                   
        esc_seq_state = 0;
        return;
    }
    
    if (esc_seq_state == 2) {
                            
        if (scancode == 0xAA || scancode == 0xB6) {
            esc_seq_state = 1;
        } else {
            esc_seq_state = 0;
        }
        return;
    }
    
                                       
    
            
    if (scancode == 0x2A || scancode == 0x36) {
        shift_pressed = 1;
        return;
    }
    if (scancode == 0xAA || scancode == 0xB6) {
        shift_pressed = 0;
        return;
    }
    
                            
    if (scancode == 0x1D) {
        ctrl_pressed = 1;
        return;
    }
    if (scancode == 0x9D) {
        ctrl_pressed = 0;
        return;
    }
    
          
    if (scancode == 0x38) {
        alt_pressed = 1;
        return;
    }
    if (scancode == 0xB8) {
        alt_pressed = 0;
        return;
    }
    
                
    if (scancode == 0x3A) {
        caps_lock = !caps_lock;
        return;
    }
    
                            
    if (scancode & 0x80) return;
    
                             
    if (ctrl_pressed) {
        char c = 0;
        if (scancode < 128) c = kbd_tbl[scancode];
        
        if (c >= 'a' && c <= 'z') {
            if (c == 'c') {
                ctrl_c_pending = 1;
                return;
            }
            kb_put(c - 'a' + 1);
            return;
        }
        if (c >= 'A' && c <= 'Z') {
            kb_put(c - 'A' + 1);
            return;
        }
    }
    
                            
    if (alt_pressed) {
        char c = 0;
        if (scancode < 128) c = kbd_tbl[scancode];
        if (c >= 'a' && c <= 'z') {
            kb_put(0x80 | (c - 'a' + 'A'));
            return;
        }
    }
    
                                  
    char ascii = 0;
    
    if ((scancode >= 0x10 && scancode <= 0x19) ||
        (scancode >= 0x1E && scancode <= 0x26) ||
        (scancode >= 0x2C && scancode <= 0x32)) {
                
        ascii = shift_pressed ? kbd_tbl_shift[scancode] :
                caps_lock ? kbd_tbl_shift[scancode] : kbd_tbl[scancode];
    } else {
                    
        ascii = shift_pressed ? kbd_tbl_shift[scancode] : kbd_tbl[scancode];
    }
    
    if (ascii != 0) {
        kb_put(ascii);
    }
}

int getchar(void) {
    while (kh == kt) {
        uint8_t status = inb(KB_STATUS);
        if ((status & 1) && !(status & 0x20)) {
            process_scancode(inb(KB_PORT));
        }
    }
    int c = kbuf[kh];
    kh = (kh + 1) % KB_BUF_SIZE;
    return c;
}

int keyboard_handle_irq(void) {
    uint8_t status = inb(KB_STATUS);
    if (!(status & 1) || (status & 0x20)) return 0;

    process_scancode(inb(KB_PORT));
    if (ctrl_c_pending) {
        ctrl_c_pending = 0;
        return 1;
    }
    return 0;
}

int kbhit(void) {
    if (kh != kt) return 1;
    uint8_t status = inb(KB_STATUS);
    if ((status & 1) && !(status & 0x20)) {
        process_scancode(inb(KB_PORT));
        return kh != kt;
    }
    return 0;
}

int is_ctrl_pressed(void) { return ctrl_pressed; }
int is_alt_pressed(void) { return alt_pressed; }
int is_shift_pressed(void) { return shift_pressed; }

