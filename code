#include "arch/x86_64/apic.h"
#include "arch/x86_64/io.h"
#include "drivers/console.h"
#include "lib/str.h"

static volatile uint32_t* apic = (volatile uint32_t*)APIC_BASE;

static uint32_t apic_read(uint32_t reg) {
    return *(volatile uint32_t*)((uint8_t*)apic + reg);
}

static void apic_write(uint32_t reg, uint32_t val) {
    *(volatile uint32_t*)((uint8_t*)apic + reg) = val;
}

                                    
static int apic_detect(void) {
                               
    uint32_t eax, ebx, ecx, edx;
    __asm__ volatile("cpuid" : "=a"(eax), "=b"(ebx), "=c"(ecx), "=d"(edx) : "a"(1));
    
    if (edx & (1 << 9)) {
        print("APIC: Detected\n");
        return 1;
    }
    print("APIC: Not detected\n");
    return 0;
}

                             
void apic_init(void) {
    if (!apic_detect()) {
        print("APIC: Not supported, falling back to PIC\n");
        return;
    }
    
                       
    uint32_t svr = apic_read(APIC_SVR);
    svr |= APIC_SVR_ENABLE;
    svr |= 0xFF;                
    apic_write(APIC_SVR, svr);
    
                                       
    apic_write(APIC_LVT_TIMER, APIC_LVT_MASKED);
    apic_write(APIC_LVT_THERMAL, APIC_LVT_MASKED);
    apic_write(APIC_LVT_PERFMON, APIC_LVT_MASKED);
    apic_write(APIC_LVT_LINT0, APIC_LVT_MASKED);
    apic_write(APIC_LVT_LINT1, APIC_LVT_MASKED);
    apic_write(APIC_LVT_ERROR, APIC_LVT_MASKED);
    
    print("APIC: Enabled\n");
}

void apic_send_eoi(void) {
    apic_write(APIC_EOI, 0);
}

void apic_enable(void) {
    uint32_t svr = apic_read(APIC_SVR);
    svr |= APIC_SVR_ENABLE;
    apic_write(APIC_SVR, svr);
}

void apic_disable(void) {
    uint32_t svr = apic_read(APIC_SVR);
    svr &= ~APIC_SVR_ENABLE;
    apic_write(APIC_SVR, svr);
}

