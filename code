void history_load(void) {
    history = vector_create(sizeof(char*), 100);
    
                         
    Vector* buf = vector_create(sizeof(uint8_t), 256);
    int state = read_file(HISTORY_FILE, buf);
    if (state == -1) {
        if (fs_initialized == 1) {
            create_file(HISTORY_FILE);
            return;
    }
}
                          
    uint8_t* data = buf->data;
    int start = 0;
    for (uint32_t i = 0; i < buf->size; i++) {
        if (data[i] == '\n') {
            data[i] = '\0';
            char* line = (char*)&data[start];
            char* copy = kmalloc(i - start + 1);
            if (!copy) {
                printf("shell: Out of memory\n");
                break;
            }
            strcpy(copy, line);
            history->push(history, &copy);
            start = i + 1;
        }
    }

    history_count = history->size;
    history_pos = history_count;
    
    buf->destroy(buf);
}

                            
void history_save(void) {
    Vector* buf = vector_create(sizeof(uint8_t), 256);
    
                           
    for (uint32_t i = 0; i < history->size; i++) {
        char** cmd = (char**)history->at(history, i);
        int len = strlen(*cmd);
        for (int j = 0; j < len; j++) {
            uint8_t c = (*cmd)[j];
            buf->push(buf, &c);
        }
        uint8_t nl = '\n';
        buf->push(buf, &nl);
    }
    
    int state = write_file(HISTORY_FILE, buf);
    if (state == -1) {
        if (fs_initialized == 1) {
            create_file(HISTORY_FILE);
            write_file(HISTORY_FILE, buf);
        }
    }
    buf->destroy(buf);
}

                               
void history_add(const char* cmd) {
    if (!history || cmd[0] == '\0') return;
    
    if (history->size > 0) {
        char** last = (char**)history->at(history, history->size - 1);
        if (strcmp(*last, cmd) == 0) return;
    }
    
    char* copy = kmalloc(strlen(cmd) + 1);
    strcpy(copy, cmd);
    history->push(history, &copy);
    history_count = history->size;
    history_pos = history_count;
    
    history_save();
}

static uint32_t parse_next_num(const char** p) {
    uint32_t val = 0;
    const char* str = *p;
    while (*str >= '0' && *str <= '9') {
        val = val * 10 + (*str - '0');
        str++;
    }
    *p = str;
    return val;
}

static int parse_chmod_mode(const char* mode_str, uint16_t current_mode) {
    uint16_t new_mode = current_mode;
    
                                    
                          
    int octal = 1;
    const char* p = mode_str;
    while (*p) {
        if (*p < '0' || *p > '7') { octal = 0; break; }
        p++;
    }
    
    if (octal && strlen(mode_str) <= 4) {
        uint16_t mode = 0;
        p = mode_str;
        while (*p) {
            mode = mode * 8 + (*p - '0');
            p++;
        }
        return mode;
    }
    
                                  
                                         
    char who = 'a';               
    char op = '+';             
    
                                
                                       
                  
                            
    
    const char* ptr = mode_str;
    
                    
    if (*ptr == 'u' || *ptr == 'g' || *ptr == 'o' || *ptr == 'a') {
        who = *ptr;
        ptr++;
    }
    
                   
    if (*ptr == '+' || *ptr == '-' || *ptr == '=') {
        op = *ptr;
        ptr++;
    }
    
                      
    uint16_t rights = 0;
    int has_x = 0, has_r = 0, has_w = 0;
    int has_s = 0, has_t = 0;
    
    while (*ptr) {
        switch (*ptr) {
            case 'r': has_r = 1; break;
            case 'w': has_w = 1; break;
            case 'x': has_x = 1; break;
            case 's': has_s = 1; break;
            case 't': has_t = 1; break;
            default:
                printf("chmod: invalid mode: %c\n", *ptr);
                return -1;
        }
        ptr++;
    }
    
                      
    if (has_r) {
        if (who == 'u' || who == 'a') rights |= 0400;
        if (who == 'g' || who == 'a') rights |= 0040;
        if (who == 'o' || who == 'a') rights |= 0004;
    }
    if (has_w) {
        if (who == 'u' || who == 'a') rights |= 0200;
        if (who == 'g' || who == 'a') rights |= 0020;
        if (who == 'o' || who == 'a') rights |= 0002;
    }
    if (has_x) {
        if (who == 'u' || who == 'a') rights |= 0100;
        if (who == 'g' || who == 'a') rights |= 0010;
        if (who == 'o' || who == 'a') rights |= 0001;
    }
    if (has_s) {
        if (who == 'u' || who == 'a') rights |= 04000;
        if (who == 'g' || who == 'a') rights |= 02000;
    }
    if (has_t) {
        if (who == 'o' || who == 'a') rights |= 01000;
    }
    
    if (rights == 0) {
        printf("chmod: invalid mode: %s\n", mode_str);
        return -1;
    }
    
                         
    if (op == '+') {
        new_mode |= rights;
    } else if (op == '-') {
        new_mode &= ~rights;
    } else if (op == '=') {
                                                                      
                                    
        uint16_t mask = 0;
        if (who == 'u' || who == 'a') mask |= 0700;
        if (who == 'g' || who == 'a') mask |= 0070;
        if (who == 'o' || who == 'a') mask |= 0007;
        new_mode = (new_mode & ~mask) | rights;
    }
    
    return new_mode;
}

