        print("  zip <out> <files...> - Create a ZIP archive\n");
        print("  unzip <archive> [dir] - Extract a ZIP archive\n");
        print("  ziplist <archive>   - List ZIP contents\n");
        print("  lpi                 - Show package manager commands\n");
        print("  lpi update          - Update package index\n");
        print("  lpi install <pkg>   - Install a package\n");
        print("  lpi remove <pkg>    - Remove a package\n");
        print("  lpi search <query>  - Search packages\n");
        print("  lpi list            - List installed packages\n");
        print("  lpi info <pkg>      - Show package information\n");
        print("  lpi upgrade         - Upgrade all packages\n");
        return;
    }

    printf("Unknown help category: %s\n", topic);
    print("Available categories: shell, fs, ext4, disk, network, drivers, system, programs, packages\n");
}

static int shell_alias(char* cmd) {
    Vector* data = vector_create(sizeof(uint8_t), 2048);
    if (read_file(console_config.aliases_path, data) < 0) {
        data->destroy(data);
        return 0;
    }
    char line[512];
    int position = 0;
    int matched = 0;
    for (uint32_t i = 0; i <= data->size && !matched; i++) {
        char current = i < data->size ? ((char*)data->data)[i] : '\n';
        if (current == '\n' || current == '\r') {
            line[position] = '\0';
            if (position > 0 && line[0] != '#') {
                char* equal = strchr(line, '=');
                if (equal) {
                    *equal = '\0';
                    if (strcmp(line, cmd) == 0) {
                        print(equal + 1);
                        putc('\n');
                        matched = 1;
                    }
                }
            }
            position = 0;
        } else if (position < 511) {
            line[position++] = current;
        }
    }
    data->destroy(data);
    return matched;
}

void shell_execute(char* cmd) {
        if (cmd[0] && shell_alias(cmd)) return;
        if (strcmp(cmd, "config") == 0 || strcmp(cmd, "config show") == 0) {
            printf("system.hostname=%s\n", system_config.hostname);
            printf("system.greeting=%s\n", system_config.greeting);
            printf("system.debug_level=%d\n", system_config.debug_level);
            printf("console.aliases=%s\n", console_config.aliases_path);
            printf("lpi.repositories=%s\n", lpi_config.repositories);
            printf("lpi.cache_limit_kb=%d\n", lpi_config.cache_limit_kb);
            printf("lpi.require_root=%d\n", lpi_config.require_root);
            printf("edit.tab_size=%d\n", edit_config.tab_size);
        } else if (strncmp(cmd, "alias ", 6) == 0) {
            char* definition = cmd + 6;
            char* separator = strchr(definition, ' ');
