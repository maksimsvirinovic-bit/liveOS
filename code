void* driver_get_symbol(const char* name) {
    if (!exported_symbols) return NULL;
    for (uint32_t i = 0; i < exported_symbols->size; i++) {
        Symbol* sym = (Symbol*)exported_symbols->at(exported_symbols, i);
        char* sym_name = vec_str_get(sym->name);
        if (strcmp(sym_name, name) == 0) {
            return sym->ptr;
        }
    }
    return NULL;
}

int driver_export_symbol(const char* name, void* ptr) {
    if (!exported_symbols) {
        exported_symbols = vector_create(sizeof(Symbol), 32);
    }
    
    for (uint32_t i = 0; i < exported_symbols->size; i++) {
        Symbol* sym = (Symbol*)exported_symbols->at(exported_symbols, i);
        char* sym_name = vec_str_get(sym->name);
        if (strcmp(sym_name, name) == 0) {
            sym->ptr = ptr;
            return 0;
        }
    }
    
    Symbol sym;
    sym.name = vec_str_create(name);
    sym.ptr = ptr;
    exported_symbols->push(exported_symbols, &sym);
    
    return 0;
}

void driver_print_symbols(void) {
    if (!exported_symbols || exported_symbols->size == 0) {
        printf("No exported symbols\n");
        return;
    }
    
    printf("\n=== Exported Symbols ===\n");
    for (uint32_t i = 0; i < exported_symbols->size; i++) {
        Symbol* sym = (Symbol*)exported_symbols->at(exported_symbols, i);
        printf("  %s -> 0x%p\n", vec_str_get(sym->name), sym->ptr);
    }
    printf("==========================\n");
}

                        
void pci_table_update(void) {
    Vector* buf = vector_create(sizeof(char), 256);
    
    char* header = "# PCI Driver Mapping\n# Format: driver_name vid:did class:subclass\n\n";
    for (int i = 0; header[i]; i++) buf->push(buf, &header[i]);
    
    char line[128];
    for (uint32_t i = 0; i < drivers->size; i++) {
        Driver** drv_ptr = (Driver**)drivers->at(drivers, i);
        Driver* drv = *drv_ptr;
        
        for (uint32_t j = 0; j < drv->info.pci_reserve->size; j++) {
            PCIReserve* res = (PCIReserve*)drv->info.pci_reserve->at(drv->info.pci_reserve, j);
            if (res->use_class) {
                sprintf(line, "%s class:%02X:%02X\n", 
                        vec_str_get(drv->info.name),
                        res->class_code,
                        res->subclass);
            } else {
                sprintf(line, "%s %04X:%04X\n", 
                        vec_str_get(drv->info.name),
                        res->vendor_id,
                        res->device_id);
            }
            for (int k = 0; line[k]; k++) buf->push(buf, &line[k]);
        }
    }
    
    write_file("/sys/drivers/pci_table.cfg", buf);
    buf->destroy(buf);
}

                      
void driver_cleanup(void) {
    if (!drivers) return;
    
    while (drivers->size > 0) {
        Driver** drv_ptr = (Driver**)drivers->at(drivers, 0);
        Driver* drv = *drv_ptr;
        char* name = vec_str_get(drv->info.name);
        if (name) driver_unload(name);
    }
    
    drivers->destroy(drivers);
    drivers = NULL;
    
    if (exported_symbols) {
        for (uint32_t i = 0; i < exported_symbols->size; i++) {
            Symbol* sym = (Symbol*)exported_symbols->at(exported_symbols, i);
            if (sym->name) sym->name->destroy(sym->name);
        }
        exported_symbols->destroy(exported_symbols);
        exported_symbols = NULL;
    }
}

