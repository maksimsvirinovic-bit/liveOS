// Rendering
static int desktop_rects_intersect(int ax, int ay, int aw, int ah,
                                   int bx, int by, int bw, int bh) {
    return ax < bx + bw && ax + aw > bx && ay < by + bh && ay + ah > by;
}

void desktop_mark_dirty(Desktop* d, int x, int y, int width, int height) {
    if (!d || width <= 0 || height <= 0) return;
    if (x < 0) { width += x; x = 0; }
    if (y < 0) { height += y; y = 0; }
    if (x + width > (int)w) width = w - x;
    if (y + height > (int)h) height = h - y;
    if (width <= 0 || height <= 0) return;

    for (uint32_t i = 0; i < d->dirty_count; i++) {
        DesktopDirtyRect* current = &d->dirty[i];
        if (desktop_rects_intersect(current->x, current->y, current->width, current->height,
                                    x, y, width, height)) {
            int right = current->x + current->width;
            int bottom = current->y + current->height;
            if (x + width > right) right = x + width;
            if (y + height > bottom) bottom = y + height;
            if (x < current->x) current->x = x;
            if (y < current->y) current->y = y;
            current->width = right - current->x;
            current->height = bottom - current->y;
            return;
        }
    }

    if (d->dirty_count < 32) {
        d->dirty[d->dirty_count].x = x;
        d->dirty[d->dirty_count].y = y;
        d->dirty[d->dirty_count].width = width;
        d->dirty[d->dirty_count].height = height;
        d->dirty_count++;
    } else {
        d->dirty_all = 1;
    }
}

void desktop_mark_all_dirty(Desktop* d) {
    if (!d) return;
    d->dirty_all = 1;
    d->dirty_count = 0;
