#include "gui_core.h"
#include "str.h"
#include "heap.h"
#include "console.h"

GUIContext* g_gui = NULL;

int gui_init(int w, int h) {
    if (g_gui) return -1;
    
    g_gui = (GUIContext*)kmalloc(sizeof(GUIContext));
    g_gui->windows = vector_create(sizeof(Window*), 16);
    g_gui->screen_w = w;
    g_gui->screen_h = h;
    
    printf("[GUI] Initialized: %dx%d\n", w, h);
    return 0;
}

void gui_shutdown(void) {
    if (!g_gui) return;
    
    while (g_gui->windows->size > 0) {
        Window* w = *(Window**)g_gui->windows->at(g_gui->windows, 0);
        gui_close_window(w);
    }
    
    g_gui->windows->destroy(g_gui->windows);
    kfree(g_gui);
    g_gui = NULL;
}

Window* gui_create_window(const char* title, int x, int y, int w, int h) {
    if (!g_gui) return NULL;
    
    Window* win = (Window*)kmalloc(sizeof(Window));
    strcpy(win->title, title);
    win->rect.x = x;
    win->rect.y = y;
    win->rect.w = w;
    win->rect.h = h;
    win->active = 1;
    win->needs_redraw = 1;
    
    win->root = gui_create_widget(WIDGET_PANEL, "root", 0, 0, w, h);
    
    g_gui->windows->push(g_gui->windows, &win);
    g_gui->active = win;
    
    return win;
}

void gui_close_window(Window* w) {
    if (!w) return;

    if (g_gui && g_gui->windows) {
        for (uint32_t i = 0; i < g_gui->windows->size; i++) {
            Window* current = *(Window**)g_gui->windows->at(g_gui->windows, i);
            if (current == w) {
                g_gui->windows->remove(g_gui->windows, i);
                break;
            }
        }
    }
    
    // Cleanup widgets recursively
    if (w->root) {
        for (uint32_t i = 0; i < w->root->children->size; i++) {
            Widget* child = *(Widget**)w->root->children->at(w->root->children, i);
            child->children->destroy(child->children);
            child->handlers->destroy(child->handlers);
            kfree(child);
        }
        w->root->children->destroy(w->root->children);
        w->root->handlers->destroy(w->root->handlers);
        kfree(w->root);
    }
    
    kfree(w);
}

Widget* gui_create_widget(WidgetType type, const char* id, int x, int y, int w, int h) {
    Widget* wid = (Widget*)kmalloc(sizeof(Widget));
    
    wid->type = type;
    strcpy(wid->id, id);
    wid->rect.x = x;
    wid->rect.y = y;
    wid->rect.w = w;
    wid->rect.h = h;
    wid->visible = 1;
    wid->children = vector_create(sizeof(Widget*), 8);
    wid->handlers = vector_create(sizeof(EventHandler), 4);
    
    // Default colors
    wid->bg.r = 40; wid->bg.g = 40; wid->bg.b = 40;
    wid->fg.r = 255; wid->fg.g = 255; wid->fg.b = 255;
    
    wid->text[0] = '\0';
    wid->parent = NULL;
    
    return wid;
}

void gui_add_child(Widget* parent, Widget* child) {
    if (!parent || !child) return;
    
    parent->children->push(parent->children, &child);
    child->parent = parent;
}

void gui_set_text(Widget* w, const char* text) {
    if (!w || !text) return;
    strcpy(w->text, text);
}

void gui_set_colors(Widget* w, Color bg, Color fg) {
    if (!w) return;
    w->bg = bg;
    w->fg = fg;
}

void gui_add_handler(Widget* w, EventHandler h) {
    if (!w || !h) return;
    w->handlers->push(w->handlers, &h);
}

void gui_send_event(Widget* w, Event* e) {
    if (!w || !e) return;
    
    for (uint32_t i = 0; i < w->handlers->size; i++) {
        EventHandler handler = *(EventHandler*)w->handlers->at(w->handlers, i);
        if (handler) handler(w, e);
    }
}

void gui_render_frame(void) {
    if (!g_gui || !g_gui->active) return;
    
    Window* w = g_gui->active;
    if (!w->needs_redraw) return;
    
    // Simple text-based rendering
    printf("\x1b[2J\x1b[H"); // Clear screen, home
    
    // Draw window border
    printf("┌");
    for (int i = 0; i < w->rect.w - 2; i++) printf("─");
    printf("┐\n");
    
    // Draw title
    printf("│ %s", w->title);
    for (int i = strlen(w->title) + 2; i < w->rect.w - 1; i++) printf(" ");
    printf("│\n");
    
    // Draw content area
    for (int i = 0; i < w->rect.h - 2; i++) {
        printf("│");
        for (int j = 0; j < w->rect.w - 2; j++) printf(" ");
        printf("│\n");
    }
    
    // Draw bottom border
    printf("└");
    for (int i = 0; i < w->rect.w - 2; i++) printf("─");
    printf("┘\n");
    
    w->needs_redraw = 0;
}

