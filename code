extern void* driver_resolve_symbol(const char* name);

static Context shell_context;
int shell_context_saved = 0;
static uint8_t* prog_mem = NULL;
static uint64_t prog_mem_size = 0;

static int elf_range_valid(uint64_t offset, uint64_t size, uint64_t limit) {
    return offset <= limit && size <= limit - offset;
}

static uint64_t elf_runtime_address(uint8_t* memory, uint64_t image_start,
                                    uint64_t image_size, uint64_t address) {
    if (address < image_start || address - image_start >= image_size) {
        return 0;
    }
    return (uint64_t)(memory + (address - image_start));
}

static int elf_apply_relocations(uint8_t* elf, uint64_t file_size,
                                 Elf64_Ehdr* header, uint8_t* memory,
                                 uint64_t image_start, uint64_t image_size) {
    if (header->e_shnum == 0) return 0;
    if (header->e_shentsize < sizeof(Elf64_Shdr) ||
        !elf_range_valid(header->e_shoff,
                         (uint64_t)header->e_shnum * header->e_shentsize,
                         file_size)) {
        printf("ELF: Invalid section header table\n");
        return -1;
    }

    Elf64_Shdr* sections = (Elf64_Shdr*)(elf + header->e_shoff);
    Elf64_Shdr* symtab = NULL;
    Elf64_Shdr* strtab = NULL;

    for (uint16_t i = 0; i < header->e_shnum; i++) {
        Elf64_Shdr* section = (Elf64_Shdr*)((uint8_t*)sections +
                                            (uint64_t)i * header->e_shentsize);
        if (section->sh_type == SHT_SYMTAB) {
            symtab = section;
            if (section->sh_link < header->e_shnum) {
                strtab = (Elf64_Shdr*)((uint8_t*)sections +
                                       (uint64_t)section->sh_link * header->e_shentsize);
            }
            break;
        }
    }

    if (symtab && (!elf_range_valid(symtab->sh_offset, symtab->sh_size, file_size) ||
                   symtab->sh_entsize < sizeof(Elf64_Sym) || !strtab ||
                   !elf_range_valid(strtab->sh_offset, strtab->sh_size, file_size))) {
        printf("ELF: Invalid symbol table\n");
        return -1;
    }

    for (uint16_t i = 0; i < header->e_shnum; i++) {
        Elf64_Shdr* relocation_section = (Elf64_Shdr*)((uint8_t*)sections +
                                                        (uint64_t)i * header->e_shentsize);
        if (relocation_section->sh_type != SHT_RELA) continue;
        if (relocation_section->sh_entsize < sizeof(Elf64_Rela) ||
            !elf_range_valid(relocation_section->sh_offset,
                             relocation_section->sh_size, file_size)) {
            printf("ELF: Invalid relocation section\n");
            return -1;
        }

        uint64_t relocation_count = relocation_section->sh_size /
                                    relocation_section->sh_entsize;
        for (uint64_t j = 0; j < relocation_count; j++) {
            Elf64_Rela* relocation = (Elf64_Rela*)(elf + relocation_section->sh_offset +
                                                   j * relocation_section->sh_entsize);
            uint32_t type = ELF64_R_TYPE(relocation->r_info);
            uint64_t target_address = elf_runtime_address(memory, image_start,
                                                           image_size,
                                                           relocation->r_offset);
            uint64_t relocation_width = (type == R_X86_64_PC32 ||
                                         type == R_X86_64_PLT32 ||
                                         type == R_X86_64_32 ||
                                         type == R_X86_64_32S) ? 4 : 8;
            if (!target_address || relocation->r_offset < image_start ||
                image_size < relocation_width ||
                relocation->r_offset - image_start > image_size - relocation_width) {
                printf("ELF: Relocation target is outside image\n");
                return -1;
            }

            uint64_t symbol_value = 0;
            uint32_t symbol_index = ELF64_R_SYM(relocation->r_info);
            if (type != R_X86_64_RELATIVE) {
                if (!symtab || symbol_index >= symtab->sh_size / symtab->sh_entsize) {
                    printf("ELF: Relocation symbol is unavailable\n");
                    return -1;
                }

                Elf64_Sym* symbol = (Elf64_Sym*)(elf + symtab->sh_offset +
                                                 symbol_index * symtab->sh_entsize);
                if (symbol->st_shndx == SHN_UNDEF) {
                    char* name = (char*)(elf + strtab->sh_offset + symbol->st_name);
                    if (symbol->st_name >= strtab->sh_size) return -1;
                    void* resolved = driver_resolve_symbol(name);
                    if (!resolved) {
                        printf("ELF: Unresolved symbol: %s\n", name);
                        return -1;
                    }
                    symbol_value = (uint64_t)resolved;
                } else if (symbol->st_shndx == 0xFFF1) {
                    symbol_value = symbol->st_value;
                } else {
                    symbol_value = elf_runtime_address(memory, image_start,
                                                       image_size, symbol->st_value);
                    if (!symbol_value) return -1;
                }
            }

            int64_t value;
            if (type == R_X86_64_RELATIVE) {
                value = (int64_t)((uint64_t)memory - image_start) +
                        relocation->r_addend;
            } else if (type == R_X86_64_64) {
                value = (int64_t)(symbol_value + relocation->r_addend);
                *(uint64_t*)target_address = (uint64_t)value;
                continue;
            } else if (type == R_X86_64_PC32 || type == R_X86_64_PLT32) {
                value = (int64_t)symbol_value + relocation->r_addend -
                        (int64_t)target_address;
                *(uint32_t*)target_address = (uint32_t)value;
                continue;
            } else if (type == R_X86_64_32 || type == R_X86_64_32S) {
                value = (int64_t)symbol_value + relocation->r_addend;
                *(uint32_t*)target_address = (uint32_t)value;
                continue;
            } else if (type == R_X86_64_NONE) {
                continue;
            } else {
                printf("ELF: Unsupported relocation type %d\n", type);
                return -1;
            }

            *(uint64_t*)target_address = (uint64_t)value;
        }
    }

    return 0;
}

                                   
static void restore_shell(void) {
    if (shell_context_saved) {
                                       
        if (prog_mem) {
            kfree(prog_mem);
            prog_mem = NULL;
            prog_mem_size = 0;
        }
        
        shell_context_saved = 0;
        
                                
        context_restore(&shell_context);
    }
}

void elf_abort_current(void) {
    if (!shell_context_saved) return;

    printf("\n^C\n");
    restore_shell();
}

                                   
void elf_crash_handler(int vector, ExceptionContext* ctx) {
    set_color(COLOR_RED, COLOR_BLACK);
    printf("\n*** ELF CRASH: Exception %d ***\n", vector);
    reset_color();
    
    printf("RIP: 0x%016X\n", ctx->frame.rip);
    printf("RSP: 0x%016X\n", ctx->frame.rsp);
    
    if (vector == 14) {
        uint64_t cr2;
        __asm__ volatile("mov %%cr2, %0" : "=r"(cr2));
        printf("CR2: 0x%016X\n", cr2);
    }
    
    set_color(COLOR_YELLOW, COLOR_BLACK);
    printf("[!] Program crashed.\n");
    printf("    Press Enter to continue.\n");
    reset_color();
    
    while (getchar() != '\n');

    printf("\n");
    
    restore_shell();
}

                         
int elf_run_args(const char* path, int argc, char** argv) {
    printf("Loading: %s\n", path);
    
                                                                               
    Vector* buf = vector_create(sizeof(uint8_t), 256);
    int size = read_file(path, buf);
    
    if (size <= 0) {
        printf("Cannot read file!\n");
        buf->destroy(buf);
        return -1;
    }
    
    uint8_t* elf = buf->data;
    
    if (size < 64 || elf[0] != 0x7F || elf[1] != 'E' || elf[2] != 'L' || elf[3] != 'F') {
        printf("Not ELF!\n");
        buf->destroy(buf);
        return -1;
    }
    
    if (size < (int)sizeof(Elf64_Ehdr)) {
        printf("ELF: Header is truncated\n");
        buf->destroy(buf);
        return -1;
    }

    Elf64_Ehdr* header = (Elf64_Ehdr*)elf;
    if (header->e_phentsize < sizeof(Elf64_Phdr) ||
        header->e_phnum == 0 ||
        header->e_phoff > (uint64_t)size ||
        header->e_phnum > ((uint64_t)size - header->e_phoff) / header->e_phentsize) {
        printf("ELF: Invalid program header table\n");
        buf->destroy(buf);
        return -1;
    }

    uint64_t image_start = ~(uint64_t)0;
    uint64_t image_end = 0;
    int loadable_segments = 0;

    for (uint16_t i = 0; i < header->e_phnum; i++) {
        Elf64_Phdr* ph = (Elf64_Phdr*)(elf + header->e_phoff +
                                       (uint64_t)i * header->e_phentsize);
        if (ph->p_type != PT_LOAD) continue;
        if (ph->p_filesz > ph->p_memsz || ph->p_offset > (uint64_t)size ||
            ph->p_filesz > (uint64_t)size - ph->p_offset ||
            ph->p_vaddr > (~(uint64_t)0) - ph->p_memsz) {
            printf("ELF: Invalid loadable segment\n");
            buf->destroy(buf);
            return -1;
        }

        if (ph->p_vaddr < image_start) image_start = ph->p_vaddr;
        if (ph->p_vaddr + ph->p_memsz > image_end) {
            image_end = ph->p_vaddr + ph->p_memsz;
        }
        loadable_segments++;
    }

    if (loadable_segments == 0 || header->e_entry < image_start ||
        header->e_entry >= image_end || image_end - image_start > 0xFFFFFFFFULL) {
        printf("ELF: No valid loadable image\n");
        buf->destroy(buf);
        return -1;
    }

    uint64_t image_size = image_end - image_start;

                                                    
    if (!shell_context_saved) {
        printf("Saving shell context...\n");
        
        if (context_save(&shell_context) == 1) {
                                                                        
                                                                           
            shell_context_saved = 0;
            
                                                                 
                                                                        
            return 0; 
        }
        shell_context_saved = 1;
    }
    
    prog_mem = (uint8_t*)kmalloc((uint32_t)image_size);
    if (!prog_mem) {
        printf("ELF: Cannot allocate %d bytes\n", (uint32_t)image_size);
        buf->destroy(buf);
        shell_context_saved = 0;
        return -1;
    }

    prog_mem_size = image_size;
    memset(prog_mem, 0, (uint32_t)image_size);

    for (uint16_t i = 0; i < header->e_phnum; i++) {
        Elf64_Phdr* ph = (Elf64_Phdr*)(elf + header->e_phoff +
                                       (uint64_t)i * header->e_phentsize);
        if (ph->p_type != PT_LOAD || ph->p_filesz == 0) continue;
        memcpy(prog_mem + (ph->p_vaddr - image_start),
               elf + ph->p_offset, (uint32_t)ph->p_filesz);
    }

    if (elf_apply_relocations(elf, (uint64_t)size, header, prog_mem,
                              image_start, image_size) != 0) {
        kfree(prog_mem);
        prog_mem = NULL;
        prog_mem_size = 0;
        buf->destroy(buf);
        shell_context_saved = 0;
        return -1;
    }

    uint64_t entry_offset = header->e_entry - image_start;
    
                                                                                   
    printf("[ELF] Ready to execute! First byte: 0x%02X, second byte: 0x%02X\n", 
           prog_mem[entry_offset], prog_mem[entry_offset + 1]);
    printf("=== PROGRAM OUTPUT ===\n");
    
                                             
    buf->destroy(buf);
    buf = NULL;                                                                       
    
                                
    __asm__ volatile("cpuid" : : : "rax","rbx","rcx","rdx");
    
                          
    uint64_t target_exec_addr = (uint64_t)(prog_mem + entry_offset);
    typedef int (*ElfEntry)(const KernelApi* api, int argc, char** argv);
    ElfEntry entry_point = (ElfEntry)target_exec_addr;
    const KernelApi* api = kernel_api_get();
    __asm__ volatile(
        "call *%0"
        :
        : "r"(entry_point), "D"(api), "S"(argc), "d"(argv)
        : "rax", "rcx", "r8", "r9", "r10", "r11", "memory"
    );
    
                                                          
    printf("\n[+] Program finished normally.\n");
    kfree(prog_mem);
    prog_mem = NULL;
    prog_mem_size = 0;
    shell_context_saved = 0;
    return 0;
}

int elf_run(const char* path) {
    return elf_run_args(path, 0, NULL);
}


