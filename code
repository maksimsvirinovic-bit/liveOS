#include "core/kernel_api.h"
#include "core/elf.h"

static int is_digit(char value) { return value >= '0' && value <= '9'; }

typedef struct {
    const char* cursor;
    const char* end;
} ExpressionParser;

static void skip_space(ExpressionParser* parser) {
    while (parser->cursor < parser->end && (*parser->cursor == ' ' || *parser->cursor == '\t')) parser->cursor++;
}

static int parse_expression(ExpressionParser* parser, int* value);

static int parse_factor(ExpressionParser* parser, int* value) {
    skip_space(parser);
    int sign = 1;
    if (parser->cursor < parser->end && *parser->cursor == '-') { sign = -1; parser->cursor++; }
    skip_space(parser);
    if (parser->cursor < parser->end && *parser->cursor == '(') {
        parser->cursor++;
        if (parse_expression(parser, value) != 0) return -1;
        skip_space(parser);
        if (parser->cursor >= parser->end || *parser->cursor != ')') return -1;
        parser->cursor++;
        *value *= sign;
        return 0;
    }
    if (parser->cursor >= parser->end || !is_digit(*parser->cursor)) return -1;
    int number = 0;
    while (parser->cursor < parser->end && is_digit(*parser->cursor)) number = number * 10 + (*parser->cursor++ - '0');
    *value = number * sign;
    return 0;
}

static int parse_term(ExpressionParser* parser, int* value) {
    if (parse_factor(parser, value) != 0) return -1;
    for (;;) {
        skip_space(parser);
        char operation = parser->cursor < parser->end ? *parser->cursor : 0;
        if (operation != '*' && operation != '/') return 0;
        parser->cursor++;
        int right = 0;
        if (parse_factor(parser, &right) != 0 || (operation == '/' && right == 0)) return -1;
        if (operation == '*') *value *= right; else *value /= right;
    }
}

static int parse_expression(ExpressionParser* parser, int* value) {
    if (parse_term(parser, value) != 0) return -1;
    for (;;) {
        skip_space(parser);
        char operation = parser->cursor < parser->end ? *parser->cursor : 0;
        if (operation != '+' && operation != '-') return 0;
        parser->cursor++;
        int right = 0;
        if (parse_term(parser, &right) != 0) return -1;
        if (operation == '+') *value += right; else *value -= right;
    }
}

static int find_return(const char* text, uint32_t size, int* value) {
    const char* needle = "return";
    for (uint32_t i = 0; i + 6 < size; i++) {
        int match = 1;
        for (int j = 0; j < 6; j++) if (text[i + j] != needle[j]) match = 0;
        if (!match) continue;
        ExpressionParser parser = { text + i + 6, text + size };
        if (parse_expression(&parser, value) == 0) return 0;
    }
    return -1;
}

int main(const KernelApi* api, int argc, char** argv) {
    if (!api || argc < 3 || argc > 4) {
        if (api) api->printf("Usage: cc <source.c> -o <output.elf>\n");
        return 1;
    }
    const char* output = argv[2];
    if (argc == 4 && argv[2][0] == '-' && argv[2][1] == 'o') output = argv[3];
    Vector* source = api->vector_create(sizeof(char), 256);
    if (api->read_file(argv[1], source) <= 0) { api->printf("cc: cannot read %s\n", argv[1]); source->destroy(source); return 1; }
    int result = 0;
    if (find_return((char*)source->data, source->size, &result) != 0) {
        api->printf("cc: supported subset requires a numeric return statement\n");
        source->destroy(source);
        return 1;
    }
    Elf64_Ehdr header;
    Elf64_Phdr program;
    for (uint32_t i = 0; i < sizeof(header); i++) ((uint8_t*)&header)[i] = 0;
    for (uint32_t i = 0; i < sizeof(program); i++) ((uint8_t*)&program)[i] = 0;
    header.e_ident[0] = 0x7F; header.e_ident[1] = 'E'; header.e_ident[2] = 'L'; header.e_ident[3] = 'F';
    header.e_ident[4] = 2; header.e_ident[5] = 1; header.e_type = 2; header.e_machine = 62; header.e_version = 1;
    header.e_entry = 0x400100; header.e_phoff = sizeof(header); header.e_ehsize = sizeof(header); header.e_phentsize = sizeof(program); header.e_phnum = 1;
    program.p_type = PT_LOAD; program.p_flags = 5; program.p_offset = 0x100; program.p_vaddr = 0x400100; program.p_paddr = 0x400100; program.p_filesz = 6; program.p_memsz = 6; program.p_align = 0x1000;
    Vector* output_data = api->vector_create(sizeof(uint8_t), 512);
    for (uint32_t i = 0; i < 0x100; i++) { uint8_t zero = 0; output_data->push(output_data, &zero); }
    for (uint32_t i = 0; i < sizeof(header); i++) output_data->data[i] = ((uint8_t*)&header)[i];
    for (uint32_t i = 0; i < sizeof(program); i++) output_data->data[sizeof(header) + i] = ((uint8_t*)&program)[i];
    uint8_t code[6] = { 0xB8, (uint8_t)result, (uint8_t)(result >> 8), (uint8_t)(result >> 16), (uint8_t)(result >> 24), 0xC3 };
    for (uint32_t i = 0; i < sizeof(code); i++) output_data->push(output_data, &code[i]);
    int status = api->write_file(output, output_data);
    output_data->destroy(output_data); source->destroy(source);
    if (status != 0) { api->printf("cc: cannot write %s\n", output); return 1; }
