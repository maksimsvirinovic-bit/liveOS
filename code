// Serial port (COM1) I/O functions
#define SERIAL_PORT 0x3F8
#define SERIAL_TIMEOUT 100000

static inline uint8_t inb(uint16_t port) {
    uint8_t val;
    __asm__ volatile("inb %1, %0" : "=a"(val) : "dN"(port));
    return val;
}

static inline void outb(uint16_t port, uint8_t val) {
    __asm__ volatile("outb %0, %1" : : "a"(val), "dN"(port));
}

static inline void serial_putc(char c) {
    int timeout = SERIAL_TIMEOUT;
    // Wait for transmit buffer to be empty
    while (timeout-- && !(inb(SERIAL_PORT + 5) & 0x20));
    outb(SERIAL_PORT, (uint8_t)c);
}

uint32_t* fb;
uint32_t w, h, p;
int cx = 0, cy = 0;

int cols, rows;

uint32_t fg_color = COLOR_WHITE;
uint32_t bg_color = COLOR_BLACK;

int need_scroll = 0;

                        
static void scroll_up(void) {
                                            
    uint32_t row_size = p * FONT_H;                                   
    uint32_t screen_size = h * p;                                
    
                                                 
    for (uint32_t y = 0; y < h - FONT_H; y++) {
        for (uint32_t x = 0; x < w; x++) {
            fb[y * p + x] = fb[(y + FONT_H) * p + x];
        }
    }
    
                               
    for (uint32_t y = h - FONT_H; y < h; y++) {
        for (uint32_t x = 0; x < w; x++) {
            fb[y * p + x] = bg_color;
        }
    }
}

void console_init(uint32_t* framebuffer, uint32_t width, uint32_t height, uint32_t pitch) {
    fb = framebuffer;
    w = width;
    h = height;
    p = pitch / 4;
    cx = cy = 0;
    cols = w / 8;
    rows = h / 8;
}

void set_color(uint32_t fg, uint32_t bg) { fg_color = fg; bg_color = bg; }
void reset_color(void) { fg_color = COLOR_WHITE; bg_color = COLOR_BLACK; }

void putc(char c) {
    serial_putc(c);  // Also send to serial console
    
    if (c == '\n') {
        cx = 0;
        cy++;


        if (cy >= rows) {
            if (!need_scroll){
                scroll_up();
                cy = rows - 1;
            }
        }
        return;
    }
    
    if (c == '\r') {
        cx = 0;
        return;
    }
    
    if (c == '\b') {
        if (cx > 0) {
            cx--;
                              
            for (int fy = 0; fy < FONT_H; fy++) {
                for (int fx = 0; fx < FONT_W; fx++) {
                    int px = cx * FONT_W + fx;
                    int py = cy * FONT_H + fy;
                    if (px >= 0 && px < (int)w && py >= 0 && py < (int)h) {
                        fb[py * p + px] = bg_color;
                    }
                }
            }
        }
        return;
    }
    
                                                   
    if (cx >= cols) {
        cx = 0;
        cy++;
        if (cy >= rows) {
            scroll_up();
            cy = rows - 1;
        }
    }
    
                    
    const uint8_t* glyph = font8x8[(uint8_t)c];
    for (int fy = 0; fy < FONT_H; fy++) {
        for (int fx = 0; fx < FONT_W; fx++) {
            int px = cx * FONT_W + fx;
            int py = cy * FONT_H + fy;
            if (px >= 0 && px < (int)w && py >= 0 && py < (int)h) {
                if (glyph[fy] & (1 << (7 - fx))) {
                    fb[py * p + px] = fg_color;
                } else {
                    fb[py * p + px] = bg_color;
                }
            }
        }
    }
    
    cx++;
    
                               
    if (!need_scroll) {
        if (cx >= cols) {
            cx = 0;
            cy++;
            if (cy >= rows) {
                scroll_up();
                cy = rows - 1;
            }
        }
    }
}

void print(const char* s) {
    while (*s) putc(*s++);
}

void print_int(int v) {
    if (v < 0) { putc('-'); v = -v; }
    if (v >= 10) print_int(v / 10);
    putc('0' + v % 10);
}

void print_hex(uint64_t v) {
    print("0x");
    for (int i = 60; i >= 0; i -= 4) {
        int d = (v >> i) & 0xF;
        putc(d < 10 ? '0' + d : 'A' + d - 10);
    }
}

void print_rainbow(const char* s) {
    static const uint32_t colors[] = {
        COLOR_RED, COLOR_ORANGE, COLOR_YELLOW,
        COLOR_GREEN, COLOR_BLUE, COLOR_MAGENTA
    };
    
    int ci = 0;
    while (*s) {
        fg_color = colors[ci % 6];
        putc(*s);
        s++;
        ci++;
    }
}

void clear_line(void) {
    print("\r");
    for (int i = 0; i < rows; i++) putc(' ');
    print("\r");
}

                                         
void console_gotoxy(int x, int y) {
    if (x < 0) x = 0;
    if (x >= cols) x = cols - 1;
    if (y < 0) y = 0;
    if (y >= rows) y = rows - 1;
    cx = x;
    cy = y;
}

                         
void console_clear_line(int y) {
    int old_cx = cx;
    int old_cy = cy;
    
    cx = 0;
    cy = y;
    for (int i = 0; i < cols; i++) putc(' ');
    cx = 0;
    cy = y;
    
    cx = old_cx;
    cy = old_cy;
}

                                 
void console_clear_current_line(void) {
    int old_cx = cx;
    
                                   
    cx = 0;
                         
    for (int i = 0; i < cols; i++) putc(' ');
                                          
    cx = old_cx;
}

                                    
void console_save_cursor(void) {
    putc(0x1B); putc('7');                              
}

                                       
void console_restore_cursor(void) {
    putc(0x1B); putc('8');                                 
}

