int udp_send(uint32_t dst_ip, uint16_t src_port, uint16_t dst_port, 
             const uint8_t* data, uint16_t len) {
    uint8_t packet[1500];
    if (!data || len > sizeof(packet) - sizeof(UdpHeader)) return -1;

    UdpHeader* udp = (UdpHeader*)packet;
    
    udp->src_port = htons(src_port);
    udp->dst_port = htons(dst_port);
    udp->length = htons(sizeof(UdpHeader) + len);
    udp->checksum = 0;
    
    memcpy(packet + sizeof(UdpHeader), data, len);

    return ip_send(dst_ip, 17, packet, sizeof(UdpHeader) + len);
}

int udp_receive(uint8_t* buffer, uint16_t max_len, uint32_t* src_ip, uint16_t* src_port) {
    if (!buffer || max_len == 0) return -1;

                 
    for (int attempt = 0; attempt < 1000; attempt++) {
        uint8_t frame[2048];
        int frame_len = e1000_receive_packet(frame, sizeof(frame));
        
        if (frame_len > 0) {
            uint16_t ethertype = (frame[12] << 8) | frame[13];
            
            if (ethertype == ETHERTYPE_IPV4) {
                Ipv4Header* ip = (Ipv4Header*)(frame + 14);
                
                if (ip->protocol == 17) {        
                    UdpHeader* udp = (UdpHeader*)(frame + 14 + 20);
                    
                    uint16_t udp_length = ntohs(udp->length);
                    if (udp_length < sizeof(UdpHeader) ||
                        14 + 20 + udp_length > frame_len) {
                        continue;
                    }

                    uint16_t data_len = udp_length - sizeof(UdpHeader);
                    if (data_len > max_len) data_len = max_len;
                    
                    if (data_len > 0) {
                        memcpy(buffer, frame + 14 + 20 + 8, data_len);
                        
                        if (src_ip) *src_ip = ntohl(ip->src_ip);
                        if (src_port) *src_port = ntohs(udp->src_port);
                        
                        #ifdef DEBUG_UDP
                        print("UDP: Received ");
                        print_int(data_len);
                        print(" bytes from ");
                        print_ip(ntohl(ip->src_ip));
                        print(":");
                        print_int(ntohs(udp->src_port));
                        print("\n");
                        #endif
                        
                        return data_len;
                    }
                }
            }
        }
        
        for (volatile int i = 0; i < 1000; i++);
    }
    
    return 0;
}

