static inline uint16_t htons(uint16_t x) {
    return ((x & 0xFF) << 8) | ((x >> 8) & 0xFF);
}

static inline uint32_t htonl(uint32_t x) {
    return ((x & 0xFF) << 24) | ((x & 0xFF00) << 8) | 
           ((x >> 8) & 0xFF00) | ((x >> 24) & 0xFF);
}

static inline uint16_t ntohs(uint16_t x) { return htons(x); }
static inline uint32_t ntohl(uint32_t x) { return htonl(x); }

static inline void print_ip(uint32_t ip) {
    print_int((ip >> 24) & 0xFF);
    print(".");
    print_int((ip >> 16) & 0xFF);
    print(".");
    print_int((ip >> 8) & 0xFF);
    print(".");
    print_int(ip & 0xFF);
}

static int parse_ip(const char* str, uint64_t* out) {
    uint32_t ip = 0;
    int parts = 0;
    
    for (int i = 0; i < 4; i++) {
        uint32_t part = 0;
        while (*str >= '0' && *str <= '9') {
            part = part * 10 + (*str - '0');
            str++;
        }
        
        if (part > 255) return 0;
        
        ip = (ip << 8) | part;
        parts++;
        
        if (*str == '.') str++;
        else break;
    }
    
    if (parts != 4) return 0;
    
    *out = ip;
    return 1;
}

static uint32_t parse_ip_str(const char* ip_str) {
    uint32_t ip = 0;
    uint32_t part = 0;
    const char* p = ip_str;
    
    for (int i = 0; i < 4; i++) {
        part = 0;
        while (*p >= '0' && *p <= '9') {
            part = part * 10 + (*p - '0');
            p++;
        }
        ip |= ((part & 0xFF) << (i * 8));
        if (*p == '.') p++;
    }
    return ip;
}


