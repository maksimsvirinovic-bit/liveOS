static uint16_t dns_message_id = 0x1234;

                             
static int dns_encode_domain_tls(uint8_t* buffer, int offset, const char* domain) {
    const char* start = domain;
    int pos = offset;
    
    while (*start) {
        const char* end = start;
        while (*end && *end != '.') end++;
        
        int len = end - start;
        if (len > 63) return -1;
        
        buffer[pos++] = (uint8_t)len;
        for (int i = 0; i < len; i++) {
            buffer[pos++] = start[i];
        }
        
        if (*end == '.') start = end + 1;
        else break;
    }
    
    buffer[pos++] = 0;
    return pos - offset;
}

                                 
static int dns_build_query_tls(const char* domain, uint8_t* buffer, int max_len) {
    int pos = 0;
    
             
    buffer[pos++] = (dns_message_id >> 8) & 0xFF;
    buffer[pos++] = dns_message_id & 0xFF;
    dns_message_id++;
    
    buffer[pos++] = 0x01;           
    buffer[pos++] = 0x00;
    
    buffer[pos++] = 0x00;
    buffer[pos++] = 0x01;                
    
    buffer[pos++] = 0x00;
    buffer[pos++] = 0x00;                
    buffer[pos++] = 0x00;
    buffer[pos++] = 0x00;                
    buffer[pos++] = 0x00;
    buffer[pos++] = 0x00;                
    
               
    int enc_len = dns_encode_domain_tls(buffer, pos, domain);
    if (enc_len < 0) return -1;
    pos += enc_len;
    
    buffer[pos++] = 0x00;
    buffer[pos++] = 0x01;           
    
    buffer[pos++] = 0x00;
    buffer[pos++] = 0x01;             
    
    return pos;
}

                             
static int dns_parse_response_tls(const uint8_t* data, int len, uint32_t* resolved_ip) {
    if (len < 12) return -1;
    
    uint16_t id = (data[0] << 8) | data[1];
    uint16_t flags = (data[2] << 8) | data[3];
    uint16_t qdcount = (data[4] << 8) | data[5];
    uint16_t ancount = (data[6] << 8) | data[7];
    
    if ((flags & 0xF) != 0) {
        #ifdef DEBUG_DOT
        printf("DNS: Error code %d\n", flags & 0xF);
        #endif
        return -1;
    }
    
    if (ancount == 0) {
        #ifdef DEBUG_DOT
        printf("DNS: No answers\n");
        #endif
        return -1;
    }
    
    int pos = 12;
    
                        
    while (pos < len) {
        if (data[pos] == 0) {
            pos++;
            break;
        } else if (data[pos] & 0xC0) {
            pos += 2;
            break;
        } else {
            pos += data[pos] + 1;
        }
    }
    
    pos += 4;                 
    
                    
    for (int i = 0; i < ancount; i++) {
              
        if (pos >= len) break;
        if (data[pos] & 0xC0) {
            pos += 2;
        } else {
            while (pos < len && data[pos] != 0) pos++;
            pos++;
        }
        
        if (pos + 10 > len) break;
        
        uint16_t type = (data[pos] << 8) | data[pos+1];
        pos += 2;
        
        uint16_t class = (data[pos] << 8) | data[pos+1];
        pos += 2;
        
        uint32_t ttl = (data[pos] << 24) | (data[pos+1] << 16) |
                       (data[pos+2] << 8) | data[pos+3];
        pos += 4;
        
        uint16_t rdlength = (data[pos] << 8) | data[pos+1];
        pos += 2;
        
        if (type == 1 && rdlength == 4) {
            *resolved_ip = (data[pos] << 24) | (data[pos+1] << 16) |
                           (data[pos+2] << 8) | data[pos+3];
            return 0;
        }
        
        pos += rdlength;
    }
    
    return -1;
}

                       
int dns_resolve_dot(uint32_t server_ip, const char* domain, uint32_t* resolved_ip) {
    if (!domain || !resolved_ip) return -1;
    #ifdef DEBUG_DOT
    printf("DoT: Resolving %s via %d.%d.%d.%d:853\n", domain,
           (server_ip >> 24) & 0xFF,
           (server_ip >> 16) & 0xFF,
           (server_ip >> 8) & 0xFF,
           server_ip & 0xFF);
    #endif
    
                     
    TcpConnection tcp;
    if (tcp_connect(&tcp, server_ip, 853, 12345) != 0) {
        #ifdef DEBUG_DOT
        printf("DoT: TCP connection failed\n");
        #endif
        return -1;
    }
    
                     
    TlsConnection tls;
    if (tls_connect(&tls, &tcp, "1.1.1.1") != 0) {
        #ifdef DEBUG_DOT
        printf("DoT: TLS handshake failed\n");
        #endif
        tcp_close(&tcp);
        return -1;
    }
    
                        
    uint8_t query[512];
    int query_len = dns_build_query_tls(domain, query, sizeof(query));
    if (query_len < 0) {
        #ifdef DEBUG_DOT
        printf("DoT: Failed to build query\n");
        #endif
        tls_close(&tls);
        return -1;
    }
    
                                                          
    uint8_t packet[514];
    packet[0] = (query_len >> 8) & 0xFF;
    packet[1] = query_len & 0xFF;
    memcpy(packet + 2, query, query_len);
    
                 
    tls_send(&tls, packet, query_len + 2);
    
                 
    uint8_t response[1024];
    int len = tls_receive(&tls, response, sizeof(response));
    
    tls_close(&tls);
    
    if (len < 2) {
        #ifdef DEBUG_DOT
        printf("DoT: No response\n");
        #endif
        return -1;
    }
    
                      
    uint16_t resp_len = (response[0] << 8) | response[1];
    if (resp_len + 2 > len) {
        #ifdef DEBUG_DOT
        printf("DoT: Truncated response\n");
        #endif
        return -1;
    }
    
                   
    if (dns_parse_response_tls(response + 2, resp_len, resolved_ip) == 0) {
        #ifdef DEBUG_DOT
        printf("DoT: Resolved %s -> ", domain);
        print_ip(*resolved_ip);
        printf("\n");
        #endif
        return 0;
    }
    #ifdef DEBUG_DOT
    printf("DoT: No A record found\n");
    #endif
    return -1;
}

