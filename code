#include "arp.h"
#include "../e1000.h"
#include "ethernet.h"
#include "console.h"
#include "str.h"
#include "netutils.h"

MacAddress our_mac;
uint32_t our_ip = 0;

MacAddress arp_cached_mac;
uint8_t arp_mac_is_cached = 0;

static inline void lock_arp(void) { asm volatile("cli"); }
static inline void unlock_arp(void) { asm volatile("sti"); }

void arp_init(uint32_t ip) {
    our_ip = ip;
    memcpy(our_mac.bytes, e1000_get_mac(), 6);
}

int arp_request(uint32_t target_ip, MacAddress* result_mac) {
    #ifdef DEBUG_ARP
    print("ARP: Who has ");
    print_ip(target_ip);
    print("?\n");
    #endif

    if (arp_mac_is_cached == 1){
        #ifdef DEBUG_ARP
        print("Use saved MAC\n");
        #endif
        memcpy(result_mac->bytes, arp_cached_mac.bytes, 6);
        return 0;
    }
    
                           
    ArpPacket arp;
    arp.htype = htons(1);
    arp.ptype = htons(0x0800);
    arp.hlen = 6;
    arp.plen = 4;
    arp.opcode = htons(1);
    memcpy(arp.sender_mac.bytes, our_mac.bytes, 6);
    arp.sender_ip = htonl(our_ip);
    memset(arp.target_mac.bytes, 0, 6);
    arp.target_ip = htonl(target_ip);
    
                 
    ethernet_send(broadcast_mac, ETHERTYPE_ARP, (uint8_t*)&arp, sizeof(arp));
    #ifdef DEBUG_ARP
    print("ARP: Sent, waiting for reply...\n");
    #endif
    int packet_count = 0;
    
    for (int i = 0; i < 200; i++) {
        uint8_t buf[2048];
        int len = ethernet_receive(buf, sizeof(buf));
        
        if (len > 0) {
            packet_count++;
            
                                  
            uint16_t ethertype = (buf[12] << 8) | buf[13];
            
            if (ethertype != ETHERTYPE_ARP) {
                continue;
            }
            
            ArpPacket* reply = (ArpPacket*)(buf + 14);
            #ifdef DEBUG_ARP
            print("  ARP opcode: ");
            print_int(ntohs(reply->opcode));
            print("\n");
            
            print("  sender_ip: ");
            print_ip(ntohl(reply->sender_ip));
            print("\n");
            
            print("  target_ip: ");
            print_ip(ntohl(reply->target_ip));
            print("\n");
            
            print("  our_ip: ");
            print_ip(our_ip);
            print("\n");
            
                                
            
            if (ntohs(reply->opcode) == 2) {
                print("  It's a REPLY!\n");
            } else {
                print("  Not a REPLY (opcode=");
                print_int(ntohs(reply->opcode));
                print(")\n");
            }
            
            if (ntohl(reply->sender_ip) == target_ip) {
                print("  Sender IP MATCHES!\n");
            } else {
                print("  Sender IP mismatch (expected ");
                print_ip(target_ip);
                print(")\n");
            }
            #endif
            
            if (ntohs(reply->opcode) == 2 && ntohl(reply->sender_ip) == target_ip) {
                lock_arp();
                memcpy(result_mac->bytes, reply->sender_mac.bytes, 6);
                memcpy(arp_cached_mac.bytes, reply->sender_mac.bytes, 6);
                arp_mac_is_cached = 1;
                unlock_arp();
                #ifdef DEBUG_ARP
                print("ARP: Got MAC!\n");
                #endif
                return 0;
            }
        }
        
                   
        for (volatile int j = 0; j < 1000; j++);
    }
    #ifdef DEBUG_ARP
    print("ARP: Timeout! Received ");
    print_int(packet_count);
    print(" packets total\n");
    #endif
    return -1;
}

