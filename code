Vector* shell_variables = NULL;
Vector* shell_functions = NULL;

static int shell_script_depth = 0;
#define SHELL_SCRIPT_MAX_DEPTH 16

                            
void shell_script_init(void) {
    if (!shell_variables) {
        shell_variables = vector_create(sizeof(ShellVar), 16);
    }
    if (!shell_functions) {
        shell_functions = vector_create(sizeof(ShellFunc), 16);
    }
}

                         
void shell_set_var(const char* name, const char* value) {
    if (!shell_variables) shell_script_init();
    
                        
    for (uint32_t i = 0; i < shell_variables->size; i++) {
        ShellVar* var = (ShellVar*)shell_variables->at(shell_variables, i);
        if (strcmp(var->name, name) == 0) {
            strcpy(var->value, value);
            return;
        }
    }
    
                      
    ShellVar var;
    strcpy(var.name, name);
    strcpy(var.value, value);
    shell_variables->push(shell_variables, &var);
}

char* shell_get_var(const char* name) {
    if (!shell_variables) return NULL;
    
                             
    if (strcmp(name, "PWD") == 0) {
        return (char*)vfs_get_path();
    }
    if (strcmp(name, "HOME") == 0) {
        return "/home";
    }
    if (strcmp(name, "USER") == 0) {
        return "root";
    }
    if (strcmp(name, "SHELL") == 0) {
        return "/bin/sh";
    }
    
    for (uint32_t i = 0; i < shell_variables->size; i++) {
        ShellVar* var = (ShellVar*)shell_variables->at(shell_variables, i);
        if (strcmp(var->name, name) == 0) {
            return var->value;
        }
    }
    return NULL;
}

void shell_unset_var(const char* name) {
    if (!shell_variables) return;
    
    for (uint32_t i = 0; i < shell_variables->size; i++) {
        ShellVar* var = (ShellVar*)shell_variables->at(shell_variables, i);
        if (strcmp(var->name, name) == 0) {
                      
            for (uint32_t j = i; j < shell_variables->size - 1; j++) {
                shell_variables->data[j * sizeof(ShellVar)] = 
                    shell_variables->data[(j + 1) * sizeof(ShellVar)];
            }
            shell_variables->size--;
            return;
        }
    }
}

void shell_print_env(void) {
    if (!shell_variables) {
        printf("(empty)\n");
        return;
    }
    
    printf("\n=== Environment ===\n");
    for (uint32_t i = 0; i < shell_variables->size; i++) {
        ShellVar* var = (ShellVar*)shell_variables->at(shell_variables, i);
        printf("  %s = %s\n", var->name, var->value);
    }
    printf("===================\n");
}

                      
void shell_add_function(const char* name, const char* body) {
    if (!shell_functions) shell_script_init();
    
                        
    for (uint32_t i = 0; i < shell_functions->size; i++) {
        ShellFunc* func = (ShellFunc*)shell_functions->at(shell_functions, i);
        if (strcmp(func->name, name) == 0) {
                                        
            if (func->body) kfree(func->body);
            func->body = (char*)kmalloc(strlen(body) + 1);
            if (!func->body) {
                printf("shell: Out of memory\n");
                return;
            }
            strcpy(func->body, body);
            func->body_len = strlen(body);
            func->is_defined = 1;
            return;
        }
    }
    
                      
    ShellFunc func;
    strcpy(func.name, name);
    func.body = (char*)kmalloc(strlen(body) + 1);
    if (!func.body) {
        printf("shell: Out of memory\n");
        return;
    }
    strcpy(func.body, body);
    func.body_len = strlen(body);
    func.is_defined = 1;
    shell_functions->push(shell_functions, &func);
    
    printf("shell: Function '%s' defined\n", name);
}

char* shell_get_function_body(const char* name) {
    if (!shell_functions) return NULL;
    
    for (uint32_t i = 0; i < shell_functions->size; i++) {
        ShellFunc* func = (ShellFunc*)shell_functions->at(shell_functions, i);
        if (strcmp(func->name, name) == 0 && func->is_defined) {
            return func->body;
        }
    }
    return NULL;
}

int shell_is_function(const char* name) {
    return shell_get_function_body(name) != NULL;
}

int shell_call_function(const char* name) {
    char* body = shell_get_function_body(name);
    if (!body) {
        printf("shell: Function '%s' not found\n", name);
        return -1;
    }
    
    printf("shell: Calling function '%s'\n", name);
    
                                               
                        
    if (shell_script_depth >= SHELL_SCRIPT_MAX_DEPTH) {
        printf("shell: maximum script depth exceeded\n");
        return -1;
    }
    shell_script_depth++;
    
                    
    char* code = (char*)kmalloc(strlen(body) + 1);
    if (!code) {
        printf("shell: Out of memory\n");
        shell_script_depth--;
        return -1;
    }
    strcpy(code, body);
    
                          
    char* line = strtok(code, "\n");
    while (line) {
                          
        char* start = line;
        while (*start == ' ' || *start == '\t') start++;
        
        if (*start != '\0' && *start != '#') {
            shell_execute_line(start);
        }
        line = strtok(NULL, "\n");
    }
    
    kfree(code);
    shell_script_depth--;
    
    return 0;
}

                          
char* shell_expand(const char* input) {
    static char buffer[2048];
    int pos = 0;
    int i = 0;
    
    while (input[i] && pos < 2047) {
        if (input[i] == '$') {
            i++;
            
                                       
            if (input[i] == '(') {
                i++;
                char cmd[256];
                int j = 0;
                while (input[i] && input[i] != ')' && j < 255) {
                    cmd[j++] = input[i++];
                }
                cmd[j] = '\0';
                if (input[i] == ')') i++;
                
                                                     
                                                      
                                                
                                            
                continue;
            }
            
                   
            char name[64];
            int j = 0;
            while (input[i] && (input[i] == '_' || (input[i] >= 'a' && input[i] <= 'z') || 
                   (input[i] >= 'A' && input[i] <= 'Z') || (input[i] >= '0' && input[i] <= '9'))) {
                name[j++] = input[i++];
            }
            name[j] = '\0';
            
            char* value = shell_get_var(name);
            if (value) {
                for (int k = 0; value[k] && pos < 2047; k++) {
                    buffer[pos++] = value[k];
                }
            }
        } else if (input[i] == '~') {
                       
            char* home = shell_get_var("HOME");
            if (home) {
                for (int k = 0; home[k] && pos < 2047; k++) {
                    buffer[pos++] = home[k];
                }
            }
            i++;
        } else {
            buffer[pos++] = input[i++];
        }
    }
    buffer[pos] = '\0';
    return buffer;
}

                              
static int shell_parse_function_def(const char* line, char* name, char** body_start) {
                                          
    const char* p = line;
    char temp[64];
    int j = 0;
    
                         
    while (*p && *p != ' ' && *p != '(' && *p != '\t') {
        if (j < 63) temp[j++] = *p;
        p++;
    }
    temp[j] = '\0';
    
                                                               
    const char* open_paren = strchr(p, '(');
    const char* close_paren = strchr(p, ')');
    const char* open_brace = strchr(p, '{');
    
    if ((open_paren && close_paren && open_brace) || strstr(line, "function") == line) {
        if (strstr(line, "function") == line) {
                                
            p = line + 8;
            while (*p == ' ') p++;
            j = 0;
            while (*p && *p != ' ' && *p != '(') {
                if (j < 63) temp[j++] = *p;
                p++;
            }
            temp[j] = '\0';
        }
        
                               
        const char* body = strchr(line, '{');
        if (!body) body = strchr(line, '\n');
        if (body) {
            body++;
            strcpy(name, temp);
            *body_start = (char*)body;
            return 1;
        }
    }
    
    return 0;
}

                                
void shell_execute_line(const char* line) {
                         
    while (*line == ' ' || *line == '\t') line++;
    if (*line == '\0' || *line == '#') return;
    
                                           
    char func_name[64];
    char* body_start = NULL;
    if (shell_parse_function_def(line, func_name, &body_start)) {
        if (body_start) {
            shell_add_function(func_name, body_start);
        }
        return;
    }
    
                                     
    if (shell_is_function(line)) {
        shell_call_function(line);
        return;
    }
    
                      
    char* expanded = shell_expand(line);
    shell_execute(expanded);
}

                                 
int shell_run_script(const char* path) {
    printf("Running script: %s\n", path);
    
    Vector* content = vector_create(sizeof(uint8_t), 256);
    int size = read_file(path, content);
    
    if (size <= 0) {
        printf("shell: Cannot read script: %s\n", path);
        content->destroy(content);
        return -1;
    }
    
    char* data = (char*)content->data;
    char* line = strtok(data, "\n");
    int line_num = 0;
    
                          
    if (shell_script_depth >= SHELL_SCRIPT_MAX_DEPTH) {
        printf("shell: maximum script depth exceeded\n");
        content->destroy(content);
        return -1;
    }
    shell_script_depth++;
    
    while (line) {
        line_num++;
        
                                   
        char* start = line;
        while (*start == ' ' || *start == '\t') start++;
        
        if (*start != '\0' && *start != '#') {
                                  
            shell_execute_line(start);
        }
        
        line = strtok(NULL, "\n");
    }
    
    shell_script_depth--;
    content->destroy(content);
    
    return 0;
}

int shell_run_script_string(const char* code) {
    if (!code || code[0] == '\0') return 0;
    
    printf("Running script from string...\n");
    
                             
    char temp_path[256];
    sprintf(temp_path, "/tmp/script_%d.sh", (int)rdtsc());
    
                     
    Vector* buf = vector_create(sizeof(char), 256);
    for (int i = 0; code[i]; i++) {
        buf->push(buf, &code[i]);
    }
    write_file(temp_path, buf);
    buf->destroy(buf);
    
                
    int ret = shell_run_script(temp_path);
    
                             
    delete_file(temp_path);
    
    return ret;
}

                                
int shell_run_string(const char* code) {
    return shell_run_script_string(code);
}

                                            
void shell_print_functions(void) {
    if (!shell_functions || shell_functions->size == 0) {
        printf("(no functions)\n");
        return;
    }
    
    printf("\n=== Defined Functions ===\n");
    for (uint32_t i = 0; i < shell_functions->size; i++) {
        ShellFunc* func = (ShellFunc*)shell_functions->at(shell_functions, i);
        if (func->is_defined) {
            printf("  %s()", func->name);
            if (func->body) {
                printf(" (body: %d bytes)\n", func->body_len);
            } else {
                printf("\n");
            }
        }
    }
    printf("========================\n");
}

