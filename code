int icmp_ping(uint32_t dst_ip, uint16_t sequence) {
    #ifdef DEBUG_ICMP
    print("ICMP: Ping ");
    print_ip(dst_ip);
    print("\n");
    #endif
    
    uint8_t packet[64];
    IcmpHeader* icmp = (IcmpHeader*)packet;
    
    icmp->type = 8;
    icmp->code = 0;
    icmp->checksum = 0;
    icmp->id = htons(0x1234);
    icmp->sequence = htons(sequence);
    
    for (int i = 8; i < 64; i++) packet[i] = i;
    
    icmp->checksum = checksum((uint16_t*)packet, 32);
    
    if (ip_send(dst_ip, 1, packet, 64) <= 0) {
        return -1;
    }
    
                 
    for (int i = 0; i < 500; i++) {
        uint8_t buf[2048];
        int len = ip_receive(buf, sizeof(buf));
        
        if (len > 0) {
            Ipv4Header* ip = (Ipv4Header*)buf;
            if (ip->protocol == 1) {
                IcmpHeader* reply = (IcmpHeader*)(buf + sizeof(Ipv4Header));
                if (reply->type == 0) {
                    #ifdef DEBUG_ICMP
                    print("ICMP: Pong!\n");
                    #endif
                    return 0;
                }
            }
        }
        
        for (volatile int j = 0; j < 1000; j++);
    }
    #ifdef DEBUG_ICMP
    print("ICMP: Timeout!\n");
    #endif
    return -1;
}

