#include "ata.h"
#include "io.h"

                                   
int ata_wait_bsy(uint16_t base) {
    for (int i = 0; i < 100000; i++) {
        if (!(inb(base + 7) & ATA_SR_BSY)) return 0;
    }
    return -1;            
}

                                         
static int ata_wait_drq(uint16_t base) {
    for (int i = 0; i < 100000; i++) {
        if (inb(base + 7) & ATA_SR_DRQ) return 0;
    }
    return -1;            
}

                                             
static void ata_select(uint16_t base, int slave, uint32_t lba) {
                                         
    uint8_t drive = 0xE0;                     
    if (slave) drive = 0xF0;          
    drive |= (lba >> 24) & 0x0F;
    
    outb(base + 6, drive);
    outb(base + 2, 1);                              
    outb(base + 3, lba & 0xFF);             
    outb(base + 4, (lba >> 8) & 0xFF);               
    outb(base + 5, (lba >> 16) & 0xFF);               
}

                                   
int ata_read_sector(uint16_t base, int slave, uint32_t lba, uint8_t* buf) {
    if (!buf) return -1;
    if (ata_wait_bsy(base) != 0) return -1;
    
    ata_select(base, slave, lba);
    outb(base + 7, ATA_CMD_READ_SECTORS);
    
    if (ata_wait_bsy(base) != 0) return -1;
    if (ata_wait_drq(base) != 0) return -1;
    
                                 
    for (int i = 0; i < 256; i++) {
        uint16_t word = inw(base);
        buf[i*2] = word & 0xFF;
        buf[i*2+1] = (word >> 8) & 0xFF;
    }
    
    return 0;
}

                                   
int ata_write_sector(uint16_t base, int slave, uint32_t lba, const uint8_t* buf) {
    if (ata_wait_bsy(base) != 0) return -1;
    
    ata_select(base, slave, lba);
    outb(base + 7, ATA_CMD_WRITE_SECTORS);
    
    if (ata_wait_bsy(base) != 0) return -1;
    if (ata_wait_drq(base) != 0) return -1;
    
                                
    for (int i = 0; i < 256; i++) {
        uint16_t word = buf[i*2] | (buf[i*2+1] << 8);
        outw(base, word);
    }
    
    return 0;
}

uint32_t ata_get_total_sectors(void) {
                                  
    outb(ATA_PRIMARY_DRIVE, 0xE0);           
    outb(ATA_PRIMARY_SECCOUNT, 0);
    outb(ATA_PRIMARY_LBA_LO, 0);
    outb(ATA_PRIMARY_LBA_MID, 0);
    outb(ATA_PRIMARY_LBA_HI, 0);
    outb(ATA_PRIMARY_CMD, 0xEC);             
    
                       
    if (ata_wait_bsy(ATA_PRIMARY_DATA) != 0) return 0;
    
                      
    uint16_t data[256];
    for (int i = 0; i < 256; i++) {
        data[i] = inw(ATA_PRIMARY_DATA);
    }
    
                                                  
    if (data[83] & (1 << 10)) {
                               
        uint64_t sectors = *(uint64_t*)(data + 100);
        return (uint32_t)sectors;                                      
    } else {
                             
        uint32_t sectors = *(uint32_t*)(data + 60);
        return sectors;
    }
}

