#ifndef RANDOM_H
#define RANDOM_H

#include "types.h"

                                              
static inline uint64_t rdtsc(void) {
    uint32_t low, high;
    __asm__ volatile("rdtsc" : "=a"(low), "=d"(high));
    return ((uint64_t)high << 32) | low;
}

                                                         
typedef struct {
    uint64_t state;
} RandomState;

                                       
static inline void random_init(RandomState* rnd) {
                                                     
    uint64_t seed = rdtsc();
    
                                             
    uint64_t stack_addr;
    __asm__ volatile("mov %%rsp, %0" : "=r"(stack_addr));
    seed ^= stack_addr;
    
                                 
    seed ^= (uint64_t)(uintptr_t)rnd;
    
    rnd->state = seed ^ 0x9E3779B97F4A7C15ULL;
}

                                                 
static inline uint64_t random_next(RandomState* rnd) {
    uint64_t x = rnd->state;
    x ^= x << 7;
    x ^= x >> 9;
    rnd->state = x;
    return x;
}

                                       
static inline uint64_t random_range(RandomState* rnd, uint64_t max) {
    return random_next(rnd) % max;
}

                 
static inline uint8_t random_byte(RandomState* rnd) {
    return (uint8_t)(random_next(rnd) & 0xFF);
}

                                       
static inline void random_bytes(RandomState* rnd, uint8_t* buffer, uint32_t size) {
    for (uint32_t i = 0; i < size; i++) {
        buffer[i] = random_byte(rnd);
    }
}

                                         

                                                    
static RandomState g_random;
static int g_random_initialized = 0;

static inline void random_seed(void) {
    if (!g_random_initialized) {
        random_init(&g_random);
        g_random_initialized = 1;
    }
}

static inline uint64_t rand64(void) {
    random_seed();
    return random_next(&g_random);
}

static inline uint32_t rand32(void) {
    return (uint32_t)rand64();
}

static inline uint16_t rand16(void) {
    return (uint16_t)rand64();
}

static inline uint8_t rand8(void) {
    return (uint8_t)rand64();
}

