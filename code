static void lpi_load_repo_config(void) {
    if (lpi_repo_configs) lpi_repo_configs->destroy(lpi_repo_configs);
    lpi_repo_configs = vector_create(sizeof(LpiRepoConfig), 8);

    // Load repos.cfg
    Vector* content = vector_create(sizeof(uint8_t), 256);
    int size = read_file(LPI_REPOS, content);

    if (size > 0) {
        char* buffer = (char*)kmalloc(size + 1);
        if (buffer) {
            memcpy(buffer, content->data, size);
            buffer[size] = '\0';

            char* line_ptr = buffer;
            char line_buf[512];
            LpiRepoConfig repo;

            while (*line_ptr) {
                int i = 0;
                while (*line_ptr && *line_ptr != '\n' && i < 511) {
                    line_buf[i++] = *line_ptr++;
                }
                if (*line_ptr == '\n') line_ptr++;
                line_buf[i] = '\0';

                char* line = lpi_trim(line_buf);
                if (!line[0] || line[0] == '#' || line[0] == '[') continue;

                char* eq = strchr(line, '=');
                if (!eq) continue;

                *eq = '\0';
                char* key = lpi_trim(line);
                char* val = lpi_trim(eq + 1);

                if (strcmp(key, "repo.name") == 0) {
                    memset(&repo, 0, sizeof(repo));
                    strcpy(repo.name, val);
                    repo.enabled = 1;
                } else if (strcmp(key, "repo.url") == 0) {
                    strcpy(repo.url, val);
                    repo.is_local = 0;
                } else if (strcmp(key, "repo.path") == 0) {
                    strcpy(repo.path, val);
                    repo.is_local = 1;
                } else if (strcmp(key, "repo.enabled") == 0) {
                    repo.enabled = strcmp(val, "1") == 0 ? 1 : 0;
                    if (repo.name[0]) {
                        lpi_repo_configs->push(lpi_repo_configs, &repo);
                    }
                }
            }
            kfree(buffer);
        }
    }
    content->destroy(content);

    // Default repo if none configured
    if (lpi_repo_configs->size == 0) {
        LpiRepoConfig default_repo;
        memset(&default_repo, 0, sizeof(default_repo));
        strcpy(default_repo.name, "system");
        strcpy(default_repo.path, lpi_config.repositories[0] ? lpi_config.repositories : "/repository");
        default_repo.is_local = 1;
        default_repo.enabled = 1;
        lpi_repo_configs->push(lpi_repo_configs, &default_repo);
    }
}

// ============================================================================
// LOCAL REPOSITORY OPERATIONS
// ============================================================================

static LpiPackage* lpi_find_in_local_repo(const char* pkg_name, const char* repo_path) {
    char pkg_file[512];
    sprintf(pkg_file, "%s/packages/%s.lpi", repo_path, pkg_name);

    Vector* content = vector_create(sizeof(uint8_t), 256);
    int size = read_file(pkg_file, content);

    if (size <= 0) {
        content->destroy(content);
        return NULL;
    }

    LpiPackage* pkg = lpi_parse_package(content->data, size);
    content->destroy(content);
    return pkg;
}

// ============================================================================
// DEPENDENCY RESOLUTION
// ============================================================================

static int lpi_resolve_deps(const char* pkg_name, const char* deps_str, 
                            Vector* resolved, int depth) {
    if (depth > LPI_MAX_DEPS) {
        lpi_print_error("Dependency depth exceeded");
        return -1;
    }

    if (!deps_str || !deps_str[0]) return 0;

    char deps_copy[512];
    strcpy(deps_copy, deps_str);

    char* dep = strtok(deps_copy, ",");
    while (dep) {
        dep = lpi_trim(dep);
        
        // Check if already resolved
        int already_resolved = 0;
        for (int i = 0; i < resolved->size; i++) {
            LpiPackage* p = *(LpiPackage**)resolved->at(resolved, i);
            if (strcmp(p->name, dep) == 0) {
                already_resolved = 1;
                break;
            }
        }

        if (!already_resolved) {
            LpiPackage* dep_pkg = NULL;

            // Search in all repos
            for (int i = 0; i < lpi_repo_configs->size; i++) {
                LpiRepoConfig* repo = (LpiRepoConfig*)lpi_repo_configs->at(lpi_repo_configs, i);
                if (!repo->enabled) continue;

                if (repo->is_local) {
                    dep_pkg = lpi_find_in_local_repo(dep, repo->path);
                }

                if (dep_pkg) break;
            }

            if (!dep_pkg) {
                char err_msg[256];
                sprintf(err_msg, "Dependency '%s' not found", dep);
                lpi_print_error(err_msg);
                return -1;
            }

            // Recursively resolve its dependencies
            if (lpi_resolve_deps(dep, dep_pkg->depends, resolved, depth + 1) < 0) {
                kfree(dep_pkg);
                return -1;
            }

            char info_msg[256];
            sprintf(info_msg, "Resolved dependency: %s", dep);
            lpi_print_info(info_msg);
            resolved->push(resolved, &dep_pkg);
        }

        dep = strtok(NULL, ",");
    }

    return 0;
}

// ============================================================================
// INSTALLATION ENGINE
// ============================================================================

static int lpi_is_driver(const char* filename) {
    const char* ext = strrchr(filename, '.');
    return ext && strcmp(ext, ".drv") == 0;
}

static int lpi_install_package(LpiPackage* pkg, int is_dependency) {
    if (!pkg || !pkg->name[0]) return -1;

    char msg[256];
    sprintf(msg, "Installing %s v%s...", pkg->name, pkg->version);
    lpi_print_info(msg);

    // Check if already installed
    for (int i = 0; i < lpi_installed_cache->size; i++) {
        LpiInstalled* inst = (LpiInstalled*)lpi_installed_cache->at(lpi_installed_cache, i);
        if (strcmp(inst->name, pkg->name) == 0) {
            sprintf(msg, "Package %s already installed", pkg->name);
            lpi_print_info(msg);
            return 0;
        }
    }

    // Find package file (.zip)
    char pkg_zip[512];
    int found = 0;

    for (int i = 0; i < lpi_repo_configs->size; i++) {
        LpiRepoConfig* repo = (LpiRepoConfig*)lpi_repo_configs->at(lpi_repo_configs, i);
        if (!repo->enabled || !repo->is_local) continue;

        sprintf(pkg_zip, "%s/packages/%s-%s.zip", repo->path, pkg->name, pkg->version);
        Vector* test = vector_create(sizeof(uint8_t), 1);
        int sz = read_file(pkg_zip, test);
        test->destroy(test);

        if (sz > 0) {
            found = 1;
            break;
        }
    }

    if (!found) {
        sprintf(msg, "Package file not found for %s", pkg->name);
        lpi_print_error(msg);
        return -1;
    }

    // Extract to temp directory
    char temp_dir[512];
    sprintf(temp_dir, LPI_TEMP "/%s", pkg->name);
    ext4_create_dir(temp_dir);

    lpi_print_info("Extracting package...");
    unzip_extract_all(pkg_zip, temp_dir);

    // Determine installation target and copy files
    int is_driver_pkg = 0;
    char install_path[256];
    install_path[0] = '\0';

    if (pkg->files[0]) {
        char files_copy[512];
        strcpy(files_copy, pkg->files);
        char* file = strtok(files_copy, ",");

        while (file) {
            file = lpi_trim(file);

            // Determine type from filename
            if (strcmp(pkg->type, "DRV") == 0 || lpi_is_driver(file)) {
                is_driver_pkg = 1;
                const char* fname = strrchr(file, '/');
                if (fname) fname++; else fname = file;
                char driver_dir[256];
                sprintf(driver_dir, "/sys/drivers/available/%s.drv", pkg->name);
                ext4_create_dir(driver_dir);
                sprintf(install_path, "%s/%s", driver_dir, fname);
            } else {
                const char* fname = strrchr(file, '/');
                if (fname) fname++; else fname = file;
                sprintf(install_path, "/usr/bin/%s", fname);
            }

            // Copy file
            char src[512];
            sprintf(src, "%s/%s", temp_dir, file);
            
            if (copy_file_ext4(src, install_path) < 0) {
                sprintf(msg, "Failed to copy %s", file);
                lpi_print_error(msg);
                return -1;
            }
            sprintf(msg, "Installed %s", install_path);
            lpi_print_success(msg);

            file = strtok(NULL, ",");
        }
    }

    // Load driver if applicable
    if (is_driver_pkg && install_path[0]) {
        lpi_print_info("Loading driver...");
        if (driver_load(install_path) < 0) {
            lpi_print_error("Failed to load driver");
            return -1;
        }
    }

    // Record installation
    LpiInstalled installed;
    memset(&installed, 0, sizeof(installed));
    strcpy(installed.name, pkg->name);
    strcpy(installed.version, pkg->version);
    strcpy(installed.install_path, install_path);
    installed.is_driver = is_driver_pkg;
    lpi_installed_cache->push(lpi_installed_cache, &installed);

    sprintf(msg, "Package %s installed successfully", pkg->name);
    lpi_print_success(msg);
    return 0;
}

// ============================================================================
// REMOVAL ENGINE
// ============================================================================

static int lpi_remove_package(const char* pkg_name) {
    char msg[256];
    sprintf(msg, "Removing %s...", pkg_name);
    lpi_print_info(msg);

    // Find installation record
    LpiInstalled* to_remove = NULL;
    int idx = -1;

    for (int i = 0; i < lpi_installed_cache->size; i++) {
        LpiInstalled* inst = (LpiInstalled*)lpi_installed_cache->at(lpi_installed_cache, i);
        if (strcmp(inst->name, pkg_name) == 0) {
            to_remove = inst;
            idx = i;
            break;
        }
    }

    if (!to_remove) {
        sprintf(msg, "Package %s not installed", pkg_name);
        lpi_print_error(msg);
        return -1;
    }

    // Unload driver if applicable
    if (to_remove->is_driver && to_remove->install_path[0]) {
        lpi_print_info("Unloading driver...");
        driver_unload_by_path(to_remove->install_path);
    }

    // Remove installation files
    if (to_remove->install_path[0]) {
        ext4_delete_file(to_remove->install_path);
        sprintf(msg, "Removed %s", to_remove->install_path);
        lpi_print_success(msg);
    }

    // Remove from cache
    if (idx >= 0) {
        for (int i = idx; i < lpi_installed_cache->size - 1; i++) {
            LpiInstalled* curr = (LpiInstalled*)lpi_installed_cache->at(lpi_installed_cache, i);
            LpiInstalled* next = (LpiInstalled*)lpi_installed_cache->at(lpi_installed_cache, i + 1);
            memcpy(curr, next, sizeof(LpiInstalled));
        }
        lpi_installed_cache->size--;
    }

    sprintf(msg, "Package %s removed successfully", pkg_name);
    lpi_print_success(msg);
    return 0;
}

