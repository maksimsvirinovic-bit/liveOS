#ifndef CHECKSUM_H
#define CHECKSUM_H

#include "types.h"

                                        
static inline uint16_t checksum(uint16_t* data, uint32_t words) {
    uint32_t sum = 0;
    
    for (uint32_t i = 0; i < words; i++) {
        sum += data[i];
        if (sum > 0xFFFF) {
            sum = (sum & 0xFFFF) + (sum >> 16);
        }
    }
    
    return ~(sum & 0xFFFF);
}

#endif

