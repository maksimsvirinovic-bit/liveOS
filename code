static int parse_pci_table(void) {
    if (!pci_mappings) {
        pci_mappings = vector_create(sizeof(PciMapping), 16);
    }
    
    Vector* content = vector_create(sizeof(uint8_t), 256);
    int size = read_file("/sys/drivers/pci_table.cfg", content);
    
    if (size <= 0) {
        printf("Driver Manager: No pci_table.cfg\n");
        content->destroy(content);
        return -1;
    }
    
    char* data = (char*)content->data;
    char* line = strtok(data, "\n");
    
    while (line) {
        char* start = line;
        while (*start == ' ' || *start == '\t') start++;
        if (*start == '#' || *start == '\0') {
            line = strtok(NULL, "\n");
            continue;
        }
        
        PciMapping mapping;
        memset(&mapping, 0, sizeof(PciMapping));
        
        char* name = start;
        char* rest = strchr(name, ' ');
        if (!rest) {
            line = strtok(NULL, "\n");
            continue;
        }
        
        *rest = '\0';
        rest++;
        while (*rest == ' ') rest++;
        
        mapping.driver_name = vec_str_create(name);
        
        if (strncmp(rest, "class:", 6) == 0) {
            mapping.use_class = 1;
            sscanf(rest + 6, "%hhx:%hhx", &mapping.class_code, &mapping.subclass);
        } else {
            mapping.use_class = 0;
            sscanf(rest, "%hx:%hx", &mapping.vendor_id, &mapping.device_id);
        }
        
        pci_mappings->push(pci_mappings, &mapping);
        line = strtok(NULL, "\n");
    }
    
    content->destroy(content);
    return 0;
}

                             
static const char* find_driver_for_pci(PCIDevice* dev) {
    if (!pci_mappings) return NULL;
    
    for (uint32_t i = 0; i < pci_mappings->size; i++) {
        PciMapping* map = (PciMapping*)pci_mappings->at(pci_mappings, i);
        
        if (map->use_class) {
            if (dev->class_code == map->class_code &&
                dev->subclass == map->subclass) {
                return vec_str_get(map->driver_name);
            }
        } else {
            if (dev->vendor_id == map->vendor_id &&
                dev->device_id == map->device_id) {
                return vec_str_get(map->driver_name);
            }
        }
    }
    
    return NULL;
}

                           
static void driver_autoload_available_entry(const char* name, int is_dir, void* user_data);

void driver_autoload(void) {
    #ifdef DEBUG_DRIVER_MANAGER
    printf("Driver Manager: Autoloading drivers...\n");
    #endif

    ext4_foreach_entry("/sys/drivers/available", driver_autoload_available_entry, NULL);
    
    if (parse_pci_table() != 0) {
        printf("Driver Manager: No PCI mapping table\n");
        return;
    }
    
    pci_init();
    
    if (!pci_devices) {
        printf("Driver Manager: No PCI devices found\n");
        return;
    }
    
    PCIEntry* entry = pci_devices;
    int loaded_count = 0;
    
    while (entry) {
        const char* driver_name = find_driver_for_pci(&entry->device);
        
        if (driver_name) {
            #ifdef DEBUG_DRIVER_MANAGER
            printf("Driver Manager: Found driver '%s' for PCI %02X:%02X.%d\n",
                   driver_name, entry->bus, entry->dev, entry->func);
            #endif
            
            if (driver_is_loaded(driver_name)) {
                entry = entry->next;
                continue;
            }
            
            char driver_path[256];
            sprintf(driver_path, "/sys/drivers/loaded/%s.drv", driver_name);
            
            Ext4_Stat stat;
            if (ext4_stat(driver_path, &stat) != 0) {
                entry = entry->next;
                continue;
            }
            
            if (driver_load(driver_path) == 0) {
                loaded_count++;
            }
        }
        
        entry = entry->next;
    }
    
    if (loaded_count > 0) {
        #ifdef DEBUG_DRIVER_MANAGER
        printf("Driver Manager: Probing %d drivers...\n", loaded_count);
        #endif
        driver_probe_all();
    }
    #ifdef DEBUG_DRIVER_MANAGER
    printf("Driver Manager: Autoload complete (%d drivers loaded)\n", loaded_count);
    #endif
}

static void driver_autoload_available_entry(const char* name, int is_dir, void* user_data) {
        (void)user_data;
    if (!name || name[0] == '.' || strcmp(name, "loaded") == 0) return;
        if (driver_is_loaded(name)) return;
        char path[256];
        sprintf(path, "/sys/drivers/available/%s", name);
        if (driver_load(path) == 0) {
            char loaded_path[256];
            sprintf(loaded_path, "/sys/drivers/loaded/%s", name);
            create_dir(loaded_path);
        }
}

                            
