static PageTable* create_table(PageTable* parent, uint64_t idx, uint64_t flags) {
    if (parent->entries[idx] & PAGE_PRESENT) {
        return (PageTable*)(parent->entries[idx] & ~0xFFF);
    }
    
    PageTable* table = (PageTable*)alloc_page();
    if (!table) {
        printf("Paging: Failed to allocate table!\n");
        return NULL;
    }
    
    parent->entries[idx] = get_phys(table) | flags | PAGE_PRESENT | PAGE_WRITE;
    return table;
}

                                  
void paging_map(uint64_t phys, uint64_t virt, uint64_t size, uint64_t flags) {
    if (!pml4) {
        printf("Paging: PML4 not initialized!\n");
        return;
    }
    
    uint64_t start_page = virt / PAGE_SIZE;
    uint64_t end_page = (virt + size + PAGE_SIZE - 1) / PAGE_SIZE;
    
    for (uint64_t page = start_page; page < end_page; page++) {
        uint64_t phys_page = phys + (page - start_page) * PAGE_SIZE;
        uint64_t virt_page = page * PAGE_SIZE;
        
        uint64_t pml4_idx = get_pml4_idx(virt_page);
        uint64_t pdp_idx = get_pdp_idx(virt_page);
        uint64_t pd_idx = get_pd_idx(virt_page);
        uint64_t pt_idx = get_pt_idx(virt_page);
        
                          
        PageTable* pdp = create_table(pml4, pml4_idx, flags & ~PAGE_NO_EXEC);
        if (!pdp) break;
        
        PageTable* pd = create_table(pdp, pdp_idx, flags & ~PAGE_NO_EXEC);
        if (!pd) break;
        
        PageTable* pt = create_table(pd, pd_idx, flags & ~PAGE_NO_EXEC);
        if (!pt) break;
        
                                 
        pt->entries[pt_idx] = phys_page | flags | PAGE_PRESENT | PAGE_WRITE;
    }
}

                                             
void paging_protect(uint64_t virt, uint64_t size) {
    if (!pml4) return;
    
    uint64_t start_page = virt / PAGE_SIZE;
    uint64_t end_page = (virt + size + PAGE_SIZE - 1) / PAGE_SIZE;
    
    for (uint64_t page = start_page; page < end_page; page++) {
        uint64_t virt_page = page * PAGE_SIZE;
        uint64_t pml4_idx = get_pml4_idx(virt_page);
        uint64_t pdp_idx = get_pdp_idx(virt_page);
        uint64_t pd_idx = get_pd_idx(virt_page);
        uint64_t pt_idx = get_pt_idx(virt_page);
        
        if (!(pml4->entries[pml4_idx] & PAGE_PRESENT)) continue;
        PageTable* pdp = (PageTable*)(pml4->entries[pml4_idx] & ~0xFFF);
        if (!(pdp->entries[pdp_idx] & PAGE_PRESENT)) continue;
        PageTable* pd = (PageTable*)(pdp->entries[pdp_idx] & ~0xFFF);
        if (!(pd->entries[pd_idx] & PAGE_PRESENT)) continue;
        PageTable* pt = (PageTable*)(pd->entries[pd_idx] & ~0xFFF);
        
                             
        pt->entries[pt_idx] &= ~PAGE_WRITE;
                               
        pt->entries[pt_idx] |= PAGE_NO_EXEC;
    }
}

                                   
void paging_identity_map(uint64_t phys, uint64_t virt, uint64_t size, uint64_t flags) {
    paging_map(phys, virt, size, flags);
}

                            
void paging_init(void) {
    printf("Paging: Initializing...\n");
    
                       
    pml4 = (PageTable*)alloc_page();
    if (!pml4) {
        printf("Paging: Failed to allocate PML4!\n");
        return;
    }
    pml4_phys = get_phys(pml4);
    
                 
    memset(pml4, 0, PAGE_SIZE);
    
                          
    uint64_t cr0;
    __asm__ volatile("mov %%cr0, %0" : "=r"(cr0));
    cr0 &= ~(1 << 31);
    __asm__ volatile("mov %0, %%cr0" : : "r"(cr0));
    
                       
    __asm__ volatile("mov %0, %%cr3" : : "r"(pml4_phys));
    
                         
    cr0 |= (1 << 31);
    __asm__ volatile("mov %0, %%cr0" : : "r"(cr0));
    
    printf("Paging: PML4 at 0x%p (phys: 0x%p)\n", pml4, pml4_phys);
}

                                            
void paging_setup_full(void) {
    printf("Paging: Setting up full memory map...\n");
    
                                                         
                                                                      
    printf("  User: 0x0 - 0x4FFFFFFFFFFFF\n");
    paging_identity_map(0x0, 0x0, 0x500000000000, PAGE_USER | PAGE_WRITE);
    
                                                  
    printf("  MMIO: 0xC00000000000 - 0xCFFFFFFFFFFFFF\n");
                                          
                                           
    paging_identity_map(0xFD000000, 0xFD000000, 0x1000000, PAGE_PRESENT | PAGE_NO_EXEC);
                        
    paging_identity_map(0xFEE00000, 0xFEE00000, 0x1000, PAGE_PRESENT | PAGE_NO_EXEC);
                        
    paging_identity_map(0xFED00000, 0xFED00000, 0x1000, PAGE_PRESENT | PAGE_NO_EXEC);
                         
    paging_identity_map(0x90600000, 0x90600000, 0x10000, PAGE_PRESENT | PAGE_NO_EXEC);
    
                                                       
    printf("  Kernel heap: 0xD00000000000 - 0xDFFFFFFFFFFFFF\n");
                                     
    paging_identity_map(0xD00000000000, 0xD00000000000, 0x100000000000, PAGE_WRITE);
    
                                                    
    printf("  Kernel: 0xF00000000000 - 0xFFFFFFFFFFFFFFFF\n");
                                
    paging_identity_map(0xF00000000000, 0xF00000000000, 0x100000000000, PAGE_WRITE);
    
                                 
    paging_protect(0xFD000000, 0x1000000);
    paging_protect(0xFEE00000, 0x1000);
    paging_protect(0xFED00000, 0x1000);
    paging_protect(0x90600000, 0x10000);
    
                                           
                                                   
    
    printf("Paging: Full memory map set up!\n");
}

                   
void paging_dump(void) {
    if (!pml4) {
        printf("Paging: Not initialized\n");
        return;
    }
    
    printf("\n=== PAGING DUMP ===\n");
    printf("PML4 at 0x%p (phys: 0x%p)\n", pml4, pml4_phys);
    
    int entries = 0;
    for (int i = 0; i < 512; i++) {
        if (pml4->entries[i] & PAGE_PRESENT) {
            printf("  PML4[%d] -> 0x%p (flags: 0x%p)\n", 
                   i, pml4->entries[i] & ~0xFFF, pml4->entries[i] & 0xFFF);
            entries++;
        }
    }
    printf("Total PML4 entries: %d\n", entries);
    
          
    uint64_t cr3;
    __asm__ volatile("mov %%cr3, %0" : "=r"(cr3));
    printf("Current CR3: 0x%p\n", cr3);
    printf("====================\n");
}

