#include "acpi.h"
#include "pci.h"
#include "arch/x86_64/io.h"
#include "console.h"
#include "lib/str.h"

static RSDP* rsdp = NULL;
static void* facs = NULL;
static void* dsdt = NULL;
static ACPIFADT* fadt = NULL;

static int acpi_checksum(void* table, uint32_t size);

                         
static RSDP* acpi_find_rsdp(void) {
                          
    uint16_t ebda = *(uint16_t*)0x40E;
    for (uint32_t addr = ebda * 16; addr < ebda * 16 + 1024; addr += 16) {
        RSDP* candidate = (RSDP*)(uintptr_t)addr;
        if (*(uint64_t*)candidate == ACPI_RSDP_SIGNATURE &&
            acpi_checksum(candidate, sizeof(RSDP))) {
            return candidate;
        }
    }
    
                                      
    for (uint32_t addr = 0xE0000; addr < 0xFFFFF; addr += 16) {
        RSDP* candidate = (RSDP*)(uintptr_t)addr;
        if (*(uint64_t*)candidate == ACPI_RSDP_SIGNATURE &&
            acpi_checksum(candidate, sizeof(RSDP)) &&
            (candidate->revision < 2 ||
             (((RSDP2*)candidate)->length >= sizeof(RSDP2) &&
              acpi_checksum(candidate, ((RSDP2*)candidate)->length)))) {
            return candidate;
        }
    }
    
    return NULL;
}

                                
static int acpi_checksum(void* table, uint32_t size) {
    uint8_t* data = (uint8_t*)table;
    uint8_t sum = 0;
    for (uint32_t i = 0; i < size; i++) {
        sum += data[i];
    }
    return sum == 0;
}

                            
int acpi_init(void) {
    #ifdef DEBUG_ACPI
    printf("ACPI: Initializing...\n");
    #endif
    
    rsdp = acpi_find_rsdp();
    if (!rsdp) {
        printf("ACPI: RSDP not found!\n");
        return -1;
    }
    #ifdef DEBUG_ACPI
    printf("ACPI: RSDP found at 0x%p\n", rsdp);
    printf("  OEM: %.6s\n", rsdp->oemid);
    #endif
    
    uint64_t table_addr = rsdp->rsdt_addr;
    uint32_t entry_size = 4;
    if (rsdp->revision >= 2 && ((RSDP2*)rsdp)->xsdt_addr) {
        table_addr = ((RSDP2*)rsdp)->xsdt_addr;
        entry_size = 8;
    }
    ACPISDTHeader* rsdt = (ACPISDTHeader*)(uintptr_t)table_addr;
    
    if (rsdt->length < sizeof(ACPISDTHeader) || !acpi_checksum(rsdt, rsdt->length)) {
        #ifdef DEBUG_ACPI
        printf("ACPI: RSDT checksum invalid!\n");
        #endif
        return -1;
    }
    #ifdef DEBUG_ACPI
    printf("ACPI: RSDT found at 0x%p\n", rsdt);
    printf("  Length: %d\n", rsdt->length);
    #endif
                   
    uint32_t entries = (rsdt->length - sizeof(ACPISDTHeader)) / entry_size;
    uint8_t* tables = (uint8_t*)rsdt + sizeof(ACPISDTHeader);
    
    for (uint32_t i = 0; i < entries; i++) {
        uint64_t address = entry_size == 8 ? ((uint64_t*)tables)[i] : ((uint32_t*)tables)[i];
        ACPISDTHeader* hdr = (ACPISDTHeader*)(uintptr_t)address;
        if (hdr->length < sizeof(ACPISDTHeader)) continue;
        if (hdr->signature[0] != 'F' || hdr->signature[1] != 'A' ||
            hdr->signature[2] != 'C' || hdr->signature[3] != 'S') {
            if (!acpi_checksum(hdr, hdr->length)) continue;
        }
        if (hdr->signature[0] == 'F' && hdr->signature[1] == 'A' &&
            hdr->signature[2] == 'C' && hdr->signature[3] == 'P') {
            if (hdr->length >= sizeof(ACPIFADT)) fadt = (ACPIFADT*)hdr;
            #ifdef DEBUG_ACPI
            printf("ACPI: FADT found at 0x%p\n", fadt);
            #endif
        }
        if (hdr->signature[0] == 'D' && hdr->signature[1] == 'S' &&
            hdr->signature[2] == 'D' && hdr->signature[3] == 'T') {
            dsdt = hdr;
        }
        if (hdr->signature[0] == 'F' && hdr->signature[1] == 'A' &&
            hdr->signature[2] == 'C' && hdr->signature[3] == 'S') {
            facs = hdr;
        }
    }
    #ifdef DEBUG_ACPI
    printf("ACPI: Initialized\n");
    #endif
    return 0;
}

                         
void acpi_shutdown(void) {
    printf("ACPI: Shutting down...\n");
    
    if (fadt) {
                         
        uint32_t pm1_cnt = fadt->pm1a_control_block;
        uint32_t pm1_cnt_len = fadt->pm1_control_length;
        
        uint32_t slp_typ = 0x05;
        uint32_t slp_en = 1 << 13;
        uint32_t val = (slp_typ << 10) | slp_en;
        
        #ifdef DEBUG_ACPI
        printf("ACPI: Writing to PM1_CNT (0x%x) val=0x%x\n", pm1_cnt, val);
        #endif
        if (pm1_cnt && pm1_cnt_len >= 2) {
            outw(pm1_cnt, val);
            return;
        }
    }
    
    outw(0x604, 0x2000);
    
    outb(0xCF9, 0x06);
    
    printf("ACPI: Shutdown failed!\n");
}

                           
void acpi_reboot(void) {
    printf("ACPI: Rebooting...\n");
    
    if (fadt) {
        if (fadt->reset_reg.address_space == 1 && fadt->reset_reg.address &&
            fadt->reset_reg.address <= 0xFFFF) {
            outb((uint16_t)fadt->reset_reg.address, fadt->reset_value);
            return;
        }
    }

    outb(0x64, 0xFE);
                            
    outb(0xCF9, 0x0E);
    
    printf("ACPI: Reboot failed!\n");
}

                  
int acpi_sleep(int state) {
    #ifdef DEBUG_ACPI
    printf("ACPI: Sleep state S%d...\n", state);
    #endif
    
    if (!fadt) return -1;
    
                                      
    uint32_t pm1_cnt = fadt->pm1a_control_block;
    
    uint32_t slp_typ = state;            
    uint32_t slp_en = 1 << 13;
    uint32_t val = (slp_typ << 10) | slp_en;
    
    if (!pm1_cnt || fadt->pm1_control_length < 2) return -1;
    outw(pm1_cnt, val);
    return 0;
}

                          
void acpi_dump_tables(void) {
    printf("\n=== ACPI Tables ===\n");
    if (rsdp) {
        printf("RSDP: %.8s\n", (char*)rsdp);
    }
    if (fadt) {
        ACPISDTHeader* hdr = (ACPISDTHeader*)fadt;
        printf("FADT: %.4s (len=%d, rev=%d)\n", 
               hdr->signature, hdr->length, hdr->revision);
    }
    if (dsdt) {
        ACPISDTHeader* hdr = (ACPISDTHeader*)dsdt;
        printf("DSDT: %.4s (len=%d, rev=%d)\n", 
               hdr->signature, hdr->length, hdr->revision);
    }
    if (facs) printf("FACS: 0x%p\n", facs);
    printf("===================\n");
}

