#include "vector.h"
#include "heap.h"
#include "lib/str.h"
#include "console.h"

                                 

static void vector_push_impl(Vector* self, const void* value) {
    if (self->size >= self->capacity) {
        self->capacity *= 2;
        uint8_t* new_data = (uint8_t*)krealloc(self->data, self->capacity * self->elem_size);
        if (!new_data) {
            printf("Vector: krealloc failed\n");
            return;
        }
        self->data = new_data;
    }
    
                       
    uint8_t* dest = self->data + self->size * self->elem_size;
    const uint8_t* src = (const uint8_t*)value;
    for (uint32_t i = 0; i < self->elem_size; i++) {
        dest[i] = src[i];
    }
    
    self->size++;
}

static void* vector_pop_impl(Vector* self) {
    if (self->size == 0) return NULL;
    self->size--;
    return self->data + self->size * self->elem_size;
}

static void* vector_at_impl(Vector* self, uint32_t index) {
    if (index >= self->size) return NULL;
    return self->data + index * self->elem_size;
}

static void vector_clear_impl(Vector* self) {
    self->size = 0;
}

static void vector_reset_impl(Vector* self) {
    self->size = 0;
                       
    for (uint32_t i = 0; i < self->capacity * self->elem_size; i++) {
        self->data[i] = 0;
    }
}

static void vector_destroy_impl(Vector* self) {
    if (self->data) kfree(self->data);
    kfree(self);
}

static void vector_foreach_impl(Vector* self, void (*callback)(void* item)) {
    for (uint32_t i = 0; i < self->size; i++) {
        callback(self->data + i * self->elem_size);
    }
}

static void vector_remove_impl(Vector* self, uint32_t index) {
    if (index >= self->size) return;
    
                        
    uint8_t* dest = self->data + index * self->elem_size;
    uint8_t* src = self->data + (index + 1) * self->elem_size;
    uint32_t bytes = (self->size - index - 1) * self->elem_size;
    
    if (bytes > 0) {
        memmove(dest, src, bytes);
    }
    self->size--;
}

                       

Vector* vector_create(uint32_t elem_size, uint32_t initial_capacity) {
    
    if (initial_capacity < 4) initial_capacity = 4;
    
    Vector* vec = (Vector*)kmalloc(sizeof(Vector));
    
    if (!vec) {
        printf("vector_create: kmalloc failed for Vector!\n");
        return NULL;
    }
    
    uint32_t data_size = elem_size * initial_capacity;
    vec->data = (uint8_t*)kmalloc(data_size);
    
    if (!vec->data) {
        printf("vector_create: kmalloc failed for data!\n");
        kfree(vec);
        return NULL;
    }
    
    vec->size = 0;
    vec->capacity = initial_capacity;
    vec->elem_size = elem_size;
    
    vec->push = vector_push_impl;
    vec->pop = vector_pop_impl;
    vec->at = vector_at_impl;
    vec->clear = vector_clear_impl;
    vec->reset = vector_reset_impl;
    vec->destroy = vector_destroy_impl;
    vec->foreach = vector_foreach_impl;
    vec->remove = vector_remove_impl;
    
    return vec;
}

