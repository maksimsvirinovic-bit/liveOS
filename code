int parse_num(const char* s, uint64_t* val) {
    if (!s || !*s) return 0;
    *val = 0;
    int neg = 0;
    if (*s == '-') { neg = 1; s++; }
    
    if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {
        s += 2;
        while (*s) {
            *val <<= 4;
            if (*s >= '0' && *s <= '9') *val += *s - '0';
            else if (*s >= 'A' && *s <= 'F') *val += *s - 'A' + 10;
            else if (*s >= 'a' && *s <= 'f') *val += *s - 'a' + 10;
            else return 0;
            s++;
        }
    } else {
        while (*s >= '0' && *s <= '9') {
            *val = *val * 10 + (*s - '0');
            s++;
        }
    }
    
    if (neg) *val = -(*val);
    return 1;
}

                       
static int is_number(const char* s) {
    if (!s || !*s) return 0;
    if (*s == '-') s++;
    if (*s == '0' && (s[1] == 'x' || s[1] == 'X')) return 1;
    return (*s >= '0' && *s <= '9');
}

                           
static void int_to_str(int val, char* buf) {
    if (val == 0) {
        buf[0] = '0';
        buf[1] = '\0';
        return;
    }
    
    if (val < 0) {
        *buf++ = '-';
        val = -val;
    }
    
    char temp[16];
    int pos = 0;
    while (val > 0) {
        temp[pos++] = '0' + val % 10;
        val /= 10;
    }
    
    int k = 0;
    while (pos > 0) {
        buf[k++] = temp[--pos];
    }
    buf[k] = '\0';
}

static void add_label(const char* name, int pos) {
    if (label_inited == 0) {
        labels_vec = vector_create(sizeof(Label), 16);
        label_inited++;
    }

    Label lbl;
    strcpy(lbl.name, name);
    lbl.pos = pos;
    labels_vec->push(labels_vec, &lbl);
}

static int find_label(const char* name) {
    if (label_inited == 0) {
        labels_vec = vector_create(sizeof(Label), 16);
        label_inited++;
    }

    for (uint32_t i = 0; i < labels_vec->size; i++) {
        Label* lbl = (Label*)labels_vec->at(labels_vec, i);
        if (strcmp(lbl->name, name) == 0) {
            return lbl->pos;
        }
    }
    return -1;
}

static void labels_clear(void) {
    labels_vec->clear(labels_vec);
}

                                         
