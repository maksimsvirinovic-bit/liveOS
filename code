#include "ip.h"
#include "ethernet.h"
#include "arp.h"
#include "console.h"
#include "netutils.h"
#include "str.h"

uint32_t gateway_ip = 10 << 24 | 0 << 16 | 2 << 8 | 1;

uint16_t checksum(uint16_t* data, uint32_t words) {
    uint32_t sum = 0;
    
                                                         
    for (uint32_t i = 0; i < words; i++) {
        sum += data[i];
    }
    
                                                   
    while (sum >> 16) {
        sum = (sum & 0xFFFF) + (sum >> 16);
    }
    
                                                                       
    if (sum == 0xFFFF) {
        return 0xFFFF; 
    }
    
    return (uint16_t)~sum;
}


int ip_send(uint32_t dst_ip, uint8_t protocol, const uint8_t* payload, uint16_t len) {
    uint32_t target_ip = dst_ip;
    uint32_t real_dst = dst_ip;
    
                            
                                                   
    if ((dst_ip & 0xFFFFFF00) != (our_ip & 0xFFFFFF00)) {
                                
        target_ip = gateway_ip;                 
        #ifdef DEBUG_IP
        print("IP: Routing ");
        print_ip(dst_ip);
        print(" via gateway ");
        print_ip(target_ip);
        print("\n");
        #endif
    }
    
                                                           
    MacAddress dst_mac;
    if (arp_request(target_ip, &dst_mac) != 0) {
        #ifdef DEBUG_IP
        print("IP: ARP failed for ");
        print_ip(target_ip);
        print("\n");
        #endif
        return -1;
    }
    
                                 
    uint8_t packet[1500];
    Ipv4Header* ip = (Ipv4Header*)packet;
    memset(ip, 0, sizeof(Ipv4Header));
    
    ip->version_ihl = 0x45;
    ip->total_length = htons(sizeof(Ipv4Header) + len);
    ip->identification = htons(0x1234);
    ip->ttl = 64;
    ip->protocol = protocol;
    ip->src_ip = htonl(our_ip);
    ip->dst_ip = htonl(real_dst);                                     
    ip->header_checksum = 0;
    ip->header_checksum = checksum((uint16_t*)ip, 10);
    
    memcpy(packet + sizeof(Ipv4Header), payload, len);
    
                                      
    return ethernet_send(dst_mac, ETHERTYPE_IPV4, packet, sizeof(Ipv4Header) + len);
}

int ip_receive(uint8_t* buffer, uint16_t max_len) {
    for (int i = 0; i < 5000; i++) {
        uint8_t frame[2048];
        int len = ethernet_receive(frame, sizeof(frame));
        
        if (len > 0) {
            uint16_t ethertype = (frame[12] << 8) | frame[13];
            
            if (ethertype != ETHERTYPE_IPV4) continue;
            
            Ipv4Header* ip = (Ipv4Header*)(frame + 14);
            
            if (ntohl(ip->dst_ip) != our_ip) continue;
            
            uint16_t total = ntohs(ip->total_length);
            if (total > max_len) total = max_len;
            
            memcpy(buffer, frame + 14, total);
            return total;
        }
        
                             
        for (volatile int j = 0; j < 10000; j++);
    }
    return 0;
}

