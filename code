static void http_send_request(TcpConnection* conn, const char* method, 
                              const char* host, const char* path, 
                              const char* extra_headers, const char* body) {
                            
    char request[2048];
    int pos = 0;

    if (!conn || !method || !host || !path) return;
    if (strlen(method) + strlen(host) + strlen(path) +
        (extra_headers ? strlen(extra_headers) : 0) +
        (body ? strlen(body) : 0) + 128 >= sizeof(request)) {
        printf("HTTP: Request too large\n");
        return;
    }
    
                   
    pos += sprintf(request + pos, "%s %s HTTP/1.1\r\n", method, path);
    pos += sprintf(request + pos, "Host: %s\r\n", host);
    pos += sprintf(request + pos, "User-Agent: LiveOS/6.0\r\n");
    pos += sprintf(request + pos, "Accept: */*\r\n");
    pos += sprintf(request + pos, "Connection: close\r\n");
    
    if (extra_headers) {
        pos += sprintf(request + pos, "%s", extra_headers);
    }
    
    if (body) {
        pos += sprintf(request + pos, "Content-Length: %d\r\n", strlen(body));
    }
    
    pos += sprintf(request + pos, "\r\n");
    
    if (body) {
        pos += sprintf(request + pos, "%s", body);
    }
    #ifdef DEBUG_HTTP
    printf("HTTP: Sending request (%d bytes)\n", pos);
    printf("%s", request);
    printf("\n");
    #endif
    
    tcp_send(conn, (uint8_t*)request, pos);
}

                       

int http_get(TcpConnection* conn, const char* host, const char* path) {
    if (!conn || conn->state != TCP_CONNECTED) {
        printf("HTTP: Not connected!\n");
        return -1;
    }
    #ifdef DEBUG_HTTP
    printf("HTTP: GET %s from %s\n", path, host);
    #endif
    
    http_send_request(conn, "GET", host, path, NULL, NULL);
    
                 
    char response[8192];
    int total = 0;
    
    while (total < (int)sizeof(response) - 1) {
        uint8_t buf[4096];
        int remaining = sizeof(response) - 1 - total;
        int request_len = remaining < (int)sizeof(buf) ? remaining : (int)sizeof(buf);
        int len = tcp_receive(conn, buf, request_len);
        if (len <= 0) break;
        
        memcpy(response + total, buf, len);
        total += len;
        
    }
    
    response[total] = '\0';
    #ifdef DEBUG_HTTP
    printf("HTTP: Received %d bytes\n", total);
    #endif
    
                   
    HttpResponse http_resp;
    if (http_parse_response(response, total, &http_resp) == 0) {
        http_print_response(&http_resp);
        
                       
        char* body = strstr(response, "\r\n\r\n");
        if (body) {
            body += 4;
            #ifdef DEBUG_HTTP
            printf("\n=== BODY ===\n");
            printf("%s", body);
            printf("\n");
            #endif
        }
    }
    
    return total;
}

                        

int http_post(TcpConnection* conn, const char* host, const char* path, const char* data) {
    if (!conn || conn->state != TCP_CONNECTED) {
        printf("HTTP: Not connected!\n");
        return -1;
    }
    
    #ifdef DEBUG_HTTP
    printf("HTTP: POST %s to %s\n", path, host);
    printf("Data: %s\n", data);
    #endif
    
    char headers[256];
    sprintf(headers, "Content-Type: application/x-www-form-urlencoded\r\n");
    
    http_send_request(conn, "POST", host, path, headers, data);
    
                                  
    char response[8192];
    int total = 0;
    
    while (total < (int)sizeof(response) - 1) {
        uint8_t buf[4096];
        int remaining = sizeof(response) - 1 - total;
        int request_len = remaining < (int)sizeof(buf) ? remaining : (int)sizeof(buf);
        int len = tcp_receive(conn, buf, request_len);
        if (len <= 0) break;
        
        memcpy(response + total, buf, len);
        total += len;
        
    }
    
    response[total] = '\0';
    #ifdef DEBUG_HTTP
    printf("HTTP: Received %d bytes\n", total);
    #endif
    
    return total;
}

                                  

int http_parse_response(const char* response, int len, HttpResponse* result) {
    if (!response || len < 10) return -1;
    
    memset(result, 0, sizeof(HttpResponse));
    
                              
    const char* p = response;
    
             
    int i = 0;
    while (*p != ' ' && i < 15) {
        result->version[i++] = *p++;
    }
    result->version[i] = '\0';
    p++;                     
    
                 
    result->status_code = 0;
    while (*p >= '0' && *p <= '9') {
        result->status_code = result->status_code * 10 + (*p - '0');
        p++;
    }
    p++;                     
    
                   
    i = 0;
    while (*p != '\r' && *p != '\n' && i < 63) {
        result->status_text[i++] = *p++;
    }
    result->status_text[i] = '\0';
    
                       
    p += 2;                   
    
    while (*p) {
        if (strncmp(p, "Content-Length: ", 16) == 0) {
            p += 16;
            result->content_length = 0;
            while (*p >= '0' && *p <= '9') {
                result->content_length = result->content_length * 10 + (*p - '0');
                p++;
            }
        } else if (strncmp(p, "Content-Type: ", 14) == 0) {
            p += 14;
            int j = 0;
            while (*p != '\r' && *p != '\n' && j < 63) {
                result->content_type[j++] = *p++;
            }
            result->content_type[j] = '\0';
        } else if (strncmp(p, "Server: ", 8) == 0) {
            p += 8;
            int j = 0;
            while (*p != '\r' && *p != '\n' && j < 63) {
                result->server[j++] = *p++;
            }
            result->server[j] = '\0';
        }
        
                                     
        while (*p && !(*p == '\r' && *(p+1) == '\n')) p++;
        if (*p) p += 2;
        
                        
        if (*p == '\r' && *(p+1) == '\n') break;
    }
    
    return 0;
}

                                 

void http_print_response(HttpResponse* resp) {
    printf("\n=== HTTP RESPONSE ===\n");
    printf("Version: ");
    printf(resp->version);
    printf("\n");
    
    printf("Status: ");
    print_int(resp->status_code);
    printf(" ");
    printf(resp->status_text);
    printf("\n");
    
    if (resp->content_length) {
        printf("Content-Length: ");
        print_int(resp->content_length);
        printf("\n");
    }
    
    if (resp->content_type[0]) {
        printf("Content-Type: ");
        printf(resp->content_type);
        printf("\n");
    }
    
    if (resp->server[0]) {
        printf("Server: ");
        printf(resp->server);
        printf("\n");
    }
    
    printf("=====================\n");
}

                                          

int http_request(const char* host, uint16_t port, const char* path, const char* method, const char* data) {
                   
    uint32_t ip;
    if (dns_resolve(8 << 24 | 8 << 16 | 8 << 8 | 8, host, &ip) != 0) {
        printf("HTTP: DNS resolution failed\n");
        return -1;
    }
    #ifdef DEBUG_HTTP
    printf("HTTP: Connecting to %s (%d.%d.%d.%d):%d\n", 
          host,
          (ip >> 24) & 0xFF, (ip >> 16) & 0xFF,
          (ip >> 8) & 0xFF, ip & 0xFF,
          port);
    #endif
                     
    TcpConnection conn;
    if (tcp_connect(&conn, ip, port, 0) != 0) {
        printf("HTTP: TCP connection failed\n");
        return -1;
    }
    
    int result = -1;
    
    if (strcmp(method, "GET") == 0) {
        result = http_get(&conn, host, path);
    } else if (strcmp(method, "POST") == 0) {
        result = http_post(&conn, host, path, data);
    }
    
    tcp_close(&conn);
    return result;
}

static int find_http_boundary(const uint8_t* data, int data_len, const char* pattern) {
    int pat_len = strlen(pattern);
    for (int i = 0; i <= data_len - pat_len; i++) {
        if (memcmp(data + i, pattern, pat_len) == 0) {
            return i;
        }
    }
    return -1;
}

int http_fetch_file(uint32_t host_ip, uint16_t host_port, const char* remote_path, const char* local_path) {
    TcpConnection conn;
    memset(&conn, 0, sizeof(TcpConnection));
    uint16_t local_port = 49152; 

                                      
    int status = tcp_connect(&conn, host_ip, host_port, local_port);
    if (status < 0) {
        printf("[HTTP] TCP connection failed!\n");
        return -1;
    }

                                   
    char req_str[512];
    memset(req_str, 0, sizeof(req_str));
    strcpy(req_str, "GET ");
    strcat(req_str, remote_path);
    strcat(req_str, " HTTP/1.1\r\nHost: dev-pc\r\nConnection: close\r\n\r\n");

                           
    tcp_send(&conn, (const uint8_t*)req_str, (uint16_t)strlen(req_str));
    #ifdef DEBUG_HTTP
    printf("[HTTP] Downloading %s -> %s...\n", remote_path, local_path);
    #endif

                                        
    #define HTTP_RECV_BUF_SIZE 2048
    uint8_t chunk[HTTP_RECV_BUF_SIZE];
    
    int headers_passed = 0;
    int payload_offset = 0;

                                                            
    Vector* stream_vec = vector_create(sizeof(uint8_t), HTTP_RECV_BUF_SIZE);

    while (1) {
        int received = tcp_receive(&conn, chunk, HTTP_RECV_BUF_SIZE);
        if (received <= 0) break;                                                

        for (int i = 0; i < received; i++) {
            stream_vec->push(stream_vec, &chunk[i]);
        }

                                                                     
        if (!headers_passed) {
            int border = find_http_boundary(stream_vec->data, stream_vec->size, "\r\n\r\n");
            if (border >= 0) {
                headers_passed = 1;
                payload_offset = border + 4;                                   
                
                if (find_http_boundary(stream_vec->data, border, "200 OK") < 0) {
                    #ifdef DEBUG_HTTP
                    printf("[HTTP] ERROR: File not found on server (Non-200 Status)!\n");
                    #endif
                    stream_vec->destroy(stream_vec);
                    tcp_close(&conn);
                    return -1;
                }
            }
        }
    }

    tcp_close(&conn);

    if (!headers_passed) {
        printf("[HTTP] ERROR: Invalid HTTP payload from server!\n");
        stream_vec->destroy(stream_vec);
        return -1;
    }

                                                  
    int final_binary_size = stream_vec->size - payload_offset;
    if (final_binary_size <= 0) {
        printf("[HTTP] ERROR: Downloaded file content is empty!\n");
        stream_vec->destroy(stream_vec);
        return -1;
    }

                                                            
    Vector* file_data_only = vector_create(sizeof(uint8_t), final_binary_size);
    for (int i = payload_offset; i < stream_vec->size; i++) {
        file_data_only->push(file_data_only, &stream_vec->data[i]);
    }

                                                 
                                                             
    int fs_status = write_file(local_path, file_data_only);
    
                                      
    file_data_only->destroy(file_data_only);
    stream_vec->destroy(stream_vec);

    if (fs_status < 0) {
        printf("[HTTP] ERROR: Local write_file to %s failed!\n", local_path);
        return -1;
    }
    #ifdef DEBUG_HTTP
    printf("[HTTP] Success! Saved %d bytes to %s\n", final_binary_size, local_path);
    #endif
    return final_binary_size;
}

