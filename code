#define MAX_LINES 500
#define MAX_LINE_LEN 256

                   
static char line_data[MAX_LINES][MAX_LINE_LEN];
static char* lines[MAX_LINES];
static int line_count = 0;
static int current_line = 0;
static int current_col = 0;
static int screen_top = 0;
static char filename[256] = "";
static int modified = 0;
static int is_undoing = 0;

                   
#define UNDO_DEPTH 100

typedef enum {
    UNDO_INSERT,                     
    UNDO_DELETE,                    
    UNDO_SPLIT,                     
    UNDO_JOIN,                         
} UndoType;

typedef struct {
    UndoType type;
    int line;                            
    int col;                              
    char data[MAX_LINE_LEN];           
    int data_len;
} UndoAction;

static UndoAction undo_stack[UNDO_DEPTH];
static int undo_count = 0;
static int undo_pos = 0;

                           
                             
static void load_file(const char* path) {
                   
    int len = strlen(path);
    for (int i = 0; i < len && i < 255; i++) filename[i] = path[i];
    filename[len] = '\0';
    
                               
    Vector* buf = vector_create(sizeof(uint8_t), 256);
    int size = read_file(path, buf);
    
                            
    line_count = 0;
    
    if (size <= 0) {
                                          
        lines[0] = line_data[0];
        line_data[0][0] = '\0';
        line_count = 1;
        buf->destroy(buf);
        return;
    }
    
                          
    uint8_t* data = buf->data;
    int start = 0;
    
    for (int i = 0; i < size && line_count < MAX_LINES; i++) {
        if (data[i] == '\n') {
            int len = i - start;
            if (len >= MAX_LINE_LEN) len = MAX_LINE_LEN - 1;
            
            for (int j = 0; j < len; j++) {
                line_data[line_count][j] = data[start + j];
            }
            line_data[line_count][len] = '\0';
            lines[line_count] = line_data[line_count];
            line_count++;
            
            start = i + 1;
        }
    }
    
                                             
    if (start < size && line_count < MAX_LINES) {
        int len = size - start;
        if (len >= MAX_LINE_LEN) len = MAX_LINE_LEN - 1;
        
        for (int j = 0; j < len; j++) {
            line_data[line_count][j] = data[start + j];
        }
        line_data[line_count][len] = '\0';
        lines[line_count] = line_data[line_count];
        line_count++;
    }
    
    if (line_count == 0) {
        lines[0] = line_data[0];
        line_data[0][0] = '\0';
        line_count = 1;
    }
    
    buf->destroy(buf);
}

                               
static void save_file(void) {
    if (filename[0] == '\0') return;

    if (edit_config.backup_files) {
        char backup[300];
        strcpy(backup, filename);
        strcat(backup, ".bak");
        copy(filename, backup);
    }
    
                                
    Vector* buf = vector_create(sizeof(uint8_t), 256);
    
                                   
    for (int i = 0; i < line_count; i++) {
        int len = strlen(lines[i]);
        
        for (int j = 0; j < len; j++) {
            uint8_t c = (uint8_t)lines[i][j];
            buf->push(buf, &c);
        }
        
        uint8_t nl = '\n';
        buf->push(buf, &nl);
    }
    
                             
    write_file(filename, buf);
    
    buf->destroy(buf);
    modified = 0;
}

static void undo_push(UndoType type, int line, int col, const char* data, int len) {
    if (is_undoing) return;

    if (undo_count >= UNDO_DEPTH) {
                        
        for (int i = 0; i < UNDO_DEPTH - 1; i++) {
            undo_stack[i] = undo_stack[i + 1];
        }
        undo_count = UNDO_DEPTH - 1;
    }
    
    UndoAction* a = &undo_stack[undo_count];
    a->type = type;
    a->line = line;
    a->col = col;
    a->data_len = len;
    
    if (data && len > 0 && len < MAX_LINE_LEN) {
        for (int i = 0; i < len; i++) a->data[i] = data[i];
        a->data[len] = '\0';
    }
    
    undo_count++;
    undo_pos = undo_count;
}

                              
static void insert_char(char c) {
    char* line = lines[current_line];
    int len = strlen(line);
    
    if (len >= MAX_LINE_LEN - 1) return;

    if (!is_undoing) {
        char temp[2];
        temp[0] = c;
        temp[1] = '\0';
        undo_push(UNDO_INSERT, current_line, current_col, temp, 1);
    }

                      
    for (int i = len; i >= current_col; i--) {
        line[i + 1] = line[i];
    }
    line[current_col] = c;
    current_col++;
    modified = 1;
}

                               
static void delete_char(void) {
    char* line = lines[current_line];
    int len = strlen(line);
    
    if (current_col >= len) return;

    char temp[2];
    temp[0] = line[current_col];
    temp[1] = '\0';
    undo_push(UNDO_DELETE, current_line, current_col, temp, 1);
    
                     
    for (int i = current_col; i < len; i++) {
        line[i] = line[i + 1];
    }
    modified = 1;
}

                                      
static void split_line(void) {
    if (line_count >= MAX_LINES) return;

    if (!is_undoing) {
        undo_push(UNDO_SPLIT, current_line, current_col, NULL, 0);
    }
    
    char* line = lines[current_line];
    
                          
    int len = strlen(line + current_col);
    if (len >= MAX_LINE_LEN) len = MAX_LINE_LEN - 1;
    
                                   
    static char temp[MAX_LINE_LEN];
    for (int i = 0; i < len; i++) {
        temp[i] = line[current_col + i];
    }
    temp[len] = '\0';
    
                                                    
                                                              
                                                    
    
                                                                      
                                    
    
                                                  
    for (int i = line_count; i > current_line; i--) {
        strcpy(line_data[i], line_data[i-1]);
        lines[i] = line_data[i];
    }
    
                                                               
    for (int i = 0; i < len; i++) {
        line_data[current_line + 1][i] = temp[i];
    }
    line_data[current_line + 1][len] = '\0';
    lines[current_line + 1] = line_data[current_line + 1];
    
                       
    lines[current_line][current_col] = '\0';
    
    line_count++;
    current_line++;
    current_col = 0;
    modified = 1;
}

                                                     
static void join_lines(void) {
    if (current_line == 0) return;

    if (!is_undoing) {
        undo_push(UNDO_JOIN, current_line - 1, strlen(lines[current_line - 1]), NULL, 0);
    }
    
    int prev_len = strlen(lines[current_line - 1]);
    int curr_len = strlen(lines[current_line]);
    
    if (prev_len + curr_len >= MAX_LINE_LEN - 1) return;
    
                                          
    for (int i = 0; i < curr_len; i++) {
        line_data[current_line - 1][prev_len + i] = line_data[current_line][i];
    }
    line_data[current_line - 1][prev_len + curr_len] = '\0';
    
                                
    for (int i = current_line; i < line_count - 1; i++) {
        strcpy(line_data[i], line_data[i + 1]);
        lines[i] = line_data[i];
    }
    
                        
    line_data[line_count - 1][0] = '\0';
    
    line_count--;
    current_line--;
    current_col = prev_len;
    modified = 1;
}

                   
static void undo(void) {
    if (undo_pos <= 0) return;
    
    undo_pos--;
    UndoAction* a = &undo_stack[undo_pos];

    is_undoing = 1;
    
    switch (a->type) {
        case UNDO_INSERT:
                                         
            current_line = a->line;
            current_col = a->col;
            delete_char();
            break;
            
        case UNDO_DELETE:
                                                 
            current_line = a->line;
            current_col = a->col;
            insert_char(a->data[0]);
            break;
            
        case UNDO_SPLIT:
                                        
            current_line = a->line + 1;
            current_col = 0;
            join_lines();
            break;
            
        case UNDO_JOIN:
                                       
            current_line = a->line;
            current_col = a->col;
            split_line();
            break;
    }

    is_undoing = 0;
    modified = 1;
}

                        
