void edit(const char* path) {
    load_file(path);
    current_line = 0;
    current_col = 0;
    screen_top = 0;
    
    while (1) {
        draw();
        
        int c = getchar();
        
                            
        if (c == 24 || c == 17) {                      
            if (modified) {
                                        
                set_color(COLOR_RED, COLOR_BLACK);
                print("\nUnsaved changes! Save? (y/n/c): ");
                char ans = getchar();
                if (ans == 'y' || ans == 'Y') {
                    save_file();
                } else if (ans == 'c' || ans == 'C') {
                    continue;                                      
                }
            }
            break;
        }
        
                                 
        if (c == 15 || c == 19) {                      
            save_file();
            continue;
        }
        
                              
        if (c == KEY_UP) {
            if (current_line > 0) {
                current_line--;
                if (current_col > (int)strlen(lines[current_line]))
                    current_col = strlen(lines[current_line]);
                if (current_line < screen_top)
                    screen_top = current_line;
            }
            continue;
        }
        if (c == KEY_DOWN) {
            if (current_line < line_count - 1) {
                current_line++;
                if (current_col > (int)strlen(lines[current_line]))
                    current_col = strlen(lines[current_line]);
                if (current_line - screen_top >= rows - 6)
                    screen_top++;
            }
            continue;
        }
        if (c == KEY_LEFT) {
            if (current_col > 0) {
                current_col--;
            } else if (current_line > 0) {
                current_line--;
                current_col = strlen(lines[current_line]);
                if (current_line < screen_top)
                    screen_top = current_line;
            }
            continue;
        }
        if (c == KEY_RIGHT) {
            if (current_col < (int)strlen(lines[current_line])) {
                current_col++;
            } else if (current_line < line_count - 1) {
                current_line++;
                current_col = 0;
                if (current_line - screen_top >= rows - 6)
                    screen_top++;
            }
            continue;
        }
        
                               
        if (c == KEY_HOME || c == 1) {                        
            current_col = 0;
            continue;
        }
        if (c == KEY_END || c == 5) {                       
            current_col = strlen(lines[current_line]);
            continue;
        }
        
                                
        if (c == KEY_PGUP) {
            current_line -= rows - 6;
            if (current_line < 0) current_line = 0;
            screen_top -= rows - 6;
            if (screen_top < 0) screen_top = 0;
            if (current_col > (int)strlen(lines[current_line]))
                current_col = strlen(lines[current_line]);
            continue;
        }
        if (c == KEY_PGDN) {
            current_line += rows - 6;
            if (current_line >= line_count) current_line = line_count - 1;
            screen_top += rows - 6;
            if (screen_top > line_count - 1) screen_top = line_count - 1;
            if (screen_top < 0) screen_top = 0;
            if (current_col > (int)strlen(lines[current_line]))
                current_col = strlen(lines[current_line]);
            continue;
        }
        
                             
        if (c == KEY_DELETE) {
            if (current_col < (int)strlen(lines[current_line])) {
                delete_char();
            } else if (current_line < line_count - 1) {
                join_lines();
            }
            continue;
        }
        
                            
        if (c == '\n') {
            split_line();
            continue;
        }
        
                                
        if (c == '\b' || c == 127) {
            if (current_col > 0) {
                current_col--;
                delete_char();
            } else if (current_line > 0) {
                                                   
                                             
                join_lines();
            }
        }
        
                          
        if (c == '\t') {
                                  
            insert_char(' ');
            insert_char(' ');
            insert_char(' ');
            insert_char(' ');
            continue;
        }

        if (c == 26) {           
            undo();
            continue;
        }
        
                                       
        if (c >= 32 && c < 127) {
            insert_char(c);
        }
    }
}

