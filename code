    }
    

    #ifdef DEBUG_TCP
    printf("TCP: Closing connection (state=%d)\n", conn->state);
    #endif
    
                                                   
    if (conn->state == TCP_CONNECTED) {
        uint8_t packet[sizeof(TcpHeader)];
        TcpHeader* tcp = (TcpHeader*)packet;
        memset(packet, 0, sizeof(TcpHeader));
        
        tcp->src_port = htons(conn->local_port);
        tcp->dst_port = htons(conn->remote_port);
        tcp->seq_num = htonl(conn->seq);
        tcp->ack_num = htonl(conn->ack);
        tcp->data_offset = 5 << 4;
        tcp->flags = TCP_FIN | TCP_ACK;
        tcp->window_size = htons(65535);
        tcp->checksum = tcp_checksum(our_ip, conn->remote_ip, packet, sizeof(TcpHeader));
        
        ip_send(conn->remote_ip, IP_PROTO_TCP, packet, sizeof(TcpHeader));
        
                          
        for (int i = 0; i < 100; i++) {
            uint8_t buf[2048];
            int len = ip_receive(buf, sizeof(buf));
            if (len > 0) {
                                
                Ipv4Header* ip = (Ipv4Header*)buf;
                if (ip->protocol == IP_PROTO_TCP) {
                    uint16_t ip_len = (ip->version_ihl & 0x0F) * 4;
                    TcpHeader* resp = (TcpHeader*)((uint8_t*)ip + ip_len);
                    
                    if (ntohs(resp->src_port) == conn->remote_port &&
                        ntohs(resp->dst_port) == conn->local_port &&
                        (resp->flags & TCP_ACK)) {
                        #ifdef DEBUG_TCP
                        printf("TCP: FIN-ACK received\n");
                        #endif
                        break;
                    }
                }
            }
            for (volatile int j = 0; j < 1000; j++);
        }
    }
    
                            
    conn->state = TCP_CLOSED;
    conn->remote_ip = 0;
    conn->remote_port = 0;
    #ifdef DEBUG_TCP
    printf("TCP: Connection closed\n");
    #endif
}

