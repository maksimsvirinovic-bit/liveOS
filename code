static void dos_time(uint16_t* time, uint16_t* date) {
                                
    *time = 0x0000;
    *date = 0x21B1;
}

                                                    
                                               
static uint32_t deflate_data(const uint8_t* in, uint32_t in_len, uint8_t** out) {
                                     
    *out = (uint8_t*)kmalloc(in_len);
    if (!*out) {
        printf("zip: Out of memory\n");
        return 0;
    }
    memcpy(*out, in, in_len);
