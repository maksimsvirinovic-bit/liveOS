SystemConfig system_config;
ConsoleConfig console_config;
LpiConfig lpi_config;
EditConfig edit_config;

static int cfg_parse_int(const char* value, int fallback) {
    if (!value || !value[0]) return fallback;
    int result = 0;
    int sign = 1;
    if (*value == '-') { sign = -1; value++; }
    while (*value >= '0' && *value <= '9') result = result * 10 + (*value++ - '0');
    return result * sign;
}

static int load_key_value(const char* path, void (*apply)(const char*, const char*)) {
    Vector* data = vector_create(sizeof(uint8_t), 512);
    int size = read_file(path, data);
    if (size < 0) { data->destroy(data); return -1; }
    char line[512];
    int position = 0;
    for (uint32_t i = 0; i <= data->size; i++) {
        char current = i < data->size ? ((char*)data->data)[i] : '\n';
        if (current == '\n' || current == '\r') {
            line[position] = '\0';
            if (position > 0 && line[0] != '#') {
                char* equal = strchr(line, '=');
                if (equal) {
                    *equal = '\0';
                    apply(line, equal + 1);
                }
            }
            position = 0;
        } else if (position < 511) {
            line[position++] = current;
        }
    }
    data->destroy(data);
    return 0;
}

static void apply_system(const char* key, const char* value) {
    if (strcmp(key, "hostname") == 0) strcpy(system_config.hostname, value);
    else if (strcmp(key, "greeting") == 0) strcpy(system_config.greeting, value);
    else if (strcmp(key, "prompt_user") == 0) strcpy(system_config.prompt_user, value);
    else if (strcmp(key, "debug_level") == 0) system_config.debug_level = cfg_parse_int(value, system_config.debug_level);
    else if (strcmp(key, "font_size") == 0) system_config.font_size = cfg_parse_int(value, system_config.font_size);
    else if (strcmp(key, "autoload_desktop") == 0) system_config.autoload_desktop = cfg_parse_int(value, system_config.autoload_desktop);
}

static void apply_console(const char* key, const char* value) {
    if (strcmp(key, "aliases") == 0) strcpy(console_config.aliases_path, value);
    else if (strcmp(key, "history_size") == 0) console_config.history_size = cfg_parse_int(value, console_config.history_size);
    else if (strcmp(key, "echo_commands") == 0) console_config.echo_commands = cfg_parse_int(value, console_config.echo_commands);
    else if (strcmp(key, "color_output") == 0) console_config.color_output = cfg_parse_int(value, console_config.color_output);
}

static void apply_lpi(const char* key, const char* value) {
    if (strcmp(key, "repositories") == 0) strcpy(lpi_config.repositories, value);
    else if (strcmp(key, "certificate") == 0) strcpy(lpi_config.certificate, value);
    else if (strcmp(key, "cache_limit_kb") == 0) lpi_config.cache_limit_kb = cfg_parse_int(value, lpi_config.cache_limit_kb);
    else if (strcmp(key, "require_root") == 0) lpi_config.require_root = cfg_parse_int(value, lpi_config.require_root);
    else if (strcmp(key, "verify_signatures") == 0) lpi_config.verify_signatures = cfg_parse_int(value, lpi_config.verify_signatures);
}

static void apply_edit(const char* key, const char* value) {
    if (strcmp(key, "tab_size") == 0) edit_config.tab_size = cfg_parse_int(value, edit_config.tab_size);
    else if (strcmp(key, "insert_spaces") == 0) edit_config.insert_spaces = cfg_parse_int(value, edit_config.insert_spaces);
    else if (strcmp(key, "line_numbers") == 0) edit_config.line_numbers = cfg_parse_int(value, edit_config.line_numbers);
    else if (strcmp(key, "auto_indent") == 0) edit_config.auto_indent = cfg_parse_int(value, edit_config.auto_indent);
    else if (strcmp(key, "word_wrap") == 0) edit_config.word_wrap = cfg_parse_int(value, edit_config.word_wrap);
    else if (strcmp(key, "backup_files") == 0) edit_config.backup_files = cfg_parse_int(value, edit_config.backup_files);
    else if (strcmp(key, "color_scheme") == 0) strcpy(edit_config.color_scheme, value);
}

static void apply_syslog(const char* key, const char* value) {
    if (strcmp(key, "all") != 0 && strcmp(key, "default") != 0) return;
    if (strcmp(value, "DEBUG") == 0) system_config.debug_level = SYSTEM_LOG_LEVEL_DEBUG;
    else if (strcmp(value, "INFO") == 0) system_config.debug_level = SYSTEM_LOG_LEVEL_INFO;
    else if (strcmp(value, "WARN") == 0) system_config.debug_level = SYSTEM_LOG_LEVEL_WARN;
    else if (strcmp(value, "ERROR") == 0) system_config.debug_level = SYSTEM_LOG_LEVEL_ERROR;
    else if (strcmp(value, "NONE") == 0) system_config.debug_level = SYSTEM_LOG_LEVEL_NONE;
}

void system_config_init(void) {
    memset(&system_config, 0, sizeof(system_config));
    memset(&console_config, 0, sizeof(console_config));
    memset(&lpi_config, 0, sizeof(lpi_config));
    memset(&edit_config, 0, sizeof(edit_config));
    strcpy(system_config.hostname, "liveos");
    strcpy(system_config.greeting, "Welcome to LiveOS");
    strcpy(system_config.prompt_user, "liveos");
    system_config.debug_level = SYSTEM_LOG_LEVEL_INFO;
    system_config.font_size = 8;
    system_config.autoload_desktop = 0;
    strcpy(console_config.aliases_path, "/etc/cfgs/console/aliases.cfg");
    console_config.history_size = 1000;
    console_config.echo_commands = 0;
    console_config.color_output = 1;
    strcpy(lpi_config.repositories, "/repository");
    lpi_config.cache_limit_kb = 16384;
    lpi_config.require_root = 0;
    lpi_config.verify_signatures = 0;
    edit_config.tab_size = 4;
    edit_config.insert_spaces = 1;
    edit_config.line_numbers = 0;
    edit_config.auto_indent = 1;
    edit_config.word_wrap = 0;
    edit_config.backup_files = 1;
    strcpy(edit_config.color_scheme, "default");
}

int system_config_load(void) {
    load_key_value(SYSTEM_CONFIG_SYSTEM, apply_system);
    load_key_value(SYSTEM_CONFIG_CONSOLE, apply_console);
    load_key_value(SYSTEM_CONFIG_LPI, apply_lpi);
    load_key_value(SYSTEM_CONFIG_EDIT, apply_edit);
    load_key_value(SYSTEM_CONFIG_SYSLOG, apply_syslog);
    return 0;
}

static void write_text(const char* path, const char* text) {
    Vector* data = vector_create(sizeof(char), 512);
    while (*text) data->push(data, text++);
    create_file(path);
    write_file(path, data);
    data->destroy(data);
}

int system_config_save_defaults(void) {
    Vector* existing = vector_create(sizeof(uint8_t), 32);
    int has_config = read_file(SYSTEM_CONFIG_SYSTEM, existing) >= 0;
    existing->destroy(existing);
    if (has_config) return 0;
    create_dir("/etc");
    create_dir(SYSTEM_CONFIG_ROOT);
    create_dir(SYSTEM_CONFIG_ROOT "/system");
    create_dir(SYSTEM_CONFIG_ROOT "/console");
    create_dir(SYSTEM_CONFIG_ROOT "/lpi");
    create_dir(SYSTEM_CONFIG_ROOT "/edit");
    create_dir(SYSTEM_CONFIG_ROOT "/syslog");
    write_text(SYSTEM_CONFIG_SYSTEM, "hostname=liveos\ngreeting=Welcome to LiveOS\nprompt_user=liveos\ndebug_level=3\nfont_size=8\nautoload_desktop=0\n");
    write_text(SYSTEM_CONFIG_CONSOLE, "aliases=/etc/cfgs/console/aliases.cfg\nhistory_size=1000\necho_commands=0\ncolor_output=1\n");
    write_text(SYSTEM_CONFIG_LPI, "repositories=/repository\ncache_limit_kb=16384\nrequire_root=0\nverify_signatures=0\ncertificate=\n");
    write_text(SYSTEM_CONFIG_EDIT, "tab_size=4\ninsert_spaces=1\nline_numbers=0\nauto_indent=1\nword_wrap=0\nbackup_files=1\ncolor_scheme=default\n");
    write_text(SYSTEM_CONFIG_SYSLOG, "default=INFO\nall=INFO\n");
    write_text(console_config.aliases_path, "# name=one-line command\nhello=echo Hello!\n");
    return 0;
}

const char* system_hostname(void) { return system_config.hostname; }


