static const char* http_get_mime(const char* path) {
    const char* ext = strrchr(path, '.');
    if (!ext) return "application/octet-stream";
    
    if (strcmp(ext, ".html") == 0 || strcmp(ext, ".htm") == 0)
        return "text/html";
    if (strcmp(ext, ".css") == 0) return "text/css";
    if (strcmp(ext, ".js") == 0) return "application/javascript";
    if (strcmp(ext, ".json") == 0) return "application/json";
    if (strcmp(ext, ".png") == 0) return "image/png";
    if (strcmp(ext, ".jpg") == 0 || strcmp(ext, ".jpeg") == 0)
        return "image/jpeg";
    if (strcmp(ext, ".gif") == 0) return "image/gif";
    if (strcmp(ext, ".txt") == 0) return "text/plain";
    if (strcmp(ext, ".xml") == 0) return "application/xml";
    if (strcmp(ext, ".pdf") == 0) return "application/pdf";
    
    return "application/octet-stream";
}

                           
static int http_parse_request(const uint8_t* data, int len, char* path, int path_len) {
    if (len < 4) return -1;
    
                      
    char line[512];
    int line_len = 0;
    while (line_len < len && line_len < sizeof(line) - 1) {
        line[line_len] = data[line_len];
        if (data[line_len] == '\n') break;
        line_len++;
    }
    line[line_len] = '\0';
    
                                 
    char* method = strtok(line, " ");
    if (!method) return -1;
    if (strcmp(method, "GET") != 0 && strcmp(method, "HEAD") != 0) return -1;
    
    char* url = strtok(NULL, " ");
    if (!url) return -1;
    
                        
    char* q = strchr(url, '?');
    if (q) *q = '\0';
    
                                                                             
    char normalized[512];
    char* components[64];
    int comp_count = 0;

                              
    char* token = strtok(url, "/");
    while (token && comp_count < 64) {
        if (strcmp(token, ".") == 0) {
                         
        } else if (strcmp(token, "..") == 0) {
                                          
            if (comp_count > 0) comp_count--;
        } else if (token[0] != '\0') {
            components[comp_count++] = token;
        }
        token = strtok(NULL, "/");
    }

                       
    int pos = 0;
    for (int i = 0; i < comp_count && pos < path_len - 1; i++) {
        normalized[pos++] = '/';
        for (char* p = components[i]; *p && pos < path_len - 1; p++) {
            normalized[pos++] = *p;
        }
    }
    if (pos == 0) normalized[pos++] = '/';
    normalized[pos] = '\0';

    strncpy(path, normalized, path_len - 1);
    path[path_len - 1] = '\0';
}

                                  
static int http_send_response(TcpConnection* conn, int status, const char* status_text,
                              const char* content_type, const uint8_t* body, int body_len) {
    char header[512];
    int pos = 0;
    
    pos += sprintf(header + pos, "HTTP/1.1 %d %s\r\n", status, status_text);
    pos += sprintf(header + pos, "Content-Type: %s\r\n", content_type);
    pos += sprintf(header + pos, "Content-Length: %d\r\n", body_len);
    pos += sprintf(header + pos, "Server: LiveOS/6.0\r\n");
    pos += sprintf(header + pos, "Connection: close\r\n");
    pos += sprintf(header + pos, "\r\n");
    
    tcp_send(conn, (uint8_t*)header, pos);
    if (body && body_len > 0) {
        tcp_send(conn, body, body_len);
    }
    
    return pos + body_len;
}

                                
static void http_handle_request(TcpConnection* conn, const uint8_t* data, int len) {
    char path[256];
    
    if (http_parse_request(data, len, path, sizeof(path)) != 0) {
        const char* err = "<h1>400 Bad Request</h1>";
        http_send_response(conn, 400, "Bad Request", "text/html",
                          (uint8_t*)err, strlen(err));
        return;
    }
    
    printf("HTTP: GET %s\n", path);
    
                                   
    if (strcmp(path, "/status") == 0) {
                             
        char status_page[1024];
        int pos = 0;
        pos += sprintf(status_page + pos, "<h1>LiveOS Status</h1>\n");
        pos += sprintf(status_page + pos, "<p>IP: %d.%d.%d.%d</p>\n",
                (our_ip >> 24) & 0xFF, (our_ip >> 16) & 0xFF,
                (our_ip >> 8) & 0xFF, our_ip & 0xFF);
        pos += sprintf(status_page + pos, "<p>Uptime: 0 seconds</p>\n");
        pos += sprintf(status_page + pos, "<p>RAM: %d KB free</p>\n", heap_get_free() / 1024);
        
        http_send_response(conn, 200, "OK", "text/html",
                          (uint8_t*)status_page, pos);
        return;
    }
    
    if (strcmp(path, "/") == 0) {
                               
        strcpy(path, "/index.html");
    }
    
                          
    Vector* file_data = vector_create(sizeof(uint8_t), 256);
    int size = read_file(path, file_data);
    
    if (size > 0) {
                  
        const char* mime = http_get_mime(path);
        http_send_response(conn, 200, "OK", mime,
                          file_data->data, size);
        #ifdef DEBUG_HTTP_SERVER
        printf("HTTP: 200 %s (%d bytes)\n", path, size);
        #endif
    } else {
              
        char error[512];
        sprintf(error, "<h1>404 Not Found</h1><p>File: %s</p><hr><pre>%s</pre>",
                path, vfs_get_path());
        
        http_send_response(conn, 404, "Not Found", "text/html",
                          (uint8_t*)error, strlen(error));
        #ifdef DEBUG_HTTP_SERVER
        printf("HTTP: 404 %s\n", path);
        #endif
    }
    
    file_data->destroy(file_data);
}

                                          
static int http_server_loop(void) {
    printf("HTTP Server: Listening on port %d\n", HTTP_SERVER_PORT);
    set_color(COLOR_GREEN, COLOR_BLACK);
    printf("  Visit http://");
