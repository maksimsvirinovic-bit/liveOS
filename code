    int size = ext4_read_file(xattr_path, data);
    
    if (size <= 0) {
        data->destroy(data);
        return -1;
    }
    
    uint32_t to_copy = (uint32_t)size;
    if (to_copy > max_size) to_copy = max_size;
    
    for (uint32_t i = 0; i < to_copy; i++) {
        ((uint8_t*)value)[i] = data->data[i];
    }
    
    data->destroy(data);
    return to_copy;
}

               
