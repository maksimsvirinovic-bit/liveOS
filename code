}

                                       
int zip_add_file(Vector* archive, const char* file_path, const char* arc_name) {
    if (!archive || !file_path) return -1;
    
                  
    Vector* content = vector_create(sizeof(uint8_t), 256);
    int size = read_file(file_path, content);
    if (size <= 0) {
        content->destroy(content);
        return -1;
    }
    
                     
    const char* name = arc_name ? arc_name : file_path;
    if (strchr(name, '/')) {
        name = strrchr(name, '/') + 1;
    }
    uint16_t name_len = strlen(name);
    
            
    uint32_t crc = crc32_compute(content->data, size);
    
                          
    uint8_t* compressed = NULL;
    uint32_t compressed_size = deflate_data(content->data, size, &compressed);
    
            
    uint16_t mod_time, mod_date;
    dos_time(&mod_time, &mod_date);
    
                           
    ZipLocalHeader header;
    header.signature = ZIP_LOCAL_SIG;
    header.version = 0x0014;
    header.flags = 0x0000;
    header.compression = ZIP_STORE;
    header.mod_time = mod_time;
    header.mod_date = mod_date;
    header.crc32 = crc;
    header.compressed_size = compressed_size;
    header.uncompressed_size = size;
    header.name_len = name_len;
    header.extra_len = 0;
    
    archive->push(archive, &header);
    for (int i = 0; i < name_len; i++) {
        archive->push(archive, &name[i]);
    }
    for (uint32_t i = 0; i < compressed_size; i++) {
        archive->push(archive, &compressed[i]);
    }
    
    if (compressed) kfree(compressed);
    content->destroy(content);
    
    return 0;
}

                                            
int zip_create(const char* output_path, const char* files[], int file_count) {
    if (!output_path || !files || file_count <= 0) return -1;
    
    printf("ZIP: Creating %s (%d files)...\n", output_path, file_count);
    
    Vector* archive = vector_create(sizeof(uint8_t), 256);
    Vector* central_dir = vector_create(sizeof(uint8_t), 256);
    uint32_t local_offset = 0;
    int added = 0;
    
    for (int i = 0; i < file_count; i++) {
        const char* path = files[i];
        
                                        
        Ext4_Stat stat;
        if (ext4_stat(path, &stat) != 0) {
            printf("ZIP: Warning: %s not found, skipping\n", path);
            continue;
        }
        
                                 
        uint32_t start_pos = archive->size;
        if (zip_add_file(archive, path, NULL) != 0) {
            printf("ZIP: Failed to add %s\n", path);
            continue;
        }
        
                       
        char* name = (char*)path;
        if (strchr(name, '/')) {
            name = strrchr(name, '/') + 1;
        }
        uint16_t name_len = strlen(name);
        
                                    
        ZipCentralDir cd;
        cd.signature = ZIP_CENTRAL_SIG;
        cd.version_made = 0x0014;
        cd.version_needed = 0x0014;
        cd.flags = 0x0000;
        cd.compression = ZIP_STORE;
        cd.mod_time = 0x0000;
        cd.mod_date = 0x21B1;
        cd.crc32 = crc32_file(path);
        cd.compressed_size = archive->size - start_pos - sizeof(ZipLocalHeader) - name_len;
        cd.uncompressed_size = stat.size;
        cd.name_len = name_len;
        cd.extra_len = 0;
        cd.comment_len = 0;
        cd.disk_start = 0;
        cd.internal_attr = 0x0000;
        cd.external_attr = 0x0000;
        cd.local_header_offset = local_offset;
        
        central_dir->push(central_dir, &cd);
        for (int j = 0; j < name_len; j++) {
            central_dir->push(central_dir, &name[j]);
        }
        
        local_offset += archive->size - start_pos;
        added++;
        printf("ZIP: Added %s (%d bytes)\n", name, stat.size);
    }
    
    if (added == 0) {
        printf("ZIP: No files added!\n");
        archive->destroy(archive);
        central_dir->destroy(central_dir);
        return -1;
    }
    
                                       
    ZipEndCentralDir end;
    end.signature = ZIP_END_SIG;
    end.disk_num = 0;
    end.cd_disk_num = 0;
    end.cd_entries_on_disk = added;
    end.cd_total_entries = added;
    end.cd_size = central_dir->size;
    end.cd_offset = local_offset;
    end.comment_len = 0;
    
                             
    Vector* result = vector_create(sizeof(uint8_t), archive->size + central_dir->size + sizeof(ZipEndCentralDir));
    
    for (uint32_t i = 0; i < archive->size; i++) {
        result->push(result, &archive->data[i]);
    }
    for (uint32_t i = 0; i < central_dir->size; i++) {
        result->push(result, &central_dir->data[i]);
    }
    result->push(result, &end);
    
    int ret = write_file(output_path, result);
    
    archive->destroy(archive);
    central_dir->destroy(central_dir);
    result->destroy(result);
    
    if (ret > 0) {
        printf("ZIP: Created %s (%d bytes, %d files)\n", output_path, ret, added);
        return 0;
    }
    
    return -1;
}

                             
int unzip_extract_all(const char* archive_path, const char* output_dir) {
    if (!archive_path || !output_dir) return -1;
    
    printf("ZIP: Extracting %s to %s...\n", archive_path, output_dir);
    
    Vector* archive = vector_create(sizeof(uint8_t), 256);
    int size = read_file(archive_path, archive);
    if (size <= 0) {
        printf("ZIP: Cannot read %s\n", archive_path);
        archive->destroy(archive);
        return -1;
    }
    
    uint8_t* data = archive->data;
    uint32_t pos = 0;
    int extracted = 0;
    
                             
    create_dir(output_dir);
    
    while (pos + sizeof(ZipLocalHeader) < (uint32_t)size) {
        ZipLocalHeader* header = (ZipLocalHeader*)(data + pos);
        
        if (header->signature != ZIP_LOCAL_SIG) {
            if (header->signature == ZIP_END_SIG || header->signature == ZIP_CENTRAL_SIG) break;
            pos++;
            continue;
        }
        
                    
        char name[512];
        uint16_t name_len = header->name_len;
        if (name_len > 511) name_len = 511;
        memcpy(name, data + pos + sizeof(ZipLocalHeader), name_len);
        name[name_len] = '\0';
        
                                          
        int is_dir = (name[name_len - 1] == '/');
        
                 
        uint32_t data_offset = pos + sizeof(ZipLocalHeader) + header->name_len + header->extra_len;
        uint32_t data_size = header->uncompressed_size;
        uint32_t comp_size = header->compressed_size;
        
        if (is_dir) {
                                 
            char dir_path[512];
            sprintf(dir_path, "%s/%s", output_dir, name);
            create_dir(dir_path);
            printf("ZIP: Created directory %s\n", name);
            pos = data_offset + comp_size;
            continue;
        }
        
        printf("ZIP: Extracting %s (%d bytes)\n", name, data_size);
        
                      
        char full_path[512];
        sprintf(full_path, "%s/%s", output_dir, name);
        
                                
        char* last_slash = strrchr(full_path, '/');
        if (last_slash) {
            *last_slash = '\0';
            create_dir(full_path);
            *last_slash = '/';
        }
        
                        
        uint8_t* compressed = data + data_offset;
        
                        
        uint8_t* out_data = NULL;
        uint32_t out_size = inflate_data(compressed, comp_size, &out_data, data_size);
        
        if (out_data && out_size > 0) {
            Vector* content = vector_create(sizeof(uint8_t), out_size);
            for (uint32_t i = 0; i < out_size; i++) {
                content->push(content, &out_data[i]);
            }
            write_file(full_path, content);
            content->destroy(content);
            kfree(out_data);
            extracted++;
        }
        
        pos = data_offset + comp_size;
    }
    
    archive->destroy(archive);
    
    printf("ZIP: Extracted %d files\n", extracted);
    return 0;
}

                                  
void unzip_list(const char* archive_path) {
    Vector* archive = vector_create(sizeof(uint8_t), 256);
    int size = read_file(archive_path, archive);
    if (size <= 0) {
        printf("ZIP: Cannot read %s\n", archive_path);
        archive->destroy(archive);
        return;
    }
    
    uint8_t* data = archive->data;
    uint32_t pos = 0;
    int file_count = 0;
    
    printf("\n=== ZIP: %s ===\n", archive_path);
    printf("%-30s %-12s %-12s %s\n", "Name", "Size", "Compressed", "CRC32");
    printf("------------------------------------------------------------\n");
    
    while (pos + sizeof(ZipLocalHeader) < (uint32_t)size) {
        ZipLocalHeader* header = (ZipLocalHeader*)(data + pos);
        
        if (header->signature != ZIP_LOCAL_SIG) {
            if (header->signature == ZIP_END_SIG || header->signature == ZIP_CENTRAL_SIG) break;
            pos++;
            continue;
        }
        
        char name[512];
        uint16_t name_len = header->name_len;
        if (name_len > 511) name_len = 511;
        memcpy(name, data + pos + sizeof(ZipLocalHeader), name_len);
        name[name_len] = '\0';
        
        printf("%-30s %-12d %-12d 0x%08X\n", 
               name, 
               header->uncompressed_size, 
               header->compressed_size,
               header->crc32);
        
        file_count++;
        pos += sizeof(ZipLocalHeader) + header->name_len + header->extra_len + header->compressed_size;
    }
    
    printf("------------------------------------------------------------\n");
    printf("Total: %d files\n", file_count);
    
    archive->destroy(archive);
}

                            
int unzip(const char* archive_path, const char* output_dir) {
    return unzip_extract_all(archive_path, output_dir);
}

                                
