    vfs_init();

    if (!fs_initialized) {
        print("Filesystem not found! Formatting...\n");
        
        VFS_FormatOptions opts;
        memset(&opts, 0, sizeof(opts));
        opts.type = VFS_TYPE_EXT4;
        opts.quick = 1;
        
        format(VFS_TYPE_EXT4, &opts);
        create_file("/.inited");
    } else {
        Vector* marker = vector_create(sizeof(uint8_t), 16);
        int ret = read_file("/.inited", marker);
        marker->destroy(marker);
        
        if (ret < 0) {
            print("Marker not found! Creating...\n");
            create_file("/.inited");
        } else {
            print("System initialized!\n");
        }
    }

    system_config_init();
    system_config_save_defaults();
    system_config_load();
    logger_init();
    log("INFO", "BOOT", "filesystem ready");

    driver_manager_init();
    log("INFO", "DRIVER", "driver manager initialized");

    //driver_autoload();
    log("INFO", "DRIVER", "driver autoload complete");

                                                                                    
    lpi_init();

                   
    log("INFO", "NETWORK", "initializing e1000");
    e1000_init(0x90600000);
    e1000_enable_interrupts();
    
    arp_init(10 << 24 | 2 << 8 | 2);
                                  
    __asm__ volatile("sti");
    
    print("Good!\n");

    keyboard_reset_input();
    console_init((uint32_t*)info->FbAddr, info->Width, info->Height, info->Pitch);

    log("DEBUG", "CONSOLE", "console inited!");

    task_create("shell", shell_task, 10);
    task_create("logger", logger_daemon, 1);

    log("DEBUG", "TASKING", "Tasks registred!");
        
    for (uint32_t i = 0; i < info->Height * (info->Pitch / 4); i++) {
        ((uint32_t*)info->FbAddr)[i] = COLOR_BLACK;
    }

    scheduler_start();

    //shell_loop();
}

