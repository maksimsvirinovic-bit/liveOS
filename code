    r->parser = lgs_parser_create();
    r->executor = lgs_executor_create(r->parser);
    r->width = w;
    r->height = h;
    r->window = NULL;
    return r;
}

void lgs_renderer_destroy(LGSRenderer* r) {
    if (!r) return;
    
    if (r->executor) lgs_executor_destroy(r->executor);
    if (r->parser) lgs_parser_destroy(r->parser);
    if (r->window) gui_close_window(r->window);
    
    kfree(r);
}

// Execute <exec> blocks
static int lgs_exec_blocks(LGSRenderer* r, ASTNode* root) {
    if (!r || !root || !r->executor) return 0;
    
    ASTNode* exec_node = lgs_find_node(root, "exec");
    while (exec_node) {
        printf("[LGS] Executing code block...\n");
        ExprValue* result = lgs_eval_code_block(r->executor, exec_node);
        if (result) {
            printf("[LGS] Result: %d\n", result->value.int_val);
            kfree(result);
        }
        // Find next exec block (simplified - would need better traversal)
        exec_node = NULL;
    }
    
    return 0;
}

// Parse widgets from <widgets> section
static int lgs_render_widgets(LGSRenderer* r, ASTNode* widgets_node) {
    if (!r || !widgets_node || !r->window) return -1;
    
    int y_offset = 2;
    
    for (uint32_t i = 0; i < widgets_node->children->size; i++) {
        ASTNode* child = *(ASTNode**)widgets_node->children->at(widgets_node->children, i);
        
        if (strcmp(child->name, "button") == 0) {
            // Parse button attributes
            char label[128] = "Button";
            int x = 5, y = y_offset, w = 20, h = 1;
            
            // Extract value as label if present
            if (child->value[0]) {
                strcpy(label, child->value);
            }
            
            // TODO: Parse attributes (x, y, w, h, label)
            
            Widget* btn = gui_button_create("btn", x, y, w, h, label);
            gui_add_child(r->window->root, btn);
            
            y_offset += 2;
            
        } else if (strcmp(child->name, "label") == 0) {
            char text[256] = "Label";
            int x = 5, y = y_offset, w = 30, h = 1;
            
            if (child->value[0]) {
                strcpy(text, child->value);
            }
            
            Widget* lbl = gui_label_create("lbl", x, y, w, h, text);
            gui_add_child(r->window->root, lbl);
            
            y_offset += 1;
            
        } else if (strcmp(child->name, "panel") == 0) {
            int x = 5, y = y_offset, w = 40, h = 10;
            
            Widget* pnl = gui_panel_create("pnl", x, y, w, h);
            gui_panel_set_border(pnl, 1);
            gui_add_child(r->window->root, pnl);
            
            y_offset += 12;
            
        } else if (strcmp(child->name, "input") == 0) {
            int x = 5, y = y_offset, w = 30, h = 1;
            
            Widget* inp = gui_input_create("inp", x, y, w, h, 255);
            gui_add_child(r->window->root, inp);
            
            y_offset += 2;
        }
    }
    
    return 0;
}

// Parse params and configure window
static int lgs_render_params(LGSRenderer* r, ASTNode* params_node) {
    if (!r || !params_node) return -1;
    
    char title[256] = "LiveOS App";
    int fullscreen = 0;
    
    for (uint32_t i = 0; i < params_node->children->size; i++) {
        ASTNode* child = *(ASTNode**)params_node->children->at(params_node->children, i);
        
        if (strcmp(child->name, "title") == 0 && child->value[0]) {
            strcpy(title, child->value);
        } else if (strcmp(child->name, "can_fullscreening") == 0) {
            fullscreen = (child->value[0] == '1') ? 1 : 0;
        }
    }
    
    // Create window with parsed title
    r->window = gui_create_window(title, 0, 0, r->width, r->height);
    
    return 0;
}

// Main rendering
int lgs_render_string(LGSRenderer* r, const char* lgs_content) {
    if (!r || !lgs_content) return -1;
    
    // Parse LGS
    if (lgs_parse_string(r->parser, lgs_content) != 0) {
        printf("[LGS] Parse error: %s\n", r->parser->error);
        return -1;
    }
    
    if (!r->parser->root) {
        printf("[LGS] No AST generated\n");
        return -1;
    }
    
    // Debug: print AST
    printf("[LGS] AST:\n");
    lgs_print_ast(r->parser->root, 0);
    
    // Find params section
    ASTNode* params = lgs_find_node(r->parser->root, "params");
    if (params) {
        if (lgs_render_params(r, params) != 0) {
            printf("[LGS] Params rendering failed\n");
            return -1;
        }
    } else {
        // Create default window
        r->window = gui_create_window("LiveOS App", 0, 0, r->width, r->height);
    }
    
    // Execute code blocks first
    if (lgs_exec_blocks(r, r->parser->root) != 0) {
        printf("[LGS] Code execution failed (non-fatal)\n");
    }
    
    // Find widgets section
    ASTNode* widgets = lgs_find_node(r->parser->root, "widgets");
    if (widgets) {
        if (lgs_render_widgets(r, widgets) != 0) {
            printf("[LGS] Widgets rendering failed\n");
            return -1;
        }
    }
    
    // Render
    r->window->needs_redraw = 1;
    gui_render_frame();
    
    printf("[LGS] Rendering complete\n");
    return 0;
}

int lgs_render(LGSRenderer* r, const char* lgs_file) {
    if (!r || !lgs_file) return -1;
    
    // Read file
    Vector* buf = vector_create(sizeof(uint8_t), 8192);
    if (read_file(lgs_file, buf) != 0) {
        printf("[LGS] Cannot read file: %s\n", lgs_file);
        buf->destroy(buf);
        return -1;
    }
    
    // Convert to string
    char* content = (char*)kmalloc(buf->size + 1);
    for (uint32_t i = 0; i < buf->size; i++) {
        content[i] = *(uint8_t*)buf->at(buf, i);
    }
    content[buf->size] = '\0';
    buf->destroy(buf);
    
    // Render
    int ret = lgs_render_string(r, content);
    kfree(content);
    
    return ret;
}

Window* lgs_get_window(LGSRenderer* r) {
    return r ? r->window : NULL;
}


