// Helper: convert seconds to HH:MM:SS
static void format_time(uint32_t seconds, char* buf) {
    uint32_t hours = (seconds / 3600) % 24;
    uint32_t minutes = (seconds / 60) % 60;
    uint32_t secs = seconds % 60;
    
    // Manual formatting (sprintf not available)
    buf[0] = '0' + (hours / 10);
    buf[1] = '0' + (hours % 10);
    buf[2] = ':';
    buf[3] = '0' + (minutes / 10);
    buf[4] = '0' + (minutes % 10);
    buf[5] = ':';
    buf[6] = '0' + (secs / 10);
    buf[7] = '0' + (secs % 10);
    buf[8] = '\0';
}

