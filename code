void driver_export_kernel_symbol(const char* name, void* addr) {
    DriverSymbol sym;
    sym.name = (char*)kmalloc(strlen(name) + 1);
    if (!sym.name) {
        printf("driver: Out of memory\n");
        return;
    }
    strcpy(sym.name, name);
    sym.addr = addr;
    sym.size = 0;
    sym.is_exported = 1;
    sym.is_imported = 0;
    kernel_symbols->push(kernel_symbols, &sym);
}

                          
static int parse_elf_sections(uint8_t* elf, DriverImage* img) {
    Elf64_Ehdr* ehdr = (Elf64_Ehdr*)elf;
    
                              
    uint64_t shoff = ehdr->e_shoff;
    uint16_t shnum = ehdr->e_shnum;
    uint16_t shentsize = ehdr->e_shentsize;
    
    char* strtab = NULL;
    
                             
    for (int i = 0; i < shnum; i++) {
        Elf64_Shdr* shdr = (Elf64_Shdr*)(elf + shoff + i * shentsize);
        if (shdr->sh_type == SHT_STRTAB && i != ehdr->e_shstrndx) {
            strtab = (char*)(elf + shdr->sh_offset);
            break;
        }
    }
    
                    
    for (int i = 0; i < shnum; i++) {
        Elf64_Shdr* shdr = (Elf64_Shdr*)(elf + shoff + i * shentsize);
        
        if (shdr->sh_type == SHT_PROGBITS && (shdr->sh_flags & SHF_ALLOC)) {
            DriverSection* sec = (DriverSection*)kmalloc(sizeof(DriverSection));
            
            char* name = strtab + shdr->sh_name;
            sec->name = (char*)kmalloc(strlen(name) + 1);
            strcpy(sec->name, name);
            
                                         
            sec->size = shdr->sh_size;
            sec->addr = kmalloc(shdr->sh_size);
            memcpy(sec->addr, elf + shdr->sh_offset, shdr->sh_size);
            
            sec->flags = shdr->sh_flags;
            sec->is_loadable = 1;
            
            img->sections->push(img->sections, &sec);
        }
    }
    
    return 0;
}

                               
static int parse_elf_symbols(uint8_t* elf, DriverImage* img) {
    Elf64_Ehdr* ehdr = (Elf64_Ehdr*)elf;
    uint64_t shoff = ehdr->e_shoff;
    uint16_t shnum = ehdr->e_shnum;
    uint16_t shentsize = ehdr->e_shentsize;
    
    Elf64_Shdr* symtab = NULL;
    Elf64_Shdr* strtab = NULL;
    
                            
    for (int i = 0; i < shnum; i++) {
        Elf64_Shdr* shdr = (Elf64_Shdr*)(elf + shoff + i * shentsize);
        if (shdr->sh_type == SHT_SYMTAB) {
            symtab = shdr;
        }
        if (shdr->sh_type == SHT_STRTAB && symtab && i > 0) {
            strtab = shdr;
        }
    }
    
    if (!symtab || !strtab) return -1;
    
    Elf64_Sym* syms = (Elf64_Sym*)(elf + symtab->sh_offset);
    int sym_count = symtab->sh_size / sizeof(Elf64_Sym);
    char* strtab_data = (char*)(elf + strtab->sh_offset);
    
    for (int i = 0; i < sym_count; i++) {
        Elf64_Sym* sym = &syms[i];
        uint8_t type = ELF64_ST_TYPE(sym->st_info);
        uint8_t bind = ELF64_ST_BIND(sym->st_info);
        
        if (type != STT_FUNC && type != STT_OBJECT) continue;
        
        DriverSymbol* dsym = (DriverSymbol*)kmalloc(sizeof(DriverSymbol));
        if (!dsym) continue;
        dsym->name = (char*)kmalloc(strlen(strtab_data + sym->st_name) + 1);
        if (!dsym->name) {
            kfree(dsym);
            continue;
        }
        strcpy(dsym->name, strtab_data + sym->st_name);
        dsym->size = sym->st_size;
        dsym->is_exported = (bind == STB_GLOBAL);
        dsym->is_imported = (sym->st_shndx == SHN_UNDEF);
        
                          
        if (!dsym->is_imported) {
                             
            Elf64_Shdr* sec = (Elf64_Shdr*)(elf + shoff + sym->st_shndx * shentsize);
                                         
            for (uint32_t j = 0; j < img->sections->size; j++) {
                DriverSection** sec_ptr = (DriverSection**)img->sections->at(img->sections, j);
                if (strcmp((*sec_ptr)->name, strtab_data + sec->sh_name) == 0) {
                    dsym->addr = (*sec_ptr)->addr + sym->st_value;
                    break;
                }
            }
        } else {
            dsym->addr = NULL;
        }
        
        img->symbols->push(img->symbols, &dsym);
    }
    
    return 0;
}

                                   
static int resolve_relocations(uint8_t* elf, DriverImage* img) {
    Elf64_Ehdr* ehdr = (Elf64_Ehdr*)elf;
    uint64_t shoff = ehdr->e_shoff;
    uint16_t shnum = ehdr->e_shnum;
    uint16_t shentsize = ehdr->e_shentsize;
    
                                             
    char* strtab = NULL;
    Elf64_Shdr* symtab_hdr = NULL;
    
    for (int i = 0; i < shnum; i++) {
        Elf64_Shdr* shdr = (Elf64_Shdr*)(elf + shoff + i * shentsize);
        if (shdr->sh_type == SHT_SYMTAB) {
            symtab_hdr = shdr;
        }
        if (shdr->sh_type == SHT_STRTAB && symtab_hdr) {
            strtab = (char*)(elf + shdr->sh_offset);
        }
    }
    
    if (!symtab_hdr || !strtab) return -1;
    
    Elf64_Sym* symtab = (Elf64_Sym*)(elf + symtab_hdr->sh_offset);
    int sym_count = symtab_hdr->sh_size / sizeof(Elf64_Sym);
    
    for (int i = 0; i < shnum; i++) {
        Elf64_Shdr* shdr = (Elf64_Shdr*)(elf + shoff + i * shentsize);
        if (shdr->sh_type != SHT_RELA) continue;
        
        Elf64_Rela* rel = (Elf64_Rela*)(elf + shdr->sh_offset);
        int rel_count = shdr->sh_size / sizeof(Elf64_Rela);
        
        for (int j = 0; j < rel_count; j++) {
            Elf64_Rela* r = &rel[j];
            int sym_idx = ELF64_R_SYM(r->r_info);
            Elf64_Sym* sym = &symtab[sym_idx];
            char* name = strtab + sym->st_name;
            
                               
            void* sym_addr = driver_resolve_symbol(name);
            if (!sym_addr) {
                printf("Driver: Unresolved symbol: %s\n", name);
                return -1;
            }
            
                                     
            Elf64_Shdr* target_sec = (Elf64_Shdr*)(elf + shoff + shdr->sh_info * shentsize);
            
                                         
            void* target_addr = NULL;
            for (uint32_t k = 0; k < img->sections->size; k++) {
                DriverSection** sec_ptr = (DriverSection**)img->sections->at(img->sections, k);
                                      
                char* sec_name = (char*)(elf + shoff + target_sec->sh_name);
                if (strcmp((*sec_ptr)->name, sec_name) == 0) {
                    target_addr = (*sec_ptr)->addr;
                    break;
                }
            }
            
            if (!target_addr) {
                printf("Driver: Target section not found\n");
                return -1;
            }
            
                                  
            uint64_t* addr = (uint64_t*)(target_addr + r->r_offset);
            *addr = (uint64_t)sym_addr + r->r_addend;
        }
    }
    
    return 0;
}

                           
void* driver_load_elf(const char* path) {
    #ifdef DEBUG_DRIVER_LOADER
    printf("Loading ELF: %s\n", path);
    #endif
                     
    Vector* content = vector_create(sizeof(uint8_t), 256);
    int size = read_file(path, content);
    if (size <= 0) {
        printf("Cannot read file!\n");
        content->destroy(content);
        return NULL;
    }
    
    uint8_t* elf = content->data;

    if (size < (int)sizeof(Elf64_Ehdr)) {
        printf("Driver: ELF header truncated\n");
        content->destroy(content);
        return NULL;
    }
    
                       
    if (elf[0] != 0x7F || elf[1] != 'E' || elf[2] != 'L' || elf[3] != 'F') {
        printf("Not ELF!\n");
        content->destroy(content);
        return NULL;
    }
    
    Elf64_Ehdr* ehdr = (Elf64_Ehdr*)elf;
    if (ehdr->e_machine != 62) {             
        printf("Not x86_64!\n");
        content->destroy(content);
        return NULL;
    }
    if (ehdr->e_shentsize < sizeof(Elf64_Shdr) || ehdr->e_shnum == 0 ||
        ehdr->e_shoff > (uint64_t)size ||
        ehdr->e_shnum > ((uint64_t)size - ehdr->e_shoff) / ehdr->e_shentsize ||
        ehdr->e_shstrndx >= ehdr->e_shnum) {
        printf("Driver: invalid ELF section table\n");
        content->destroy(content);
        return NULL;
    }
    
                       
    DriverImage* img = (DriverImage*)kmalloc(sizeof(DriverImage));
    if (!img) {
        printf("driver: Out of memory\n");
        content->destroy(content);
        return NULL;
    }
    memset(img, 0, sizeof(DriverImage));
    img->sections = vector_create(sizeof(DriverSection*), 8);
    img->symbols = vector_create(sizeof(DriverSymbol*), 16);
    img->loaded = 0;
    img->ref_count = 0;
    
                       
    if (parse_elf_sections(elf, img) != 0) {
        printf("Failed to parse sections!\n");
        goto cleanup;
    }
    
                        
    if (parse_elf_symbols(elf, img) != 0) {
        printf("Failed to parse symbols!\n");
        goto cleanup;
    }
    
                             
    if (resolve_relocations(elf, img) != 0) {
        printf("Failed to resolve relocations!\n");
        goto cleanup;
    }
    
                             
    img->entry_point = ehdr->e_entry;
    if (img->sections->size > 0) {
        DriverSection** first_sec = (DriverSection**)img->sections->at(img->sections, 0);
        img->base_addr = (*first_sec)->addr;
    } else {
        img->base_addr = NULL;
    }
    img->loaded = 1;
    
                            
    loaded_images->push(loaded_images, &img);
    
    content->destroy(content);
    #ifdef DEBUG_DRIVER_LOADER
    printf("ELF loaded: %s (size=%d, entry=0x%p)\n", path, size, img->entry_point);
    #endif

    return (void*)img;

cleanup:
    content->destroy(content);
                           
    return NULL;
}

                           
int driver_unload_elf(void* handle) {
    DriverImage* img = (DriverImage*)handle;
    if (!img) return -1;
    
    if (img->ref_count > 0) {
        printf("Driver is in use (ref_count=%d)\n", img->ref_count);
        return -1;
    }
    
                         
    for (uint32_t i = 0; i < img->sections->size; i++) {
        DriverSection** sec_ptr = (DriverSection**)img->sections->at(img->sections, i);
        if ((*sec_ptr)->addr) kfree((*sec_ptr)->addr);
        if ((*sec_ptr)->name) kfree((*sec_ptr)->name);
        kfree(*sec_ptr);
    }
    img->sections->destroy(img->sections);
    
                          
    for (uint32_t i = 0; i < img->symbols->size; i++) {
        DriverSymbol** sym_ptr = (DriverSymbol**)img->symbols->at(img->symbols, i);
        if ((*sym_ptr)->name) kfree((*sym_ptr)->name);
        kfree(*sym_ptr);
    }
    img->symbols->destroy(img->symbols);
    
    kfree(img);
    return 0;
}

                                 
void* driver_resolve_symbol(const char* name) {
                     
    for (uint32_t i = 0; i < kernel_symbols->size; i++) {
        DriverSymbol* sym = (DriverSymbol*)kernel_symbols->at(kernel_symbols, i);
        if (strcmp(sym->name, name) == 0) {
            return sym->addr;
        }
    }
    
                                      
    for (uint32_t i = 0; i < loaded_images->size; i++) {
        DriverImage** img_ptr = (DriverImage**)loaded_images->at(loaded_images, i);
        DriverImage* img = *img_ptr;
        
        for (uint32_t j = 0; j < img->symbols->size; j++) {
            DriverSymbol** sym_ptr = (DriverSymbol**)img->symbols->at(img->symbols, j);
            DriverSymbol* sym = *sym_ptr;
            if (sym->is_exported && strcmp(sym->name, name) == 0) {
                return sym->addr;
            }
        }
    }
    
    return NULL;
}

void* driver_image_symbol(void* handle, const char* name) {
    DriverImage* image = (DriverImage*)handle;
    if (!image || !name) return NULL;
    for (uint32_t i = 0; i < image->symbols->size; i++) {
        DriverSymbol** item = (DriverSymbol**)image->symbols->at(image->symbols, i);
        if (item && *item && (*item)->is_exported && strcmp((*item)->name, name) == 0) {
            return (*item)->addr;
        }
    }
    return NULL;
}

