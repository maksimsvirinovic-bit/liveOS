// Configuration management
int desktop_load_config(Desktop* d, const char* config_file) {
    if (!d || !config_file) return -1;
    
    printf("[Desktop] Loading config from %s\n", config_file);
    
    // Read config file
    Vector* buf = vector_create(sizeof(uint8_t), 2048);
    if (read_file(config_file, buf) != 0) {
        printf("[Desktop] Config file not found, using defaults\n");
        buf->destroy(buf);
        return 0;
    }
    
    // Parse simple key=value format
    char line[256];
    uint32_t line_idx = 0;
    
    for (uint32_t i = 0; i < buf->size; i++) {
        uint8_t c = *(uint8_t*)buf->at(buf, i);
        
        if (c == '\n' || i == buf->size - 1) {
            if (i == buf->size - 1 && c != '\n') line[line_idx++] = c;
            line[line_idx] = '\0';
            
            // Parse line
            char* eq = strchr(line, '=');
            if (eq) {
                *eq = '\0';
                char* key = line;
                char* val = eq + 1;
                
                if (strcmp(key, "wallpaper") == 0) {
                    strcpy(d->config.wallpaper_path, val);
                } else if (strcmp(key, "theme") == 0) {
                    strcpy(d->config.theme_name, val);
                } else if (strcmp(key, "taskbar_height") == 0) {
                    d->config.taskbar_height = atoi(val);
                } else if (strcmp(key, "show_icons") == 0) {
                    d->config.show_icons = (val[0] == '1') ? 1 : 0;
                }
            }
            
            line_idx = 0;
        } else {
            if (line_idx < 255) line[line_idx++] = c;
        }
    }
    
    buf->destroy(buf);
    printf("[Desktop] Config loaded\n");
    return 0;
}

