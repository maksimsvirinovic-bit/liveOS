static int text_equal(const char* left, const char* right) {
    while (*left && *left == *right) {
        left++;
        right++;
    }
    return *left == *right;
}

int main(const KernelApi* api, int argc, char** argv) {
    if (!api || api->version < KERNEL_API_VERSION || argc < 2) {
        if (api) api->printf("Usage: lpi <update|install|remove|search|list|info> [arg]\n");
        return 1;
    }

    if (text_equal(argv[1], "update")) return api->lpi_update();
    if (text_equal(argv[1], "list")) {
        api->lpi_list();
        return 0;
    }
    if (argc < 3) {
        api->printf("lpi: missing argument\n");
        return 1;
    }
    if (text_equal(argv[1], "install")) return api->lpi_install(argv[2]);
    if (text_equal(argv[1], "remove")) return api->lpi_remove(argv[2]);
    if (text_equal(argv[1], "search")) return api->lpi_search(argv[2]);
    if (text_equal(argv[1], "info")) {
        api->lpi_info(argv[2]);
        return 0;
    }

    api->printf("lpi: unknown command\n");
