static uint16_t tcp_allocate_ephemeral_port(void) {
    uint16_t port = tcp_next_ephemeral_port++;
    if (tcp_next_ephemeral_port < 49152) {
        tcp_next_ephemeral_port = 49152;
    }
    return port;
}

                                          
                                              
static uint16_t tcp_checksum(uint32_t src_ip, uint32_t dst_ip, 
                             uint8_t* data, uint16_t len) {
    uint32_t sum = 0;
    
                                           
    src_ip = htonl(src_ip);
    dst_ip = htonl(dst_ip);
    
                              
                                    
    sum += (src_ip >> 16) & 0xFFFF;
    sum += src_ip & 0xFFFF;
    sum += (dst_ip >> 16) & 0xFFFF;
    sum += dst_ip & 0xFFFF;
    sum += htons(6);                       
    sum += htons(len);                 
    
                         
    uint16_t* ptr = (uint16_t*)data;
    while (len > 1) {
        sum += *ptr++;
        len -= 2;
    }
    
                          
    if (len) {
        sum += *(uint8_t*)ptr << 8;
    }
    
           
    while (sum >> 16) {
        sum = (sum & 0xFFFF) + (sum >> 16);
    }
    
    return (uint16_t)(~sum);
}

                                        
