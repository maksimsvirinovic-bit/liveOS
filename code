static int read_cluster(uint32_t cluster, uint8_t* buffer) {
    if (cluster < 2) {
        print("ERROR: Invalid cluster ");
        print_int(cluster);
        putc('\n');
        return -1;
    }
    
    uint32_t lba = data_start + (cluster - 2) * sectors_per_cluster;
    
    for (uint32_t i = 0; i < sectors_per_cluster; i++) {
        int ret = ata_read_sector(ATA_PRIMARY_DATA, 0, lba + i, 
                                  buffer + i * bytes_per_sector);
        if (ret != 0) {
            print("ATA read error at LBA ");
            print_int(lba + i);
            putc('\n');
            return -1;
        }
    }
    return 0;
}

static int write_cluster(uint32_t cluster, const uint8_t* buffer) {
    if (cluster < 2) {
        print("ERROR: Invalid cluster ");
        print_int(cluster);
        putc('\n');
        return -1;
    }
    
    uint32_t lba = data_start + (cluster - 2) * sectors_per_cluster;
    
    for (uint32_t i = 0; i < sectors_per_cluster; i++) {
        int ret = ata_write_sector(ATA_PRIMARY_DATA, 0, lba + i,
                                   buffer + i * bytes_per_sector);
        if (ret != 0) {
            print("ATA write error at LBA ");
            print_int(lba + i);
            putc('\n');
            return -1;
        }
    }
    return 0;
}

                    
static uint32_t read_fat(uint32_t cluster) {
    uint32_t fat_offset = cluster * 4;                      
    uint32_t fat_sector = fat_start + (fat_offset / bytes_per_sector);
    uint32_t ent_offset = fat_offset % bytes_per_sector;
    
    if (ata_read_sector(ATA_PRIMARY_DATA, 0, fat_sector, fat_buf) != 0) {
        return 0x0FFFFFF7;           
    }
    
    uint32_t val = *(uint32_t*)(fat_buf + ent_offset) & 0x0FFFFFFF;
    return val;
}

                    
static int write_fat(uint32_t cluster, uint32_t value) {
    uint32_t fat_offset = cluster * 4;
    uint32_t fat_sector = fat_start + (fat_offset / bytes_per_sector);
    uint32_t ent_offset = fat_offset % bytes_per_sector;
    
    if (ata_read_sector(ATA_PRIMARY_DATA, 0, fat_sector, fat_buf) != 0) {
        return -1;
    }
    
    *(uint32_t*)(fat_buf + ent_offset) = (*(uint32_t*)(fat_buf + ent_offset) & 0xF0000000) | (value & 0x0FFFFFFF);
    
    if (ata_write_sector(ATA_PRIMARY_DATA, 0, fat_sector, fat_buf) != 0) {
        return -1;
    }
    
    return 0;
}

static uint32_t find_free_cluster(void) {
    uint32_t total_clusters = total_sectors / sectors_per_cluster;
    
    for (uint32_t i = 3; i < total_clusters; i++) {
        uint32_t val = read_fat(i);
        if (val == 0) {
            uint8_t zero[4096];
            memset(zero, 0, 4096);
            write_cluster(i, zero);

            return i;
        }
    }
    
    print("No free clusters!\n");
    return 0;
}

static void name_to_83(const char* name, uint8_t* dest) {
                          
    for (int i = 0; i < 11; i++) dest[i] = ' ';
    
                                     
    if (strcmp(name, ".") == 0) {
        dest[0] = '.';
        return;
    }
    if (strcmp(name, "..") == 0) {
        dest[0] = '.';
        dest[1] = '.';
        return;
    }
    
                              
    const char* dot = strchr(name, '.');
    int name_len = dot ? (dot - name) : strlen(name);
    int ext_len = dot ? strlen(dot + 1) : 0;
    
                          
    for (int i = 0; i < name_len && i < 8; i++) {
        if (name[i] >= 'a' && name[i] <= 'z') {
            dest[i] = name[i] - 'a' + 'A';
        } else {
            dest[i] = name[i];
        }
    }
    
                                 
    if (dot && ext_len > 0) {
        for (int i = 0; i < ext_len && i < 3; i++) {
            if (dot[i+1] >= 'a' && dot[i+1] <= 'z') {
                dest[8+i] = dot[i+1] - 'a' + 'A';
            } else {
                dest[8+i] = dot[i+1];
            }
        }
    }
}

static int resolve_path(const char* path, char* name_out, uint32_t* saved_dir) {
    if (!path || path[0] == '\0') return -1;
    
                                   
    *saved_dir = current_dir_cluster;
    
                                
    char temp[256];
    int len = strlen(path);
    for (int i = 0; i < len && i < 255; i++) temp[i] = path[i];
    temp[len] = '\0';
    
                            
    int last_slash = -1;
    for (int i = len - 1; i >= 0; i--) {
        if (temp[i] == '/') {
            last_slash = i;
            break;
        }
    }
    
    if (last_slash >= 0) {
                                          
        temp[last_slash] = '\0';                           
        char* dir_path = temp;
        char* file_name = temp + last_slash + 1;
        
                       
        int name_len = strlen(file_name);
        for (int i = 0; i < name_len && i < 255; i++) name_out[i] = file_name[i];
        name_out[name_len] = '\0';
        
                                 
        if (dir_path[0] != '\0') {
            if (fat32_change_dir(dir_path) != 0) {
                current_dir_cluster = *saved_dir;                 
                return -1;
            }
        }
    } else {
                                                          
        int name_len = strlen(temp);
        for (int i = 0; i < name_len && i < 255; i++) name_out[i] = temp[i];
        name_out[name_len] = '\0';
    }
    
    return 0;
}

                            
int fat32_init(void) {
    print("FAT32: Initializing...\n");

    if (fat_initialized){
        print("FAT32 already initialized!");
        return -1;
    }
    
                         
    if (ata_read_sector(ATA_PRIMARY_DATA, 0, 0, (uint8_t*)&boot) != 0) {
        print("FAT32: Cannot read boot sector!\n");
        return -1;
    }
    
                          
    if (boot.magic != 0xAA55) {
        print("FAT32: Invalid boot signature!\n");
        return -1;
    }
    
    bytes_per_sector = boot.bytes_per_sector;
    sectors_per_cluster = boot.sectors_per_cluster;
    total_sectors = (boot.total_sectors_16 != 0) ? 
                     boot.total_sectors_16 : boot.total_sectors_32;
    fat_start = boot.reserved_sectors;
    data_start = fat_start + boot.num_fats * boot.sectors_per_fat_32;
    root_cluster = boot.root_cluster;
    
    fat_initialized = 1;
    
    print("FAT32: Ready\n");
    print("  Sectors: "); print_int(total_sectors); putc('\n');
    print("  Cluster size: "); print_int(bytes_per_sector * sectors_per_cluster / 1024); print(" KB\n");
    
    return 0;
}

                             
int fat32_format(FormatOptions* opts) {
    print("FAT32: Formatting");
    if (opts->quick) print(" (quick)");
    if (opts->full) print(" (full)");
    print("\n");
    
    total_sectors = ata_get_total_sectors();
    if (total_sectors == 0) {
        print("ERROR: Cannot get disk size!\n");
        return -1;
    }
    
                          
    uint16_t bps = opts->has_bps ? opts->bytes_per_sector : 512;
    uint8_t spc = opts->has_spc ? opts->sectors_per_cluster : 8;
    
    uint32_t total_clusters = total_sectors / spc;
    uint32_t fat_size = (total_clusters * 4 + bps - 1) / bps;
    
                            
    memset(&boot, 0, sizeof(boot));
    boot.jmp[0] = 0xEB; boot.jmp[1] = 0x58; boot.jmp[2] = 0x90;
    memcpy(boot.oem, "LIVEOS  ", 8);
    boot.bytes_per_sector = bps;
    boot.sectors_per_cluster = spc;
    boot.reserved_sectors = 32;
    boot.num_fats = 2;
    boot.total_sectors_16 = (total_sectors < 65536) ? total_sectors : 0;
    boot.total_sectors_32 = total_sectors;
    boot.media_type = 0xF8;
    boot.sectors_per_track = 63;
    boot.num_heads = 255;
    boot.sectors_per_fat_32 = fat_size;
    boot.root_cluster = 2;
    boot.fs_info = 1;
    boot.backup_boot = 6;
    boot.drive_number = 0x80;
    boot.boot_signature = 0x29;
    boot.volume_id = opts->has_volid ? opts->volume_id : 0x12345678;
    
            
    if (opts->has_label) {
        memset(boot.volume_label, ' ', 11);
        int len = strlen(opts->label);
        if (len > 11) len = 11;
        for (int i = 0; i < len; i++) {
            boot.volume_label[i] = (opts->label[i] >= 'a' && opts->label[i] <= 'z') ?
                                    opts->label[i] - 'a' + 'A' : opts->label[i];
        }
    } else {
        memset(boot.volume_label, ' ', 11);
        memcpy(boot.volume_label, "LIVEOS     ", 11);
    }
    
    memcpy(boot.fs_type, "FAT32   ", 8);
    boot.magic = 0xAA55;
    
                               
    ata_write_sector(ATA_PRIMARY_DATA, 0, 0, (uint8_t*)&boot);
    ata_write_sector(ATA_PRIMARY_DATA, 0, 6, (uint8_t*)&boot);
    
             
    uint8_t fsinfo[512];
    memset(fsinfo, 0, 512);
    fsinfo[0] = 0x52; fsinfo[1] = 0x52; fsinfo[2] = 0x61; fsinfo[3] = 0x41;
    *(uint32_t*)(fsinfo + 488) = total_clusters - 3;
    *(uint32_t*)(fsinfo + 492) = 3;
    fsinfo[508] = 0x72; fsinfo[509] = 0x72; fsinfo[510] = 0x41; fsinfo[511] = 0x61;
    ata_write_sector(ATA_PRIMARY_DATA, 0, 1, fsinfo);
    
                  
    memset(fat_buf, 0, 512);
    for (uint32_t i = 0; i < fat_size * 2; i++) {
        ata_write_sector(ATA_PRIMARY_DATA, 0, 32 + i, fat_buf);
    }
    
    write_fat(0, 0x0FFFFFF8);
    write_fat(1, 0x0FFFFFF8);
    write_fat(2, 0x0FFFFFF8);
    
                   
    memset(cluster_buf, 0, 4096);
    write_cluster(2, cluster_buf);
    
                                                     
                         
    if (opts->full) {
        print("  Clearing data clusters...\n");
        print("  Press ESC to cancel\n");
        
        uint8_t zero[4096];
        memset(zero, 0, 4096);
        
        uint32_t total = total_clusters;
        uint32_t last_percent = 0;
        
        for (uint32_t c = 3; c < total; c++) {
            write_cluster(c, zero);
            
                       
            uint32_t percent = (c - 3) * 100 / (total - 3);
            if (percent != last_percent) {
                last_percent = percent;
                
                                                    
                clear_line();
                
                print_int(percent);
                print("% (");
                print_int(c);
                print("/");
                print_int(total);
                print(")");
            }
            
                                           
            if (kbhit()) {
                char c = getchar();
                if (c == 27) {        
                    print("\n  Cancelled!\n");
                    break;
                }
            }
        }
        print("\n");
    }
    
    fat_initialized = 1;
    print("FAT32: Format complete\n");
    print("  Label: ");
    for (int i = 0; i < 11; i++) putc(boot.volume_label[i]);
    print("\n  Cluster size: ");
    print_int(bps * spc / 1024);
    print(" KB\n");
    print("  Volume ID: ");
    print_hex(boot.volume_id);
    putc('\n');
    
    return 0;
}

                             
int fat32_create_file(const char* path) {
    if (!fat_initialized) return -1;

    char name[256];
    uint32_t saved_dir;
    if (resolve_path(path, name, &saved_dir) != 0) return -1;
                                                 
    uint8_t name_83[11];
    name_to_83(name, name_83);
    
                              
    uint8_t dir_buf[4096];
    if (read_cluster(current_dir_cluster, dir_buf) != 0) {
        print("ERROR: Cannot read root!\n");
        return -1;
    }
    
    FAT32DirEntry* entries = (FAT32DirEntry*)dir_buf;
    
                                   
    for (int i = 0; i < 16; i++) {
        if (entries[i].name[0] == 0x00) break;                 
        if (entries[i].name[0] == 0xE5) continue;              
        if (entries[i].attributes == FAT32_ATTR_LONG_NAME) continue;
        
        if (memcmp(entries[i].name, name_83, 11) == 0) {
            print("File already exists!\n");
            return -1;
        }
    }
    
                                
    uint32_t cluster = find_free_cluster();
    if (cluster == 0) {
        print("FAT32: No free clusters!\n");
        return -1;
    }
    
                                        
    write_fat(cluster, 0x0FFFFFF8);
    
                                       
    int free_entry = -1;
    for (int i = 0; i < 16; i++) {
        if (entries[i].name[0] == 0x00 || entries[i].name[0] == 0xE5) {
            free_entry = i;
            break;
        }
    }
    
    if (free_entry < 0) {
        print("Directory full!\n");
        return -1;
    }
    
                     
    memset(&entries[free_entry], 0, sizeof(FAT32DirEntry));
    memcpy(entries[free_entry].name, name_83, 11);
    entries[free_entry].attributes = FAT32_ATTR_ARCHIVE;
    entries[free_entry].cluster_low = cluster & 0xFFFF;
    entries[free_entry].cluster_high = (cluster >> 16) & 0xFFFF;
    entries[free_entry].file_size = 0;
    
                                 
    if (write_cluster(current_dir_cluster, dir_buf) != 0) {
        print("ERROR: Cannot write root!\n");
        return -1;
    }

    restore_dir(saved_dir);
    
    return 0;
}

int fat32_create_dir(const char* path) {
    if (!fat_initialized) return -1;

    char name[256];
    uint32_t saved_dir;
    if (resolve_path(path, name, &saved_dir) != 0) return -1;
    
    uint8_t name_83[11];
    name_to_83(name, name_83);
    
    uint8_t dir_buf[4096];
    read_cluster(current_dir_cluster, dir_buf);
    FAT32DirEntry* entries = (FAT32DirEntry*)dir_buf;
    
                          
    for (int i = 0; i < 16; i++) {
        if (entries[i].name[0] == 0x00) break;
        if (memcmp(entries[i].name, name_83, 11) == 0) {
            print("Already exists!\n");
            return -1;
        }
    }
    
                       
    uint32_t cluster = find_free_cluster();
    if (cluster == 0) return -1;
    
    write_fat(cluster, 0x0FFFFFF8);
    
                            
    uint8_t sub_dir[4096];
    for (int i = 0; i < 4096; i++) sub_dir[i] = 0;
    
    FAT32DirEntry* sub_entries = (FAT32DirEntry*)sub_dir;
    
                               
    name_to_83(".", sub_entries[0].name);
    sub_entries[0].attributes = FAT32_ATTR_DIRECTORY;
    sub_entries[0].cluster_low = cluster & 0xFFFF;
    sub_entries[0].cluster_high = (cluster >> 16) & 0xFFFF;
    
                                     
    name_to_83("..", sub_entries[1].name);
    sub_entries[1].attributes = FAT32_ATTR_DIRECTORY;
    sub_entries[1].cluster_low = current_dir_cluster & 0xFFFF;
    sub_entries[1].cluster_high = (current_dir_cluster >> 16) & 0xFFFF;
    
    write_cluster(cluster, sub_dir);
    
                                            
    int free_entry = -1;
    for (int i = 0; i < 16; i++) {
        if (entries[i].name[0] == 0x00 || entries[i].name[0] == 0xE5) {
            free_entry = i;
            break;
        }
    }
    
    if (free_entry < 0) return -1;
    
    for (int i = 0; i < 32; i++) ((uint8_t*)&entries[free_entry])[i] = 0;
    for (int i = 0; i < 11; i++) entries[free_entry].name[i] = name_83[i];
    entries[free_entry].attributes = FAT32_ATTR_DIRECTORY;
    entries[free_entry].cluster_low = cluster & 0xFFFF;
    entries[free_entry].cluster_high = (cluster >> 16) & 0xFFFF;
    
    write_cluster(current_dir_cluster, dir_buf);
    
    restore_dir(saved_dir);

    return 0;
}

                             
int fat32_delete_file(const char* path) {
    if (!fat_initialized) return -1;

    if (strcmp(path, ".") == 0 || strcmp(path, "..") == 0) {
        print("Cannot delete . or ..\n");
        return -1;
    }

    char name[256];
    uint32_t saved_dir;
    if (resolve_path(path, name, &saved_dir) != 0) return -1;
    
    uint8_t name_83[11];
    name_to_83(name, name_83);
    
                              
    uint8_t dir_buf[4096];
    if (read_cluster(current_dir_cluster, dir_buf) != 0) return -1;
    
    FAT32DirEntry* entries = (FAT32DirEntry*)dir_buf;
    
                
    for (int i = 0; i < 16; i++) {
        if (entries[i].name[0] == 0x00) break;
        if (entries[i].name[0] == 0xE5) continue;
        if (entries[i].attributes & FAT32_ATTR_DIRECTORY) continue;
        
        if (memcmp(entries[i].name, name_83, 11) == 0) {
                                   
            uint32_t cluster = entries[i].cluster_low | 
                              (entries[i].cluster_high << 16);
            
            while (cluster != 0 && cluster < 0x0FFFFFF8) {
                uint32_t next = read_fat(cluster);
                write_fat(cluster, 0);                
                cluster = next;
            }
            
                                            
            entries[i].name[0] = 0xE5;
            
                                         
            write_cluster(current_dir_cluster, dir_buf);
            restore_dir(saved_dir);
            return 0;
        }
    }
    
    print("File not found!\n");
    restore_dir(saved_dir);
    return -1;
}

int fat32_delete_dir(const char* path) {
    if (!fat_initialized) return -1;
    
                              
    if (strcmp(path, ".") == 0 || strcmp(path, "..") == 0) {
        print("Cannot delete . or ..\n");
        return -1;
    }

    char name[256];
    uint32_t saved_dir;
    if (resolve_path(path, name, &saved_dir) != 0) return -1;
    
    uint8_t name_83[11];
    name_to_83(name, name_83);
    
    uint8_t dir_buf[4096];
    if (read_cluster(current_dir_cluster, dir_buf) != 0) return -1;
    
    FAT32DirEntry* entries = (FAT32DirEntry*)dir_buf;
    
    for (int i = 0; i < 16; i++) {
        if (entries[i].name[0] == 0x00) break;
        if (entries[i].name[0] == 0xE5) continue;
        if (!(entries[i].attributes & FAT32_ATTR_DIRECTORY)) continue;
        
        if (memcmp(entries[i].name, name_83, 11) == 0) {
            uint32_t cluster = entries[i].cluster_low | 
                              (entries[i].cluster_high << 16);
            
                                         
            uint8_t sub_dir[4096];
            if (read_cluster(cluster, sub_dir) != 0) return -1;
            
            FAT32DirEntry* sub = (FAT32DirEntry*)sub_dir;
            int is_empty = 1;
            
            for (int j = 0; j < 16; j++) {
                if (sub[j].name[0] == 0x00) break;
                if (sub[j].name[0] == 0xE5) continue;
                
                                                                                  
                if (memcmp(sub[j].name, name_83, 11) == 0) {
                    continue;              
                }

                if (sub[j].name[0] == '.' && sub[j].name[1] == ' '){
                    continue;
                }
                
                                                             
                if (sub[j].name[0] == '.' && sub[j].name[1] == '.' && sub[j].name[2] == ' ') {
                    continue;               
                }
                
                                            
                is_empty = 0;
                break;
            }
            
            if (!is_empty) {
                print("Directory not empty!\n");
                                              
                for (int j = 0; j < 16; j++) {
                    if (sub[j].name[0] == 0x00) break;
                    if (sub[j].name[0] == 0xE5) continue;
                    print("  Contains: '");
                    for (int k = 0; k < 11; k++) {
                        if (sub[j].name[k] >= 32 && sub[j].name[k] < 127) {
                            putc(sub[j].name[k]);
                        } else {
                            putc('?');
                        }
                    }
                    print("'\n");
                }
                return -1;
            }
            
                                   
            while (cluster != 0 && cluster < 0x0FFFFFF8) {
                uint32_t next = read_fat(cluster);
                write_fat(cluster, 0);
                cluster = next;
            }
            
            entries[i].name[0] = 0xE5;
            write_cluster(current_dir_cluster, dir_buf);
            restore_dir(saved_dir);
            return 0;
        }
    }
    restore_dir(saved_dir);
    print("Directory not found!\n");
    return -1;
}

                             
