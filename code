#include "arch/x86_64/gdt.h"
#include "arch/x86_64/tss.h"
#include "drivers/console.h"
#include "lib/str.h"                             
                                           
static uint8_t gdt[8 * 8 + 16] __attribute__((aligned(16)));
static GDTPtr gdt_ptr;
                               
#define GDT8(idx)   ((GDTEntry8*)(gdt + idx * 8))
#define GDT16(idx)  ((GDTEntry16*)(gdt + idx * 8))

void gdt_set_gate8(int index, uint32_t base, uint32_t limit, uint8_t access, uint8_t gran) {
    GDTEntry8* entry = GDT8(index);
    entry->limit_low = limit & 0xFFFF;
    entry->base_low = base & 0xFFFF;
    entry->base_mid = (base >> 16) & 0xFF;
    entry->access = access;
    entry->granularity = (limit >> 16) & 0x0F;
    entry->granularity |= gran & 0xF0;
    entry->base_high = (base >> 24) & 0xFF;
}

void gdt_set_gate16(int index, uint64_t base, uint32_t limit, uint8_t access, uint8_t gran) {
    GDTEntry16* entry = GDT16(index);
    entry->limit_low = limit & 0xFFFF;
    entry->base_low = base & 0xFFFF;
    entry->base_mid = (base >> 16) & 0xFF;
    entry->access = access;
    entry->granularity = (limit >> 16) & 0x0F;
    entry->granularity |= gran & 0xF0;
    entry->base_high = (base >> 24) & 0xFF;
    entry->base_high32 = (base >> 32) & 0xFFFFFFFF;
    entry->reserved = 0;
}

void gdt_init(void) {                             
                 
    gdt_set_gate8(0, 0, 0, 0, 0);
    gdt_set_gate8(1, 0, 0xFFFFFFFF, GDT_ACCESS_PRESENT | GDT_ACCESS_DATA, GDT_GRAN_4KB | GDT_GRAN_32BIT);                  
    gdt_set_gate8(2, 0, 0xFFFFFFFF, GDT_ACCESS_PRESENT | GDT_ACCESS_CODE, GDT_GRAN_4KB | GDT_GRAN_32BIT);
    gdt_set_gate8(3, 0, 0xFFFFFFFF, GDT_ACCESS_PRESENT | GDT_ACCESS_DATA, GDT_GRAN_4KB | GDT_GRAN_32BIT);
    gdt_set_gate8(4, 0, 0xFFFFFFFF, GDT_ACCESS_PRESENT | GDT_ACCESS_CODE, GDT_GRAN_4KB | GDT_GRAN_32BIT);
    gdt_set_gate8(5, 0, 0xFFFFFFFF, GDT_ACCESS_PRESENT | GDT_ACCESS_CODE, GDT_GRAN_4KB | GDT_GRAN_32BIT);
    gdt_set_gate8(6, 0, 0xFFFFFFFF, GDT_ACCESS_PRESENT | GDT_ACCESS_DATA, GDT_GRAN_4KB | GDT_GRAN_32BIT);
    gdt_set_gate8(7, 0, 0xFFFFFFFF, GDT_ACCESS_PRESENT | GDT_ACCESS_CODE, GDT_GRAN_4KB | GDT_GRAN_64BIT);
    gdt_set_gate16(8, 0, 0, 0, 0);
                    
    gdt_ptr.limit = sizeof(gdt) - 1;
    gdt_ptr.base = (uint64_t)(uintptr_t)gdt;
    
    __asm__ volatile("lgdt %0" : : "m"(gdt_ptr) : "memory");
    
    __asm__ volatile(
        "pushq $0x38\n"
        "leaq 1f(%%rip), %%rax\n"
        "pushq %%rax\n"
        "lretq\n"
        "1:\n"
        "movq $0x30, %%rax\n"
        "movq %%rax, %%ds\n"
        "movq %%rax, %%es\n"
        "movq %%rax, %%ss\n"
        : : : "rax", "memory"
    );
    #ifdef DEBUG_GDT
    print("GDT: Loaded (8-byte segments + 16-byte TSS)\n");
    #endif
}

void gdt_set_tss64(void* tss) {
    uint64_t base = (uint64_t)(uintptr_t)tss;
    uint32_t limit = sizeof(TSS) - 1;
                                
    GDTEntry16* entry = GDT16(8);
    entry->limit_low = limit & 0xFFFF;
    entry->base_low = base & 0xFFFF;
    entry->base_mid = (base >> 16) & 0xFF;
    entry->access = GDT_ACCESS_TSS_64;         
    entry->granularity = (limit >> 16) & 0x0F;
    entry->base_high = (base >> 24) & 0xFF;
    entry->base_high32 = (base >> 32) & 0xFFFFFFFF;
    entry->reserved = 0;
                        
    __asm__ volatile("lgdt %0" : : "m"(gdt_ptr) : "memory");
    #ifdef DEBUG_GDT
    print("GDT: TSS64 set at 0x40 (base=0x");
    print_hex(base);
    print(")\n");
    #endif
}

void gdt_dump(void) {
    print("\n=== GDT Dump ===\n");
                                          
    for (int i = 0; i < 8; i++) {
        GDTEntry8* e = GDT8(i);
        uint32_t base = e->base_low | (e->base_mid << 16) | (e->base_high << 24);
        uint32_t limit = e->limit_low | ((e->granularity & 0x0F) << 16);
        
        print("0x");
        print_hex(i * 8);
        print(": base=0x");
        print_hex(base);
        print(" limit=0x");
        print_hex(limit);
        print(" access=0x");
        print_hex(e->access);
        print(" gran=0x");
        print_hex(e->granularity);
        print("\n");
    }
    
                            
    GDTEntry16* e = GDT16(8);
    uint64_t base = e->base_low | (e->base_mid << 16) | (e->base_high << 24) | ((uint64_t)e->base_high32 << 32);
    uint32_t limit = e->limit_low | ((e->granularity & 0x0F) << 16);
    
    print("0x40: TSS64 base=0x");
    print_hex(base);
    print(" limit=0x");
    print_hex(limit);
    print(" access=0x");
    print_hex(e->access);
    print("\n");
    
    print("==================\n");
}

