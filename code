static Vector* vec_str_create(const char* str) {
    Vector* vec = vector_create(sizeof(char), 16);
    if (str) {
        for (int i = 0; str[i]; i++) {
            vec->push(vec, &str[i]);
        }
    }
    char null = '\0';
    vec->push(vec, &null);
    return vec;
}

static char* vec_str_get(Vector* vec) {
    if (!vec || vec->size == 0) return NULL;
    return (char*)vec->data;
}

static int vec_str_cmp(Vector* a, Vector* b) {
    if (!a || !b) return -1;
    char* sa = (char*)a->data;
    char* sb = (char*)b->data;
    return strcmp(sa, sb);
}

static Vector* vec_str_copy(const char* str) {
    return vec_str_create(str);
}

static void vec_str_destroy(Vector* vec) {
    if (vec) vec->destroy(vec);
}

