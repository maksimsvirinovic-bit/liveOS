}

void shell_task(void) {
    char cmd[256];
    shell_script_init();
    while (1) {
        print_prompt();
        shell_readline(cmd, 256);
        
                                               
        if (cmd[0] != '\0') {
            history_add(cmd);
        }

        shell_execute(cmd);
        // Уступаем другим задачам
        task_yield();
    }
}

