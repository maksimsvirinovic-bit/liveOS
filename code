#include "graphics.h"
#include "drivers/console.h"
#include "drivers/input.h"
#include "font8x8.h"
#include "lib/types.h"

static int graphics_ready;

int graphics_init(void) {
    graphics_ready = fb != NULL && w != 0 && h != 0;
    return graphics_ready ? 0 : -1;
}

int graphics_is_ready(void) {
    return graphics_ready;
}

int graphics_width(void) { return (int)w; }
int graphics_height(void) { return (int)h; }

void graphics_clear(uint32_t color) {
    if (!graphics_ready) return;
    for (uint32_t y = 0; y < h; y++) {
        for (uint32_t x = 0; x < w; x++) {
            fb[y * p + x] = color;
        }
    }
}

void graphics_fill_rect(int x, int y, int width, int height, uint32_t color) {
    if (!graphics_ready || width <= 0 || height <= 0) return;
    if (x < 0) { width += x; x = 0; }
    if (y < 0) { height += y; y = 0; }
    if (x + width > (int)w) width = w - x;
    if (y + height > (int)h) height = h - y;
    if (width <= 0 || height <= 0) return;
    for (int row = 0; row < height; row++) {
        for (int col = 0; col < width; col++) {
            fb[(y + row) * p + x + col] = color;
        }
    }
}

void graphics_rect(int x, int y, int width, int height, uint32_t color) {
    if (width < 2 || height < 2) return;
    graphics_fill_rect(x, y, width, 1, color);
    graphics_fill_rect(x, y + height - 1, width, 1, color);
    graphics_fill_rect(x, y, 1, height, color);
    graphics_fill_rect(x + width - 1, y, 1, height, color);
}

void graphics_text(int x, int y, const char* text, uint32_t foreground, uint32_t background) {
    if (!graphics_ready || !text) return;
    while (*text) {
        unsigned char character = (unsigned char)*text++;
        const uint8_t* glyph = font8x8[character];
        for (int row = 0; row < 8; row++) {
            for (int col = 0; col < 8; col++) {
                int px = x + col;
                int py = y + row;
                if (px >= 0 && py >= 0 && px < (int)w && py < (int)h) {
                    fb[py * p + px] = (glyph[row] & (1 << (7 - col))) ? foreground : background;
                }
            }
        }
        x += 8;
        if (x + 8 >= (int)w) { x = 0; y += 8; }
        if (y >= (int)h) break;
    }
}

void graphics_cursor(int x, int y) {
    if (!graphics_ready) return;
    int cursor_width = input_cursor_width();
    int cursor_height = input_cursor_height();
    if (cursor_width <= 0 || cursor_height <= 0) return;
    for (int row = 0; row < cursor_height; row++) {
        for (int col = 0; col < cursor_width; col++) {
            int color = input_cursor_pixel(col, row);
            if (color < 0) continue;
            int px = x + col;
            int py = y + row;
            if (px >= 0 && py >= 0 && px < (int)w && py < (int)h) {
                fb[py * p + px] = (uint32_t)color;
            }
        }
    }
}

