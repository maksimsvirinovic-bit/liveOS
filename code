#include "logging.h"
#include "console.h"
#include "str.h"
#include "fs.h"
#include "../core/system_config.h"

LoggerConfig logger;

static char log_buffer[1024];
static int log_pos = 0;

void logger_init(void) {
    logger.log_level = LOG_DEBUG;
    logger.use_colors = 1;
    logger.error_color = COLOR_RED;
    logger.warn_color = COLOR_YELLOW;
    logger.info_color = COLOR_GREEN;
    logger.debug_color = COLOR_GRAY;
    logger.show_timestamp = 0;
    logger.show_prefix = 1;
    logger.log_to_file = 0;
    strcpy(logger.log_file, "/.liveos.log");
    if (system_config.debug_level >= LOG_NONE && system_config.debug_level <= LOG_DEBUG) {
        logger.log_level = system_config.debug_level;
    }
}

                                       
void logger_apply(const LoggerConfig* cfg) {
    if (!cfg) return;
    logger = *cfg;
}

                                       
void logger_config(int first_option, ...) {
    va_list args;
    va_start(args, first_option);
    
    int value = first_option;
    
    while (1) {
        int type = va_arg(args, int);
        
        switch (type) {
            case LOG_LEVEL_SET:
                logger.log_level = value;
                break;
                
            case LOG_COLORS_SET:
                logger.use_colors = value;
                break;
                
            case LOG_PREFIX_SET:
                logger.show_prefix = value;
                break;
                
            case LOG_TIMESTAMP_SET:
                logger.show_timestamp = value;
                break;
                
            case LOG_FILE_SET: {
                const char* path = (const char*)(uint64_t)value;
                strcpy(logger.log_file, path);
                logger.log_to_file = 1;
                break;
            }
                
            case LOG_ERROR_COLOR_SET:
                logger.error_color = (uint32_t)value;
                break;
                
            case LOG_WARN_COLOR_SET:
                logger.warn_color = (uint32_t)value;
                break;
                
            case LOG_INFO_COLOR_SET:
                logger.info_color = (uint32_t)value;
                break;
                
            case LOG_DEBUG_COLOR_SET:
                logger.debug_color = (uint32_t)value;
                break;
                
            default:
                va_end(args);
                return;
        }
        
        value = va_arg(args, int);
    }
}

                   
static void log_buf_reset(void) { log_pos = 0; }
static void log_buf_char(char c) { if (log_pos < 1023) log_buffer[log_pos++] = c; }
static void log_buf_str(const char* s) { while (*s && log_pos < 1023) log_buffer[log_pos++] = *s++; }
static void log_buf_int(int v) {
    if (v < 0) { log_buf_char('-'); v = -v; }
    if (v >= 10) log_buf_int(v / 10);
    log_buf_char('0' + v % 10);
}
static void log_buf_hex(uint64_t v) {
    log_buf_str("0x");
    char hex[17];
    int pos = 0;
    for (int i = 60; i >= 0; i -= 4) {
        int d = (v >> i) & 0xF;
        hex[pos++] = d < 10 ? '0' + d : 'A' + d - 10;
    }
    hex[pos] = '\0';
    log_buf_str(hex);
}

                
static void log_to_file(const char* text) {
    if (!logger.log_to_file) return;
    
                         
    Vector* old_vec = vector_create(sizeof(uint8_t), 256);
    int old_size = read_file(logger.log_file, old_vec);
    if (old_size < 0) old_size = 0;
    
                                                  
    Vector* new_vec = vector_create(sizeof(uint8_t), old_size + strlen(text) + 16);
    
                                         
    for (int i = 0; i < old_size; i++) {
        uint8_t byte = old_vec->data[i];
        new_vec->push(new_vec, &byte);
    }
    
                                        
    for (int i = 0; text[i]; i++) {
        uint8_t byte = text[i];
        new_vec->push(new_vec, &byte);
    }
    
                 
    write_file(logger.log_file, new_vec);
    
              
    old_vec->destroy(old_vec);
    new_vec->destroy(new_vec);
}

                               
static void log_vmsg(int level, const char* fmt, va_list args) {
    if (level > logger.log_level || logger.log_level == LOG_NONE) return;
    
    log_buf_reset();
    
              
    if (logger.show_prefix) {
        switch (level) {
            case LOG_ERROR: log_buf_str("[ERROR] "); break;
            case LOG_WARN:  log_buf_str("[WARN]  "); break;
            case LOG_INFO:  log_buf_str("[INFO]  "); break;
            case LOG_DEBUG: log_buf_str("[DEBUG] "); break;
        }
    }
    
                     
    for (const char* p = fmt; *p; p++) {
        if (*p == '%' && *(p+1)) {
            p++;
            switch (*p) {
                case 's': log_buf_str(va_arg(args, const char*)); break;
                case 'd': log_buf_int(va_arg(args, int)); break;
                case 'x': log_buf_hex(va_arg(args, uint64_t)); break;
                case 'c': log_buf_char((char)va_arg(args, int)); break;
                case '%': log_buf_char('%'); break;
            }
        } else {
            log_buf_char(*p);
        }
    }
    log_buf_char('\n');
    log_buf_char('\0');
    
                
    uint32_t color = COLOR_WHITE;
    switch (level) {
        case LOG_ERROR: color = logger.error_color; break;
        case LOG_WARN:  color = logger.warn_color;  break;
        case LOG_INFO:  color = logger.info_color;  break;
        case LOG_DEBUG: color = logger.debug_color; break;
    }
    
    if (logger.use_colors) set_color(color, COLOR_BLACK);
    print(log_buffer);
    if (logger.use_colors) reset_color();
    
             
    log_to_file(log_buffer);
}

void log_error(const char* fmt, ...) { va_list a; va_start(a, fmt); log_vmsg(LOG_ERROR, fmt, a); va_end(a); }
void log_warn(const char* fmt, ...)  { va_list a; va_start(a, fmt); log_vmsg(LOG_WARN, fmt, a); va_end(a); }
void log_info(const char* fmt, ...)  { va_list a; va_start(a, fmt); log_vmsg(LOG_INFO, fmt, a); va_end(a); }
void log_debug(const char* fmt, ...) { va_list a; va_start(a, fmt); log_vmsg(LOG_DEBUG, fmt, a); va_end(a); }

void log(const char* level, const char* module, const char* message) {
    int numeric_level = LOG_INFO;
    if (level && strcmp(level, "ERROR") == 0) numeric_level = LOG_ERROR;
    else if (level && strcmp(level, "WARN") == 0) numeric_level = LOG_WARN;
    else if (level && strcmp(level, "DEBUG") == 0) numeric_level = LOG_DEBUG;
    if (numeric_level > logger.log_level || logger.log_level == LOG_NONE) return;
    char line[512];
    line[0] = '\0';
    if (logger.show_prefix) {
        strcpy(line, "[");
        strcat(line, level ? level : "INFO");
        strcat(line, "] ");
    }
    if (module && module[0]) {
        strcat(line, "[");
        strcat(line, module);
        strcat(line, "] ");
    }
    if (message) strcat(line, message);
    strcat(line, "\n");
    print(line);
    log_to_file(line);
}

void logger_daemon(void) {
    while (1) {
        // Пишем что-то в лог
        log_info("Heartbeat");
        
        // Спим 1000 ms (кооперативно)
        task_sleep(1000);
    }
}

