static inline char* strtok(char *str, const char *delim) {
    static char *last = NULL;
    char *start;
    
    if (str) {
        start = str;
        last = str;
    } else if (!last) {
        return NULL;
    } else {
        start = last;
    }
    
    while (*start && strchr(delim, *start)) {
        start++;
    }
    
    if (*start == '\0') {
        last = NULL;
        return NULL;
    }
    
    char *end = start;
    while (*end && !strchr(delim, *end)) {
        end++;
    }
    
    if (*end) {
        *end = '\0';
        last = end + 1;
    } else {
        last = NULL;
    }
    
    return start;
}

