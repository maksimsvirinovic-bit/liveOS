        char* port_str = strtok(NULL, " ");
        char* data = strtok(NULL, "");
        
        if (!host || !port_str) {
            printf("Usage: request tls <host> <port> [data]\n");
            return;
        }
        
        uint16_t port = atoi(port_str);
        if (port == 0) port = 443;
        
              
        uint32_t ip;
        if (dns_resolve(8 << 24 | 8 << 16 | 8 << 8 | 8, host, &ip) != 0) {
            printf("TLS: DNS failed\n");
            return;
        }
        
        printf("TLS: Connecting to %s (%d.%d.%d.%d):%d\n", host,
            (ip >> 24) & 0xFF, (ip >> 16) & 0xFF,
            (ip >> 8) & 0xFF, ip & 0xFF, port);
        
              
        TcpConnection tcp;
        if (tcp_connect(&tcp, ip, port, 12345) != 0) {
            printf("TLS: TCP failed\n");
            return;
        }
        
              
        TlsConnection tls;
        if (tls_connect(&tls, &tcp, host) != 0) {
            printf("TLS: Handshake failed\n");
            tcp_close(&tcp);
            return;
        }
        
        printf("TLS: Connected!\n");
        
                    
        if (data && data[0]) {
            tls_send(&tls, (uint8_t*)data, strlen(data));
        }
        
                           
        uint8_t buf[8192];
        int len = tls_receive(&tls, buf, sizeof(buf));
        
        if (len > 0) {
            printf("TLS Response (%d bytes):\n", len);
            for (int i = 0; i < len && i < 1024; i++) {
                putc(buf[i]);
            }
            if (len > 1024) printf("...\n");
            putc('\n');
        }
        
        tls_close(&tls);
    } else if (strcmp(protocol, "telnet") == 0) {
        char* host = strtok((char*)(args + i), " ");
        char* port_str = strtok(NULL, " ");
        char* data = strtok(NULL, "");
        
        if (!host) {
            printf("Usage: request telnet <host> [port] [data]\n");
            printf("Example: request telnet 192.168.31.1\n");
            printf("         request telnet google.com 80 \"GET / HTTP/1.0\\r\\n\\r\\n\"\n");
            return;
        }
        
        uint16_t port = 23;
        if (port_str) {
            port = atoi(port_str);
            if (port == 0) port = 23;
        }
        
                                        
        uint32_t ip;
        if (parse_ip(host, (uint64_t*)&ip) == 0) {
                           
            if (mdns_query(host, &ip) != 0) {
                              
                if (dns_resolve(8 << 24 | 8 << 16 | 8 << 8 | 8, host, &ip) != 0) {
                    printf("Telnet: Cannot resolve %s\n", host);
                    return;
                }
            }
        }
        
        printf("Telnet: Connecting to %s (%d.%d.%d.%d):%d\n", host,
            (ip >> 24) & 0xFF, (ip >> 16) & 0xFF,
            (ip >> 8) & 0xFF, ip & 0xFF, port);
        
              
        TcpConnection conn;
        if (tcp_connect(&conn, ip, port, 12345) != 0) {
            printf("Telnet: Connection failed\n");
            return;
        }
        
        printf("Telnet: Connected! (Ctrl+Q to quit)\n");
        
                                                  
        if (data && data[0]) {
            tcp_send(&conn, (uint8_t*)data, strlen(data));
            
            uint8_t buf[4096];
            int len = tcp_receive(&conn, buf, sizeof(buf));
            if (len > 0) {
                printf("Response (%d bytes):\n", len);
                for (int i = 0; i < len && i < 1024; i++) {
                    putc(buf[i]);
                }
                if (len > 1024) printf("...\n");
                putc('\n');
            }
            tcp_close(&conn);
            return;
        }
        
                              
        uint8_t recv_buf[1024];
        int recv_pos = 0;
        int iac_sequence = 0;
        
        while (1) {
                         
            if (kbhit()) {
                int c = getchar();
                if (c == 17) {           
                    printf("\nTelnet: Disconnected\n");
                    break;
                }
                uint8_t key = (uint8_t)c;
                tcp_send(&conn, &key, 1);
            }
            
                   
            int len = tcp_receive(&conn, recv_buf + recv_pos, sizeof(recv_buf) - recv_pos);
            if (len > 0) {
                recv_pos += len;
                int i = 0;
                while (i < recv_pos) {
                    if (recv_buf[i] == 0xFF) {        
                        if (i + 1 < recv_pos) {
                                                        
                            if (recv_buf[i+1] >= 0xFB && recv_buf[i+1] <= 0xFE) {
                                i += 3;
                            } else {
                                i += 2;
                            }
                        } else {
                            break;
                        }
                    } else {
                        putc(recv_buf[i++]);
                    }
                }
                if (i > 0) {
                    memmove(recv_buf, recv_buf + i, recv_pos - i);
                    recv_pos -= i;
                }
            }
            
            for (volatile int j = 0; j < 1000; j++);
        }
        
        tcp_close(&conn);
    }
    
                              
    else if (strcmp(protocol, "httpd") == 0) {
        char* subcmd = strtok((char*)(args + i), " ");
        
        if (!subcmd) {
            printf("Usage: request httpd <start|stop|status>\n");
