#include "sysmon.h"
#include "str.h"
#include "heap.h"
#include "console.h"

SystemMonitor* sysmon_create(void) {
    SystemMonitor* s = (SystemMonitor*)kmalloc(sizeof(SystemMonitor));
    
    s->cpu.usage_percent = 0;
    s->cpu.frequency_mhz = 2400;
    s->cpu.cores = 4;
    
    s->memory.total_kb = 8192 * 1024;  // 8GB
    s->memory.used_kb = 2048 * 1024;   // 2GB
    s->memory.free_kb = s->memory.total_kb - s->memory.used_kb;
    
    s->disks = vector_create(sizeof(DiskInfo*), 4);
    
    s->network.packets_in = 0;
    s->network.packets_out = 0;
    s->network.bytes_in = 0;
    s->network.bytes_out = 0;
    
    s->uptime_sec = 0;
    s->cpu_temp = 45;
    
    printf("[SysMon] Created\n");
    return s;
}

void sysmon_destroy(SystemMonitor* s) {
    if (!s) return;
    
    for (uint32_t i = 0; i < s->disks->size; i++) {
        DiskInfo* d = *(DiskInfo**)s->disks->at(s->disks, i);
        if (d) kfree(d);
    }
    s->disks->destroy(s->disks);
    
    kfree(s);
}

// Update CPU info
void sysmon_update_cpu(SystemMonitor* s) {
    if (!s) return;
    
    // Simulated CPU usage (in real system, would read /proc/stat or similar)
    // For now, use a simple oscillating pattern
    static uint32_t cycle = 0;
    cycle++;
    
    s->cpu.usage_percent = 30 + (cycle % 40);
    s->cpu_temp = 45 + ((cycle / 20) % 15);
    
    printf("[SysMon] CPU: %d%% @ %d MHz (%d°C, %d cores)\n", 
           s->cpu.usage_percent, s->cpu.frequency_mhz, s->cpu_temp, s->cpu.cores);
}

// Update memory info
void sysmon_update_memory(SystemMonitor* s) {
    if (!s) return;
    
    // Simulated memory usage
    static uint32_t mem_cycle = 0;
    mem_cycle++;
    
    s->memory.used_kb = 2048 * 1024 + (mem_cycle % (1024 * 1024));
    s->memory.free_kb = s->memory.total_kb - s->memory.used_kb;
    
    printf("[SysMon] Memory: %d MB / %d MB (%.1f%%)\n",
           s->memory.used_kb / 1024,
           s->memory.total_kb / 1024,
           (s->memory.used_kb * 100) / s->memory.total_kb);
}

// Update disk info
void sysmon_update_disks(SystemMonitor* s) {
    if (!s) return;
    
    if (s->disks->size == 0) {
        // Add default root partition
        DiskInfo* root = (DiskInfo*)kmalloc(sizeof(DiskInfo));
        strcpy(root->name, "root");
        root->total_mb = 50 * 1024;  // 50GB
        root->used_mb = 25 * 1024;   // 25GB used
        root->free_mb = root->total_mb - root->used_mb;
        
        s->disks->push(s->disks, &root);
    }
    
    printf("[SysMon] Disks:\n");
    for (uint32_t i = 0; i < s->disks->size; i++) {
        DiskInfo* d = *(DiskInfo**)s->disks->at(s->disks, i);
        printf("  %s: %d MB / %d MB (%.1f%%)\n",
               d->name, d->used_mb, d->total_mb,
               (d->used_mb * 100) / d->total_mb);
    }
}

// Update network info
void sysmon_update_network(SystemMonitor* s) {
    if (!s) return;
    
    // Simulated network stats
    static uint32_t net_cycle = 0;
    net_cycle++;
    
    s->network.packets_in += 100 + (net_cycle % 50);
    s->network.packets_out += 50 + (net_cycle % 25);
    s->network.bytes_in += 10000 + (net_cycle % 5000);
    s->network.bytes_out += 5000 + (net_cycle % 2500);
    
    printf("[SysMon] Network: %d in / %d out packets, %d KB in / %d KB out\n",
           s->network.packets_in, s->network.packets_out,
           s->network.bytes_in / 1024, s->network.bytes_out / 1024);
}

// Main update
void sysmon_update(SystemMonitor* s) {
    if (!s) return;
    
    s->uptime_sec++;
    
    sysmon_update_cpu(s);
    sysmon_update_memory(s);
    sysmon_update_disks(s);
    sysmon_update_network(s);
}

// Display functions
void sysmon_print_stats(SystemMonitor* s) {
    if (!s) return;
    
    printf("\n╔════════════════════════════════════════╗\n");
    printf("║       LiveOS System Monitor v1.0       ║\n");
    printf("╚════════════════════════════════════════╝\n\n");
    
    sysmon_print_cpu(s);
    printf("\n");
    sysmon_print_memory(s);
    printf("\n");
    sysmon_print_disks(s);
    printf("\n");
    sysmon_print_network(s);
    printf("\n");
    
    // Uptime
    uint32_t hours = s->uptime_sec / 3600;
    uint32_t minutes = (s->uptime_sec % 3600) / 60;
    uint32_t seconds = s->uptime_sec % 60;
    printf("Uptime: %d:%02d:%02d\n", hours, minutes, seconds);
}

void sysmon_print_cpu(SystemMonitor* s) {
    if (!s) return;
    
    printf("CPU Information:\n");
    printf("  Usage: ");
    
    // Progress bar
    int bar_width = s->cpu.usage_percent / 5;
    for (int i = 0; i < 20; i++) {
        printf("%s", i < bar_width ? "█" : "░");
    }
    printf(" %d%%\n", s->cpu.usage_percent);
    
    printf("  Frequency: %d MHz\n", s->cpu.frequency_mhz);
    printf("  Temperature: %d°C\n", s->cpu_temp);
    printf("  Cores: %d\n", s->cpu.cores);
}

void sysmon_print_memory(SystemMonitor* s) {
    if (!s) return;
    
    uint32_t used_mb = s->memory.used_kb / 1024;
    uint32_t total_mb = s->memory.total_kb / 1024;
    uint32_t percent = (s->memory.used_kb * 100) / s->memory.total_kb;
    
    printf("Memory Information:\n");
    printf("  Used: %d MB / %d MB\n", used_mb, total_mb);
    printf("  Usage: ");
    
    // Progress bar
