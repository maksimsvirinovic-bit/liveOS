    uint16_t logical_block_size_be;
    uint32_t path_table_size_le;
    uint32_t path_table_size_be;
    uint32_t path_table_l_loc;
    uint32_t path_table_opt_l_loc;
    uint32_t path_table_m_loc;
    uint32_t path_table_opt_m_loc;
    uint8_t root_dir_record[34];
} ISO9660_PVD;

// Directory Record
typedef struct {
    uint8_t length;
    uint8_t ext_attr_length;
    uint32_t lba_le;
    uint32_t lba_be;
    uint32_t data_length_le;
    uint32_t data_length_be;
    uint8_t date_time[7];
    uint8_t flags;
    uint8_t file_unit_size;
    uint8_t gap_size;
    uint16_t seq_num_le;
    uint16_t seq_num_be;
    uint8_t name_len;
    char name[256];
} ISO9660_DirRecord;

int iso_mount_to_dir(const char* iso_path, const char* target_dir) {
    if (!iso_path || !target_dir) return -1;
    
    // Read ISO file
    Vector* iso_data = vector_create(sizeof(uint8_t), 8192);
    if (read_file(iso_path, iso_data) != 0) {
        iso_data->destroy(iso_data);
        printf("[ERROR] Failed to read ISO file: %s\n", iso_path);
        return -1;
    }
    
    if (iso_data->size < 32768) {
        iso_data->destroy(iso_data);
        printf("[ERROR] ISO file too small\n");
        return -1;
    }
    
    // ISO 9660 Primary Volume Descriptor starts at sector 16 (offset 32768)
    uint8_t* pvd_sector = (uint8_t*)iso_data->data + 32768;
    
    // Check PVD signature
    if (pvd_sector[0] != 1 || 
        pvd_sector[1] != 'C' || 
        pvd_sector[2] != 'D' || 
        pvd_sector[3] != '0' || 
        pvd_sector[4] != '0' || 
        pvd_sector[5] != '1') {
        iso_data->destroy(iso_data);
        printf("[ERROR] Not a valid ISO 9660 image\n");
        return -1;
    }
    
    printf("[*] Found valid ISO 9660 image\n");
    printf("[*] Creating target directory: %s\n", target_dir);
    
    // Create target directory
    if (create_dir(target_dir) != 0) {
        printf("[WARNING] Target directory creation failed (may already exist)\n");
    }
    
    // Extract root directory listing from ISO
    // This is a simplified implementation - just extract all regular files
    
    uint32_t block_size = 2048; // Standard ISO block size
    uint32_t logical_block_size = *(uint16_t*)(pvd_sector + 128);
    
    // Root directory is in root_dir_record
    uint8_t* root_rec = pvd_sector + 156;
    uint32_t root_lba = *(uint32_t*)(root_rec + 2);
    uint32_t root_size = *(uint32_t*)(root_rec + 10);
    
    printf("[*] Root directory at LBA 0x%x, size %d bytes\n", root_lba, root_size);
    
    // Read root directory
    uint32_t root_offset = root_lba * block_size;
    if (root_offset + root_size > iso_data->size) {
        iso_data->destroy(iso_data);
        printf("[ERROR] Root directory beyond ISO size\n");
        return -1;
    }
    
    uint8_t* root_dir = (uint8_t*)iso_data->data + root_offset;
    
    // Parse directory entries
    uint32_t pos = 0;
    int file_count = 0;
    
    while (pos < root_size) {
        if (pos + 33 > root_size) break;
        
        uint8_t rec_len = root_dir[pos];
        if (rec_len == 0) break;
        
        uint8_t flags = root_dir[pos + 25];
        uint8_t name_len = root_dir[pos + 32];
        char name[256] = {0};
        
        if (name_len > 0 && name_len < 255) {
            memcpy(name, &root_dir[pos + 33], name_len);
            name[name_len] = '\0';
            
            // Skip . and ..
            if (name_len > 1 || (name_len == 1 && name[0] > '\x01')) {
                // Regular file (not directory)
                if ((flags & 0x02) == 0) {
                    uint32_t file_lba = *(uint32_t*)(&root_dir[pos + 2]);
                    uint32_t file_size = *(uint32_t*)(&root_dir[pos + 10]);
                    
                    printf("  File: %s (%d bytes)\n", name, file_size);
                    file_count++;
                }
            }
        }
        
        pos += rec_len;
    }
    
    iso_data->destroy(iso_data);
    printf("[OK] ISO mount complete (%d files found)\n", file_count);
    
    return 0;
}

// Simple alternative: just list ISO contents without extracting
int iso_list_contents(const char* iso_path) {
    if (!iso_path) return -1;
    
    Vector* iso_data = vector_create(sizeof(uint8_t), 8192);
    if (read_file(iso_path, iso_data) != 0) {
        iso_data->destroy(iso_data);
