#define TELNET_IAC   0xFF
#define TELNET_WILL  0xFB
#define TELNET_WONT  0xFC
#define TELNET_DO    0xFD
#define TELNET_DONT  0xFE
#define TELNET_ECHO  0x01
#define TELNET_SGA   0x03

static void telnet_send_command(TcpConnection* conn, uint8_t cmd, uint8_t opt) {
    uint8_t packet[3] = {TELNET_IAC, cmd, opt};
    tcp_send(conn, packet, 3);
}

static void telnet_handle_iac(TcpConnection* conn, uint8_t* data, int* pos, int len) {
    if (*pos + 1 >= len) return;
    
    uint8_t cmd = data[++(*pos)];
    uint8_t opt = data[++(*pos)];
    #ifdef DEBUG_TELNET
    printf("Telnet: IAC cmd=%02X opt=%02X\n", cmd, opt);
    #endif
    
    switch (cmd) {
        case TELNET_WILL:
                                                          
            if (opt == TELNET_ECHO || opt == TELNET_SGA) {
                telnet_send_command(conn, TELNET_DO, opt);
            } else {
                telnet_send_command(conn, TELNET_DONT, opt);
            }
            break;
            
        case TELNET_DO:
                            
            telnet_send_command(conn, TELNET_WONT, opt);
            break;
            
        case TELNET_WONT:
        case TELNET_DONT:
                         
            break;
            
        default:
                                  
            break;
    }
}

                            
int telnet_client_connect(const char* host, uint16_t port) {
    if (!host) return -1;
    
                            
    uint32_t ip;
    
                     
    if (parse_ip(host, (uint64_t*)&ip) == 0) {
                       
        if (mdns_query(host, &ip) != 0) {
                                  
            if (dns_resolve(8 << 24 | 8 << 16 | 8 << 8 | 8, host, &ip) != 0) {
                #ifdef DEBUG_TELNET
                printf("Telnet: Cannot resolve %s\n", host);
                #endif
                return -1;
            }
        }
    }
    #ifdef DEBUG_TELNET
    printf("Telnet: Connecting to %s (%d.%d.%d.%d):%d\n",
           host,
           (ip >> 24) & 0xFF,
           (ip >> 16) & 0xFF,
           (ip >> 8) & 0xFF,
           ip & 0xFF,
           port);
    #endif
                             
    TcpConnection conn;
    if (tcp_connect(&conn, ip, port, 12345) != 0) {
        printf("Telnet: Connection failed\n");
        return -1;
    }
    
    printf("Telnet: Connected! (Ctrl+Q to quit)\n");
    set_color(COLOR_GREEN, COLOR_BLACK);
    printf("========================================\n");
    reset_color();
    
                            
    uint8_t recv_buf[1024];
    int recv_pos = 0;
    int iac_sequence = 0;
    
    while (1) {
                                       
        if (kbhit()) {
            int c = getchar();
            
                             
            if (c == 17) {           
                printf("\nTelnet: Disconnected\n");
                break;
            }
            
                                 
            uint8_t key = (uint8_t)c;
            tcp_send(&conn, &key, 1);
        }
        
                                 
        int len = tcp_receive(&conn, recv_buf + recv_pos, sizeof(recv_buf) - recv_pos);
        
        if (len > 0) {
            recv_pos += len;
            
                                  
            int i = 0;
            while (i < recv_pos) {
                if (recv_buf[i] == TELNET_IAC) {
                                     
                    if (i + 1 < recv_pos) {
                        telnet_handle_iac(&conn, recv_buf, &i, recv_pos);
                    } else {
                                                  
                        break;
                    }
                } else {
                                     
                    putc(recv_buf[i++]);
                }
            }
            
                             
            if (i > 0) {
                memmove(recv_buf, recv_buf + i, recv_pos - i);
                recv_pos -= i;
            }
        }
        
                             
        for (volatile int j = 0; j < 1000; j++);
    }
    
    tcp_close(&conn);
    return 0;
}

