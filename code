#include "mdns.h"
#include "../e1000.h"
#include "udp.h"
#include "ip.h"
#include "console.h"
#include "str.h"
#include "netutils.h"
#include "heap.h"
#include "fs.h"

char mdns_hostname[64] = "liveos";
uint32_t mdns_ip = 0;
static int mdns_initialized = 0;

static void mdns_trim_hostname(char* s) {
    if (!s) return;
    int len = strlen(s);
    while (len > 0 && (s[len - 1] == '\n' || s[len - 1] == '\r' || s[len - 1] == ' ' || s[len - 1] == '\t')) {
        s[len - 1] = '\0';
        len--;
    }
    while (*s == ' ' || *s == '\t') {
        memmove(s, s + 1, strlen(s));
    }
}

int mdns_load_hostname(void) {
    Vector* buf = vector_create(sizeof(uint8_t), 64);
    if (!buf) return -1;

    int size = read_file("/etc/hostname", buf);
    if (size <= 0) {
        buf->destroy(buf);
        return -1;
    }

    uint8_t zero = 0;
    if (buf->size == 0 || buf->data[buf->size - 1] != 0) {
        buf->push(buf, &zero);
    }

    char* hostname = (char*)buf->data;
    mdns_trim_hostname(hostname);
    if (hostname[0] == '\0' || strlen(hostname) >= sizeof(mdns_hostname)) {
        buf->destroy(buf);
        return -1;
    }

    strncpy(mdns_hostname, hostname, sizeof(mdns_hostname) - 1);
    mdns_hostname[sizeof(mdns_hostname) - 1] = '\0';
    buf->destroy(buf);
    return 0;
}

int mdns_save_hostname(const char* hostname) {
    if (!hostname || hostname[0] == '\0') return -1;

    if (strlen(hostname) >= sizeof(mdns_hostname)) return -1;

    Vector* buf = vector_create(sizeof(uint8_t), 64);
    if (!buf) return -1;

    for (int i = 0; hostname[i]; i++) {
        uint8_t c = (uint8_t)hostname[i];
        buf->push(buf, &c);
    }
    uint8_t nl = '\n';
    buf->push(buf, &nl);

    int ret = write_file("/etc/hostname", buf);
    if (ret >= 0) {
        strncpy(mdns_hostname, hostname, sizeof(mdns_hostname) - 1);
        mdns_hostname[sizeof(mdns_hostname) - 1] = '\0';
    }

    buf->destroy(buf);
    return ret;
}

                                    
static int mdns_encode_name(uint8_t* buffer, int offset, const char* name) {
    int pos = offset;
    const char* start = name;
    
    while (*start) {
        const char* end = start;
        while (*end && *end != '.') end++;
        
        int len = end - start;
        if (len > 63) return -1;
        
        buffer[pos++] = (uint8_t)len;
        for (int i = 0; i < len; i++) {
            buffer[pos++] = start[i];
        }
        
        if (*end == '.') start = end + 1;
        else break;
    }
    
    buffer[pos++] = 0;
    return pos - offset;
}

                                
static int mdns_parse_name(const uint8_t* data, int pos, int len, char* name, int max_len) {
    int name_pos = 0;
    
    while (pos < len) {
        if (data[pos] == 0) {
            pos++;
            break;
        } else if (data[pos] & 0xC0) {
                        
            int ptr = ((data[pos] & 0x3F) << 8) | data[pos+1];
            pos += 2;
                                
            mdns_parse_name(data, ptr, len, name + name_pos, max_len - name_pos);
            break;
        } else {
            int seg_len = data[pos++];
            if (name_pos > 0 && name_pos < max_len - 1) {
                name[name_pos++] = '.';
            }
            for (int i = 0; i < seg_len && name_pos < max_len - 1; i++) {
                name[name_pos++] = data[pos++];
            }
        }
    }
    
    name[name_pos] = '\0';
    return pos;
}

                                   
static int mdns_build_response(uint8_t* packet, const char* name, uint32_t ip) {
    int pos = 0;
    
             
    packet[pos++] = 0x00; packet[pos++] = 0x00;       
    packet[pos++] = 0x84; packet[pos++] = 0x00;                    
    packet[pos++] = 0x00; packet[pos++] = 0x00;            
    packet[pos++] = 0x00; packet[pos++] = 0x01;            
    packet[pos++] = 0x00; packet[pos++] = 0x00;            
    packet[pos++] = 0x00; packet[pos++] = 0x00;            
    
                       
    int name_len = mdns_encode_name(packet, pos, name);
    if (name_len < 0) return -1;
    pos += name_len;
    
    packet[pos++] = 0x00; packet[pos++] = 0x01;           
    packet[pos++] = 0x00; packet[pos++] = 0x01;             
    packet[pos++] = 0x00; packet[pos++] = 0x00;                  
    packet[pos++] = 0x00; packet[pos++] = 0x78;                
    packet[pos++] = 0x00; packet[pos++] = 0x04;                 
    
    packet[pos++] = (ip >> 24) & 0xFF;
    packet[pos++] = (ip >> 16) & 0xFF;
    packet[pos++] = (ip >> 8) & 0xFF;
    packet[pos++] = ip & 0xFF;
    
    return pos;
}

                                   
static void mdns_parse_query(const uint8_t* data, int len) {
    if (len < 12) return;
    
    uint16_t qdcount = (data[4] << 8) | data[5];
    if (qdcount == 0) return;
    
    int pos = 12;
    char name[256];
    
    pos = mdns_parse_name(data, pos, len, name, sizeof(name));
    
    if (pos + 4 > len) return;
    
    uint16_t qtype = (data[pos] << 8) | data[pos+1];
    uint16_t qclass = (data[pos+2] << 8) | data[pos+3];
    
                                       
    if (qtype == MDNS_TYPE_A) {
                          
        uint8_t response[512];
        int resp_len = mdns_build_response(response, name, mdns_ip);
        
        if (resp_len > 0) {
            udp_send(MDNS_MULTICAST_IP, MDNS_PORT, MDNS_PORT, response, resp_len);
            #ifdef DEBUG_MDNS
            printf("mDNS: Answered %s -> ", name);
            print_ip(mdns_ip);
            printf("\n");
            #endif
        }
    }
}

                                 
static void mdns_receive_loop(void) {
    uint8_t buf[512];
    uint32_t src_ip;
    uint16_t src_port;
    
    while (1) {
        int len = udp_receive(buf, sizeof(buf), &src_ip, &src_port);
        if (len > 0 && src_port == MDNS_PORT) {
            mdns_parse_query(buf, len);
        }
    }
}

                               
int mdns_announce(const char* hostname, uint32_t ip) {
    if (!hostname || ip == 0) return -1;
    
    strncpy(mdns_hostname, hostname, 63);
    mdns_ip = ip;
    
                                             
    uint8_t packet[512];
    
               
    int len = mdns_build_response(packet, hostname, ip);
    if (len > 0) {
        udp_send(MDNS_MULTICAST_IP, MDNS_PORT, MDNS_PORT, packet, len);
        #ifdef DEBUG_MDNS
        printf("mDNS: Announced %s.local -> ", hostname);
        print_ip(ip);
        printf("\n");
        #endif
    }
    
    return 0;
}

                          
int mdns_query(const char* name, uint32_t* ip) {
    if (!name || !ip) return -1;
    #ifdef DEBUG_MDNS
    printf("mDNS: Querying %s.local\n", name);
    #endif
                        
    uint8_t query[256];
    int pos = 0;
    
             
    query[pos++] = 0x00; query[pos++] = 0x01;       
    query[pos++] = 0x00; query[pos++] = 0x00;                 
    query[pos++] = 0x00; query[pos++] = 0x01;                
    query[pos++] = 0x00; query[pos++] = 0x00;            
    query[pos++] = 0x00; query[pos++] = 0x00;            
    query[pos++] = 0x00; query[pos++] = 0x00;            
    
               
    char full_name[256];
    sprintf(full_name, "%s.local", name);
    
    int name_len = mdns_encode_name(query, pos, full_name);
    if (name_len < 0) return -1;
    pos += name_len;
    
    query[pos++] = 0x00; query[pos++] = 0x01;           
    query[pos++] = 0x00; query[pos++] = 0x01;             
    
                           
    udp_send(MDNS_MULTICAST_IP, MDNS_PORT, MDNS_PORT, query, pos);
    
                 
    uint8_t resp[512];
    uint32_t src_ip;
    uint16_t src_port;
    
    for (int attempt = 0; attempt < 100; attempt++) {
        int len = udp_receive(resp, sizeof(resp), &src_ip, &src_port);
        if (len > 0 && src_port == MDNS_PORT) {
                           
            uint16_t ancount = (resp[6] << 8) | resp[7];
            if (ancount > 0) {
                int p = 12;
                char resp_name[256];
                p = mdns_parse_name(resp, p, len, resp_name, sizeof(resp_name));
                
                if (p + 10 <= len) {
                    uint16_t type = (resp[p] << 8) | resp[p+1];
                    p += 2;
                    p += 2;          
                    p += 4;        
                    uint16_t rdlen = (resp[p] << 8) | resp[p+1];
                    p += 2;
                    
                    if (type == MDNS_TYPE_A && rdlen == 4) {
                        *ip = (resp[p] << 24) | (resp[p+1] << 16) |
                              (resp[p+2] << 8) | resp[p+3];
                        #ifdef DEBUG_MDNS
                        printf("mDNS: %s.local -> ", name);
                        print_ip(*ip);
                        printf("\n");
                        #endif
                        return 0;
                    }
                }
            }
        }
        
        for (volatile int j = 0; j < 100000; j++);
    }
    #ifdef DEBUG_MDNS
    printf("mDNS: No response for %s.local\n", name);
    #endif
    return -1;
}

                            
int mdns_init(void) {
    if (mdns_initialized) return 0;
    #ifdef DEBUG_MDNS
    printf("mDNS: Initializing on port %d\n", MDNS_PORT);
    #endif
                                     
    uint8_t* mac = e1000_get_mac();
    sprintf(mdns_hostname, "liveos-%02X%02X%02X",
            mac[3], mac[4], mac[5]);

    if (mdns_load_hostname() != 0) {
        #ifdef DEBUG_MDNS
        printf("mDNS: Using default hostname: %s.local\n", mdns_hostname);
        #endif
    } else {
        #ifdef DEBUG_MDNS
        printf("mDNS: Loaded hostname from /etc/hostname: %s.local\n", mdns_hostname);
        #endif
    }
    
    mdns_ip = our_ip;
    mdns_initialized = 1;
    
    #ifdef DEBUG_MDNS                                                
    printf("mDNS: Hostname: %s.local\n", mdns_hostname);
    #endif
    
    return 0;
}

                                             
void mdns_poll(void) {
    if (!mdns_initialized) return;
    
    uint8_t buf[512];
    uint32_t src_ip;
    uint16_t src_port;
    
                          
    int len = udp_receive(buf, sizeof(buf), &src_ip, &src_port);
    if (len > 0 && src_port == MDNS_PORT) {
        mdns_parse_query(buf, len);
    }
}

