void cmd_rdbyte(uint32_t lba) {
    print("Reading LBA ");
    print_int(lba);
    print("... ");
    
    if (ata_read_sector(ATA_PRIMARY_DATA, 0, lba, sector_buf) == 0) {
        print("OK\n");
                                     
        for (int i = 0; i < 64; i++) {
            uint8_t b = sector_buf[i];
            putc("0123456789ABCDEF"[b >> 4]);
            putc("0123456789ABCDEF"[b & 0xF]);
            putc(' ');
            if ((i + 1) % 16 == 0) putc('\n');
        }
        putc('\n');
    } else {
        print("ERROR!\n");
    }
}
                                        
void cmd_wrbyte(uint32_t lba, uint32_t offset, uint8_t value) {
    if (offset >= 512) {
        print("Offset must be < 512\n");
        return;
    }
    
    print("Writing byte to LBA ");
    print_int(lba);
    print(" offset ");
    print_int(offset);
    print("... ");
    
                            
    if (ata_read_sector(ATA_PRIMARY_DATA, 0, lba, sector_buf) != 0) {
        print("Read ERROR!\n");
        return;
    }
    
                  
    sector_buf[offset] = value;
    
                         
    if (ata_write_sector(ATA_PRIMARY_DATA, 0, lba, sector_buf) == 0) {
        print("OK\n");
    } else {
        print("Write ERROR!\n");
    }
}

static void shell_readline(char* buf, int max) {
    int pos = 0;
    
                                               
    int prompt_pos_x = cx;                                     
    int prompt_pos_y = cy;                      
    
                                          
    static char temp_buf[256];
    static int temp_pos = 0;
    
    buf[0] = '\0';
    
    while (1) {
        int c = getchar();
        
        if (c == '\n') {
            buf[pos] = '\0';
            history_pos = history_count;
            putc('\n');
            break;
        }
        
        if (c == KEY_UP) {
            if (history_pos > 0) {
                need_scroll = 1;
                                         
                if (history_pos == history_count) {
                    for (int i = 0; i < pos; i++) temp_buf[i] = buf[i];
                    temp_buf[pos] = '\0';
                    temp_pos = pos;
                }
                
                history_pos--;
                
                                                                     
                cx = prompt_pos_x;
                cy = prompt_pos_y;
                
                                                                                              
                for (int i = cx; i < cols; i++) putc(' ');
                
                                                             
                cx = prompt_pos_x;
                cy = prompt_pos_y;
                
                                              
                char* hist_cmd = NULL;
                if (history_pos < (int)history->size) {
                    char** item = (char**)history->at(history, history_pos);
                    if (item) hist_cmd = *item;
                }
                
                if (hist_cmd) {
                    int len = strlen(hist_cmd);
                    for (int i = 0; i < len && i < max - 1; i++) {
                        buf[i] = hist_cmd[i];
                        putc(buf[i]);
                    }
                    buf[len] = '\0';
                    pos = len;
                }
            }
            need_scroll = 0;
            continue;
        }
        
        if (c == KEY_DOWN) {
            need_scroll = 1;
            if (history_pos < history_count) {
                history_pos++;
                
                                                                     
                cx = prompt_pos_x;
                cy = prompt_pos_y;
                
                                                         
                for (int i = cx; i < cols; i++) putc(' ');
                cx = prompt_pos_x;
                cy = prompt_pos_y;
                
                char* hist_cmd = NULL;
                int len = 0;
                
                if (history_pos < (int)history->size) {
                    char** item = (char**)history->at(history, history_pos);
                    if (item) hist_cmd = *item;
                } else if (history_pos == history_count) {
                    hist_cmd = temp_buf;
                }
                
                if (hist_cmd) {
                    len = strlen(hist_cmd);
                    for (int i = 0; i < len && i < max - 1; i++) {
                        buf[i] = hist_cmd[i];
                        putc(buf[i]);
                    }
                }
                buf[len] = '\0';
                pos = len;
            }
            need_scroll = 0;
            continue;
        }
        
        if (c >= 32 && c < 127) {
            history_pos = history_count;
        }
        
        if (c == '\b' || c == 127) {
            if (pos > 0) {
                pos--;
                putc('\b');
                putc(' ');
                putc('\b');
            }
            continue;
        }
        
        if (c >= 32 && c < 127 && pos < max - 1) {
            buf[pos++] = c;
            putc(c);
        }
    }
}

