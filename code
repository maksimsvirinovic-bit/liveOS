            if (!server || !user || !pass || !file) {
                printf("Usage: request ftp get <server> <user> <pass> <file>\n");
                return;
            }
            
            ftp_get(server, user, pass, file);
        } else {
            printf("Unknown: %s\n", subcmd);
        }
    }
    
                       
    else if (strcmp(protocol, "mdns") == 0) {
        char* subcmd = strtok((char*)(args + i), " ");
        
        if (!subcmd) {
            printf("Usage: request mdns <announce|query|setname|status>\n");
            return;
        }
        
        if (strcmp(subcmd, "announce") == 0) {
            mdns_announce(mdns_hostname, our_ip);
        } else if (strcmp(subcmd, "query") == 0) {
            char* name = strtok(NULL, " ");
            if (name) {
                uint32_t ip;
                if (mdns_query(name, &ip) == 0) {
                    printf("  %s.local -> ", name);
                    print_ip(ip);
                    printf("\n");
                }
            } else {
                printf("Usage: request mdns query <hostname>\n");
            }
        } else if (strcmp(subcmd, "setname") == 0) {
            char* name = strtok(NULL, " ");
            if (name) {
                strncpy(mdns_hostname, name, 63);
                printf("mDNS: Hostname set to %s.local\n", mdns_hostname);
            } else {
                printf("Usage: request mdns setname <hostname>\n");
            }
        } else if (strcmp(subcmd, "status") == 0) {
            printf("mDNS: Hostname: %s.local\n", mdns_hostname);
            printf("mDNS: IP: ");
            print_ip(mdns_ip);
            printf("\n");
        } else {
            printf("Unknown: %s\n", subcmd);
        }
    }
    
                       
    else if (strcmp(protocol, "dhcp") == 0) {
        char* subcmd = strtok((char*)(args + i), " ");
        
        if (!subcmd || strcmp(subcmd, "request") == 0) {
            DhcpConfig config;
