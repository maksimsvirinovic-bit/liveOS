        return -1;
    }
    
    if (iso_data->size < 32768) {
        iso_data->destroy(iso_data);
        return -1;
    }
    
    uint8_t* pvd_sector = (uint8_t*)iso_data->data + 32768;
    
    // Check signature
    if (pvd_sector[0] != 1 || pvd_sector[1] != 'C' || pvd_sector[2] != 'D') {
        iso_data->destroy(iso_data);
