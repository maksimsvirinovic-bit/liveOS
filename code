    strcpy(btn->name, name);
    strcpy(btn->path, path);
    btn->active = 0;
    btn->x = 0;
    btn->y = 0;
    btn->width = strlen(name) + 4;
    btn->height = 1;
    
    t->buttons->push(t->buttons, &btn);
    printf("[Taskbar] Added button: %s\n", name);
    return 0;
}

int taskbar_remove_button(Taskbar* t, const char* name) {
    if (!t || !name) return -1;
    
    for (uint32_t i = 0; i < t->buttons->size; i++) {
        TaskbarButton* btn = *(TaskbarButton**)t->buttons->at(t->buttons, i);
        if (strcmp(btn->name, name) == 0) {
            TaskbarButton* last = *(TaskbarButton**)t->buttons->at(t->buttons, t->buttons->size - 1);
            *(TaskbarButton**)t->buttons->at(t->buttons, i) = last;
            t->buttons->size--;
            kfree(btn);
            printf("[Taskbar] Removed button: %s\n", name);
            return 0;
        }
    }
    
    return -1;
}

TaskbarButton* taskbar_find_button(Taskbar* t, const char* name) {
