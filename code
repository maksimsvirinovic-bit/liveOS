            if (vfs_unmount(cmd + 7) != 0) printf("umount: not mounted: %s\n", cmd + 7);

        } else if (strcmp(cmd, "cdrom-info") == 0) {
            // Detailed CD-ROM diagnostics
            uint8_t sector[512];
            printf("[*] CD-ROM Diagnostics\n");
            printf("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n");
            
            printf("[*] Reading first sector from IDE Secondary (0x170), Slave...\n");
            if (ata_read_sector(ATA_SECONDARY_DATA, 1, 0, sector) != 0) {
                printf("[ERROR] Failed to read sector\n");
                printf("Possible reasons:\n");
                printf("  1. CD-ROM not detected\n");
                printf("  2. Device not responding\n");
                printf("  3. IDE Secondary controller issue\n");
                printf("\nTry: mount 0x170 1 /mnt/cdrom\n");
            } else {
                printf("[OK] Sector read successfully\n");
                printf("\nFirst 64 bytes (HEX):\n");
                for (int i = 0; i < 64; i++) {
                    if (i % 16 == 0) printf("%04x: ", i);
                    printf("%02x ", sector[i]);
                    if ((i + 1) % 16 == 0) printf("\n");
                }
                
                printf("\nFirst 64 bytes (ASCII):\n");
                for (int i = 0; i < 64; i++) {
                    if (sector[i] >= 32 && sector[i] < 127) printf("%c", sector[i]);
                    else printf(".");
                }
                printf("\n\n");
                
                // Filesystem detection
                printf("[*] Filesystem Detection:\n");
                
                // Check for FAT32 boot sector
                if ((sector[0] == 0xEB && sector[2] == 0x90) || sector[0] == 0xE9) {
                    printf("✓ FAT32 Boot Sector signature found\n");
                    
                    // Read BPB (BIOS Parameter Block)
                    uint16_t bytes_per_sector = *(uint16_t*)(sector + 11);
                    uint8_t sectors_per_cluster = sector[13];
                    uint16_t reserved_sectors = *(uint16_t*)(sector + 14);
                    uint8_t num_fats = sector[16];
                    uint32_t total_sectors = *(uint32_t*)(sector + 32);
                    uint32_t sectors_per_fat = *(uint32_t*)(sector + 36);
                    
                    printf("  Bytes per sector: %d\n", bytes_per_sector);
                    printf("  Sectors per cluster: %d\n", sectors_per_cluster);
                    printf("  Reserved sectors: %d\n", reserved_sectors);
                    printf("  Number of FATs: %d\n", num_fats);
                    printf("  Total sectors: %d\n", total_sectors);
                    printf("  Sectors per FAT: %d\n", sectors_per_fat);
                    printf("  Total size: %d MB\n", (total_sectors * bytes_per_sector) / (1024*1024));
                } else if (sector[0] == 0x00 && sector[1] == 0x00 && sector[2] == 0x00) {
                    printf("✗ Device appears empty/unformatted\n");
                } else if (sector[1] == 'C' && sector[2] == 'D' && sector[3] == '0') {
                    printf("✓ ISO 9660 CD detected\n");
                    printf("  Try: mount-iso or extract ISO contents\n");
                } else {
                    printf("? Unknown format\n");
                    printf("  First byte: 0x%02x (should be 0xEB or 0xE9 for FAT32)\n", sector[0]);
                }
                
                printf("\n[*] Troubleshooting:\n");
                printf("  If empty: ISO may not be properly burned to CD\n");
                printf("  If readable but mount fails:\n");
                printf("    1. Try: mount 0x170 1 /mnt/test\n");
                printf("    2. Check: ls /mnt/test\n");
                printf("    3. Verify: cdrom-mount (will try FAT32 then EXT4)\n");
            }

        } else if (strcmp(cmd, "cdrom-mount") == 0) {
            // Mount CD-ROM device (IDE Secondary, slave)
            // ISO mounted as CD-ROM on IDE 1 (secondary)
            char mountpoint[256] = "/mnt/cdrom";
            
            printf("[*] Mounting CD-ROM device...\n");
            printf("    Device: IDE Secondary (0x170), Slave\n");
            printf("    Mount point: %s\n", mountpoint);
            
            // Create mount point
            if (create_dir(mountpoint) != 0) {
                printf("[WARNING] Failed to create mountpoint\n");
            }
            
            // Try FAT32 first (most common for ISO on CD)
            printf("[*] Trying FAT32...\n");
            if (vfs_mount_ata_fat32(ATA_SECONDARY_DATA, 1, 0, mountpoint) == 0) {
                printf("[OK] CD-ROM mounted as FAT32 at %s\n", mountpoint);
                printf("Use: ls %s\n", mountpoint);
            } else {
                printf("[*] FAT32 failed, trying EXT4...\n");
                // Try EXT4
                if (vfs_mount_ata(ATA_SECONDARY_DATA, 1, 0, mountpoint) == 0) {
                    printf("[OK] CD-ROM mounted as EXT4 at %s\n", mountpoint);
                    printf("Use: ls %s\n", mountpoint);
                } else {
                    printf("[ERROR] Failed to mount CD-ROM\n");
                    printf("Possible reasons:\n");
                    printf("  1. CD-ROM not detected\n");
                    printf("  2. Unsupported filesystem (not FAT32 or EXT4)\n");
                    printf("  3. Device read error\n");
                    printf("\nDiagnostics:\n");
                    printf("  cdrom-info       - Check if CD-ROM is readable\n");
                    printf("  mount 0x170 1 /mnt/cdrom - Try direct mount\n");
                }
            }

        } else if (strncmp(cmd, "mount-iso ", 10) == 0) {
            char* args = cmd + 10;
            char iso_path[256] = {0};
            char target_dir[256] = {0};
            
            // Parse: mount-iso <iso_file> [target_dir]
            int i = 0;
            while (*args && *args != ' ' && i < 255) iso_path[i++] = *args++;
            while (*args == ' ') args++;
            i = 0;
            while (*args && i < 255) target_dir[i++] = *args++;
            
            if (iso_path[0] == '\0') {
                print("Usage: mount-iso <iso_file> [target_dir]\n");
                print("Example: mount-iso /boot/liveos.iso /mnt/iso\n");
            } else {
                if (target_dir[0] == '\0') strcpy(target_dir, "/mnt/iso");
                
                // Mount ISO to directory (extracts contents)
                if (iso_mount_to_dir(iso_path, target_dir) != 0) {
                    printf("mount-iso: failed to mount %s\n", iso_path);
                }
            }

        } else if (strncmp(cmd, "iso-ls ", 7) == 0) {
            // List ISO contents without extracting
            const char* iso_path = cmd + 7;
            if (iso_list_contents(iso_path) != 0) {
                printf("iso-ls: failed to read ISO\n");
            }

        } else if (strncmp(cmd, "mount ", 6) == 0) {
            char* args = cmd + 6;
            char* base_text = strtok(args, " ");
            char* slave_text = strtok(NULL, " ");
            char* point = strtok(NULL, " ");
            if (!base_text || !slave_text) {
                print("Usage: mount <base> <slave> [partition] [mountpoint]\n");
                print("Example: mount 0x1f0 0 1 /mnt\n");
            } else {
                uint64_t base = 0; uint64_t slave = 0;
                char* partition_text = strtok(NULL, " ");
                char* mountpoint = strtok(NULL, " ");
                parse_num(base_text, &base); parse_num(slave_text, &slave);
                uint64_t partition = 0;
                if (partition_text) parse_num(partition_text, &partition);
                if (!mountpoint) mountpoint = point ? point : "/";
                int mounted = partition ? vfs_mount_ata_partition((uint16_t)base, (int)slave, (int)partition, mountpoint) : vfs_mount_ata((uint16_t)base, (int)slave, 0, mountpoint);
                if (mounted != 0) {
                    print("mount: unsupported or invalid ext4 device\n");
                }
            }
            
        } else if (strncmp(cmd, "format", 6) == 0) {
            VFS_FormatOptions opts;
            memset(&opts, 0, sizeof(opts));
            opts.type = VFS_TYPE_EXT4;                
            opts.quick = 1;
            
            char* p = cmd + 6;
            while (*p) {
                while (*p == ' ') p++;
                if (*p == '\0') break;
                
                if (*p == '-') {
                    p++;
                    switch (*p) {
                        case 'a': opts.full = 1; opts.quick = 0; p++; break;
                        case 'l':
                            p++;
                            while (*p == ' ') p++;
                            if (*p == '"') {
                                p++;
                                int i = 0;
                                while (*p != '"' && *p && i < 11) opts.label[i++] = *p++;
                                opts.label[i] = '\0';
                                if (*p == '"') p++;
                            }
                            break;
                        case 's':
                            p++;
                            while (*p == ' ') p++;
                            uint64_t val;
                            if (parse_num(p, &val)) {
                                opts.bytes_per_sector = (uint16_t)val;
                            }
                            while (*p >= '0' && *p <= '9') p++;
                            break;
                        case 'c':
                            p++;
                            while (*p == ' ') p++;
                            uint64_t val2;
                            if (parse_num(p, &val2)) {
                                opts.sectors_per_cluster = (uint8_t)val2;
                            }
                            while (*p >= '0' && *p <= '9') p++;
                            break;
                        case 'v':
                            p++;
                            while (*p == ' ') p++;
                            uint64_t val3;
                            if (parse_num(p, &val3)) {
                                opts.volume_id = (uint32_t)val3;
                            }
                            while (*p != ' ' && *p) p++;
                            break;
                        default: p++; break;
                    }
                } else {
                    p++;
                }
            }
            
                                 
            if (strstr(cmd, "ext4")) {
                opts.type = VFS_TYPE_EXT4;
                                                 
                                              
            }
            
            format(opts.type, &opts);
        } else if (strncmp(cmd, "ls", 2) == 0) {
            char* args = cmd + 2;
            while (*args == ' ') args++;
            
            int show_all = 0;
            int long_format = 0;
            char* paths[16];
            int path_count = 0;
            
                                         
            char* arg = args;
            while (*arg) {
                                     
                while (*arg == ' ') arg++;
                if (*arg == '\0') break;
                
                                                 
                if (*arg == '-') {
                    arg++;                   
                    while (*arg && *arg != ' ') {
                        switch (*arg) {
                            case 'a': show_all = 1; break;
                            case 'l': long_format = 1; break;
                            default:
                                printf("ls: invalid option -- '%c'\n", *arg);
                                printf("Usage: ls [-al] [path...]\n");
                        }
                        arg++;
                    }
                    continue;
                }
                
                           
                if (path_count < 16) {
                    paths[path_count++] = arg;
                }
                                                   
                while (*arg && *arg != ' ') arg++;
                if (*arg) {
                    *arg = '\0';
                    arg++;
                }
            }
            
                                
            if (path_count == 0) {
                                     
                ext4_list_dir(NULL, show_all, long_format);
            }
            
                                  
            for (int i = 0; i < path_count; i++) {
                if (path_count > 1) {
                    printf("\n%s:\n", paths[i]);
                }
                ext4_list_dir(paths[i], show_all, long_format);
            }
        } else if (strcmp(cmd, "pwd") == 0) {
            const char* path = ext4_get_current_path();
            printf("%s\n", path);
        } else if (strncmp(cmd, "touch ", 6) == 0) {
            create_file(cmd + 6);
        
        } else if (strncmp(cmd, "mkdir ", 6) == 0) {
            create_dir(cmd + 6);

        } else if (strncmp(cmd, "rm ", 3) == 0) {
            char* args = cmd + 3;
            while (*args == ' ') args++;
            
            int recursive = 0;
            if (strncmp(args, "-r ", 3) == 0) {
                recursive = 1;
                args += 3;
                while (*args == ' ') args++;
            }
            
            if (recursive) {
                ext4_delete_dir_recursive(args);
            } else {
                                                  
                Ext4_Stat stat;
                if (ext4_stat(args, &stat) == 0 && stat.type_char == 'd') {
                    printf("rm: cannot remove '%s': Is a directory (use -r)\n", args);
                    return;
                }
                delete_file(args);
            }
        } else if (strncmp(cmd, "rmdir ", 6) == 0) {
            delete_dir(cmd + 6);
            
        } else if (strncmp(cmd, "rename ", 7) == 0) {
                                     
            char* old_name = cmd + 7;
            char* new_name = strchr(old_name, ' ');
            if (new_name) {
                *new_name = '\0';
                new_name++;
                rename(old_name, new_name);
            }
            
        } else if (strncmp(cmd, "cd ", 3) == 0) {
            change_dir(cmd + 3);
            
        } else if (strncmp(cmd, "cp ", 3) == 0) {
            char* src = cmd + 3;
            char* dst = strchr(src, ' ');
            if (dst) {
                *dst = '\0';
                dst++;
                copy(src, dst);
            }

        } else if (strncmp(cmd, "mv ", 3) == 0) {
            char* src = cmd + 3;
            char* dst = strchr(src, ' ');
            if (dst) {
                *dst = '\0';
                dst++;
                move(src, dst);
            }
        } else if (strncmp(cmd, "cat ", 4) == 0) {
            Vector* buf = vector_create(sizeof(uint8_t), 256);
            int bytes = read_file(cmd + 4, buf);
            if (bytes > 0) {
                for (int i = 0; i < bytes; i++) {
                    putc(buf->data[i]);
                }
                putc('\n');
            }
            buf->destroy(buf);
        } else if (strncmp(cmd, "write ", 6) == 0) {
            char* file = cmd + 6;
            char* text = strchr(file, ' ');
            if (text) {
                *text = '\0';
                text++;
                
                Vector* buf = vector_create(sizeof(uint8_t), 256);
                int len = strlen(text);
                for (int i = 0; i < len; i++) {
                    buf->push(buf, &text[i]);
                }
                
                write_file(file, buf);
                buf->destroy(buf);
                print("Written!\n");
            }
        } else if (strncmp(cmd, "edit ", 5) == 0) {
            need_scroll = 1;
            edit(cmd + 5);
            need_scroll = 0;
                                                      
            for (uint32_t i = 0; i < h * p; i++) fb[i] = COLOR_BLACK;
            cx = cy = 0;
        } else if (strncmp(cmd, "asm ", 4) == 0) {
                                       
            char* src = cmd + 4;
            char* dst = strchr(src, ' ');
            if (dst) {
                *dst = '\0';
                dst++;
                asm_assemble_file(src, dst);
                }
        } else if (strncmp(cmd, "cc ", 3) == 0) {
            char* args = cmd + 3;
            char* source = strtok(args, " ");
            char* flag = strtok(NULL, " ");
            char* output = strtok(NULL, " ");
            if (!source || !flag || strcmp(flag, "-o") != 0 || !output) {
                print("Usage: cc <source.c> -o <output.elf>\n");
            } else {
                char command[256];
                sprintf(command, "run /bin/cc.elf %s -o %s", source, output);
                shell_execute(command);
            }
        } else if (strcmp(cmd, "debug") == 0) {
            debug_repl();

        } else if (strncmp(cmd, "./", 2) == 0) {
                        
            shell_run_elf_command(cmd + 2);
            
        } else if (strncmp(cmd, "run ", 4) == 0) {
                               
            shell_run_elf_command(cmd + 4);

        } else if (strcmp(cmd, "ext4") == 0) {
            ext4_init();
            
        } else if (strncmp(cmd, "readlink ", 9) == 0) {
            char target[256];
            if (ext4_read_symlink(cmd + 13, target, 256) > 0) {
                print(" -> ");
                print(target);
                putc('\n');
            }

        } else if (strncmp(cmd, "ln ", 3) == 0) {
            char* target = cmd + 3;
            char* link = strchr(target, ' ');
            if (link) {
                *link = '\0';
                link++;
                ext4_create_hardlink(target, link);
            }
            
        } else if (strncmp(cmd, "chmod ", 6) == 0) {
            char* args = cmd + 6;
            while (*args == ' ') args++;
            
            char* mode_str = args;
            char* path = strchr(args, ' ');
            if (!path) {
                printf("Usage: chmod <mode> <file>\n");
                printf("  Octal:  755, 644, 400, 777\n");
                printf("  Symbolic: +x, -x, +r, -r, +w, -w\n");
                printf("             u+x, g+x, o+x, a+x\n");
                printf("             u=rwx, g=rx, o=r\n");
                printf("  Examples:\n");
                printf("    chmod +x script.elf\n");
                printf("    chmod 755 script.elf\n");
                printf("    chmod u+x script.elf\n");
                printf("    chmod -w file.txt\n");
                return;
            }
            *path = '\0';
            path++;
            while (*path == ' ') path++;
            
                                     
            Ext4_Stat stat;
            if (ext4_stat(path, &stat) != 0) {
                printf("chmod: Cannot stat %s\n", path);
                return;
            }
            
                                 
            uint16_t new_mode = parse_chmod_mode(mode_str, stat.mode);
            if (new_mode == (uint16_t)-1) {
                return;
            }
            
                        
            ext4_chmod(path, new_mode);
            
                                     
            Ext4_Stat new_stat;
            ext4_stat(path, &new_stat);
            printf("  New mode: 0%o\n", new_stat.mode & 0777);
            printf("  Permissions: ");
            printf((new_stat.mode & 0400) ? "r" : "-");
            printf((new_stat.mode & 0200) ? "w" : "-");
            printf((new_stat.mode & 0100) ? "x" : "-");
            printf((new_stat.mode & 0040) ? "r" : "-");
            printf((new_stat.mode & 0020) ? "w" : "-");
            printf((new_stat.mode & 0010) ? "x" : "-");
            printf((new_stat.mode & 0004) ? "r" : "-");
            printf((new_stat.mode & 0002) ? "w" : "-");
            printf((new_stat.mode & 0001) ? "x" : "-");
            printf("\n");
        } else if (strncmp(cmd, "hash ", 9) == 0) {
            uint64_t hash = ext4_file_hash(cmd + 9);
            print("Hash: ");
            print_hex(hash);
