static inline float sin_approx(float x) {
                           
    while (x > PI) x -= 2 * PI;
    while (x < -PI) x += 2 * PI;
    
                                                             
    float x2 = x * x;
    float x3 = x2 * x;
    float x5 = x3 * x2;
    float x7 = x5 * x2;
    return x - x3 / 6.0f + x5 / 120.0f - x7 / 5040.0f;
}

static inline float cos_approx(float x) {
    return sin_approx(x + PI / 2.0f);
}

static inline float tan_approx(float x) {
    float s = sin_approx(x);
    float c = cos_approx(x);
    if (c == 0) return 0;
    return s / c;
}

                                    

