static void print_uint32(uint32_t num, int base, int width, int zero_pad) {
    char buf[32];
    char* p = buf + 31;
    *p = '\0';
    
    if (num == 0) {
        *--p = '0';
    } else {
        const char digits[] = "0123456789ABCDEF";
        while (num > 0) {
            *--p = digits[num % base];
            num /= base;
        }
    }
    
                       
    while ((buf + 31 - p) < width) {
        *--p = zero_pad ? '0' : ' ';
    }
    
    print(p);
}

