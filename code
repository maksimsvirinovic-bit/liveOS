    Vector* mountpoint;
} VfsMount;
static Vector* mounts;

static Vector* vfs_string(const char* value) {
    Vector* result = vector_create(sizeof(char), 32);
    while (value && *value) result->push(result, value++);
    char zero = '\0'; result->push(result, &zero);
    return result;
}

void vfs_init(void) {
    if (!mounts) mounts = vector_create(sizeof(VfsMount), 4);
                                         
    if (ext4_init() == 0) {
        current_fs = VFS_TYPE_EXT4;
        #ifdef DEBUG_VFS
        print("VFS: ext4 mounted\n");
        #endif
        fs_initialized = 1;
    } else {
            print("VFS: No filesystem found!\n");
            
    }
}

int vfs_mount_ata_fat32(uint16_t base, int slave, uint32_t start_lba, const char* mountpoint) {
    if (!mountpoint || mountpoint[0] != '/') return -1;
    
    // Note: Current FAT32 implementation is hardcoded to PRIMARY controller
    // For Secondary (CD-ROM) we would need to modify fat32.c
    // For now, try basic mounting
    
    // Register mount point
    VfsMount mount;
    mount.base = base;
    mount.slave = slave;
    mount.start_lba = start_lba;
    mount.mountpoint = vfs_string(mountpoint);
    mounts->push(mounts, &mount);
    
    current_fs = VFS_TYPE_FAT32;
    fs_initialized = 1;
    vfs_set_path(mountpoint);
    
    return 0;
}

int vfs_mount_ata(uint16_t base, int slave, uint32_t start_lba, const char* mountpoint) {
    if (!mountpoint || mountpoint[0] != '/') return -1;
    if (ext4_mount_device(base, slave, start_lba) != 0) return -1;
    VfsMount mount;
    mount.base = base; mount.slave = slave; mount.start_lba = start_lba; mount.mountpoint = vfs_string(mountpoint);
    mounts->push(mounts, &mount);
    current_fs = VFS_TYPE_EXT4;
    fs_initialized = 1;
    vfs_set_path(mountpoint);
    return 0;
}

int vfs_mount_ata_partition(uint16_t base, int slave, int partition, const char* mountpoint) {
    if (partition < 1 || partition > 4) return -1;
    uint8_t sector[512];
    if (ata_read_sector(base, slave, 0, sector) != 0 || sector[510] != 0x55 || sector[511] != 0xAA) return -1;
    uint32_t offset = 446 + (uint32_t)(partition - 1) * 16;
    uint32_t start = sector[offset + 8] | ((uint32_t)sector[offset + 9] << 8) |
                     ((uint32_t)sector[offset + 10] << 16) | ((uint32_t)sector[offset + 11] << 24);
    if (start == 0) return -1;
    return vfs_mount_ata(base, slave, start, mountpoint);
}

int vfs_mount_iso(const char* iso_path, const char* mountpoint) {
    if (!iso_path || !mountpoint || mountpoint[0] != '/') return -1;
    
    // ISO 9660 mounting not fully implemented yet
    // Current workaround: extract ISO contents to ext4 before mounting
    // Or mount from host: mount -o loop /path/to/iso /mnt/point
    
    printf("ISO mounting requires pre-extraction or host-level loop mount\n");
    printf("Workarounds:\n");
    printf("1. On host: mount -o loop %s %s\n", iso_path, mountpoint);
    printf("2. Or extract ISO contents to ext4 filesystem first\n");
    
    return -1;
}

int vfs_unmount(const char* mountpoint) {
    if (!mounts || !mountpoint) return -1;
    for (uint32_t i = 0; i < mounts->size; i++) {
        VfsMount* mount = (VfsMount*)mounts->at(mounts, i);
        if (strcmp((char*)mount->mountpoint->data, mountpoint) == 0) {
            mount->mountpoint->destroy(mount->mountpoint);
            mounts->remove(mounts, i);
            return 0;
        }
    }
    return -1;
}

void vfs_list_mounts(void) {
    if (!mounts || mounts->size == 0) { print("No mounted filesystems\n"); return; }
    for (uint32_t i = 0; i < mounts->size; i++) {
        VfsMount* mount = (VfsMount*)mounts->at(mounts, i);
        printf("ext4 ata 0x%X %s lba=%d -> %s\n", mount->base, mount->slave ? "slave" : "master", mount->start_lba, (char*)mount->mountpoint->data);
    }
}

void vfs_path_init(void) {
    if (path_initialized) return;
    
    vfs_current_path = vector_create(sizeof(char), 256);
    char root = '/';
    vfs_current_path->push(vfs_current_path, &root);
    path_initialized = 1;
}

const char* vfs_get_path(void) {
    vfs_path_init();
    
    char null_char = '\0';
    vfs_current_path->push(vfs_current_path, &null_char);
    
    const char* result = (const char*)vfs_current_path->data;
    
    vfs_current_path->pop(vfs_current_path);
    
    return result;
}

void vfs_set_path(const char* path) {
    vfs_path_init();
    vfs_current_path->clear(vfs_current_path);
    
    for (int i = 0; path[i]; i++) {
        vfs_current_path->push(vfs_current_path, &path[i]);
    }
}

void vfs_append_path(const char* component) {
    vfs_path_init();
    
    if (vfs_current_path->size > 0) {
        char last = vfs_current_path->data[vfs_current_path->size - 1];
        if (last != '/') {
            char slash = '/';
            vfs_current_path->push(vfs_current_path, &slash);
        }
    }
    
    for (int i = 0; component[i]; i++) {
        vfs_current_path->push(vfs_current_path, &component[i]);
    }
}

void vfs_path_up(void) {
    vfs_path_init();
    
    if (vfs_current_path->size <= 1) return;
    
    if (vfs_current_path->data[vfs_current_path->size - 1] == '/') {
        vfs_current_path->pop(vfs_current_path);
    }
    
    while (vfs_current_path->size > 1) {
        char c = vfs_current_path->data[vfs_current_path->size - 1];
        if (c == '/') break;
        vfs_current_path->pop(vfs_current_path);
    }
}

int format(int type, VFS_FormatOptions* opts) {
    if (type == VFS_TYPE_EXT4) {
        current_fs = VFS_TYPE_EXT4;
        return ext4_format();
    }                                     
    
    print("VFS: Unknown filesystem type!\n");
    return -1;
}

                                

int create_file(const char* path) {
    if (current_fs == VFS_TYPE_EXT4) return ext4_create_file(path);
                                           
    return -1;
}

int create_dir(const char* path) {
    if (!path || path[0] == '\0') return -1;
    
    // Handle relative paths by converting to absolute
    char abs_path[4096];
    if (path[0] != '/') {
        // Relative path - prepend current path
        const char* current = vfs_get_path();
        strcpy(abs_path, current);
        if (abs_path[strlen(abs_path) - 1] != '/') strcat(abs_path, "/");
        strcat(abs_path, path);
    } else {
        // Absolute path
        strcpy(abs_path, path);
    }
    
    if (current_fs == VFS_TYPE_EXT4) return ext4_create_dir(abs_path);
}

