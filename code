static void telnet_handle_iac(uint8_t* data, int len) {
                                 
    for (int i = 0; i < len; i++) {
        if (data[i] == TELNET_IAC && i + 2 < len) {
            uint8_t cmd = data[i+1];
            uint8_t opt = data[i+2];
            
            if (cmd == TELNET_WILL) {
                              
                uint8_t resp[3] = {TELNET_IAC, TELNET_DO, opt};
                tcp_send(&telnet_conn, resp, 3);
            } else if (cmd == TELNET_DO) {
                                
                uint8_t resp[3] = {TELNET_IAC, TELNET_WONT, opt};
                tcp_send(&telnet_conn, resp, 3);
            }
        }
    }
}

                            
static int telnet_server_loop(void) {
    TcpConnection conn;
    
    printf("Telnet: Listening on port %d\n", TELNET_PORT);
    
                                            
    while (1) {
                                          
                                                         
        if (tcp_connect(&conn, 0x0A000002, TELNET_PORT, 12345) != 0) {
                   
            for (volatile int i = 0; i < 1000000; i++);
            continue;
        }
        
        printf("Telnet: Connection from %d.%d.%d.%d:%d\n",
               (conn.remote_ip >> 24) & 0xFF,
               (conn.remote_ip >> 16) & 0xFF,
               (conn.remote_ip >> 8) & 0xFF,
               conn.remote_ip & 0xFF,
               conn.remote_port);
        
                                 
        tcp_send(&conn, (uint8_t*)"\r\nWelcome to LiveOS Telnet Server!\r\n", 37);
        tcp_send(&conn, (uint8_t*)"Login: ", 7);
        
                        
        uint8_t buf[256];
        int pos = 0;
        
        while (1) {
            int len = tcp_receive(&conn, buf + pos, sizeof(buf) - pos);
            if (len <= 0) break;
            
            for (int i = 0; i < len; i++) {
                if (buf[pos + i] == '\n' || buf[pos + i] == '\r') {
                    buf[pos + i] = '\0';
                                      
                    if (strcmp((char*)buf, "root") == 0) {
                        tcp_send(&conn, (uint8_t*)"Password: ", 10);
                                                
                        tcp_send(&conn, (uint8_t*)"\r\nWelcome, root!\r\n", 18);
                                                    
                                                           
                        return 0;
                    } else {
                        tcp_send(&conn, (uint8_t*)"\r\nLogin failed\r\n", 16);
                        tcp_send(&conn, (uint8_t*)"Login: ", 7);
                        pos = 0;
                    }
                } else {
                    pos++;
                }
            }
        }
        
        tcp_close(&conn);
    }
}

int telnet_server_start(void) {
    if (telnet_server_running) return 0;
    telnet_server_running = 1;
    return telnet_server_loop();
}

