// Math implementation
double lgs_math_sqrt(double x) {
    if (x < 0) return 0;
    if (x == 0) return 0;
    
    double guess = x / 2.0;
    double prev = 0;
    
    for (int i = 0; i < 20; i++) {
        prev = guess;
        guess = (guess + x / guess) / 2.0;
        if (guess == prev) break;
    }
    
    return guess;
}

double lgs_math_sin(double x) {
    // Normalize to [-pi, pi]
    double pi = 3.14159265359;
    while (x > pi) x -= 2 * pi;
    while (x < -pi) x += 2 * pi;
    
    // Taylor series
    double result = x;
    double term = x;
    
    for (int i = 1; i < 10; i++) {
        term *= -x * x / ((2*i) * (2*i + 1));
        result += term;
    }
    
    return result;
}

double lgs_math_cos(double x) {
    // cos(x) = sin(x + pi/2)
    double pi = 3.14159265359;
    return lgs_math_sin(x + pi / 2.0);
}

double lgs_math_tan(double x) {
    double sin_x = lgs_math_sin(x);
    double cos_x = lgs_math_cos(x);
    
    if (cos_x == 0) return 0;
    return sin_x / cos_x;
}

double lgs_math_abs(double x) {
    return x < 0 ? -x : x;
}

int32_t lgs_math_pow(int32_t base, int32_t exp) {
    if (exp < 0) return 0;
    if (exp == 0) return 1;
    
    int32_t result = 1;
    for (int32_t i = 0; i < exp; i++) {
        result *= base;
    }
    return result;
}

// Tokenize expression by operators
static Vector* lgs_tokenize_expr(const char* expr) {
    Vector* tokens = vector_create(sizeof(char*), 16);
    uint32_t len = strlen(expr);
    uint32_t i = 0;
    
    while (i < len) {
        // Skip whitespace
        while (i < len && (expr[i] == ' ' || expr[i] == '\t')) i++;
        if (i >= len) break;
        
        // Extract token
        uint32_t start = i;
        
        // Numbers
        if ((expr[i] >= '0' && expr[i] <= '9') || expr[i] == '-') {
            while (i < len && ((expr[i] >= '0' && expr[i] <= '9') || expr[i] == '.')) i++;
        }
        // Identifiers/functions
        else if ((expr[i] >= 'a' && expr[i] <= 'z') || (expr[i] >= 'A' && expr[i] <= 'Z') || expr[i] == '_') {
            while (i < len && ((expr[i] >= 'a' && expr[i] <= 'z') || 
                               (expr[i] >= 'A' && expr[i] <= 'Z') ||
                               (expr[i] >= '0' && expr[i] <= '9') ||
                               expr[i] == '_')) i++;
        }
        // Operators and parens
        else if (expr[i] == '(' || expr[i] == ')' || expr[i] == '+' || expr[i] == '-' ||
                 expr[i] == '*' || expr[i] == '/' || expr[i] == '=' || expr[i] == '<' ||
                 expr[i] == '>' || expr[i] == '!') {
            i++;
        } else {
            i++;
        }
        
        if (i > start) {
            uint32_t tok_len = i - start;
            char* token = (char*)kmalloc(tok_len + 1);
            strncpy(token, expr + start, tok_len);
            token[tok_len] = '\0';
            tokens->push(tokens, &token);
        }
    }
    
    return tokens;
}

// Parse and evaluate expression recursively
static ExprValue* lgs_eval_expr_recursive(LGSExecutor* e, Vector* tokens, uint32_t* pos);

static ExprValue* lgs_create_expr_value(void) {
    ExprValue* val = (ExprValue*)kmalloc(sizeof(ExprValue));
    val->type = VAR_INT;
    val->value.int_val = 0;
    return val;
}

// Parse primary (number, var, function call, parenthesized expr)
static ExprValue* lgs_eval_primary(LGSExecutor* e, Vector* tokens, uint32_t* pos) {
    if (*pos >= tokens->size) {
        return lgs_create_expr_value();
    }
    
    char* token = *(char**)tokens->at(tokens, *pos);
    ExprValue* val = lgs_create_expr_value();
    
    // Number
    if ((token[0] >= '0' && token[0] <= '9') || (token[0] == '-' && strlen(token) > 1)) {
        val->type = VAR_INT;
        val->value.int_val = 0;
        
        // Parse integer
        int neg = 0;
        uint32_t i = 0;
        if (token[0] == '-') {
            neg = 1;
            i = 1;
        }
        
        while (i < strlen(token)) {
            if (token[i] >= '0' && token[i] <= '9') {
                val->value.int_val = val->value.int_val * 10 + (token[i] - '0');
            }
            i++;
        }
        
        if (neg) val->value.int_val = -val->value.int_val;
        (*pos)++;
        return val;
    }
    
    // Function call: sqrt(x), sin(x), etc
    if (strcmp(token, "sqrt") == 0 || strcmp(token, "sin") == 0 || 
        strcmp(token, "cos") == 0 || strcmp(token, "tan") == 0 || strcmp(token, "abs") == 0) {
        
        char func_name[32];
        strcpy(func_name, token);
        (*pos)++;
        
        // Expect (
        if (*pos < tokens->size && strcmp(*(char**)tokens->at(tokens, *pos), "(") == 0) {
            (*pos)++;
            ExprValue* arg = lgs_eval_expr_recursive(e, tokens, pos);
            
            // Expect )
            if (*pos < tokens->size && strcmp(*(char**)tokens->at(tokens, *pos), ")") == 0) {
                (*pos)++;
            }
            
            val->type = VAR_INT;
            double result = 0;
            
            if (arg->type == VAR_INT) {
                double x = (double)arg->value.int_val;
                
                if (strcmp(func_name, "sqrt") == 0) result = lgs_math_sqrt(x);
                else if (strcmp(func_name, "sin") == 0) result = lgs_math_sin(x);
                else if (strcmp(func_name, "cos") == 0) result = lgs_math_cos(x);
                else if (strcmp(func_name, "tan") == 0) result = lgs_math_tan(x);
                else if (strcmp(func_name, "abs") == 0) result = lgs_math_abs(x);
                
                val->value.int_val = (int32_t)result;
            }
            
            kfree(arg);
            return val;
        }
    }
    
    // Variable reference
    Variable* var = lgs_get_var(e->parser, token);
    if (var) {
        val->type = var->type;
        val->value.int_val = var->value.int_val;
        (*pos)++;
        return val;
    }
    
    // Parenthesized expression
    if (strcmp(token, "(") == 0) {
        (*pos)++;
        ExprValue* result = lgs_eval_expr_recursive(e, tokens, pos);
        
        if (*pos < tokens->size && strcmp(*(char**)tokens->at(tokens, *pos), ")") == 0) {
            (*pos)++;
        }
        
        return result;
    }
    
    (*pos)++;
    return val;
}

// Parse multiplication/division
static ExprValue* lgs_eval_mul_div(LGSExecutor* e, Vector* tokens, uint32_t* pos) {
    ExprValue* left = lgs_eval_primary(e, tokens, pos);
    
    while (*pos < tokens->size) {
        char* op = *(char**)tokens->at(tokens, *pos);
        
        if (strcmp(op, "*") == 0) {
            (*pos)++;
            ExprValue* right = lgs_eval_primary(e, tokens, pos);
            left->value.int_val *= right->value.int_val;
            kfree(right);
        } else if (strcmp(op, "/") == 0) {
            (*pos)++;
            ExprValue* right = lgs_eval_primary(e, tokens, pos);
            if (right->value.int_val != 0) {
                left->value.int_val /= right->value.int_val;
            }
            kfree(right);
        } else {
            break;
        }
    }
    
    return left;
}

// Parse addition/subtraction
static ExprValue* lgs_eval_add_sub(LGSExecutor* e, Vector* tokens, uint32_t* pos) {
    ExprValue* left = lgs_eval_mul_div(e, tokens, pos);
    
    while (*pos < tokens->size) {
        char* op = *(char**)tokens->at(tokens, *pos);
        
        if (strcmp(op, "+") == 0) {
            (*pos)++;
            ExprValue* right = lgs_eval_mul_div(e, tokens, pos);
            left->value.int_val += right->value.int_val;
            kfree(right);
        } else if (strcmp(op, "-") == 0 && *pos > 0) {
            // Check if it's binary minus (not unary)
            char* prev = *(char**)tokens->at(tokens, *pos - 1);
            if (strcmp(prev, "+") != 0 && strcmp(prev, "-") != 0 && strcmp(prev, "*") != 0 && strcmp(prev, "/") != 0) {
                (*pos)++;
                ExprValue* right = lgs_eval_mul_div(e, tokens, pos);
                left->value.int_val -= right->value.int_val;
                kfree(right);
            } else {
                break;
            }
        } else {
            break;
        }
    }
    
    return left;
}

// Top-level expression parser
static ExprValue* lgs_eval_expr_recursive(LGSExecutor* e, Vector* tokens, uint32_t* pos) {
    return lgs_eval_add_sub(e, tokens, pos);
}

// Public expression evaluation
ExprValue* lgs_eval_expression(LGSExecutor* e, const char* expr) {
    if (!e || !expr || !expr[0]) {
        return lgs_create_expr_value();
    }
    
    Vector* tokens = lgs_tokenize_expr(expr);
    uint32_t pos = 0;
    ExprValue* result = lgs_eval_expr_recursive(e, tokens, &pos);
    
    // Cleanup tokens
    for (uint32_t i = 0; i < tokens->size; i++) {
        char* tok = *(char**)tokens->at(tokens, i);
        if (tok) kfree(tok);
    }
    tokens->destroy(tokens);
    
    return result;
}

// Execute code blocks
ExprValue* lgs_eval_code_block(LGSExecutor* e, ASTNode* code_node) {
    if (!e || !code_node) return lgs_create_expr_value();
    
    ExprValue* last_val = lgs_create_expr_value();
    
    // Process each child (statement)
    for (uint32_t i = 0; i < code_node->children->size; i++) {
        ASTNode* stmt = *(ASTNode**)code_node->children->at(code_node->children, i);
        
        if (stmt->type == NODE_VAR) {
            // Variable assignment or declaration
            // Extract type, name, value from node
            if (stmt->value[0]) {
                ExprValue* val = lgs_eval_expression(e, stmt->value);
                if (val) {
                    kfree(last_val);
                    last_val = val;
                }
            }
        } else if (stmt->type == NODE_TEXT && stmt->value[0]) {
            // Evaluate as expression
            ExprValue* val = lgs_eval_expression(e, stmt->value);
            if (val) {
                kfree(last_val);
                last_val = val;
            }
        }
    }
    
    return last_val;
}

// Variable management
int lgs_exec_set_var(LGSExecutor* e, const char* name, ExprValue* val) {
    if (!e || !name || !val) return -1;
    
    // Find in parser variables and update, or create new
    Variable* var = (Variable*)kmalloc(sizeof(Variable));
    var->type = val->type;
    var->is_const = 0;
    var->value.int_val = val->value.int_val;
    
    return lgs_set_var(e->parser, name, var);
}

ExprValue* lgs_exec_get_var(LGSExecutor* e, const char* name) {
    if (!e || !name) return NULL;
    
    Variable* var = lgs_get_var(e->parser, name);
    if (!var) return NULL;
    
    ExprValue* val = lgs_create_expr_value();
    val->type = var->type;
    val->value.int_val = var->value.int_val;
    
    return val;
}


