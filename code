#include "lgs_parser.h"
#include "str.h"
#include "heap.h"
#include "console.h"
#include "fs.h"

// Forward declaration
static void lgs_ast_destroy(ASTNode* node);

LGSParser* lgs_parser_create(void) {
    LGSParser* p = (LGSParser*)kmalloc(sizeof(LGSParser));
    p->variables = vector_create(sizeof(Variable*), 32);
    p->tokens = vector_create(sizeof(char*), 256);
    p->root = NULL;
    p->pos = 0;
    p->error[0] = '\0';
    return p;
}

void lgs_parser_destroy(LGSParser* p) {
    if (!p) return;
    
    // Cleanup variables
    for (uint32_t i = 0; i < p->variables->size; i++) {
        Variable* v = *(Variable**)p->variables->at(p->variables, i);
        if (v->type == VAR_STR && v->value.str_val) {
            kfree(v->value.str_val);
        } else if (v->type == VAR_CODE && v->value.code_lines) {
            v->value.code_lines->destroy(v->value.code_lines);
        }
        kfree(v);
    }
    p->variables->destroy(p->variables);
    
    // Cleanup tokens
    for (uint32_t i = 0; i < p->tokens->size; i++) {
        char* tok = *(char**)p->tokens->at(p->tokens, i);
        if (tok) kfree(tok);
    }
    p->tokens->destroy(p->tokens);
    
    // Cleanup AST
    if (p->root) {
        lgs_ast_destroy(p->root);
    }
    
    kfree(p);
}

static void lgs_ast_destroy(ASTNode* node) {
    if (!node) return;
    
    for (uint32_t i = 0; i < node->children->size; i++) {
        ASTNode* child = *(ASTNode**)node->children->at(node->children, i);
        lgs_ast_destroy(child);
    }
    node->children->destroy(node->children);
    node->attributes->destroy(node->attributes);
    kfree(node);
}

// Tokenizer
static int lgs_tokenize(LGSParser* p, const char* content) {
    uint32_t len = strlen(content);
    uint32_t i = 0;
    
    while (i < len) {
        // Skip whitespace
        while (i < len && (content[i] == ' ' || content[i] == '\n' || content[i] == '\t' || content[i] == '\r')) {
            i++;
        }
        if (i >= len) break;
        
        // Comments: @ (single-line)
        if (content[i] == '@') {
            while (i < len && content[i] != '\n') i++;
            continue;
        }
        
        // Comments: ## (multi-line)
        if (i + 1 < len && content[i] == '#' && content[i+1] == '#') {
            i += 2;
            while (i + 1 < len && !(content[i] == '#' && content[i+1] == '#')) i++;
            if (i + 1 < len) i += 2;
            continue;
        }
        
        // Tag open: <name or <name attr=val>
        if (content[i] == '<') {
            uint32_t start = i;
            i++;
            
            // Check for closing tag </name>
            int is_closing = 0;
            if (i < len && content[i] == '/') {
                is_closing = 1;
                i++;
            }
            
            // Extract tag name
            uint32_t name_start = i;
            while (i < len && content[i] != '>' && content[i] != ' ') i++;
            
            uint32_t tok_len = i - name_start + 10;
            char* token = (char*)kmalloc(tok_len);
            if (is_closing) {
                strcpy(token, "</");
                strncpy(token + 2, content + name_start, i - name_start);
                token[i - name_start + 2] = '\0';
            } else {
                strcpy(token, "<");
                strncpy(token + 1, content + name_start, i - name_start);
                token[i - name_start + 1] = '\0';
            }
            strcat(token, ">");
            
            p->tokens->push(p->tokens, &token);
            
            // Skip to end of tag
            while (i < len && content[i] != '>') i++;
            if (i < len) i++;
            continue;
        }
        
        // Text content
        if (content[i] != '<') {
            uint32_t start = i;
            while (i < len && content[i] != '<') i++;
            
            // Trim and store if not empty
            uint32_t len = i - start;
            while (len > 0 && (content[start] == ' ' || content[start] == '\n')) {
                start++;
                len--;
            }
            while (len > 0 && (content[start + len - 1] == ' ' || content[start + len - 1] == '\n')) {
                len--;
            }
            
            if (len > 0) {
                char* token = (char*)kmalloc(len + 1);
                strncpy(token, content + start, len);
                token[len] = '\0';
                p->tokens->push(p->tokens, &token);
            }
            continue;
        }
    }
    
    return 0;
}

// AST Parser
static ASTNode* lgs_ast_parse(LGSParser* p);

static ASTNode* lgs_create_node(NodeType type, const char* name) {
    ASTNode* node = (ASTNode*)kmalloc(sizeof(ASTNode));
    node->type = type;
    strcpy(node->name, name);
    node->value[0] = '\0';
    node->attributes = vector_create(sizeof(char*), 8);
    node->children = vector_create(sizeof(ASTNode*), 16);
    return node;
}

static ASTNode* lgs_parse_node(LGSParser* p) {
    if (p->pos >= p->tokens->size) return NULL;
    
    char* tok = *(char**)p->tokens->at(p->tokens, p->pos);
    if (!tok || tok[0] != '<') return NULL;
    
    // Extract tag name
    char tag_name[128];
    int is_closing = 0;
    int start_idx = 1;
    
    if (tok[1] == '/') {
        is_closing = 1;
        start_idx = 2;
    }
    
    int i = 0;
    while (start_idx + i < strlen(tok) && tok[start_idx + i] != '>' && tok[start_idx + i] != ' ') {
        tag_name[i] = tok[start_idx + i];
        i++;
    }
    tag_name[i] = '\0';
    
    if (is_closing) {
        return NULL; // Closing tag handled by parent
    }
    
    // Determine node type
    NodeType ntype = NODE_TEXT;
    if (strcmp(tag_name, "params") == 0) ntype = NODE_PARAMS;
    else if (strcmp(tag_name, "const") == 0) ntype = NODE_CONST;
    else if (strcmp(tag_name, "app") == 0) ntype = NODE_APP;
    else if (strcmp(tag_name, "widgets") == 0) ntype = NODE_WIDGETS;
    else if (strcmp(tag_name, "exec") == 0) ntype = NODE_EXEC;
    else if (strcmp(tag_name, "int") == 0 || strcmp(tag_name, "str") == 0 || 
             strcmp(tag_name, "bool") == 0 || strcmp(tag_name, "code") == 0) {
        ntype = NODE_VAR;
    }
    
    ASTNode* node = lgs_create_node(ntype, tag_name);
    p->pos++;
    
    // Parse children until closing tag
    while (p->pos < p->tokens->size) {
        char* next_tok = *(char**)p->tokens->at(p->tokens, p->pos);
        
        // Check for closing tag
        if (next_tok[0] == '<' && next_tok[1] == '/') {
            char close_name[128];
            int ci = 0;
            int start = 2;
            while (start + ci < strlen(next_tok) && next_tok[start + ci] != '>') {
                close_name[ci] = next_tok[start + ci];
                ci++;
            }
            close_name[ci] = '\0';
            
            if (strcmp(close_name, tag_name) == 0) {
                p->pos++;
                return node;
            }
        }
        
        // Parse child
        if (next_tok[0] == '<' && next_tok[1] != '/') {
            ASTNode* child = lgs_parse_node(p);
            if (child) {
                node->children->push(node->children, &child);
            }
        } else {
            // Text content
            strcpy(node->value, next_tok);
            p->pos++;
        }
    }
    
    return node;
}

static ASTNode* lgs_parse_document(LGSParser* p) {
    ASTNode* root = lgs_create_node(NODE_DOCUMENT, "lgs");
    
    while (p->pos < p->tokens->size) {
        char* tok = *(char**)p->tokens->at(p->tokens, p->pos);
        
        if (tok[0] == '<' && tok[1] != '/') {
            ASTNode* node = lgs_parse_node(p);
            if (node) {
                root->children->push(root->children, &node);
            }
        } else {
            p->pos++;
        }
    }
    
    return root;
}

// Public API
int lgs_parse_string(LGSParser* p, const char* content) {
    if (!p || !content) return -1;
    
    // Tokenize
    if (lgs_tokenize(p, content) != 0) {
        strcpy(p->error, "Tokenization failed");
        return -1;
    }
    
    // Parse AST
    p->pos = 0;
    p->root = lgs_parse_document(p);
    
    if (!p->root) {
        strcpy(p->error, "AST parsing failed");
        return -1;
    }
    
    return 0;
}

int lgs_parse_file(LGSParser* p, const char* filename) {
    if (!p || !filename) return -1;
    
    // Read file
    Vector* buf = vector_create(sizeof(uint8_t), 4096);
    if (read_file(filename, buf) != 0) {
        strcpy(p->error, "Cannot read file");
        buf->destroy(buf);
        return -1;
    }
    
    // Convert to string
    char* content = (char*)kmalloc(buf->size + 1);
    for (uint32_t i = 0; i < buf->size; i++) {
        content[i] = *(uint8_t*)buf->at(buf, i);
    }
    content[buf->size] = '\0';
    buf->destroy(buf);
    
    // Parse
    int ret = lgs_parse_string(p, content);
    kfree(content);
    
    return ret;
}

// Variable management
Variable* lgs_get_var(LGSParser* p, const char* name) {
    if (!p || !name) return NULL;
    
    for (uint32_t i = 0; i < p->variables->size; i++) {
        Variable* v = *(Variable**)p->variables->at(p->variables, i);
        if (strcmp(v->name, name) == 0) {
            return v;
        }
    }
    return NULL;
}

int lgs_set_var(LGSParser* p, const char* name, Variable* var) {
    if (!p || !name || !var) return -1;
    
    p->variables->push(p->variables, &var);
    return 0;
}

int lgs_exec_code(LGSParser* p, const char* code_var_name) {
    if (!p || !code_var_name) return -1;
    
    Variable* var = lgs_get_var(p, code_var_name);
    if (!var || var->type != VAR_CODE) return -1;
    
    // TODO: Execute code lines
    return 0;
}

// AST utilities
ASTNode* lgs_find_node(ASTNode* root, const char* name) {
    if (!root || !name) return NULL;
    
    if (strcmp(root->name, name) == 0) return root;
    
    for (uint32_t i = 0; i < root->children->size; i++) {
        ASTNode* child = *(ASTNode**)root->children->at(root->children, i);
        ASTNode* found = lgs_find_node(child, name);
        if (found) return found;
    }
    
    return NULL;
}

void lgs_print_ast(ASTNode* node, int depth) {
    if (!node) return;
    
    for (int i = 0; i < depth; i++) printf("  ");
    printf("<%s> ", node->name);
    
    if (node->value[0]) printf("\"%s\"", node->value);
    printf("\n");
    
    for (uint32_t i = 0; i < node->children->size; i++) {
        ASTNode* child = *(ASTNode**)node->children->at(node->children, i);
        lgs_print_ast(child, depth + 1);
    }
}


