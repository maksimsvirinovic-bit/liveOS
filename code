            }
        } else {
            printf("Unknown: %s\n", subcmd);
        }
    }
    
                      
    else if (strcmp(protocol, "ftp") == 0) {
        char* subcmd = strtok((char*)(args + i), " ");
        
        if (!subcmd) {
            printf("Usage: request ftp <get|put|list> <server> <user> <pass> <file>\n");
