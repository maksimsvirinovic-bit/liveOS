int ext4_change_dir(const char* path) {
    if (!ext4_initialized) return -1;
    if (!path || path[0] == '\0') return -1;
    
                                                            
    uint32_t saved_dir = ext4_current_dir;
    Vector* saved_path = NULL;
    
                                        
    if (current_path_ext4) {
        saved_path = vector_create(sizeof(char), current_path_ext4->size + 1);
        for (uint32_t i = 0; i < current_path_ext4->size; i++) {
            saved_path->push(saved_path, &current_path_ext4->data[i]);
        }
    }
    
                              
    if (path[0] == '/') {
        ext4_current_dir = 2;             
                                    
        if (!current_path_ext4) {
            current_path_ext4 = vector_create(sizeof(char), 256);
        }
        current_path_ext4->clear(current_path_ext4);
        char root = '/';
        current_path_ext4->push(current_path_ext4, &root);
        
        if (path[1] == '\0') return 0;               
        
        path++;                   
    }
    
                             
    char token[256];
    const char* p = path;
    
    while (*p) {
                                               
        int i = 0;
        while (*p && *p != '/' && i < 255) {
            token[i++] = *p++;
        }
        token[i] = '\0';
        
        if (i > 0) {
            if (strcmp(token, ".") == 0) {
                                    
            } else if (strcmp(token, "..") == 0) {
                         
                if (ext4_current_dir == 2) {
                                               
                } else {
                                                        
                    Ext4_Inode dir_inode;
                    read_inode(ext4_current_dir, &dir_inode);
                    
                    uint8_t buf[4096];
                    read_block(dir_inode.i_block[0], buf);
                    
                    Ext4_DirEntry* dotdot = (Ext4_DirEntry*)(buf + 12);
                    ext4_current_dir = dotdot->inode;
                    
                                         
                    if (current_path_ext4 && current_path_ext4->size > 1) {
                                                
                        if (current_path_ext4->data[current_path_ext4->size - 1] == '/') {
                            current_path_ext4->pop(current_path_ext4);
                        }
                                                    
                        while (current_path_ext4->size > 1) {
                            char c = current_path_ext4->data[current_path_ext4->size - 1];
                            if (c == '/') break;
                            current_path_ext4->pop(current_path_ext4);
                        }
                    }
                }
            } else {
                                     
                uint32_t target_inode;
                
                if (ext4_find_in_dir(ext4_current_dir, token, &target_inode) != 0) {
                                  
                    set_color(COLOR_RED, COLOR_BLACK);
                    printf("ext4: Directory not found: %s\n", token);
                    reset_color();
                    
                             
                    ext4_current_dir = saved_dir;
                    if (saved_path) {
                        current_path_ext4->clear(current_path_ext4);
                        for (uint32_t i = 0; i < saved_path->size; i++) {
                            current_path_ext4->push(current_path_ext4, &saved_path->data[i]);
                        }
                        saved_path->destroy(saved_path);
                    }
                    return -1;
                }
                
                                               
                Ext4_Inode inode;
                read_inode(target_inode, &inode);
                
                if ((inode.i_mode & EXT4_S_IFMT) != EXT4_S_IFDIR) {
                    set_color(COLOR_RED, COLOR_BLACK);
                    printf("ext4: Not a directory: %s\n", token);
                    reset_color();
                    
                             
                    ext4_current_dir = saved_dir;
                    if (saved_path) {
                        current_path_ext4->clear(current_path_ext4);
                        for (uint32_t i = 0; i < saved_path->size; i++) {
                            current_path_ext4->push(current_path_ext4, &saved_path->data[i]);
                        }
                        saved_path->destroy(saved_path);
                    }
                    return -1;
                }
                
                                     
                ext4_current_dir = target_inode;
                
                                         
                if (current_path_ext4 && current_path_ext4->size > 0) {
                    char last = current_path_ext4->data[current_path_ext4->size - 1];
                    if (last != '/') {
                        char slash = '/';
                        current_path_ext4->push(current_path_ext4, &slash);
                    }
                }
                for (int j = 0; token[j]; j++) {
                    current_path_ext4->push(current_path_ext4, &token[j]);
                }
            }
        }
        
                         
        if (*p == '/') p++;
    }
    
                               
    if (saved_path) {
        saved_path->destroy(saved_path);
    }
    
    return 0;
}

int ext4_delete_dir_recursive(const char* path) {
    if (!ext4_initialized) return -1;
    
                         
    Ext4_Inode dir_inode;
    uint32_t dir_inode_num;
    
    if (ext4_find_path_with_num(path, &dir_inode, &dir_inode_num) != 0) {
        printf("ext4: Directory not found: %s\n", path);
        return -1;
    }
    
    if ((dir_inode.i_mode & EXT4_S_IFMT) != EXT4_S_IFDIR) {
        printf("ext4: Not a directory: %s\n", path);
        return -1;
    }
    
                                     
    char parent_path[512];
    strcpy(parent_path, path);
    if (parent_path[strlen(parent_path)-1] != '/') {
        strcat(parent_path, "/");
    }
    
    uint8_t dir_buf[4096];
    uint32_t data_block = dir_inode.i_block[0];
    read_block(data_block, dir_buf);
    
    int offset = 0;
    while (offset < (int)dir_inode.i_size_lo) {
        Ext4_DirEntry* entry = (Ext4_DirEntry*)(dir_buf + offset);
        if (entry->rec_len == 0) break;
        
        if (entry->inode != 0) {
            char name[256];
            for (int i = 0; i < entry->name_len && i < 255; i++) {
                name[i] = entry->name[i];
            }
            name[entry->name_len] = '\0';
            
                                
            if (strcmp(name, ".") == 0 || strcmp(name, "..") == 0) {
                offset += entry->rec_len;
                continue;
            }
            
                          
            char full_path[512];
            sprintf(full_path, "%s%s", parent_path, name);
            
                            
            Ext4_Inode inode;
            read_inode(entry->inode, &inode);
            
            if ((inode.i_mode & EXT4_S_IFMT) == EXT4_S_IFDIR) {
                                                   
                printf("  Removing directory: %s\n", full_path);
                ext4_delete_dir_recursive(full_path);
            } else {
                               
                printf("  Removing file: %s\n", full_path);
                ext4_delete_file(full_path);
            }
        }
        
        offset += entry->rec_len;
    }
    
                                         
    printf("  Removing: %s\n", path);
    return ext4_delete_dir(path);
}

