#include "heap.h"

                                        

                                        
static void dns_base64url_encode(const uint8_t* data, int len, char* out) {
    const char* b64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    int i, j = 0;
    
    for (i = 0; i + 2 < len; i += 3) {
        out[j++] = b64[(data[i] >> 2) & 0x3F];
        out[j++] = b64[((data[i] & 0x3) << 4) | ((data[i+1] >> 4) & 0xF)];
        out[j++] = b64[((data[i+1] & 0xF) << 2) | ((data[i+2] >> 6) & 0x3)];
        out[j++] = b64[data[i+2] & 0x3F];
    }
    
    if (i < len) {
        out[j++] = b64[(data[i] >> 2) & 0x3F];
        if (i + 1 < len) {
            out[j++] = b64[((data[i] & 0x3) << 4) | ((data[i+1] >> 4) & 0xF)];
        } else {
            out[j++] = b64[(data[i] & 0x3) << 4];
        }
    }
    
    out[j] = '\0';
}

                         
int dns_resolve_doh(const char* server, uint16_t port, const char* domain, uint32_t* resolved_ip) {
    if (!domain || !resolved_ip || !server) return -1;
    #ifdef DEBUG_DOH
    printf("DoH: Resolving %s via %s:%d\n", domain, server, port);
    #endif
                                                                        
    uint32_t server_ip;
    if (parse_ip(server, (uint64_t*)&server_ip) != 1) {
                                             
        if (dns_resolve(8 << 24 | 8 << 16 | 8 << 8 | 8, server, &server_ip) != 0) {
            #ifdef DEBUG_DOH
            printf("DoH: Cannot resolve server %s\n", server);
            #endif
            return -1;
        }
    }
    
                        
    uint8_t query[512];
    int query_len = dns_build_query(domain, query, sizeof(query));
    if (query_len < 0) {
        #ifdef DEBUG_DOH
        printf("DoH: Failed to build query\n");
        #endif
        return -1;
    }
    
                           
    char b64_query[700];
    dns_base64url_encode(query, query_len, b64_query);
    
                         
    char http_request[2048];
    int pos = 0;
    
    pos += sprintf(http_request + pos, "GET /dns-query?dns=%s HTTP/1.1\r\n", b64_query);
    pos += sprintf(http_request + pos, "Host: %s\r\n", server);
    pos += sprintf(http_request + pos, "User-Agent: LiveOS/6.0\r\n");
    pos += sprintf(http_request + pos, "Accept: application/dns-message\r\n");
    pos += sprintf(http_request + pos, "Connection: close\r\n");
    pos += sprintf(http_request + pos, "\r\n");
    
                
    TcpConnection tcp;
    if (tcp_connect(&tcp, server_ip, port, 12345) != 0) {
        #ifdef DEBUG_DOH
        printf("DoH: TCP connection failed\n");
        #endif
        return -1;
    }
    
    TlsConnection tls;
    if (tls_connect(&tls, &tcp, server) != 0) {
        #ifdef DEBUG_DOH
        printf("DoH: TLS handshake failed\n");
        #endif
        tcp_close(&tcp);
        return -1;
    }
    
                             
    tls_send(&tls, (uint8_t*)http_request, strlen(http_request));
    
                 
    uint8_t response[4096];
    int total_len = 0;
    
    while (1) {
        uint8_t buf[1024];
        int len = tls_receive(&tls, buf, sizeof(buf));
        if (len <= 0) break;
        memcpy(response + total_len, buf, len);
        total_len += len;
        if (total_len >= sizeof(response) - 1) break;
    }
    
    tls_close(&tls);
    
    if (total_len < 10) {
        #ifdef DEBUG_DOH
        printf("DoH: No response\n");
        #endif
        return -1;
    }
    
                                        
    uint8_t* body = (uint8_t*)strstr((char*)response, "\r\n\r\n");
    if (!body) {
        #ifdef DEBUG_DOH
        printf("DoH: Invalid HTTP response\n");
        #endif
        return -1;
    }
    body += 4;
    
    int body_len = total_len - (body - response);
    
                       
    if (dns_parse_response(body, body_len, resolved_ip) == 0) {
        #ifdef DEBUG_DOH
        printf("DoH: Resolved %s -> ", domain);
        print_ip(*resolved_ip);
        printf("\n");
        #endif
        return 0;
    }
    
    #ifdef DEBUG_DOH
    printf("DoH: No A record found\n");
    #endif
    return -1;
}

