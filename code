// Helper: Copy file (needed for installation)
int copy_file_ext4(const char* src, const char* dst) {
    Vector* content = vector_create(sizeof(uint8_t), 4096);
    int size = read_file(src, content);

    if (size <= 0) {
        content->destroy(content);
        return -1;
    }

    int result = write_file(dst, content);
    content->destroy(content);
    return result;
}


