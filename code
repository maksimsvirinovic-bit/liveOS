static LpiPackage* lpi_parse_package(const uint8_t* data, int size) {
    if (!data || size <= 0) return NULL;

    LpiPackage* pkg = (LpiPackage*)kmalloc(sizeof(LpiPackage));
    if (!pkg) return NULL;
    memset(pkg, 0, sizeof(LpiPackage));

    char* buffer = (char*)kmalloc(size + 1);
    if (!buffer) {
        kfree(pkg);
        return NULL;
    }
    memcpy(buffer, data, size);
    buffer[size] = '\0';

    char* line_ptr = buffer;
    char line_buf[512];
    
    while (*line_ptr) {
        int i = 0;
        while (*line_ptr && *line_ptr != '\n' && i < 511) {
            line_buf[i++] = *line_ptr++;
        }
        if (*line_ptr == '\n') line_ptr++;
        line_buf[i] = '\0';

        char* line = lpi_trim(line_buf);
        if (!line[0] || line[0] == '#') continue;

        char* eq = strchr(line, '=');
        if (!eq) continue;

        *eq = '\0';
        char* key = lpi_trim(line);
        char* val = lpi_trim(eq + 1);

        if (strcmp(key, "name") == 0) strcpy(pkg->name, val);
        else if (strcmp(key, "version") == 0) strcpy(pkg->version, val);
        else if (strcmp(key, "arch") == 0) strcpy(pkg->arch, val);
        else if (strcmp(key, "maintainer") == 0) strcpy(pkg->maintainer, val);
        else if (strcmp(key, "description") == 0) strcpy(pkg->description, val);
        else if (strcmp(key, "license") == 0) strcpy(pkg->license, val);
        else if (strcmp(key, "depends") == 0) strcpy(pkg->depends, val);
        else if (strcmp(key, "files") == 0) strcpy(pkg->files, val);
        else if (strcmp(key, "pre_install") == 0) strcpy(pkg->pre_install, val);
        else if (strcmp(key, "post_install") == 0) strcpy(pkg->post_install, val);
        else if (strcmp(key, "pre_remove") == 0) strcpy(pkg->pre_remove, val);
        else if (strcmp(key, "type") == 0) strcpy(pkg->type, val);
    }

    kfree(buffer);
    return pkg;
}

