int fat32_read_file(const char* path, Vector* out_vec) {
    if (!fat_initialized) return -1;
    
                     
    char name[256];
    uint32_t saved_dir;
    if (resolve_path(path, name, &saved_dir) != 0) return -1;
    
    uint8_t name_83[11];
    name_to_83(name, name_83);
    
                
    uint8_t dir_buf[4096];
    if (read_cluster(current_dir_cluster, dir_buf) != 0) {
        restore_dir(saved_dir);
        return -1;
    }
    
    FAT32DirEntry* entries = (FAT32DirEntry*)dir_buf;
    FAT32DirEntry* file_entry = NULL;
    
    for (int i = 0; i < 16; i++) {
        if (entries[i].name[0] == 0x00) break;
        if (entries[i].name[0] == 0xE5) continue;
        if (entries[i].attributes & FAT32_ATTR_DIRECTORY) continue;
        
        if (memcmp(entries[i].name, name_83, 11) == 0) {
            file_entry = &entries[i];
            break;
        }
    }
    
    if (!file_entry) {
        print("File not found!\n");
        restore_dir(saved_dir);
        return -1;
    }
    
    uint32_t file_size = file_entry->file_size;
    uint32_t cluster = file_entry->cluster_low | (file_entry->cluster_high << 16);
    
                              
    out_vec->clear(out_vec);
    
                      
    uint32_t bytes_read = 0;
    while (cluster != 0 && cluster < 0x0FFFFFF8 && bytes_read < file_size) {
        uint8_t cluster_data[4096];
        if (read_cluster(cluster, cluster_data) != 0) {
            restore_dir(saved_dir);
            return -1;
        }
        
        uint32_t to_copy = 4096;
        if (bytes_read + to_copy > file_size) to_copy = file_size - bytes_read;
        
                                  
        for (uint32_t i = 0; i < to_copy; i++) {
            out_vec->push(out_vec, &cluster_data[i]);
        }
        
        bytes_read += to_copy;
        cluster = read_fat(cluster);
    }
    
    restore_dir(saved_dir);
    return bytes_read;
}

int fat32_write_file(const char* path, Vector* data_vec) {
    if (!fat_initialized) return -1;
    
    uint8_t* data = data_vec->data;
    uint32_t size = data_vec->size;
    
                     
    char name[256];
    uint32_t saved_dir;
    if (resolve_path(path, name, &saved_dir) != 0) return -1;
    
    uint8_t name_83[11];
    name_to_83(name, name_83);
    
                
    uint8_t dir_buf[4096];
    if (read_cluster(current_dir_cluster, dir_buf) != 0) {
        restore_dir(saved_dir);
        return -1;
    }
    
    FAT32DirEntry* entries = (FAT32DirEntry*)dir_buf;
    FAT32DirEntry* file_entry = NULL;
    
    for (int i = 0; i < 16; i++) {
        if (entries[i].name[0] == 0x00) break;
        if (entries[i].name[0] == 0xE5) continue;
        if (entries[i].attributes & FAT32_ATTR_DIRECTORY) continue;
        
        if (memcmp(entries[i].name, name_83, 11) == 0) {
            file_entry = &entries[i];
            break;
        }
    }
    
    if (!file_entry) {
        restore_dir(saved_dir);
        fat32_create_file(path);
        return fat32_write_file(path, data_vec);                            
    }
    
                                  
    uint32_t cluster = file_entry->cluster_low | (file_entry->cluster_high << 16);
    if (cluster != 0) {
        uint32_t c = cluster;
        while (c != 0 && c < 0x0FFFFFF8) {
            uint32_t next = read_fat(c);
            write_fat(c, 0);
            c = next;
        }
    }
    
                     
    uint32_t clusters_needed = (size + 4095) / 4096;
    uint32_t prev_cluster = 0;
    uint32_t first_cluster = 0;
    
    for (uint32_t i = 0; i < clusters_needed; i++) {
        uint32_t new_cluster = find_free_cluster();
        if (new_cluster == 0) {
            restore_dir(saved_dir);
            return -1;
        }
        
        if (i == 0) first_cluster = new_cluster;
        if (prev_cluster != 0) write_fat(prev_cluster, new_cluster);
        
                            
        uint8_t cluster_data[4096];
        uint32_t offset = i * 4096;
        uint32_t to_write = 4096;
        if (offset + to_write > size) to_write = size - offset;
        
        for (uint32_t j = 0; j < 4096; j++) {
            if (j < to_write) cluster_data[j] = data[offset + j];
            else cluster_data[j] = 0;
        }
        
        write_cluster(new_cluster, cluster_data);
        prev_cluster = new_cluster;
    }
    
    if (prev_cluster != 0) write_fat(prev_cluster, 0x0FFFFFF8);
    
    file_entry->cluster_low = first_cluster & 0xFFFF;
    file_entry->cluster_high = (first_cluster >> 16) & 0xFFFF;
    file_entry->file_size = size;
    
    write_cluster(current_dir_cluster, dir_buf);
    restore_dir(saved_dir);
    
    return size;
}

                               
int fat32_append_file(const char* path, const uint8_t* data, uint32_t size) {
    if (!fat_initialized) return -1;
    
                                          
    Vector* old_vec = vector_create(sizeof(uint8_t), 256);
    int old_size = fat32_read_file(path, old_vec);
    
    if (old_size <= 0) {
                                           
        old_vec->destroy(old_vec);
        
        Vector* data_vec = vector_create(sizeof(uint8_t), size);
        for (uint32_t i = 0; i < size; i++) {
            data_vec->push(data_vec, &data[i]);
        }
        
        int ret = fat32_write_file(path, data_vec);
        data_vec->destroy(data_vec);
        return ret;
    }
    
                                   
    Vector* new_vec = vector_create(sizeof(uint8_t), old_size + size + 16);
    
                                         
    for (int i = 0; i < old_size; i++) {
        uint8_t byte = old_vec->data[i];
        new_vec->push(new_vec, &byte);
    }
    
                                  
    for (uint32_t i = 0; i < size; i++) {
        uint8_t byte = data[i];
        new_vec->push(new_vec, &byte);
    }
    
                         
    int ret = fat32_write_file(path, new_vec);
    
    old_vec->destroy(old_vec);
    new_vec->destroy(new_vec);
    
    return ret;
}

                            
void fat32_list_dir(void) {
    if (!fat_initialized) {
        print("FAT32: Not initialized!\n");
        return;
    }
    
    uint8_t dir_buf[4096];
    if (read_cluster(current_dir_cluster, dir_buf) != 0) {
        print("Cannot read directory!\n");
        return;
    }

    FAT32DirEntry* entrie = (FAT32DirEntry*)dir_buf;
    
                                             
    print("DEBUG: First entries:\n");
    for (int i = 0; i < 4; i++) {
        if (entrie[i].name[0] == 0x00) break;
        
        print_int(i); print(": '");
        for (int j = 0; j < 11; j++) {
            if (entrie[i].name[j] >= 32 && entrie[i].name[j] < 127) {
                putc(entrie[i].name[j]);
            } else {
                putc('?');
            }
        }
        print("' [");
        for (int j = 0; j < 11; j++) {
            print_hex(entrie[i].name[j]);
            putc(' ');
        }
        print("]\n");
    }
    
    FAT32DirEntry* entries = (FAT32DirEntry*)dir_buf;
    int count = 0;
    
    print("  Name        Size     Type\n");
    print("  ----------  -------  ----\n");
    
    for (int i = 0; i < 16; i++) {
        if (entries[i].name[0] == 0x00) break;
        if (entries[i].name[0] == 0xE5) continue;
        if (entries[i].attributes == FAT32_ATTR_LONG_NAME) continue;
        if ((entries[i].name[0] == '.' && entries[i].name[1] == ' ') ||
            (entries[i].name[0] == '.' && entries[i].name[1] == '.')) {
            continue;                           
        }

                      
        char name[13];
        int pos = 0;
        
                           
        for (int j = 0; j < 8; j++) {
            if (entries[i].name[j] != ' ') {
                name[pos++] = entries[i].name[j] >= 'A' && entries[i].name[j] <= 'Z' 
                               ? entries[i].name[j] - 'A' + 'a' 
                               : entries[i].name[j];
            }
        }
        
                     
        if (entries[i].name[8] != ' ') {
            name[pos++] = '.';
            for (int j = 8; j < 11; j++) {
                if (entries[i].name[j] != ' ') {
                    name[pos++] = entries[i].name[j] >= 'A' && entries[i].name[j] <= 'Z' 
                                   ? entries[i].name[j] - 'A' + 'a' 
                                   : entries[i].name[j];
                }
            }
        }
        name[pos] = '\0';
        
                             
        print("  ");
        print(name);
        for (int j = 0; j < 12 - pos; j++) putc(' ');
        
                 
        if (entries[i].attributes & FAT32_ATTR_DIRECTORY) {
            print("  <DIR>   ");
        } else {
            print_int(entries[i].file_size);
            for (int j = 0; j < 8 - (entries[i].file_size > 999999 ? 7 : 1); j++) putc(' ');
        }
        
              
        if (entries[i].attributes & FAT32_ATTR_DIRECTORY) {
            print(" DIR\n");
        } else {
            print(" FILE\n");
        }
        
        count++;
    }
    
    if (count == 0) {
        print("  [empty]\n");
    }
    
    print_int(count);
    print(" entries\n");
}

                                                              
static int cd_single(const char* name) {
    if (strcmp(name, ".") == 0) {
                                            
        return 0;
    }
    
    if (strcmp(name, "..") == 0) {
                                          
        uint8_t dir_buf[4096];
        if (read_cluster(current_dir_cluster, dir_buf) != 0) return -1;
        
        FAT32DirEntry* entries = (FAT32DirEntry*)dir_buf;
        
                                          
        for (int i = 0; i < 16; i++) {
            if (entries[i].name[0] == 0x00) break;
            
            if (entries[i].name[0] == '.' && 
                entries[i].name[1] == '.' && 
                entries[i].name[2] == ' ') {
                uint32_t parent = entries[i].cluster_low | 
                                 (entries[i].cluster_high << 16);
                
                                 
                int len = strlen(current_path_fat32);
                if (len > 1) {
                    len--;                          
                    while (len > 0 && current_path_fat32[len] != '/') len--;
                    if (len == 0) {
                        current_path_fat32[0] = '/';
                        current_path_fat32[1] = '\0';
                    } else {
                        current_path_fat32[len] = '\0';                    
                    }
                }
                
                current_dir_cluster = parent;
                return 0;
            }
        }
        
        print(".. not found!\n");
        return -1;
    }
    
                         
    uint8_t name_83[11];
    name_to_83(name, name_83);
    
    uint8_t dir_buf[4096];
    if (read_cluster(current_dir_cluster, dir_buf) != 0) return -1;
    
    FAT32DirEntry* entries = (FAT32DirEntry*)dir_buf;
    
    for (int i = 0; i < 16; i++) {
        if (entries[i].name[0] == 0x00) break;
        if (entries[i].name[0] == 0xE5) continue;
        if (!(entries[i].attributes & FAT32_ATTR_DIRECTORY)) continue;
        
        if (memcmp(entries[i].name, name_83, 11) == 0) {
            uint32_t new_cluster = entries[i].cluster_low | 
                                  (entries[i].cluster_high << 16);
            
                             
            int len = strlen(current_path_fat32);
            
                                       
            if (len > 0 && current_path_fat32[len-1] != '/') {
                current_path_fat32[len] = '/';
                len++;
            }
            
                            
            for (int j = 0; j < 8 && name[j] != '\0' && name[j] != '/'; j++) {
                current_path_fat32[len++] = name[j] >= 'A' && name[j] <= 'Z' 
                                     ? name[j] - 'A' + 'a' : name[j];
            }
            current_path_fat32[len] = '\0';
            
            current_dir_cluster = new_cluster;
            return 0;
        }
    }
    
    print("Directory not found: ");
    print(name);
    putc('\n');
    return -1;
}

                                        
int fat32_change_dir(const char* path) {
    if (!fat_initialized) return -1;
    if (!path || path[0] == '\0') return -1;
    
                                       
    if (path[0] == '/') {
                             
        current_dir_cluster = root_cluster;
        current_path_fat32[0] = '/';
        current_path_fat32[1] = '\0';
        
        if (path[1] == '\0') return 0;               
        
        path++;                   
    }
    
                            
    char token[256];
    const char* p = path;
    
    while (*p) {
                                               
        int i = 0;
        while (*p && *p != '/' && i < 255) {
            token[i++] = *p++;
        }
        token[i] = '\0';
        
        if (i > 0) {
                                         
            if (cd_single(token) != 0) {
                return -1;
            }
        }
        
                         
        if (*p == '/') p++;
    }
    
    return 0;
}

int fat32_copy_file(const char* src, const char* dest) {
    if (!fat_initialized) return -1;
    
                              
    char src_name[256];
    uint32_t saved_dir;
    if (resolve_path(src, src_name, &saved_dir) != 0) return -1;
    
    uint8_t src_83[11];
    name_to_83(src_name, src_83);
    
                         
    uint8_t dir_buf[4096];
    read_cluster(current_dir_cluster, dir_buf);
    FAT32DirEntry* entries = (FAT32DirEntry*)dir_buf;
    
    FAT32DirEntry* src_entry = NULL;
    for (int i = 0; i < 16; i++) {
        if (entries[i].name[0] == 0x00) break;
        if (entries[i].name[0] == 0xE5) continue;
        if (entries[i].attributes & FAT32_ATTR_DIRECTORY) continue;
        
        if (memcmp(entries[i].name, src_83, 11) == 0) {
            src_entry = &entries[i];
            break;
        }
    }
    
    if (!src_entry) {
        print("Source not found!\n");
        restore_dir(saved_dir);
        return -1;
    }
    
                                                
    uint32_t src_size = src_entry->file_size;
    uint32_t src_cluster = src_entry->cluster_low | (src_entry->cluster_high << 16);
    
    restore_dir(saved_dir);
    
                                        
    Vector* content = vector_create(sizeof(uint8_t), src_size + 16);
    
    uint32_t cluster = src_cluster;
    while (cluster != 0 && cluster < 0x0FFFFFF8) {
        uint8_t cluster_data[4096];
        read_cluster(cluster, cluster_data);
        
        uint32_t to_copy = 4096;
        if (content->size + to_copy > src_size) {
            to_copy = src_size - content->size;
        }
        
        for (uint32_t i = 0; i < to_copy; i++) {
            content->push(content, &cluster_data[i]);
        }
        
        cluster = read_fat(cluster);
    }
    
                         
    if (fat32_create_file(dest) != 0) {
        content->destroy(content);
        return -1;
    }
    
                        
    fat32_write_file(dest, content);
    
    content->destroy(content);
    
    print("File copied (");
    print_int(src_size);
    print(" bytes)\n");
    
    return 0;
}

