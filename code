#include "arch/x86_64/exception.h"
#include "arch/x86_64/context.h"
#include "core/shell.h"
#include "drivers/console.h"
#include "lib/str.h"
#include "lib/colors.h"
#include "drivers/keyboard.h"
#include "lib/logging.h"

static int exception_active = 0;

extern int shell_context_saved;
extern void elf_crash_handler(int vector, ExceptionContext* ctx);

void exception_handler(int vector, ExceptionContext* ctx) {
                                      
    if (shell_context_saved) {
        elf_crash_handler(vector, ctx);
        return;                     
    }
    
                                          
    exception_active = 1;
    log("ERROR", "CPU", "exception raised");
    
    set_color(COLOR_RED, COLOR_BLACK);
    printf("\n*** EXCEPTION %d ***\n", vector);
    reset_color();
    
    printf("RIP: 0x%016X\n", ctx->frame.rip);
    printf("RSP: 0x%016X\n", ctx->frame.rsp);
    printf("RFLAGS: 0x%016X\n", ctx->frame.rflags);
    printf("CS: 0x%04X\n", ctx->frame.cs);
    printf("SS: 0x%04X\n", ctx->frame.ss);
    
    // Показываем регистры
    printf("RAX: 0x%016X  RBX: 0x%016X\n", ctx->rax, ctx->rbx);
    printf("RCX: 0x%016X  RDX: 0x%016X\n", ctx->rcx, ctx->rdx);
    printf("RSI: 0x%016X  RDI: 0x%016X\n", ctx->rsi, ctx->rdi);
    printf("RBP: 0x%016X\n", ctx->rbp);
    
    if (vector == 14) {
        uint64_t cr2;
        __asm__ volatile("mov %%cr2, %0" : "=r"(cr2));
        printf("CR2: 0x%016X\n", cr2);
    }
    
    set_color(COLOR_YELLOW, COLOR_BLACK);
    printf("\n[!] Command terminated by exception.\n");
    printf("    Press Enter to continue.\n");
    reset_color();
    
    while (getchar() != '\n');
    
    exception_active = 0;

    shell_task();
}

