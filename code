#include "arch/x86_64/pci.h"
#include "arch/x86_64/io.h"
#include "drivers/console.h"
#include "lib/str.h"
#include "lib/heap.h"

PCIEntry* pci_devices = NULL;
int pci_device_count = 0;

                            
uint32_t pci_read(uint8_t bus, uint8_t dev, uint8_t func, uint8_t offset) {
    uint32_t address = 0;
    address |= (1 << 31);                             
    address |= (bus << 16);
    address |= (dev << 11);
    address |= (func << 8);
    address |= (offset & 0xFC);
    
    outl(PCI_CONFIG_ADDRESS, address);
    return inl(PCI_CONFIG_DATA);
}

void pci_write(uint8_t bus, uint8_t dev, uint8_t func, uint8_t offset, uint32_t value) {
    uint32_t address = 0;
    address |= (1 << 31);
    address |= (bus << 16);
    address |= (dev << 11);
    address |= (func << 8);
    address |= (offset & 0xFC);
    
    outl(PCI_CONFIG_ADDRESS, address);
    outl(PCI_CONFIG_DATA, value);
}

                                     
PCIDevice pci_read_device(uint8_t bus, uint8_t dev, uint8_t func) {
    PCIDevice device;
    uint32_t* ptr = (uint32_t*)&device;
    
    for (int i = 0; i < sizeof(PCIDevice) / 4; i++) {
        ptr[i] = pci_read(bus, dev, func, i * 4);
    }
    
    return device;
}

                               
PCIDevice* pci_get_device(uint16_t vendor, uint16_t device) {
    PCIEntry* entry = pci_devices;
    while (entry) {
        if (entry->device.vendor_id == vendor && entry->device.device_id == device) {
            return &entry->device;
        }
        entry = entry->next;
    }
    return NULL;
}

                              
PCIDevice* pci_find_class(uint8_t class_code, uint8_t subclass) {
    PCIEntry* entry = pci_devices;
    while (entry) {
        if (entry->device.class_code == class_code && 
            entry->device.subclass == subclass) {
            return &entry->device;
        }
        entry = entry->next;
    }
    return NULL;
}

                           
uint32_t pci_get_bar(PCIDevice* dev, int bar_index) {
    if (bar_index < 0 || bar_index > 5) return 0;
    return dev->bar[bar_index];
}

                                 
int pci_bar_is_io(uint32_t bar) {
    return (bar & 1) == 1;
}

int pci_bar_is_memory(uint32_t bar) {
    return (bar & 1) == 0;
}

uint32_t pci_bar_get_address(uint32_t bar) {
    if (pci_bar_is_io(bar)) {
        return bar & ~0x3;
    } else {
        return bar & ~0xF;
    }
}

void pci_enable_bus_master(PCIDevice* dev) {
    dev->command |= PCI_COMMAND_MASTER | PCI_COMMAND_MEMORY;
}

void pci_scan_bus(uint8_t bus) {
    for (uint8_t dev = 0; dev < 32; dev++) {
        uint32_t vendor = pci_read(bus, dev, 0, 0);
        if (vendor == 0xFFFFFFFF) continue;
        
        uint16_t vendor_id = vendor & 0xFFFF;
        uint16_t device_id = (vendor >> 16) & 0xFFFF;
        
                            
        for (uint8_t func = 0; func < 8; func++) {
            if (func > 0) {
                vendor = pci_read(bus, dev, func, 0);
                if (vendor == 0xFFFFFFFF) continue;
            }
            
            PCIDevice device = pci_read_device(bus, dev, func);
            
                        
            PCIEntry* entry = (PCIEntry*)kmalloc(sizeof(PCIEntry));
            if (!entry) {
                printf("PCI: Out of memory\n");
                continue;
            }
            entry->device = device;
            entry->bus = bus;
            entry->dev = dev;
            entry->func = func;
            entry->next = pci_devices;
            pci_devices = entry;
            pci_device_count++;
            
            #ifdef DEBUG_PCI       
            printf("PCI: %02X:%02X.%d VID=0x%04X DID=0x%04X CLASS=0x%02X%02X\n",
                   bus, dev, func, device.vendor_id, device.device_id,
                   device.class_code, device.subclass);
            #endif
                                                       
            if (device.class_code == PCI_CLASS_BRIDGE && device.subclass == 0x04) {
                uint32_t bus_num = pci_read(bus, dev, func, 0x18);
                uint8_t secondary_bus = (bus_num >> 8) & 0xFF;
                if (secondary_bus != 0 && secondary_bus != bus) {
                    #ifdef DEBUG_PCI
                    printf("PCI: Bridge to bus %d\n", secondary_bus);
                    #endif
                    pci_scan_bus(secondary_bus);
                }
            }
        }
    }
}

                            
void pci_init(void) {
    #ifdef DEBUG_PCI
    printf("PCI: Scanning...\n");
    #endif
    
    uint32_t vendor = pci_read(0, 0, 0, 0);
    if (vendor == 0xFFFFFFFF) {
        #ifdef DEBUG_PCI
        printf("PCI: Not available!\n");
        #endif
        return;
    }
    
    pci_scan_bus(0);
    #ifdef DEBUG_PCI
    printf("PCI: Found %d devices\n", pci_device_count);
    #endif
}

                   
void pci_dump(PCIDevice* dev) {
    if (!dev) return;
    
    printf("  VID: 0x%04X\n", dev->vendor_id);
    printf("  DID: 0x%04X\n", dev->device_id);
    printf("  Class: 0x%02X/0x%02X\n", dev->class_code, dev->subclass);
    printf("  BAR0: 0x%08X\n", dev->bar[0]);
    printf("  BAR1: 0x%08X\n", dev->bar[1]);
    printf("  BAR2: 0x%08X\n", dev->bar[2]);
    printf("  BAR3: 0x%08X\n", dev->bar[3]);
    printf("  BAR4: 0x%08X\n", dev->bar[4]);
    printf("  BAR5: 0x%08X\n", dev->bar[5]);
    printf("  IRQ: %d\n", dev->interrupt_line);
}

                                
void pci_list(void) {
    PCIEntry* entry = pci_devices;
    printf("\n=== PCI Devices ===\n");
    printf("%-12s %-10s %-10s %-10s %-10s\n", 
           "Bus:Dev.Fn", "Vendor", "Device", "Class", "Subclass");
    printf("------------------------------------------------\n");
    
    while (entry) {
        printf("%02X:%02X.%d   0x%04X    0x%04X    0x%02X      0x%02X\n",
               entry->bus, entry->dev, entry->func,
               entry->device.vendor_id, entry->device.device_id,
               entry->device.class_code, entry->device.subclass);
        entry = entry->next;
    }
    printf("Total: %d devices\n", pci_device_count);
}

void pci_show(uint8_t bus, uint8_t dev, uint8_t func) {
    PCIDevice device = pci_read_device(bus, dev, func);
    pci_dump(&device);
}

