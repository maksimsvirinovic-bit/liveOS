#include "apic_timer.h"
#include "apic.h"
#include "console.h"
#include "io.h"
#include "str.h"

// ===== APIC BASE =====
#define APIC_BASE 0xFEE00000

static volatile uint32_t* apic = (volatile uint32_t*)APIC_BASE;

// ===== ГЛОБАЛЬНЫЕ =====
static uint64_t ticks = 0;
static uint32_t ticks_per_ms = 0;
static uint32_t timer_frequency = 0;

// ===== APIC READ/WRITE =====
static uint32_t apic_read(uint32_t reg) {
    return *(volatile uint32_t*)((uint8_t*)apic + reg);
}

static void apic_write(uint32_t reg, uint32_t val) {
    *(volatile uint32_t*)((uint8_t*)apic + reg) = val;
}

// ===== КАЛИБРОВКА APIC TIMER =====
// Используем PIT для калибровки
static void pit_sleep_ms(uint32_t ms) {
    // PIT работает на частоте 1.193182 MHz
    // Для 1 ms: 1193182 / 1000 = 1193 тиков
    uint32_t pit_ticks = 1193 * ms;
    
    // Устанавливаем PIT на один выстрел
    outb(0x43, 0xB0);  // Channel 2, mode 0 (interrupt on terminal count)
    outb(0x42, pit_ticks & 0xFF);
    outb(0x42, (pit_ticks >> 8) & 0xFF);
    
    // Ждём, пока счётчик не дойдёт до 0
    // Читаем статус PIT
    for (volatile int i = 0; i < 10000000; i++) {
        // Просто задержка
    }
}

static uint32_t apic_timer_calibrate(void) {
    printf("[APIC Timer] Calibrating...\n");
    
    // 1. Устанавливаем делитель = 16
    apic_write(APIC_TIMER_DIVIDE, APIC_DIV_16);
    
    // 2. Устанавливаем начальное значение = максимум
    apic_write(APIC_TIMER_INITIAL, 0xFFFFFFFF);
    
    // 3. Ждём 10 ms (используем PIT)
    // Для точности лучше использовать PIT, но для простоты — цикл
    for (volatile uint64_t i = 0; i < 10000000; i++);
    
    // 4. Читаем текущее значение
    uint32_t current = apic_read(APIC_TIMER_CURRENT);
    
    // 5. Останавливаем таймер
    apic_write(APIC_TIMER_INITIAL, 0);
    
    // 6. Вычисляем частоту
    // elapsed = 0xFFFFFFFF - current
    // За 10 ms прошло elapsed тиков
    // frequency = elapsed * 100 (для 1 секунды)
    uint32_t elapsed = 0xFFFFFFFF - current;
    uint32_t frequency = elapsed * 100;  // ticks per second
    
    printf("[APIC Timer] Elapsed: %u ticks in ~10ms\n", elapsed);
    printf("[APIC Timer] Frequency: %u Hz\n", frequency);
    
    return frequency;
}

// ===== ИНИЦИАЛИЗАЦИЯ =====
int apic_timer_init(uint32_t frequency_hz) {
    printf("[APIC Timer] Initializing...\n");
    
    // 1. Проверяем, что APIC доступен
    if (!apic) {
        printf("[APIC Timer] APIC not available!\n");
        return -1;
    }
    
    // 2. Калибруем (узнаём частоту шины APIC)
    uint32_t apic_frequency = apic_timer_calibrate();
    if (apic_frequency == 0) {
        printf("[APIC Timer] Calibration failed!\n");
        return -1;
    }
    
    // 3. Вычисляем ticks_per_ms
    ticks_per_ms = apic_frequency / 1000;
    
    // 4. Вычисляем начальное значение для нужной частоты
    // С делителем 16: initial = apic_frequency / 16 / frequency_hz
    uint32_t initial = apic_frequency / 16 / frequency_hz;
    
    printf("[APIC Timer] Target: %u Hz, Initial: %u\n", frequency_hz, initial);
    
    // 5. Настраиваем таймер
    apic_write(APIC_TIMER_DIVIDE, APIC_DIV_16);
    apic_write(APIC_TIMER_INITIAL, initial);
    apic_write(APIC_TIMER_LVT, APIC_TIMER_VECTOR | APIC_TIMER_PERIODIC);
    
    timer_frequency = frequency_hz;
    ticks = 0;
    
    printf("[APIC Timer] Ready (%u Hz)\n", frequency_hz);
    return 0;
}

// ===== СТАРТ/СТОП =====
void apic_timer_start(void) {
    // Включаем таймер (снимаем маску)
    uint32_t lvt = apic_read(APIC_TIMER_LVT);
    lvt &= ~(1 << 16);  // Снимаем бит маски
    apic_write(APIC_TIMER_LVT, lvt);
}

void apic_timer_stop(void) {
    // Маскируем таймер
    uint32_t lvt = apic_read(APIC_TIMER_LVT);
    lvt |= (1 << 16);  // Устанавливаем бит маски
    apic_write(APIC_TIMER_LVT, lvt);
}

// ===== ОБРАБОТЧИК ПРЕРЫВАНИЯ =====
void apic_timer_handler(void) {
    ticks++;

    scheduler_tick();
    
    // Отправляем EOI
    apic_write(0xB0, 0);  // APIC_EOI
}

// ===== ВРЕМЯ =====
uint64_t apic_timer_get_ticks(void) {
    return ticks;
}

uint64_t apic_timer_get_ms(void) {
    return ticks * 1000 / timer_frequency;
}

void apic_timer_sleep_ms(uint32_t ms) {
    uint64_t target = apic_timer_get_ms() + ms;
    while (apic_timer_get_ms() < target) {
        __asm__ volatile("hlt");
    }
}

