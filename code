static inline int sqrt_int(int x) {
    if (x <= 0) return 0;
    int n = x;
    int result = (n + 1) / 2;
    while (1) {
        int prev = result;
        result = (result + n / result) / 2;
        if (result >= prev) return prev;
    }
}

