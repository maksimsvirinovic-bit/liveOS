static Ext4_Superblock superblock;
static uint32_t block_size = 4096;                     
static int ext4_initialized = 0;
static uint16_t ext4_ata_base = ATA_PRIMARY_DATA;
static int ext4_ata_slave = 0;
static uint32_t ext4_start_lba = 0;

static uint32_t journal_inode_num = 8;
static uint32_t journal_block_start = 200;
static uint32_t journal_sequence = 1;
static int journal_active = 1;
static uint32_t ext4_current_dir = 2;         
Vector* current_path_ext4 = NULL;
static int flag = 0;

                                   
static uint32_t get_block_size(void) {
    return 1024 << superblock.s_log_block_size;
}

               
static int read_block(uint64_t block_num, uint8_t* buffer) {
    uint64_t lba = ext4_start_lba + block_num * (block_size / 512);
    uint32_t sectors = block_size / 512;
    
    for (uint32_t i = 0; i < sectors; i++) {
        if (ata_read_sector(ext4_ata_base, ext4_ata_slave, lba + i,
                            buffer + i * 512) != 0) {
            return -1;
        }
    }
    return 0;
}

               
static int write_block(uint64_t block_num, const uint8_t* buffer) {
    uint64_t lba = ext4_start_lba + block_num * (block_size / 512);
    uint32_t sectors = block_size / 512;
    
    for (uint32_t i = 0; i < sectors; i++) {
        if (ata_write_sector(ext4_ata_base, ext4_ata_slave, lba + i,
                             buffer + i * 512) != 0) {
            return -1;
        }
    }
    return 0;
}

                  
static void ext4_free_block(uint32_t block_num) {
                     
    uint32_t group = block_num / superblock.s_blocks_per_group;
    uint32_t index = block_num % superblock.s_blocks_per_group;
    
                           
    uint8_t gd_buf[4096];
    read_block(2, gd_buf);
    Ext4_GroupDesc* gd = (Ext4_GroupDesc*)(gd_buf + group * superblock.s_desc_size);
    
    uint8_t bitmap_buf[4096];
    read_block(gd->bg_block_bitmap_lo, bitmap_buf);
    
                     
    bitmap_buf[index / 8] &= ~(1 << (index % 8));
    
    write_block(gd->bg_block_bitmap_lo, bitmap_buf);
}

                                         
static void ext4_free_all_blocks(Ext4_Inode* inode) {
    if (!inode) return;
    
    uint32_t blocks_per_indirect = block_size / 4;
    
                              
    for (int i = 0; i < 12; i++) {
        if (inode->i_block[i] != 0) {
            ext4_free_block(inode->i_block[i]);
            inode->i_block[i] = 0;
        }
    }
    
                                
    if (inode->i_block[12] != 0) {
        uint32_t indirect_block = inode->i_block[12];
        uint32_t* indirect_table = (uint32_t*)kmalloc(block_size);
        if (indirect_table) {
            read_block(indirect_block, (uint8_t*)indirect_table);
            for (uint32_t i = 0; i < blocks_per_indirect; i++) {
                if (indirect_table[i] != 0) {
                    ext4_free_block(indirect_table[i]);
                }
            }
            kfree(indirect_table);
        }
        ext4_free_block(indirect_block);
        inode->i_block[12] = 0;
    }
    
                                        
    if (inode->i_block[13] != 0) {
        uint32_t double_indirect_block = inode->i_block[13];
        uint32_t* double_indirect_table = (uint32_t*)kmalloc(block_size);
        if (double_indirect_table) {
            read_block(double_indirect_block, (uint8_t*)double_indirect_table);
            
            for (uint32_t i = 0; i < blocks_per_indirect; i++) {
                uint32_t sub_block = double_indirect_table[i];
                if (sub_block != 0) {
                    uint32_t* sub_table = (uint32_t*)kmalloc(block_size);
                    if (!sub_table) {
                        printf("ext4: Out of memory\n");
                        continue;
                    }
                    if (sub_table) {
                        read_block(sub_block, (uint8_t*)sub_table);
                        for (uint32_t j = 0; j < blocks_per_indirect; j++) {
                            if (sub_table[j] != 0) {
                                ext4_free_block(sub_table[j]);
                            }
                        }
                        kfree(sub_table);
                    }
                    ext4_free_block(sub_block);
                }
            }
            kfree(double_indirect_table);
        }
        ext4_free_block(double_indirect_block);
        inode->i_block[13] = 0;
    }
    
                                                    
    if (inode->i_block[14] != 0) {
                                                
        ext4_free_block(inode->i_block[14]);
        inode->i_block[14] = 0;
    }
}

                   
static void ext4_free_inode(uint32_t inode_num) {
    uint32_t group = (inode_num - 1) / superblock.s_inodes_per_group;
    uint32_t index = (inode_num - 1) % superblock.s_inodes_per_group;
    
    uint8_t gd_buf[4096];
    read_block(2, gd_buf);
    Ext4_GroupDesc* gd = (Ext4_GroupDesc*)(gd_buf + group * superblock.s_desc_size);
    
    uint8_t bitmap_buf[4096];
    read_block(gd->bg_inode_bitmap_lo, bitmap_buf);
    
    bitmap_buf[index / 8] &= ~(1 << (index % 8));
    
    write_block(gd->bg_inode_bitmap_lo, bitmap_buf);
}

                    
int ext4_journal_start(void) {
    if (!journal_active) return -1;
    return 0;
}

                  
int ext4_journal_write(uint32_t block, const uint8_t* data) {
    if (!journal_active) return -1;
    
                                          
    write_block(journal_block_start + journal_sequence, data);
    journal_sequence++;
    
    return 0;
}

                    
int ext4_journal_commit(void) {
    if (!journal_active) return -1;
    
                              
    uint8_t commit_buf[4096];
    memset(commit_buf, 0, 4096);
    
    JournalHeader* header = (JournalHeader*)commit_buf;
    header->j_magic = EXT4_JOURNAL_MAGIC;
    header->j_blocktype = JFS_COMMIT_BLOCK;
    header->j_sequence = journal_sequence;
    
    write_block(journal_block_start + journal_sequence, commit_buf);
    journal_sequence++;
    
    return 0;
}

                            
int ext4_journal_recover(void) {
    print("ext4: Journal recovery...\n");
    
                                                    
    uint8_t buf[4096];
    read_block(journal_block_start + 1, buf);
    
    JournalHeader* header = (JournalHeader*)buf;
    if (header->j_magic == EXT4_JOURNAL_MAGIC) {
        print("  Found journal sequence: ");
        print_int(header->j_sequence);
        putc('\n');
        
                                                       
    }
    
    return 0;
}

int ext4_check_integrity(void) {
    
                           
    if (superblock.s_magic != 0xEF53) {
        print("  FAIL: Bad magic!\n");
        return -1;
    }
    
                         
    if (superblock.s_free_blocks_count_lo > superblock.s_blocks_count_lo) {
        print("  FAIL: Free blocks > total blocks!\n");
        return -1;
    }
    
    if (superblock.s_free_inodes_count > superblock.s_inodes_count) {
        print("  FAIL: Free inodes > total inodes!\n");
        return -1;
    }
    #ifdef DEBUG_EXT4
    print("Check integrity OK\n");
    #endif
    return 0;
}

int path_init(void) {
    if (flag == 0) return -1;
    current_path_ext4 = vector_create(sizeof(char), 256);
    char root = '/';
    current_path_ext4->push(current_path_ext4, &root);
    return current_path_ext4 ? 0 : -1;
}

                            
int ext4_init(void) {
    
                                                       
    uint8_t buf[4096];
    
                         
    if (read_block(0, buf) != 0) {
        print("ext4: Cannot read superblock!\n");
        return -1;
    }

    if (superblock.s_state & EXT4_ERROR_FS) {
        print("ext4: Filesystem has errors! Recovering...\n");
        ext4_journal_recover();
        superblock.s_state = EXT4_VALID_FS;
    }
    
                                                
    memcpy(&superblock, buf + 1024, sizeof(Ext4_Superblock));
    
                      
    ext4_check_integrity();
    
                            
    block_size = get_block_size();

    uint8_t bitmap[4096];
    read_block(3, bitmap);

    if (flag == 0){
        current_path_ext4 = vector_create(sizeof(char), 256);
        char root = '/';
        current_path_ext4->push(current_path_ext4, &root);
        flag = 1;
    }
    
    ext4_initialized = 1;
    return 0;
}

int ext4_mount_device(uint16_t base, int slave, uint32_t start_lba) {
    ext4_ata_base = base;
    ext4_ata_slave = slave ? 1 : 0;
    ext4_start_lba = start_lba;
    ext4_initialized = 0;
    if (current_path_ext4) current_path_ext4->clear(current_path_ext4);
    return ext4_init();
}

uint16_t ext4_device_base(void) { return ext4_ata_base; }
int ext4_device_slave(void) { return ext4_ata_slave; }
uint32_t ext4_device_start(void) { return ext4_start_lba; }

const char* path_get(void) {
    if (!current_path_ext4 || current_path_ext4->size == 0) {
        return "/";
    }
    
                                        
    char null_char = '\0';
    current_path_ext4->push(current_path_ext4, &null_char);
    const char* result = (const char*)current_path_ext4->data;
    current_path_ext4->pop(current_path_ext4);                 
    
    return result;
}

void path_set(const char* new_path) {
    if (!current_path_ext4) path_init();
    
    current_path_ext4->clear(current_path_ext4);
    
    for (int i = 0; new_path[i]; i++) {
        current_path_ext4->push(current_path_ext4, &new_path[i]);
    }
}

void path_append(const char* component) {
    if (!current_path_ext4) path_init();
    
                               
    if (current_path_ext4->size > 0) {
        char last = current_path_ext4->data[current_path_ext4->size - 1];
        if (last != '/') {
            char slash = '/';
            current_path_ext4->push(current_path_ext4, &slash);
        }
    }
    
    for (int i = 0; component[i]; i++) {
        current_path_ext4->push(current_path_ext4, &component[i]);
    }
}

void path_go_up(void) {
    if (!current_path_ext4) return;
    
    if (current_path_ext4->size <= 1) return;                
    
                                                 
    if (current_path_ext4->data[current_path_ext4->size - 1] == '/') {
        current_path_ext4->pop(current_path_ext4);
    }
    
                                
    while (current_path_ext4->size > 1) {
        char c = current_path_ext4->data[current_path_ext4->size - 1];
        if (c == '/') break;
        current_path_ext4->pop(current_path_ext4);
    }
}

