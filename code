int desktop_remove_icon(Desktop* d, const char* name) {
    if (!d || !name) return -1;
    
    for (uint32_t i = 0; i < d->icons->size; i++) {
        DesktopIcon* icon = *(DesktopIcon**)d->icons->at(d->icons, i);
        if (strcmp(icon->name, name) == 0) {
            // Remove by swapping with last and popping
            DesktopIcon* last = *(DesktopIcon**)d->icons->at(d->icons, d->icons->size - 1);
            *(DesktopIcon**)d->icons->at(d->icons, i) = last;
            d->icons->size--;
            kfree(icon);
            printf("[Desktop] Removed icon: %s\n", name);
            return 0;
        }
    }
    
    return -1;
}

