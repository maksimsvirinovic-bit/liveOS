uint64_t ext4_file_hash(const char* path) {
    if (!ext4_initialized) return 0;
    
    Vector* content = vector_create(sizeof(uint8_t), 256);
    int size = ext4_read_file(path, content);
    
    if (size <= 0) {
        content->destroy(content);
        return 0;
    }
    
                    
    uint64_t hash = 0xcbf29ce484222325ULL;
    
    for (int i = 0; i < size; i++) {
        hash ^= content->data[i];
        hash *= 0x100000001b3ULL;
    }
    
    content->destroy(content);
    
    return hash;
}

                                            
int ext4_encrypt_file(const char* path, const uint8_t* key, uint32_t key_len) {
    if (!ext4_initialized) return -1;
    
    print("ext4: Encrypting ");
    print(path);
    print("\n");
    
    Vector* content = vector_create(sizeof(uint8_t), 256);
    int size = ext4_read_file(path, content);
    
    if (size <= 0) {
        content->destroy(content);
        return -1;
    }
    
                             
    uint8_t S[256];
    for (int i = 0; i < 256; i++) S[i] = i;
    
    int j = 0;
    for (int i = 0; i < 256; i++) {
        j = (j + S[i] + key[i % key_len]) % 256;
        uint8_t tmp = S[i];
        S[i] = S[j];
        S[j] = tmp;
    }
    
              
    int i = 0;
    j = 0;
    for (int pos = 0; pos < size; pos++) {
        i = (i + 1) % 256;
        j = (j + S[i]) % 256;
        
        uint8_t tmp = S[i];
        S[i] = S[j];
        S[j] = tmp;
        
        uint8_t keystream = S[(S[i] + S[j]) % 256];
        content->data[pos] ^= keystream;
    }
    
    ext4_write_file(path, content);
    content->destroy(content);
    
    print("ext4: Encrypted (");
    print_int(size);
    print(" bytes)\n");
    
    return 0;
}

int ext4_decrypt_file(const char* path, const uint8_t* key, uint32_t key_len) {
                                                             
    return ext4_encrypt_file(path, key, key_len);
}

int ext4_stat(const char* path, Ext4_Stat* stat) {
    if (!ext4_initialized) return -1;
    if (!stat) return -1;
    
                    
    Ext4_Inode inode;
    uint32_t inode_num = 0;
    
                         
    char parent[512], name[256];
    char* last_slash = NULL;
    for (char* p = (char*)path; *p; p++) {
        if (*p == '/') last_slash = p;
    }
    
    if (last_slash) {
        int len = last_slash - path;
        for (int i = 0; i < len; i++) parent[i] = path[i];
        parent[len] = '\0';
        strcpy(name, last_slash + 1);
    } else {
        strcpy(parent, "/");
        strcpy(name, path);
    }
    if (parent[0] == '\0') strcpy(parent, "/");
    
               
    if (strcmp(path, "/") == 0) {
        inode_num = 2;
        read_inode(inode_num, &inode);
    } else {
                           
        Ext4_Inode parent_inode;
        uint32_t parent_num;
        if (ext4_find_path_with_num(parent, &parent_inode, &parent_num) != 0) {
            return -1;
        }
        
                    
        uint8_t dir_buf[4096];
        read_block(parent_inode.i_block[0], dir_buf);
        
        int offset = 0;
        int found = 0;
        
        while (offset < (int)parent_inode.i_size_lo) {
            Ext4_DirEntry* entry = (Ext4_DirEntry*)(dir_buf + offset);
            if (entry->inode != 0) {
                char entry_name[256];
                for (int i = 0; i < entry->name_len && i < 255; i++) {
                    entry_name[i] = entry->name[i];
                }
                entry_name[entry->name_len] = '\0';
                
                if (strcmp(entry_name, name) == 0) {
                    inode_num = entry->inode;
                    found = 1;
                    break;
                }
            }
            offset += entry->rec_len;
        }
        
        if (!found) {
            print("ext4: File not found for stat!\n");
            return -1;
        }
        
        read_inode(inode_num, &inode);
    }
    
                           
    stat->inode_num = inode_num;
    stat->mode = inode.i_mode;
    stat->uid = inode.i_uid;
    stat->gid = inode.i_gid;
    stat->size = inode.i_size_lo;
    stat->atime = inode.i_atime;
    stat->mtime = inode.i_mtime;
    stat->ctime = inode.i_ctime;
    stat->dtime = inode.i_dtime;
    stat->links_count = inode.i_links_count;
    stat->blocks = inode.i_blocks_lo;
    stat->flags = inode.i_flags;
    
                     
    switch (inode.i_mode & EXT4_S_IFMT) {
        case EXT4_S_IFREG: stat->type_char = '-'; break;
        case EXT4_S_IFDIR: stat->type_char = 'd'; break;
        case EXT4_S_IFLNK: stat->type_char = 'l'; break;
        case EXT4_S_IFCHR: stat->type_char = 'c'; break;
        case EXT4_S_IFBLK: stat->type_char = 'b'; break;
        case EXT4_S_IFIFO: stat->type_char = 'p'; break;
        case EXT4_S_IFSOCK: stat->type_char = 's'; break;
        default: stat->type_char = '?';
    }
    
    return 0;
}

                   
