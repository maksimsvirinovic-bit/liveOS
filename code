static int find_reg(const char* name, int* code, int* is64, int* ext) {
    for (int i = 0; i < 8 && name[i]; i++) putc(name[i]);
    
    const char* regs64[] = {
        "rax","rcx","rdx","rbx","rsp","rbp","rsi","rdi",
        "r8","r9","r10","r11","r12","r13","r14","r15"
    };
    const char* regs32[] = {
        "eax","ecx","edx","ebx","esp","ebp","esi","edi",
        "r8d","r9d","r10d","r11d","r12d","r13d","r14d","r15d"
    };
    char clean[16];
    int k = 0;
    while (name[k] && name[k] != ' ' && name[k] != '\t' && name[k] != '\r' && name[k] != '\n' && k < 15) {
        clean[k] = name[k];
        k++;
    }
    clean[k] = '\0';
    
    for (int i = 0; i < 16; i++) {
        if (strcmp(clean, regs64[i]) == 0) {
            *code = i; *is64 = 1; *ext = (i >= 8);
            return 1;
        }
        if (strcmp(clean, regs32[i]) == 0) {
            *code = i; *is64 = 0; *ext = (i >= 8);
            return 1;
        }
    }
    
    return 0;
}

                                          
                                                            
