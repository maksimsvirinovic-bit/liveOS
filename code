static inline int rect_intersects(Rect a, Rect b) {
    return !(a.x + a.w <= b.x || b.x + b.w <= a.x ||
             a.y + a.h <= b.y || b.y + b.h <= a.y);
}

static inline Rect rect_intersection(Rect a, Rect b) {
    Rect result;
    result.x = max_int(a.x, b.x);
    result.y = max_int(a.y, b.y);
    result.w = min_int(a.x + a.w, b.x + b.w) - result.x;
    result.h = min_int(a.y + a.h, b.y + b.h) - result.y;
    if (result.w < 0) result.w = 0;
    if (result.h < 0) result.h = 0;
    return result;
}

static inline Rect rect_union(Rect a, Rect b) {
    Rect result;
    result.x = min_int(a.x, b.x);
    result.y = min_int(a.y, b.y);
    result.w = max_int(a.x + a.w, b.x + b.w) - result.x;
    result.h = max_int(a.y + a.h, b.y + b.h) - result.y;
    return result;
}

