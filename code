static DriverInfo* parse_driver_info(const char* path) {
    char info_path[256];
    sprintf(info_path, "%s/info.cfg", path);
    
    Ext4_Stat stat;
    if (ext4_stat(info_path, &stat) != 0) {
        printf("Driver: info.cfg not found!\n");
        return NULL;
    }
    
    DriverInfo* info = (DriverInfo*)kmalloc(sizeof(DriverInfo));
    if (!info) {
        printf("Driver: Out of memory\n");
        return NULL;
    }
    memset(info, 0, sizeof(DriverInfo));
    
    info->pci_reserve = vector_create(sizeof(PCIReserve), 8);
    info->dependencies = vector_create(sizeof(Vector*), 4);
    info->conflicts = vector_create(sizeof(Vector*), 4);
    info->symbols = vector_create(sizeof(Vector*), 8);
    
    Vector* content = vector_create(sizeof(uint8_t), 256);
    read_file(info_path, content);
    
    char* data = (char*)content->data;
    char* line = strtok(data, "\n");
    
    while (line) {
        char* start = line;
        while (*start == ' ' || *start == '\t') start++;
        if (*start == '#' || *start == '\0') { line = strtok(NULL, "\n"); continue; }
        
        char* eq = strchr(start, '=');
        if (eq) {
            *eq = '\0';
            char* key = start;
            char* val = eq + 1;
            while (*val == ' ') val++;
            
            char* end = val + strlen(val) - 1;
            while (end > val && (*end == ' ' || *end == '\t' || *end == '\n' || *end == '\r')) end--;
            *(end + 1) = '\0';
            
            if (strcmp(key, "name") == 0) {
                info->name = vec_str_create(val);
            }
            else if (strcmp(key, "version") == 0) {
                info->version = vec_str_create(val);
            }
            else if (strcmp(key, "vendor") == 0) {
                info->vendor = vec_str_create(val);
            }
            else if (strcmp(key, "description") == 0) {
                info->description = vec_str_create(val);
            }
            else if (strcmp(key, "cert") == 0) {
                info->cert_path = vec_str_create(val);
            }
            else if (strcmp(key, "entry") == 0) {
                info->entry_point = vec_str_create(val);
            }
            else if (strcmp(key, "pci") == 0) {
                PCIReserve res;
                memset(&res, 0, sizeof(PCIReserve));
                sscanf(val, "%hx:%hx", &res.vendor_id, &res.device_id);
                info->pci_reserve->push(info->pci_reserve, &res);
            }
            else if (strcmp(key, "pci_class") == 0) {
                PCIReserve res;
                memset(&res, 0, sizeof(PCIReserve));
                sscanf(val, "%hhx:%hhx", &res.class_code, &res.subclass);
                res.use_class = 1;
                info->pci_reserve->push(info->pci_reserve, &res);
            }
            else if (strcmp(key, "deps") == 0) {
                char* dep = strtok(val, ",");
                while (dep) {
                    while (*dep == ' ') dep++;
                    vec_push_str(info->dependencies, dep);
                    dep = strtok(NULL, ",");
                }
            }
            else if (strcmp(key, "conflicts") == 0) {
                char* conf = strtok(val, ",");
                while (conf) {
                    while (*conf == ' ') conf++;
                    vec_push_str(info->conflicts, conf);
                    conf = strtok(NULL, ",");
                }
            }
            else if (strcmp(key, "symbols") == 0) {
                char* sym = strtok(val, ",");
                while (sym) {
                    while (*sym == ' ') sym++;
                    vec_push_str(info->symbols, sym);
                    sym = strtok(NULL, ",");
                }
            }
        }
        line = strtok(NULL, "\n");
    }
    
    content->destroy(content);
    return info;
}

                       
int driver_load(const char* path) {
    #ifdef DEBUG_DRIVER_MANAGER
    printf("Loading driver from: %s\n", path);
    #endif
    
    char info_path[256];
    strcpy(info_path, path);
    Ext4_Stat path_stat;
    if (ext4_stat(path, &path_stat) == 0 &&
        (path_stat.mode & EXT4_S_IFMT) != EXT4_S_IFDIR) {
        char* slash = strrchr(info_path, '/');
        if (slash && slash != info_path) *slash = '\0';
        else strcpy(info_path, "/");
    }

    DriverInfo* info = parse_driver_info(info_path);
    if (!info) return -1;
    
                            
    for (uint32_t i = 0; i < info->dependencies->size; i++) {
        Vector* dep_vec = vec_get_str(info->dependencies, i);
        char* dep = vec_str_get(dep_vec);
        if (!driver_is_loaded(dep)) {
            printf("Driver: Dependency not loaded: %s\n", dep);
            return -1;
        }
    }
    
                          
    for (uint32_t i = 0; i < info->conflicts->size; i++) {
        Vector* conf_vec = vec_get_str(info->conflicts, i);
        char* conf = vec_str_get(conf_vec);
        if (driver_is_loaded(conf)) {
            printf("Driver: Conflict with: %s\n", conf);
            return -1;
        }
    }
    
    char drv_path[256];
    Ext4_Stat binary_stat;
    int binary_found = 0;

    // Accept <package>/<package-name>.drv, <package>/main.drv,
    // or a direct ELF driver file. The loader knows no device names.
    const char* package_name = strrchr(path, '/');
    package_name = package_name ? package_name + 1 : path;
    char binary_name[128];
    strcpy(binary_name, package_name);
    char* extension = strrchr(binary_name, '.');
    if (extension) *extension = '\0';
    strcat(binary_name, ".drv");
    sprintf(drv_path, "%s/%s", path, binary_name);
    if (ext4_stat(drv_path, &binary_stat) == 0) {
        binary_found = 1;
    } else {
        sprintf(drv_path, "%s/main.drv", path);
        if (ext4_stat(drv_path, &binary_stat) == 0) {
            binary_found = 1;
        } else {
            Ext4_Stat package_stat;
            if (ext4_stat(path, &package_stat) == 0 &&
                (package_stat.mode & EXT4_S_IFMT) != EXT4_S_IFDIR) {
                strcpy(drv_path, path);
                binary_found = 1;
            }
        }
    }

    if (!binary_found) {
        printf("Driver: ELF file not found in %s\n", path);
        return -1;
    }

    void* handle = driver_load_elf(drv_path);
    if (!handle) {
        printf("Driver: Failed to load ELF\n");
        return -1;
    }
    
    Driver* drv = (Driver*)kmalloc(sizeof(Driver));
    if (!drv) {
        printf("Driver: Out of memory\n");
        return -1;
    }
    memset(drv, 0, sizeof(Driver));
    drv->info = *info;
    drv->info.handle = handle;
    drv->info.loaded = 1;
    drv->next = NULL;
    
                           
    for (uint32_t i = 0; i < info->symbols->size; i++) {
        Vector* sym_vec = vec_get_str(info->symbols, i);
        char* sym = vec_str_get(sym_vec);
        if (sym) {
            driver_export_symbol(sym, driver_image_symbol(handle, sym));
        }
    }
    
    if (!drivers) {
        drivers = vector_create(sizeof(Driver*), 16);
    }
    drivers->push(drivers, &drv);
    driver_count++;
    
                           
    char* entry = vec_str_get(info->entry_point);
    if (entry) {
        DriverInit init = (DriverInit)driver_image_symbol(handle, entry);
        if (init) {
            int ret = init();
            if (ret != 0) {
                printf("Driver: Init failed with code %d\n", ret);
                driver_unload(vec_str_get(info->name));
                return -1;
            }
        }
    }
    
    pci_table_update();

    #ifdef DEBUG_DRIVER_MANAGER
    printf("Driver: %s loaded successfully\n", vec_str_get(info->name));
    #endif
    return 0;
}

                                
int driver_is_loaded(const char* name) {
    if (!drivers) return 0;
    for (uint32_t i = 0; i < drivers->size; i++) {
        Driver** drv_ptr = (Driver**)drivers->at(drivers, i);
        Driver* drv = *drv_ptr;
        char* drv_name = vec_str_get(drv->info.name);
        if (strcmp(drv_name, name) == 0) return 1;
    }
    return 0;
}

                             
Driver* driver_find(const char* name) {
    if (!drivers) return NULL;
    for (uint32_t i = 0; i < drivers->size; i++) {
        Driver** drv_ptr = (Driver**)drivers->at(drivers, i);
        Driver* drv = *drv_ptr;
        char* drv_name = vec_str_get(drv->info.name);
        if (strcmp(drv_name, name) == 0) return drv;
    }
    return NULL;
}

                    
int driver_handles_pci(Driver* drv, PCIDevice* dev) {
    for (uint32_t i = 0; i < drv->info.pci_reserve->size; i++) {
        PCIReserve* res = (PCIReserve*)drv->info.pci_reserve->at(drv->info.pci_reserve, i);
        if (res->use_class) {
            if (dev->class_code == res->class_code &&
                dev->subclass == res->subclass) {
                return 1;
            }
        } else {
            if (dev->vendor_id == res->vendor_id &&
                dev->device_id == res->device_id) {
                return 1;
            }
        }
    }
    return 0;
}

int driver_probe_all(void) {
    if (!pci_devices) return 0;
    int probed = 0;
    
    PCIEntry* entry = pci_devices;
    while (entry) {
        for (uint32_t i = 0; i < drivers->size; i++) {
            Driver** drv_ptr = (Driver**)drivers->at(drivers, i);
            Driver* drv = *drv_ptr;
            
            if (driver_handles_pci(drv, &entry->device)) {
                #ifdef DEBUG_DRIVER_MANAGER
                printf("Driver: %s -> PCI %02X:%02X.%d\n",
                       vec_str_get(drv->info.name), entry->bus, entry->dev, entry->func);
                #endif
                probed++;
                
                char* entry_pt = vec_str_get(drv->info.entry_point);
                if (entry_pt) {
                    DriverProbe probe = (DriverProbe)driver_image_symbol(drv->info.handle, entry_pt);
                    if (probe) {
                        probe(&entry->device);
                    }
                }
            }
        }
        entry = entry->next;
    }
    
    return probed;
}

                       
int driver_unload(const char* name) {
    for (uint32_t i = 0; i < drivers->size; i++) {
        Driver** drv_ptr = (Driver**)drivers->at(drivers, i);
        Driver* drv = *drv_ptr;
        
        char* drv_name = vec_str_get(drv->info.name);
        if (strcmp(drv_name, name) == 0) {
            if (drv->info.ref_count > 0) {
                printf("Driver: %s is in use (ref_count=%d)\n", name, drv->info.ref_count);
                return -1;
            }
            
            char* entry = vec_str_get(drv->info.entry_point);
            if (entry) {
                DriverExit exit = (DriverExit)driver_image_symbol(drv->info.handle, entry);
                if (exit) exit();
            }
            
            if (drv->info.handle) {
                driver_unload_elf(drv->info.handle);
            }
            
            drivers->remove(drivers, i);
            driver_count--;
            #ifdef DEBUG_DRIVER_MANAGER
            printf("Driver: %s unloaded\n", name);
            #endif
            pci_table_update();
            return 0;
        }
    }
    
    printf("Driver: %s not found\n", name);
    return -1;
}

int driver_unload_by_path(const char* path) {
    if (!path || !path[0]) return -1;

    // Extract the package name from the installed driver path.
    const char* filename = strrchr(path, '/');
    if (!filename) filename = path;
    else filename++;

    char driver_name[64];
    strcpy(driver_name, filename);
    char* dot = strchr(driver_name, '.');
    if (dot) *dot = '\0';

    return driver_unload(driver_name);
}


