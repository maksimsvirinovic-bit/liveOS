    0xa4506ceb, 0xbef9a3f7, 0xc67178f2, 0xf3bcc908, 0xeb176798, 0x22222222, 0x2a06a070, 0x2f1b41f0
};


                                                                                    
static void aes128_encrypt(void* round_keys, const uint8_t* input, uint8_t* output) {
                                                                        
                                                                                  
    AESContext* ctx = (AESContext*)round_keys;
    ctx->rounds = 10;                                            
    
                                             
    aes_encrypt_block(ctx, input, output);
}


static void tls_sha256_transform(TlsSha256Context* ctx, const uint8_t* data) {
    uint32_t a, b, c, d, e, f, g, h, t1, t2, W[64];
    
    for (int i = 0; i < 16; i++) {
        W[i] = ((uint32_t)data[i * 4] << 24) | ((uint32_t)data[i * 4 + 1] << 16) |
               ((uint32_t)data[i * 4 + 2] << 8)  | ((uint32_t)data[i * 4 + 3]);
    }
    for (int i = 16; i < 64; i++) {
        W[i] = sigma1(W[i - 2]) + W[i - 7] + sigma0(W[i - 15]) + W[i - 16];
    }
    
    a = ctx->state[0]; b = ctx->state[1]; c = ctx->state[2]; d = ctx->state[3];
    e = ctx->state[4]; f = ctx->state[5]; g = ctx->state[6]; h = ctx->state[7];
    
    for (int i = 0; i < 64; i++) {
        t1 = h + Sigma1(e) + Ch(e, f, g) + K[i] + W[i];
        t2 = Sigma0(a) + Maj(a, b, c);
        h = g; g = f; f = e; e = d + t1;
        d = c; c = b; b = a; a = t1 + t2;
    }
    
    ctx->state[0] += a; ctx->state[1] += b; ctx->state[2] += c; ctx->state[3] += d;
    ctx->state[4] += e; ctx->state[5] += f; ctx->state[6] += g; ctx->state[7] += h;
}

void tls_sha256_init(TlsSha256Context* ctx) {
    ctx->state[0] = 0x6a09e667; ctx->state[1] = 0xbb67ae85; ctx->state[2] = 0x3c6ef372; ctx->state[3] = 0xa54ff53a;
    ctx->state[4] = 0x510e527f; ctx->state[5] = 0x9b05688c; ctx->state[6] = 0x1f83d9ab; ctx->state[7] = 0x5be0cd19;
    ctx->count = 0;
}

void tls_sha256_update(TlsSha256Context* ctx, const uint8_t* data, uint32_t len) {
    uint32_t left = ctx->count & 0x3F;
    ctx->count += len;
    uint32_t fill = 64 - left;
    
    if (left && len >= fill) {
        memcpy(ctx->buffer + left, data, fill);
        tls_sha256_transform(ctx, ctx->buffer);
        data += fill; len -= fill; left = 0;
    }
    while (len >= 64) {
        tls_sha256_transform(ctx, data);
        data += 64; len -= 64;
    }
    if (len) {
        memcpy(ctx->buffer + left, data, len);
    }
}

void tls_sha256_final(TlsSha256Context* ctx, uint8_t* digest) {
    uint32_t last = ctx->count & 0x3F;
    uint32_t padn = (last < 56) ? (56 - last) : (120 - last);
    uint8_t bits[8];
    uint64_t total_bits = ctx->count << 3;
    
    for (int i = 0; i < 8; i++) bits[7 - i] = (total_bits >> (i * 8)) & 0xFF;
    
    uint8_t p[1] = {0x80};
    tls_sha256_update(ctx, p, 1);
    
    uint8_t pad[64] = {0};
    tls_sha256_update(ctx, pad, padn - 1);
    tls_sha256_update(ctx, bits, 8);
    
    for (int i = 0; i < 8; i++) {
        digest[i * 4]     = (ctx->state[i] >> 24) & 0xFF;
        digest[i * 4 + 1] = (ctx->state[i] >> 16) & 0xFF;
        digest[i * 4 + 2] = (ctx->state[i] >> 8) & 0xFF;
        digest[i * 4 + 3] = ctx->state[i] & 0xFF;
    }
}

void tls_sha256_hash(const uint8_t* data, uint32_t len, uint8_t* digest) {
    TlsSha256Context ctx;
    tls_sha256_init(&ctx);
    tls_sha256_update(&ctx, data, len);
    tls_sha256_final(&ctx, digest);
}

                                            
void tls_hmac_sha256(const uint8_t* key, uint32_t key_len, 
                     const uint8_t* data, uint32_t data_len, uint8_t* out) {
    uint8_t k_ipad[64], k_opad[64], tk[32];
    
    if (key_len > 64) {
        tls_sha256_hash(key, key_len, tk);
        key = tk; key_len = 32;
    }
    
    memset(k_ipad, 0, 64); memset(k_opad, 0, 64);
    memcpy(k_ipad, key, key_len); memcpy(k_opad, key, key_len);
    
    for (int i = 0; i < 64; i++) {
        k_ipad[i] ^= 0x36; k_opad[i] ^= 0x5C;
    }
    
    TlsSha256Context ctx;
    uint8_t inner_hash[32];
    
    tls_sha256_init(&ctx);
    tls_sha256_update(&ctx, k_ipad, 64);
    tls_sha256_update(&ctx, data, data_len);
    tls_sha256_final(&ctx, inner_hash);
    
    tls_sha256_init(&ctx);
    tls_sha256_update(&ctx, k_opad, 64);
    tls_sha256_update(&ctx, inner_hash, 32);
    tls_sha256_final(&ctx, out);
}

                                                  

void tls_hkdf_extract(const uint8_t* salt, uint32_t salt_len, 
                      const uint8_t* ikm, uint32_t ikm_len, uint8_t* prk) {
    uint8_t zero_salt[32] = {0};
    if (salt == NULL || salt_len == 0) {
        salt = zero_salt;
        salt_len = 32;
    }
                                 
    tls_hmac_sha256(salt, salt_len, ikm, ikm_len, prk);
}

void tls_hkdf_expand_label(const uint8_t* prk, const char* label, 
                           const uint8_t* context, uint32_t context_len, 
                           uint16_t out_len, uint8_t* out) {
    uint8_t hkdf_label[256];
    int pos = 0;
    
                                                                         
    hkdf_label[pos++] = (out_len >> 8) & 0xFF;
    hkdf_label[pos++] = out_len & 0xFF;
    
                                                                 
    int label_len = strlen(label);
    hkdf_label[pos++] = (uint8_t)(label_len + 6);                          
    memcpy(hkdf_label + pos, "tls13 ", 6);
    pos += 6;
    memcpy(hkdf_label + pos, label, label_len);
    pos += label_len;
    
                                                
    if (context == NULL) {
        hkdf_label[pos++] = 0;                    
    } else {
        hkdf_label[pos++] = (uint8_t)context_len;
        memcpy(hkdf_label + pos, context, context_len);
        pos += context_len;
    }
    
                                
    uint8_t T[32];
    uint8_t t_buffer[300];
    uint16_t bytes_needed = out_len;
    uint8_t counter = 1;
    int out_pos = 0;
    
    while (bytes_needed > 0) {
        int t_buf_len = 0;
        if (counter > 1) {
            memcpy(t_buffer, T, 32);
            t_buf_len = 32;
        }
        memcpy(t_buffer + t_buf_len, hkdf_label, pos);
        t_buf_len += pos;
        t_buffer[t_buf_len++] = counter;
        
        tls_hmac_sha256(prk, 32, t_buffer, t_buf_len, T);
        
        int chunk = (bytes_needed > 32) ? 32 : bytes_needed;
        memcpy(out + out_pos, T, chunk);
        
        out_pos += chunk;
        bytes_needed -= chunk;
        counter++;
    }
}

                                                                 

                                                       
static void gcm_mult(const uint8_t* x, const uint8_t* y, uint8_t* z) {
    uint8_t V[16];
    memcpy(V, y, 16);
    memset(z, 0, 16);

    for (int i = 0; i < 128; i++) {
        if (x[i >> 3] & (0x80 >> (i & 7))) {
            for (int j = 0; j < 16; j++) z[j] ^= V[j];
        }
        int rem = (V[15] & 1);
        for (int j = 15; j > 0; j--) {
            V[j] = (V[j] >> 1) | (V[j - 1] << 7);
        }
        V[0] >>= 1;
        if (rem) V[0] ^= 0xE1;                                         
    }
}

void tls_aes_gcm_init(TlsAesGcmContext* ctx, const uint8_t* key) {
                                                           
    aes128_init((AESContext*)ctx->round_keys, key);
    
                                                      
    uint8_t zero[16] = {0};
                                                                        
    aes128_encrypt((AESContext*)ctx->round_keys, zero, ctx->H);
}

void tls_aes_gcm_crypt(TlsAesGcmContext* ctx, int encrypt,
                       const uint8_t* iv, const uint8_t* aad, uint32_t aad_len,
                       const uint8_t* input, uint32_t length, 
                       uint8_t* output, uint8_t* tag) {
    uint8_t J0[16];
    uint8_t S[16];
    uint8_t T[16];
    
                                                                            
    memcpy(J0, iv, 12);
    J0[12] = 0; J0[13] = 0; J0[14] = 0; J0[15] = 1;
    
                                               
    uint8_t cb[16];
    memcpy(cb, J0, 16);
    
    uint32_t remain = length;
    uint32_t offset = 0;
    uint32_t block_num = 2;                                                                 
    
    while (remain > 0) {
        cb[12] = (block_num >> 24) & 0xFF; cb[13] = (block_num >> 16) & 0xFF;
        cb[14] = (block_num >> 8) & 0xFF;  cb[15] = block_num & 0xFF;
        
        uint8_t keystream[16];
        aes128_encrypt((AESContext*)ctx->round_keys, cb, keystream);
        
        uint32_t chunk = (remain > 16) ? 16 : remain;
        for (uint32_t i = 0; i < chunk; i++) {
            output[offset + i] = input[offset + i] ^ keystream[i];
        }
        
        remain -= chunk;
        offset += chunk;
        block_num++;
    }
    
                                                                          
    memset(S, 0, 16);
    const uint8_t* auth_data = encrypt ? output : input;
    
                                                                           
    uint32_t aad_blocks = (aad_len + 15) / 16;
    for (uint32_t i = 0; i < aad_blocks; i++) {
        uint8_t block[16] = {0};
        uint32_t chunk = (aad_len - (i * 16) > 16) ? 16 : (aad_len - (i * 16));
        memcpy(block, aad + (i * 16), chunk);
        for (int j = 0; j < 16; j++) S[j] ^= block[j];
        gcm_mult(S, ctx->H, T);
        memcpy(S, T, 16);
    }
    
                                                        
    uint32_t data_blocks = (length + 15) / 16;
    for (uint32_t i = 0; i < data_blocks; i++) {
        uint8_t block[16] = {0};
        uint32_t chunk = (length - (i * 16) > 16) ? 16 : (length - (i * 16));
        memcpy(block, auth_data + (i * 16), chunk);
        for (int j = 0; j < 16; j++) S[j] ^= block[j];
        gcm_mult(S, ctx->H, T);
        memcpy(S, T, 16);
    }
    
                                                       
    uint8_t len_block[16];
    uint64_t bit_len_a = (uint64_t)aad_len * 8;
    uint64_t bit_len_c = (uint64_t)length * 8;
    
    for (int i = 0; i < 8; i++) {
        len_block[7 - i] = (bit_len_a >> (i * 8)) & 0xFF;
        len_block[15 - i] = (bit_len_c >> (i * 8)) & 0xFF;
    }
    
    for (int j = 0; j < 16; j++) S[j] ^= len_block[j];
    gcm_mult(S, ctx->H, T);
    
                                                        
    uint8_t j0_encrypted[16];
    aes128_encrypt((AESContext*)ctx->round_keys, J0, j0_encrypted);
    
    for (int j = 0; j < 16; j++) tag[j] = T[j] ^ j0_encrypted[j];
}

