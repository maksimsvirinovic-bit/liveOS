static char* asprintf(const char* format, ...) {
    va_list args;
    va_start(args, format);
    
                            
    char temp[4096];
    int len = format_into_buffer(temp, format, args);
    va_end(args);
    
                      
    char* buffer = (char*)kmalloc(len + 1);
    if (!buffer) return NULL;
    
                          
    va_start(args, format);
    format_into_buffer(buffer, format, args);
    va_end(args);
    
    return buffer;
}

static inline int atoi(const char *str) {
    int result = 0;
    int sign = 1;
    
    while (*str == ' ') str++;
    
    if (*str == '-') {
        sign = -1;
        str++;
    } else if (*str == '+') {
        str++;
    }
    
    while (*str >= '0' && *str <= '9') {
        result = result * 10 + (*str - '0');
        str++;
    }
    
    return result * sign;
}

static uint32_t str_to_uint32(const char* str) {
    if (!str || !*str) return 0;

    uint32_t val = 0;
    const char* p = str;
    int is_hex = 0;

                                                    
    while (*p == ' ' || *p == '\t') p++;

                                                                
    if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
        is_hex = 1;
        p += 2;                              
    }

                             
    while (*p) {
        if (is_hex) {
            val <<= 4;
            if (*p >= '0' && *p <= '9')      val += (*p - '0');
            else if (*p >= 'a' && *p <= 'f') val += (*p - 'a' + 10);
            else if (*p >= 'A' && *p <= 'F') val += (*p - 'A' + 10);
            else { val >>= 4; break; }                           
        } else {
            if (*p >= '0' && *p <= '9') {
                val = val * 10 + (*p - '0');
            } else {
                break;                      
            }
        }
        p++;
    }

    return val;
}

static int is_space(char c) {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v';
}

static int is_digit(char c) {
    return c >= '0' && c <= '9';
}

static int is_hex(char c) {
    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

static int hex_val(char c) {
    if (c >= '0' && c <= '9') return c - '0';
    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
    return 0;
}

static int parse_int(const char** str, int* out) {
    const char* p = *str;
    int sign = 1;
    int val = 0;
    
                         
    while (is_space(*p)) p++;
    
           
    if (*p == '-') { sign = -1; p++; }
    else if (*p == '+') p++;
    
            
    if (!is_digit(*p)) return 0;
    while (is_digit(*p)) {
        val = val * 10 + (*p - '0');
        p++;
    }
    
    *out = val * sign;
    *str = p;
    return 1;
}

static int parse_hex_int(const char** str, unsigned int* out) {
    const char* p = *str;
    unsigned int val = 0;
    
    while (is_space(*p)) p++;
    
                
    if (p[0] == '0' && (p[1] == 'x' || p[1] == 'X')) {
        p += 2;
    }
    
    if (!is_hex(*p)) return 0;
    while (is_hex(*p)) {
        val = (val << 4) | hex_val(*p);
        p++;
    }
    
    *out = val;
    *str = p;
    return 1;
}

static int parse_string(const char** str, char* out, int max_len) {
    const char* p = *str;
    int len = 0;
    
    while (is_space(*p)) p++;
    
    while (*p && !is_space(*p) && len < max_len - 1) {
        out[len++] = *p++;
    }
    out[len] = '\0';
    
    *str = p;
    return len;
}

static int parse_char(const char** str, char* out) {
    const char* p = *str;
    
    while (is_space(*p)) p++;
    
    if (*p) {
        *out = *p++;
        *str = p;
        return 1;
    }
    return 0;
}

                               

static int sscanf(const char* str, const char* fmt, ...) {
    va_list args;
    va_start(args, fmt);
    
    int matches = 0;
    const char* p = str;
    const char* f = fmt;
    
    while (*f) {
                                   
        while (is_space(*f)) f++;
        if (*f == '\0') break;
        
                                   
        while (is_space(*p)) p++;
        if (*p == '\0') break;
        
        if (*f == '%') {
            f++;
            
                                  
            int width = 0;
            int is_long = 0;
            int is_short = 0;
            
                     
            while (is_digit(*f)) {
                width = width * 10 + (*f - '0');
                f++;
            }
            
                                 
            if (*f == 'l') {
                is_long = 1;
                f++;
            } else if (*f == 'h') {
                is_short = 1;
                f++;
            }
            
            switch (*f) {
                case 'd': {
                    int* out = va_arg(args, int*);
                    int val;
                    if (parse_int(&p, &val)) {
                        *out = val;
                        matches++;
                    }
                    break;
                }
                
                case 'u': {
                    unsigned int* out = va_arg(args, unsigned int*);
                    int val;
                    if (parse_int(&p, &val)) {
                        *out = (unsigned int)val;
                        matches++;
                    }
                    break;
                }
                
                case 'x':
                case 'X': {
                    unsigned int* out = va_arg(args, unsigned int*);
                    unsigned int val;
                    if (parse_hex_int(&p, &val)) {
                        *out = val;
                        matches++;
                    }
                    break;
                }
                
                case 's': {
                    char* out = va_arg(args, char*);
                    int max_len = width > 0 ? width : 256;
                    if (parse_string(&p, out, max_len)) {
                        matches++;
                    }
                    break;
                }
                
                case 'c': {
                    char* out = va_arg(args, char*);
                    if (parse_char(&p, out)) {
                        matches++;
                    }
                    break;
                }
                
                case 'h': {
                                    
                    if (*f == 'h') {
                        f++;
                        if (*f == 'x') {
                            unsigned short* out = va_arg(args, unsigned short*);
                            unsigned int val;
                            if (parse_hex_int(&p, &val)) {
                                *out = (unsigned short)val;
                                matches++;
                            }
                        }
                    }
                    break;
                }
                
                case '%': {
                    if (*p == '%') p++;
                    break;
                }
                
                default: {
                                                      
                    f++;
                    break;
                }
            }
            f++;
        } else {
                             
            if (*f == ' ') {
                                        
                f++;
                continue;
            }
            
            if (*p == *f) {
                p++;
                f++;
            } else {
                break;
            }
        }
    }
    
    va_end(args);
    return matches;
}


