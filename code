    else if (strcmp(line, "pop rdi") == 0) { code[0] = 0x5F; len = 1; }
    else if (strcmp(line, "pop rbp") == 0) { code[0] = 0x5D; len = 1; }
    
                               
    else if (strncmp(line, "mov rax, ", 9) == 0) {
        uint64_t val; parse_num(line+9, &val);
