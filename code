int ethernet_send(MacAddress dst, uint16_t ethertype, const uint8_t* payload, uint16_t len) {
    uint8_t frame[1514];
    
    memcpy(frame, dst.bytes, 6);
    uint8_t* mac = e1000_get_mac();
    memcpy(frame + 6, mac, 6);
    frame[12] = (ethertype >> 8) & 0xFF;
    frame[13] = ethertype & 0xFF;
    memcpy(frame + 14, payload, len);
    
    return e1000_send_packet(frame, 14 + len);
}

int ethernet_receive(uint8_t* buffer, uint16_t max_len) {
    return e1000_receive_packet(buffer, max_len);
}

void mac_to_string(MacAddress mac, char* str) {
    const char hex[] = "0123456789ABCDEF";
    int pos = 0;
    for (int i = 0; i < 6; i++) {
        str[pos++] = hex[mac.bytes[i] >> 4];
        str[pos++] = hex[mac.bytes[i] & 0xF];
        if (i < 5) str[pos++] = ':';
    }
    str[pos] = '\0';
}

