.global context_switch
.type context_switch, @function

# void context_switch(TaskContext* old, TaskContext* new)
# RDI = old, RSI = new
context_switch:
    test %rdi, %rdi
    jz .restore
    
    # === СОХРАНЕНИЕ ===
    mov %rax, 0(%rdi)
    mov %rbx, 8(%rdi)
    mov %rcx, 16(%rdi)
    mov %rdx, 24(%rdi)
    mov %rsi, 32(%rdi)
    mov %rbp, 48(%rdi)
    mov %r8,  64(%rdi)
    mov %r9,  72(%rdi)
    mov %r10, 80(%rdi)
    mov %r11, 88(%rdi)
    mov %r12, 96(%rdi)
    mov %r13, 104(%rdi)
    mov %r14, 112(%rdi)
    mov %r15, 120(%rdi)
    
    # RSP и RIP
    mov %rsp, 56(%rdi)
    mov (%rsp), %rax
    mov %rax, 128(%rdi)
    
    # RFLAGS
    pushfq
    pop %rax
    mov %rax, 136(%rdi)
    
    # RDI — ПОСЛЕДНИМ, но с сохранением в стек!
    # Используем RAX как временный
    push %rdi
    pop %rax                    # RAX = old
    mov %rdi, 40(%rax)          # сохраняем RDI по адресу old+40
    
.restore:
    # === ВОССТАНОВЛЕНИЕ ===
    mov 0(%rsi), %rax
    mov 8(%rsi), %rbx
    mov 16(%rsi), %rcx
    mov 24(%rsi), %rdx
    mov 48(%rsi), %rbp
    mov 64(%rsi), %r8
    mov 72(%rsi), %r9
    mov 80(%rsi), %r10
    mov 88(%rsi), %r11
    mov 96(%rsi), %r12
    mov 104(%rsi), %r13
    mov 112(%rsi), %r14
    mov 120(%rsi), %r15
    
    mov 56(%rsi), %rsp
    
    push 136(%rsi)
    popfq
    
    push 128(%rsi)
    
    mov 32(%rsi), %rdi          # RDI
    mov 40(%rsi), %rsi          # RSI — тоже последним
    
    ret

