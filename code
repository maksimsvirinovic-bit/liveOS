static uint32_t sub_word(uint32_t word) {
    uint32_t result = 0;
    result |= sbox[(word >> 24) & 0xFF] << 24;
    result |= sbox[(word >> 16) & 0xFF] << 16;
    result |= sbox[(word >> 8) & 0xFF] << 8;
    result |= sbox[word & 0xFF];
    return result;
}

static uint32_t rot_word(uint32_t word) {
    return ((word << 8) & 0xFFFFFF00) | ((word >> 24) & 0xFF);
}

                        
void aes128_init(AESContext* ctx, const uint8_t* key) {
    ctx->rounds = 10;
    
                            
    for (int i = 0; i < 4; i++) {
        ctx->round_keys[i] = (key[i*4] << 24) | (key[i*4+1] << 16) | 
                             (key[i*4+2] << 8) | key[i*4+3];
    }
    
                                 
    for (int i = 4; i < 44; i++) {
        uint32_t temp = ctx->round_keys[i - 1];
        
        if (i % 4 == 0) {
            temp = sub_word(rot_word(temp)) ^ rcon[(i/4) - 1];
        }
        
        ctx->round_keys[i] = ctx->round_keys[i - 4] ^ temp;
    }
}

           
static void sub_bytes(uint8_t* state) {
    for (int i = 0; i < 16; i++) {
        state[i] = sbox[state[i]];
    }
}

              
static void inv_sub_bytes(uint8_t* state) {
    for (int i = 0; i < 16; i++) {
        state[i] = inv_sbox[state[i]];
