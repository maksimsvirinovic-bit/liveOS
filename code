    if (strcmp(mnemonic, "cld") == 0) { emit(0xFC); return; }
    if (strcmp(mnemonic, "lahf") == 0) { emit(0x9F); return; }
    if (strcmp(mnemonic, "sahf") == 0) { emit(0x9E); return; }
    
                         
    if (strcmp(mnemonic, "movsb") == 0) { emit(0xA4); return; }
    if (strcmp(mnemonic, "movsw") == 0) { emit(0x66); emit(0xA5); return; }
    if (strcmp(mnemonic, "movsd") == 0) { emit(0xA5); return; }
    if (strcmp(mnemonic, "stosb") == 0) { emit(0xAA); return; }
    if (strcmp(mnemonic, "stosw") == 0) { emit(0x66); emit(0xAB); return; }
    if (strcmp(mnemonic, "stosd") == 0) { emit(0xAB); return; }
    if (strcmp(mnemonic, "lodsb") == 0) { emit(0xAC); return; }
    if (strcmp(mnemonic, "lodsw") == 0) { emit(0x66); emit(0xAD); return; }
    if (strcmp(mnemonic, "lodsd") == 0) { emit(0xAD); return; }
    if (strcmp(mnemonic, "cmpsb") == 0) { emit(0xA6); return; }
    if (strcmp(mnemonic, "cmpsw") == 0) { emit(0x66); emit(0xA7); return; }
    if (strcmp(mnemonic, "cmpsd") == 0) { emit(0xA7); return; }
    if (strcmp(mnemonic, "scasb") == 0) { emit(0xAE); return; }
    if (strcmp(mnemonic, "scasw") == 0) { emit(0x66); emit(0xAF); return; }
    if (strcmp(mnemonic, "scasd") == 0) { emit(0xAF); return; }
    if (strcmp(mnemonic, "rep") == 0) { emit(0xF3); return; }
    if (strcmp(mnemonic, "repe") == 0 || strcmp(mnemonic, "repz") == 0) { emit(0xF3); return; }
    if (strcmp(mnemonic, "repne") == 0 || strcmp(mnemonic, "repnz") == 0) { emit(0xF2); return; }
    
                                                 
                                      
                                                 
    
               
    if (strcmp(mnemonic, "int") == 0) {
        uint64_t n;
        if (parse_num(opers, &n) && n < 256) {
            emit(0xCD); emit((uint8_t)n);
        }
        return;
    }
    
                   
    if (strcmp(mnemonic, "push") == 0) {
        int c, i64, e;
        if (find_reg(opers, &c, &i64, &e)) {
            if (e) rex(0,0,0,1);
            emit(0x50 + (c & 7));
            return;
        }
        uint64_t imm;
        if (parse_num(opers, &imm)) {
            if (imm < 256) {
                emit(0x6A); emit((uint8_t)imm);
            } else {
                emit(0x68); emit32((uint32_t)imm);
            }
        }
        return;
    }
    
              
    if (strcmp(mnemonic, "pop") == 0) {
        int c, i64, e;
        if (find_reg(opers, &c, &i64, &e)) {
            if (e) rex(0,0,0,1);
            emit(0x58 + (c & 7));
        }
        return;
    }
    
                  
    if (strcmp(mnemonic, "inc") == 0 || strcmp(mnemonic, "dec") == 0) {
        int c, i64, e;
        if (find_reg(opers, &c, &i64, &e)) {
            int sub = (strcmp(mnemonic, "inc") == 0) ? 0 : 1;
            rex(i64, 0, 0, e);
            emit(0xFF);
            modrm(3, sub, c & 7);
        }
        return;
    }
    
                  
    if (strcmp(mnemonic, "not") == 0 || strcmp(mnemonic, "neg") == 0) {
        int c, i64, e;
        if (find_reg(opers, &c, &i64, &e)) {
            int sub = (strcmp(mnemonic, "not") == 0) ? 2 : 3;
            rex(1, 0, 0, e);
            emit(0xF7);
            modrm(3, sub, c & 7);
        }
        return;
    }
    
                            
    if (strcmp(mnemonic, "mul") == 0 || strcmp(mnemonic, "imul") == 0 ||
        strcmp(mnemonic, "div") == 0 || strcmp(mnemonic, "idiv") == 0) {
        int c, i64, e;
        if (find_reg(opers, &c, &i64, &e)) {
            int sub = (strcmp(mnemonic, "mul") == 0) ? 4 :
                      (strcmp(mnemonic, "imul") == 0) ? 5 :
                      (strcmp(mnemonic, "div") == 0) ? 6 : 7;
            rex(1, 0, 0, e);
            emit(0xF7);
            modrm(3, sub, c & 7);
        }
        return;
    }
    
                   
    if (strcmp(mnemonic, "jmp") == 0 || strcmp(mnemonic, "call") == 0) {
        int c, i64, e;
        if (find_reg(opers, &c, &i64, &e)) {
            int sub = (strcmp(mnemonic, "jmp") == 0) ? 4 : 2;
            rex(0, 0, 0, e);
            emit(0xFF);
            modrm(3, sub, c & 7);
            return;
        }
                       
        uint64_t imm;
        if (parse_num(opers, &imm)) {
            if (strcmp(mnemonic, "jmp") == 0) emit(0xE9);
            else emit(0xE8);
            emit32((uint32_t)imm);
        }
        return;
    }
    
                
    if (strcmp(mnemonic, "lgdt") == 0) {
        emit(0x0F); emit(0x01); modrm(0, 2, 6); return;
    }
    if (strcmp(mnemonic, "lidt") == 0) {
        emit(0x0F); emit(0x01); modrm(0, 3, 6); return;
    }
    
                                                 
                                         
                                                 
    char* comma = strchr(opers, ',');
    if (!comma) return;
    
                       
    char dst[64], src[64];
    int i, j;
    
    for (i = 0; opers[i] != ',' && opers[i] && i < 63; i++) dst[i] = opers[i];
    dst[i] = '\0';
    while (i > 0 && dst[i-1] == ' ') dst[--i] = '\0';
    char* d = dst; while (*d == ' ') d++;
    
    i++;
    while (opers[i] == ' ') i++;
    for (j = 0; opers[i] && j < 63; j++) src[j] = opers[i++];
    src[j] = '\0';
    while (j > 0 && src[j-1] == ' ') src[--j] = '\0';
    char* s = src; while (*s == ' ') s++;
    
                       
    int dc, sc, d64, s64, de, se;
    if (!find_reg(d, &dc, &d64, &de)) return;
    
                       
    int src_reg = -1;
    if (find_reg(s, &sc, &s64, &se)) {
        src_reg = sc;
        
                       
        if (strcmp(mnemonic, "mov") == 0) {
            rex(1, se, 0, de);
            emit(0x89);
            modrm(3, sc & 7, dc & 7);
            return;
        }
        
               
        if (strcmp(mnemonic, "xchg") == 0) {
            rex(1, se, 0, de);
            emit(0x87);
            modrm(3, sc & 7, dc & 7);
            return;
        }
        
               
        if (strcmp(mnemonic, "test") == 0) {
            rex(1, se, 0, de);
            emit(0x85);
            modrm(3, sc & 7, dc & 7);
            return;
        }
        
                                          
        int op = 0;
        if (strcmp(mnemonic,"add")==0) op=0x01;
        else if (strcmp(mnemonic,"sub")==0) op=0x29;
        else if (strcmp(mnemonic,"cmp")==0) op=0x39;
        else if (strcmp(mnemonic,"and")==0) op=0x21;
        else if (strcmp(mnemonic,"or")==0)  op=0x09;
        else if (strcmp(mnemonic,"xor")==0) op=0x31;
        
        if (op) {
            rex(1, se, 0, de);
            emit(op);
            modrm(3, sc & 7, dc & 7);
            return;
        }
        
              
        if (strcmp(mnemonic, "lea") == 0) {
            rex(1, se, 0, de);
            emit(0x8D);
            modrm(3, sc & 7, dc & 7);
            return;
        }
    }
    
                  
    uint64_t imm;
    if (parse_num(s, &imm)) {
                       
        if (strcmp(mnemonic, "mov") == 0) {
            rex(1, 0, 0, de);
            emit(0xB8 + (dc & 7));
            emit64(imm);
            return;
        }
        
                                           
        if (imm < 256) {
            int op = 0, subop = 0;
            if (strcmp(mnemonic,"add")==0) { op=0x83; subop=0; }
            else if (strcmp(mnemonic,"sub")==0) { op=0x83; subop=5; }
            else if (strcmp(mnemonic,"cmp")==0) { op=0x83; subop=7; }
            else if (strcmp(mnemonic,"and")==0) { op=0x83; subop=4; }
            else if (strcmp(mnemonic,"or")==0)  { op=0x83; subop=1; }
            else if (strcmp(mnemonic,"xor")==0) { op=0x83; subop=6; }
            
            if (op) {
                rex(1, 0, 0, de);
                emit(op);
                modrm(3, subop, dc & 7);
                emit((uint8_t)imm);
                return;
            }
        }
    }
    
                                   
    if (imm < 256) {
        static const struct { const char* name; uint8_t opcode; } jcc[] = {
            {"je",0x84},{"jz",0x84},{"jne",0x85},{"jnz",0x85},
            {"jc",0x82},{"jnc",0x83},{"jo",0x80},{"jno",0x81},
            {"js",0x88},{"jns",0x89},{"jp",0x8A},{"jpe",0x8A},
            {"jnp",0x8B},{"jpo",0x8B},{"jg",0x8F},{"jnle",0x8F},
            {"jge",0x8D},{"jnl",0x8D},{"jl",0x8C},{"jnge",0x8C},
            {"jle",0x8E},{"jng",0x8E},{"ja",0x87},{"jnbe",0x87},
            {"jae",0x83},{"jnb",0x83},{"jb",0x82},{"jnae",0x82},
            {"jbe",0x86},{"jna",0x86},{"jcxz",0xE3},{"jecxz",0xE3},{"jrcxz",0xE3},
            {NULL, 0}
        };
        
        for (int i = 0; jcc[i].name; i++) {
            if (strcmp(mnemonic, jcc[i].name) == 0) {
                emit(jcc[i].opcode);
                emit((uint8_t)imm);
                return;
            }
        }
    }
    
                        
    if ((strcmp(mnemonic,"shl")==0 || strcmp(mnemonic,"shr")==0) && imm < 256) {
        int sub = (strcmp(mnemonic,"shl")==0) ? 4 : 5;
        rex(1, 0, 0, de);
        emit(0xC1);
        modrm(3, sub, dc & 7);
        emit((uint8_t)imm);
        return;
    }
}

                           
                                     

                 
static void create_elf_from_vec(Vector* output, Vector* code_vec) {
                            
    uint8_t elf_header[64];
    for (int i = 0; i < 64; i++) elf_header[i] = 0;
    
    elf_header[0] = 0x7F; elf_header[1] = 'E'; elf_header[2] = 'L'; elf_header[3] = 'F';
    elf_header[4] = 2;             
    elf_header[5] = 1;                    
    elf_header[6] = 1;                    
    *(uint16_t*)(elf_header + 16) = 2;                                            
    *(uint16_t*)(elf_header + 18) = 0x3E;                       
    *(uint32_t*)(elf_header + 20) = 1;             
    
                                                                        
    *(uint64_t*)(elf_header + 24) = 0x400000 + 120; 
    
    *(uint64_t*)(elf_header + 32) = 64;                                           
    *(uint16_t*)(elf_header + 52) = 64;                          
    *(uint16_t*)(elf_header + 54) = 56;                                        
    *(uint16_t*)(elf_header + 56) = 1;                                 
    
    for (int i = 0; i < 64; i++) {
        output->push(output, &elf_header[i]);
    }
    
                               
    uint8_t prog_header[56];
    for (int i = 0; i < 56; i++) prog_header[i] = 0;
    
    *(uint32_t*)(prog_header + 0) = 1;                                             
    *(uint32_t*)(prog_header + 4) = 7;                                                              
    
                                                          
    *(uint64_t*)(prog_header + 8) = 0;                       
    *(uint64_t*)(prog_header + 16) = 0x400000;               
    *(uint64_t*)(prog_header + 24) = 0x400000;               
    
                                                                                                  
    uint64_t total_file_size = 120 + code_vec->size;
    *(uint64_t*)(prog_header + 32) = total_file_size;                
    *(uint64_t*)(prog_header + 40) = total_file_size;               
    *(uint64_t*)(prog_header + 48) = 0x1000;                                                                                        
    
    for (int i = 0; i < 56; i++) {
        output->push(output, &prog_header[i]);
    }
    
                                       
    for (uint32_t i = 0; i < code_vec->size; i++) {
        output->push(output, &code_vec->data[i]);
    }
}

                                              
int asm_assemble_elf(const char* source, Vector* output) {
    char line[256];
    
                                                                 
    out_vec = vector_create(sizeof(uint8_t), 256);
    
    const char* p1 = source;
    
    while (*p1) {
        int i = 0;
        while (*p1 && *p1 != '\n' && i < 255) line[i++] = *p1++;
        line[i] = '\0';
        if (*p1 == '\n') p1++;
        
        if (line[0] == '\0' || line[0] == ';') continue;
        
        char* start = line;
        while (*start == ' ' || *start == '\t') start++;
        
        int len = strlen(start);
        if (start[len-1] == ':') {
            start[len-1] = '\0';
            add_label(start, out_vec->size);                    
            continue;
        }
        
        char mnemonic[16];
        int j = 0;
        while (*start != ' ' && *start != '\t' && *start && j < 15) {
            mnemonic[j++] = *start++;
        }
        mnemonic[j] = '\0';
        while (*start == ' ' || *start == '\t') start++;
        
        asm_instr(mnemonic, start);
    }
    
    int code_size = out_vec->size;
    
    print("Labels: ");
    print_int(labels_vec->size);
    print(", code: ");
    print_int(code_size);
    print(" bytes\n");
    
                                                                         
    out_vec->clear(out_vec);
    
    const char* p2 = source;
    
    while (*p2) {
        int i = 0;
        while (*p2 && *p2 != '\n' && i < 255) line[i++] = *p2++;
        line[i] = '\0';
        if (*p2 == '\n') p2++;
        
        if (line[0] == '\0' || line[0] == ';') continue;
        
        char* start = line;
        while (*start == ' ' || *start == '\t') start++;
        
        int len = strlen(start);
        if (start[len-1] == ':') continue;
        
        char mnemonic[16];
        int j = 0;
        while (*start != ' ' && *start != '\t' && *start && j < 15) {
            mnemonic[j++] = *start++;
        }
        mnemonic[j] = '\0';
        while (*start == ' ' || *start == '\t') start++;
        
                                      
        if (*start && !is_number(start) && find_reg_quick(start) < 0) {
            int lbl = find_label(start);                    
            if (lbl >= 0) {
                char num_str[32];
                int_to_str(lbl, num_str);
                asm_instr(mnemonic, num_str);
            } else {
                asm_instr(mnemonic, start);
            }
        } else {
            asm_instr(mnemonic, start);
        }
    }
    
                  
    create_elf_from_vec(output, out_vec);
    
    int final_size = out_vec->size;
    out_vec->destroy(out_vec);
    
    return final_size;
}

                                    
int asm_assemble_file(const char* input_path, const char* output_path) {
                      
    Vector* source = vector_create(sizeof(uint8_t), 256);
    int src_size = read_file(input_path, source);
    
    if (src_size <= 0) {
        print("Cannot read source!\n");
        source->destroy(source);
        return -1;
    }
    
                         
    Vector* elf = vector_create(sizeof(uint8_t), 512);
    asm_assemble_elf((char*)source->data, elf);
    
                    
    write_file(output_path, elf);
    
    print("Assembled ELF: ");
    print_int(elf->size);
    print(" bytes -> ");
    print(output_path);
    putc('\n');
    
    source->destroy(source);
    elf->destroy(elf);
    
    return 0;
}

