#include "e1000.h"
#include "console.h"
#include "str.h"
#include "heap.h"
#include "pic.h"

                        
#define RX_DESC_COUNT 512
#define TX_DESC_COUNT 128
#define RX_BUFFER_SIZE 2048
#define TX_BUFFER_SIZE 2048

#define PKT_QUEUE_SIZE 512

                         
static volatile uint32_t* mmio = NULL;
static int e1000_ready = 0;
static uint8_t our_mac[6] = {0x52, 0x54, 0x00, 0x12, 0x34, 0x56};

                          
typedef struct {
    uint64_t addr;
    uint16_t length;
    uint16_t checksum;
    uint8_t  status;
    uint8_t  errors;
    uint16_t special;
} __attribute__((packed)) RxDesc;

typedef struct {
    uint64_t addr;
    uint16_t length;
    uint8_t  cso;
    uint8_t  cmd;
    uint8_t  status;
    uint8_t  css;
    uint16_t special;
} __attribute__((packed)) TxDesc;

typedef struct {
    uint8_t data[RX_BUFFER_SIZE];
    uint16_t length;
} PacketEntry;

static PacketEntry pkt_queue[PKT_QUEUE_SIZE];
static volatile int pkt_head = 0;
static volatile int pkt_tail = 0;
static volatile int pkt_count = 0;

                                                                                 
                                                                                
static inline uint64_t lock_pkt_queue(void) {
    uint64_t flags;
    asm volatile("pushfq; popq %0; cli" : "=r"(flags) : : "memory");
    return flags;
}

static inline void unlock_pkt_queue(uint64_t flags) {
    asm volatile("pushq %0; popfq" : : "r"(flags) : "memory", "cc");
}

static RxDesc rx_descs[RX_DESC_COUNT] __attribute__((aligned(16)));
static TxDesc tx_descs[TX_DESC_COUNT] __attribute__((aligned(16)));
static uint8_t rx_buffers[RX_DESC_COUNT][RX_BUFFER_SIZE] __attribute__((aligned(16)));
static uint8_t tx_buffers[TX_DESC_COUNT][TX_BUFFER_SIZE] __attribute__((aligned(16)));

static uint32_t rx_tail = 0;
static uint32_t tx_tail = 0;

static uint32_t rx_packet_count = 0;
static uint32_t rx_dropped_count = 0;

                              
static uint32_t e1000_read(uint32_t reg) {
    return mmio[reg / 4];
}

static void e1000_write(uint32_t reg, uint32_t val) {
    mmio[reg / 4] = val;
}

                                        

int e1000_packet_available(void) {
    uint64_t flags = lock_pkt_queue();
    int result = pkt_count > 0;
    unlock_pkt_queue(flags);
    return result;
}

void e1000_packet_queue_clear(void) {
    uint64_t flags = lock_pkt_queue();
    pkt_head = 0;
    pkt_tail = 0;
    pkt_count = 0;
    unlock_pkt_queue(flags);
}

                                              

void e1000_enable_interrupts(void) {
    if (!mmio) return;
    
                                     
    uint32_t ims = 0;
    ims |= (1 << 0);             
    ims |= (1 << 2);                        
    ims |= (1 << 7);             
    ims |= (1 << 6);                 
    e1000_write(E1000_IMS, ims);
    
                                 
    pic_unmask_irq(11);
    
    #ifdef DEBUG_E1000
    printf("e1000: Interrupts enabled (IRQ 11)\n");
    #endif
}

void e1000_disable_interrupts(void) {
    if (!mmio) return;
    e1000_write(E1000_IMC, 0xFFFFFFFF);
    pic_mask_irq(11);
    #ifdef DEBUG_E1000
    printf("e1000: Interrupts disabled\n");
    #endif
}


                                        
static int e1000_receive_packet_irq(uint8_t* buffer, uint16_t max_len) {
    if (!e1000_ready) return -1;
    
    for (int i = 0; i < RX_DESC_COUNT; i++) {
        uint32_t idx = (rx_tail + i) % RX_DESC_COUNT;
        
        if (rx_descs[idx].status & 0x1) {
            uint16_t length = rx_descs[idx].length;
            
            if (length > 0 && length <= max_len) {
                memcpy(buffer, rx_buffers[idx], length);
                rx_descs[idx].status = 0;
                e1000_write(E1000_RDT, idx);
                rx_tail = (idx + 1) % RX_DESC_COUNT;
                return length;
            } else {
                                         
                rx_descs[idx].status = 0;
            }
        } else {
                                 
            break;
        }
    }
    
    return 0;
}

                                    

void e1000_irq_handler(void) {
    if (!mmio) return;
    
    uint32_t icr = e1000_read(E1000_ICR);
    
    if (icr & (1 << 6)) {
                      
        #ifdef DEBUG_E1000
        printf("e1000: RX overflow! Flushing...\n");
        #endif
        e1000_rx_flush();
    }
    
    if (icr & (1 << 7)) {
                  
        while (1) {
            uint8_t buf[RX_BUFFER_SIZE];
            int len = e1000_receive_packet_irq(buf, sizeof(buf));
            if (len <= 0) break;

            uint64_t flags = lock_pkt_queue();
            int next = (pkt_tail + 1) % PKT_QUEUE_SIZE;
            if (next != pkt_head) {
                memcpy(pkt_queue[pkt_tail].data, buf, len);
                pkt_queue[pkt_tail].length = len;
                pkt_tail = next;
                pkt_count++;
            } else {
                #ifdef DEBUG_E1000
                printf("e1000: Packet queue full!\n");
                #endif
            }
            unlock_pkt_queue(flags);
        }
    }
    
                     
    pic_send_eoi(11);
}

void e1000_tx_reset(void) {
    #ifdef DEBUG_E1000
    printf("e1000: TX reset\n");
    #endif
    
                              
    for (int i = 0; i < TX_DESC_COUNT; i++) {
        tx_descs[i].status = 0;
        tx_descs[i].length = 0;
        tx_descs[i].cmd = 0;
        tx_descs[i].cso = 0;
        tx_descs[i].css = 0;
        tx_descs[i].special = 0;
    }
    
                           
    tx_tail = 0;
    e1000_write(E1000_TDH, 0);
    e1000_write(E1000_TDT, 0);
    
                       
    uint32_t tctl = e1000_read(E1000_TCTRL);
    tctl |= (1 << 1);        
    tctl |= (1 << 3);         
    e1000_write(E1000_TCTRL, tctl);
    
    #ifdef DEBUG_E1000
    printf("e1000: TX reset complete\n");
    #endif
}

                    
void e1000_reset(void) {
    if (!mmio) return;
    
    print("e1000: Reset\n");

    e1000_packet_queue_clear();
    
                           
    e1000_write(E1000_CTRL, (1 << 26));        
    for (volatile int i = 0; i < 100000; i++);
    
                  
    memset(tx_descs, 0, sizeof(tx_descs));
    memset(tx_buffers, 0, sizeof(tx_buffers));
    for (int i = 0; i < TX_DESC_COUNT; i++) {
        tx_descs[i].addr = (uint64_t)(uintptr_t)tx_buffers[i];
        tx_descs[i].status = 1;         
    }
    tx_tail = 0;
    e1000_write(E1000_TDH, 0);
    e1000_write(E1000_TDT, 0);
    
                  
    memset(rx_descs, 0, sizeof(rx_descs));
    memset(rx_buffers, 0, sizeof(rx_buffers));
    for (int i = 0; i < RX_DESC_COUNT; i++) {
        rx_descs[i].addr = (uint64_t)(uintptr_t)rx_buffers[i];
        rx_descs[i].status = 0;
    }
    rx_tail = 0;
    e1000_write(E1000_RDH, 0);
    e1000_write(E1000_RDT, RX_DESC_COUNT - 1);
    
    print("e1000: Reset complete\n");
}

                            
int e1000_init(uint64_t mmio_base) {
    #ifdef DEBUG_E1000
    print("e1000: Initializing...\n");
    #endif
    
    mmio = (volatile uint32_t*)mmio_base;
    e1000_ready = 0;
    
               
    e1000_write(E1000_CTRL, (1 << 26));
    for (volatile int i = 0; i < 100000; i++);
    
                                   
    memset(rx_descs, 0, sizeof(rx_descs));
    memset(rx_buffers, 0, sizeof(rx_buffers));
    
    for (int i = 0; i < RX_DESC_COUNT; i++) {
        rx_descs[i].addr = (uint64_t)(uintptr_t)rx_buffers[i];
        rx_descs[i].status = 0;
    }
    
    e1000_write(E1000_RDBAL, (uint32_t)((uint64_t)(uintptr_t)rx_descs & 0xFFFFFFFF));
    e1000_write(E1000_RDBAH, (uint32_t)(((uint64_t)(uintptr_t)rx_descs >> 32) & 0xFFFFFFFF));
    e1000_write(E1000_RDLEN, RX_DESC_COUNT * sizeof(RxDesc));
    e1000_write(E1000_RDH, 0);
    e1000_write(E1000_RDT, RX_DESC_COUNT - 1);
    
                                  
    uint32_t rctrl = 0;
    rctrl |= (1 << 1);         
    rctrl |= (1 << 3);          
    rctrl |= (1 << 4);          
    rctrl |= (1 << 15);         
    rctrl |= (1 << 26);           
    e1000_write(E1000_RCTRL, rctrl);
    
                                   
    memset(tx_descs, 0, sizeof(tx_descs));
    memset(tx_buffers, 0, sizeof(tx_buffers));
    
    for (int i = 0; i < TX_DESC_COUNT; i++) {
        tx_descs[i].addr = (uint64_t)(uintptr_t)tx_buffers[i];
        tx_descs[i].status = 0;         
    }
    
    e1000_write(E1000_TDBAL, (uint32_t)((uint64_t)(uintptr_t)tx_descs & 0xFFFFFFFF));
    e1000_write(E1000_TDBAH, (uint32_t)(((uint64_t)(uintptr_t)tx_descs >> 32) & 0xFFFFFFFF));
    e1000_write(E1000_TDLEN, TX_DESC_COUNT * sizeof(TxDesc));
    e1000_write(E1000_TDH, 0);
    e1000_write(E1000_TDT, 0);
    
                                  
    uint32_t tctrl = 0;
    tctrl |= (1 << 1);         
    tctrl |= (1 << 3);          
    e1000_write(E1000_TCTRL, tctrl);
    
                       
    uint32_t ctrl = e1000_read(E1000_CTRL);
    ctrl |= (1 << 5);         
    ctrl |= (1 << 6);          
    ctrl |= (1 << 0);        
    e1000_write(E1000_CTRL, ctrl);

    e1000_enable_interrupts();
    
    rx_tail = 0;
    tx_tail = 0;
    e1000_ready = 1;

    #ifdef DEBUG_E1000
    print("e1000: Ready!\n");
    #endif
    return 0;
}

                         
void e1000_rx_flush(void) {
    for (int i = 0; i < RX_DESC_COUNT; i++) {
        rx_descs[i].status = 0;
    }
    rx_tail = 0;
    e1000_write(E1000_RDT, RX_DESC_COUNT - 1);
}

                       
int e1000_send_packet(const uint8_t* data, uint16_t length) {
    if (!e1000_ready) return -1;
    if (length == 0 || length > TX_BUFFER_SIZE) return -1;
    
    #ifdef DEBUG_E1000
    printf("e1000: TX send len=%d, tail=%d\n", length, tx_tail);
    #endif
    
                                                              
    int free_desc = -1;
    int checked = 0;
    
    for (int i = 0; i < TX_DESC_COUNT; i++) {
        int idx = (tx_tail + i) % TX_DESC_COUNT;
        checked++;
        
                                              
        if (tx_descs[idx].status & 0x01) {
            #ifdef DEBUG_E1000
            printf("e1000: TX desc %d is ready, clearing\n", idx);
            #endif
            tx_descs[idx].status = 0;
            tx_descs[idx].length = 0;
            tx_descs[idx].cmd = 0;
            
            if (free_desc == -1) {
                free_desc = idx;
            }
        } else {
                                                  
            if (tx_descs[idx].status == 0 && free_desc == -1) {
                free_desc = idx;
            }
        }
    }
    
                                                 
    if (free_desc == -1) {
        #ifdef DEBUG_E1000
        printf("e1000: NO FREE TX DESCRIPTORS! Resetting...\n");
        #endif
        e1000_tx_reset();
        
                                               
        for (int i = 0; i < TX_DESC_COUNT; i++) {
            if (tx_descs[i].status == 0) {
                free_desc = i;
                break;
            }
        }
        
        if (free_desc == -1) {
            #ifdef DEBUG_E1000
            printf("e1000: Still no free descriptors after reset!\n");
            #endif
            return -1;
        }
    }
    
    #ifdef DEBUG_E1000
    printf("e1000: Using desc %d\n", free_desc);
    #endif
    
                                 
    memcpy(tx_buffers[free_desc], data, length);
    
                                        
    tx_descs[free_desc].length = length;
    tx_descs[free_desc].cmd = 0x0B;                    
    tx_descs[free_desc].status = 0;
    tx_descs[free_desc].cso = 0;
    tx_descs[free_desc].css = 0;
    tx_descs[free_desc].special = 0;
    
                                
    uint32_t old_tail = tx_tail;
    tx_tail = (free_desc + 1) % TX_DESC_COUNT;
    e1000_write(E1000_TDT, tx_tail);
    
    #ifdef DEBUG_E1000
    printf("e1000: TX submitted desc=%d, tail=%d\n", free_desc, tx_tail);
    #endif
    
                                 
    int timeout = 10000000;                  
    while (timeout-- > 0) {
        if (tx_descs[free_desc].status & 0x01) {
            #ifdef DEBUG_E1000
            printf("e1000: TX complete desc=%d\n", free_desc);
            #endif
            tx_descs[free_desc].status = 0;            
            return length;
        }
    }
    
                                      
    #ifdef DEBUG_E1000
    printf("e1000: TX timeout! Resetting desc %d\n", free_desc);
    #endif
    
    tx_descs[free_desc].status = 0;
    tx_descs[free_desc].length = 0;
    tx_descs[free_desc].cmd = 0;
    e1000_tx_reset();
    return -1;
}

                               
int e1000_receive_packet(uint8_t* buffer, uint16_t max_len) {
    if (!e1000_ready) return -1;
    
                                
    if (pkt_count > 0) {
        int len = pkt_queue[pkt_head].length;
        if (len > max_len) len = max_len;
        memcpy(buffer, pkt_queue[pkt_head].data, len);
        pkt_head = (pkt_head + 1) % PKT_QUEUE_SIZE;
        pkt_count--;
        return len;
    }
    
                                                             
    return e1000_receive_packet_irq(buffer, max_len);
}

                                
int e1000_receive_packet_timeout(uint8_t* buffer, uint16_t max_len, uint32_t timeout_ms) {
    if (!e1000_ready) return -1;
    
    for (volatile uint32_t elapsed = 0; timeout_ms == 0 || elapsed < timeout_ms; elapsed++) {
        int len = e1000_receive_packet(buffer, max_len);
        if (len > 0) return len;
        
        for (volatile int i = 0; i < 1000; i++);
    }
    
    return 0;
}

                            
