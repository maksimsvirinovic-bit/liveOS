void lpi_init(void) {
    if (lpi_initialized) return;

    lpi_print_header("Initializing LiveOS Package Manager");

    lpi_ensure_dirs();
    
    lpi_installed_cache = vector_create(sizeof(LpiInstalled), 64);
    
    lpi_load_repo_config();
    
    lpi_initialized = 1;
    
    char msg[256];
    sprintf(msg, "LPI initialized with %d repository/repositories", 
            lpi_repo_configs ? (int)lpi_repo_configs->size : 0);
    lpi_print_success(msg);
}

int lpi_update(void) {
    if (!lpi_initialized) lpi_init();

    lpi_print_header("Updating package index");

    for (int i = 0; i < lpi_repo_configs->size; i++) {
        LpiRepoConfig* repo = (LpiRepoConfig*)lpi_repo_configs->at(lpi_repo_configs, i);
        if (!repo->enabled) continue;

        char msg[256];
        sprintf(msg, "Updating %s...", repo->name);
        lpi_print_info(msg);

        if (repo->is_local) {
            // Local repo: verify exists
            Vector* test = vector_create(sizeof(uint8_t), 1);
            int sz = read_file(repo->path, test);
            test->destroy(test);

            if (sz < 0) {
                sprintf(msg, "Local repo %s not accessible", repo->path);
                lpi_print_error(msg);
            } else {
                sprintf(msg, "Local repo %s verified", repo->name);
                lpi_print_success(msg);
            }
        }
    }

    lpi_print_success("Update complete");
    return 0;
}

int lpi_install(const char* name) {
    if (!lpi_initialized) lpi_init();
    if (!name || !name[0]) {
        lpi_print_error("Package name required");
        return -1;
    }

    char header[256];
    sprintf(header, "Installing package: %s", name);
    lpi_print_header(header);

    LpiPackage* pkg = NULL;

    // Search in all repos
    for (int i = 0; i < lpi_repo_configs->size && !pkg; i++) {
        LpiRepoConfig* repo = (LpiRepoConfig*)lpi_repo_configs->at(lpi_repo_configs, i);
        if (!repo->enabled) continue;

        if (repo->is_local) {
            pkg = lpi_find_in_local_repo(name, repo->path);
        }
    }

    if (!pkg) {
        char msg[256];
        sprintf(msg, "Package '%s' not found in any repository", name);
        lpi_print_error(msg);
        return -1;
    }

    // Resolve dependencies
    Vector* to_install = vector_create(sizeof(LpiPackage*), 32);
    
    if (lpi_resolve_deps(name, pkg->depends, to_install, 0) < 0) {
        lpi_print_error("Dependency resolution failed");
        to_install->destroy(to_install);
        kfree(pkg);
        return -1;
    }

    // Install dependencies first
    for (int i = 0; i < to_install->size; i++) {
        LpiPackage* dep_pkg = *(LpiPackage**)to_install->at(to_install, i);
        if (lpi_install_package(dep_pkg, 1) < 0) {
            lpi_print_error("Failed to install dependency");
            to_install->destroy(to_install);
            kfree(pkg);
            return -1;
        }
    }

    // Install main package
    int result = lpi_install_package(pkg, 0);

    to_install->destroy(to_install);
    kfree(pkg);

    return result;
}

int lpi_remove(const char* name) {
    if (!lpi_initialized) lpi_init();
    if (!name || !name[0]) {
        lpi_print_error("Package name required");
        return -1;
    }

    char header[256];
    sprintf(header, "Removing package: %s", name);
    lpi_print_header(header);
    return lpi_remove_package(name);
}

int lpi_search(const char* query) {
    if (!lpi_initialized) lpi_init();
    if (!query || !query[0]) {
        lpi_print_error("Search query required");
        return -1;
    }

    char header[256];
    sprintf(header, "Searching for: %s", query);
    lpi_print_header(header);

    int found = 0;

    for (int i = 0; i < lpi_repo_configs->size; i++) {
        LpiRepoConfig* repo = (LpiRepoConfig*)lpi_repo_configs->at(lpi_repo_configs, i);
        if (!repo->enabled || !repo->is_local) continue;

        char search_dir[512];
        sprintf(search_dir, "%s/packages", repo->path);

        // Simple file search for matching .lpi files
        Vector* content = vector_create(sizeof(uint8_t), 512);
        int sz = read_file(search_dir, content);
        
        if (sz > 0) {
            // Crude search in directory listing
            char* buf = (char*)content->data;
            if (strstr(buf, query)) found++;
        }
        
        content->destroy(content);
    }

    if (found == 0) {
        char msg[256];
        sprintf(msg, "No packages found matching '%s'", query);
        lpi_print_info(msg);
    } else {
        char msg[256];
        sprintf(msg, "Found %d package(s)", found);
        lpi_print_success(msg);
    }

    return found;
}

void lpi_list(void) {
