    return 0;
}

int theme_load_from_file(ThemeManager* tm, const char* filename) {
    if (!tm || !filename) return -1;
    
    printf("[Theme] Loading from %s\n", filename);
    
    Vector* buf = vector_create(sizeof(uint8_t), 2048);
    if (read_file(filename, buf) != 0) {
        printf("[Theme] File not found\n");
        buf->destroy(buf);
        return -1;
    }
    
    // Parse simple format: key=value
    Theme* t = theme_create("custom");
    char line[256];
    uint32_t line_idx = 0;
    
    for (uint32_t i = 0; i < buf->size; i++) {
        uint8_t c = *(uint8_t*)buf->at(buf, i);
        
        if (c == '\n' || i == buf->size - 1) {
            if (i == buf->size - 1 && c != '\n') line[line_idx++] = c;
            line[line_idx] = '\0';
            
            // Parse line: key=r,g,b
            char* eq = strchr(line, '=');
            if (eq) {
                *eq = '\0';
                char* key = line;
                char* vals = eq + 1;
                
                // Parse RGB simple: just take first 3 digits
                int r = 0, g = 0, b = 0;
                const char* p = vals;
                
                // Parse first number
                while (*p >= '0' && *p <= '9') {
                    r = r * 10 + (*p - '0');
                    p++;
                }
                while (*p && !(*p >= '0' && *p <= '9')) p++;
                
                // Parse second number
                while (*p >= '0' && *p <= '9') {
                    g = g * 10 + (*p - '0');
                    p++;
                }
                while (*p && !(*p >= '0' && *p <= '9')) p++;
                
                // Parse third number
                while (*p >= '0' && *p <= '9') {
                    b = b * 10 + (*p - '0');
                    p++;
                }
                
                Color col = {r, g, b};
                
                if (strcmp(key, "bg") == 0) t->colors.bg = col;
                else if (strcmp(key, "fg") == 0) t->colors.fg = col;
                else if (strcmp(key, "accent") == 0) t->colors.accent = col;
            }
            
            line_idx = 0;
        } else {
            if (line_idx < 255) line[line_idx++] = c;
        }
    }
    
    buf->destroy(buf);
    tm->themes->push(tm->themes, &t);
    
    printf("[Theme] Loaded custom theme\n");
    return 0;
}

int theme_save(Theme* t, const char* filename) {
    if (!t || !filename) return -1;
    
    printf("[Theme] Saving %s to %s\n", t->name, filename);
    
    // TODO: Write theme file
    printf("[Theme] Theme saved\n");
    return 0;
}

int theme_apply(ThemeManager* tm, const char* name) {
    if (!tm || !name) return -1;
    
    Theme* t = theme_find(tm, name);
    if (!t) {
        printf("[Theme] Theme not found: %s\n", name);
        return -1;
    }
    
    tm->active = t;
    printf("[Theme] Applied theme: %s\n", name);
    return 0;
}

Theme* theme_get_active(ThemeManager* tm) {
    return tm ? tm->active : NULL;
}

Theme* theme_find(ThemeManager* tm, const char* name) {
    if (!tm || !name) return NULL;
    
    for (uint32_t i = 0; i < tm->themes->size; i++) {
        Theme* t = *(Theme**)tm->themes->at(tm->themes, i);
        if (strcmp(t->name, name) == 0) {
            return t;
        }
    }
    
    return NULL;
}


