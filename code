void idt_set_gate(uint8_t vector, void* handler, uint16_t selector, uint8_t flags) {
    uint64_t addr = (uint64_t)handler;
    idt[vector].offset_low  = (uint16_t)(addr & 0xFFFF);
    idt[vector].selector    = selector;
    idt[vector].ist         = 0;
    idt[vector].flags       = flags;
    idt[vector].offset_mid  = (uint16_t)((addr >> 16) & 0xFFFF);
    idt[vector].offset_high = (uint32_t)((addr >> 32) & 0xFFFFFFFF);
    idt[vector].reserved    = 0;
}

void irq_dispatcher(int irq) {
    switch (irq) {
        case 0:  apic_timer_handler(); break;
        case 1:  keyboard_handle_irq(); outb(0x20, 0x20); break;
        case 11: e1000_irq_handler(); break;
        case 12: input_irq_dispatch(); break;
        default: outb(0x20, 0x20); outb(0xA0, 0x20); break;
    }
    // EOI для PIC, если не APIC
    if (irq >= 8) outb(0xA0, 0x20);
    outb(0x20, 0x20);
}      

__attribute__((interrupt, target("general-regs-only"))) void irq_default_handler(void* frame) { outb(0x20, 0x20); outb(0xA0, 0x20); }
__attribute__((interrupt, target("general-regs-only"))) void irq_timer_handler(void* frame) { outb(0x20, 0x20); }
__attribute__((interrupt, target("general-regs-only"))) void irq_keyboard_handler(void* frame) {
    int abort_current = keyboard_handle_irq();
    outb(0x20, 0x20);
    if (abort_current) {
        elf_abort_current();
    }
}
