// ISO 9660 Primary Volume Descriptor
typedef struct {
    uint8_t type;
    char id[5];
    uint8_t version;
    uint8_t unused1;
    char system_id[32];
    char volume_id[32];
    uint8_t unused2[8];
    uint32_t space_size_le;
    uint32_t space_size_be;
    uint8_t unused3[32];
    uint16_t set_size_le;
    uint16_t set_size_be;
