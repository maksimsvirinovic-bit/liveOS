    if (dns_resolve(8 << 24 | 8 << 16 | 8 << 8 | 8, server, &ip) != 0) {
        printf("FTP: Cannot resolve server\n");
        return -1;
    }
    
    TcpConnection control;
    if (tcp_connect(&control, ip, FTP_PORT, 12345) != 0) {
        printf("FTP: Connection failed\n");
        return -1;
    }
    
    char buf[256];
    int len = tcp_receive(&control, (uint8_t*)buf, sizeof(buf));
    #ifdef DEBUG_FTP
    printf("FTP: %s", buf);
    
            
    sprintf(buf, "USER %s\r\n", user);
    #endif
    tcp_send(&control, (uint8_t*)buf, strlen(buf));
    len = tcp_receive(&control, (uint8_t*)buf, sizeof(buf));
    #ifdef DEBUG_FTP
    printf("FTP: %s", buf);
    
    sprintf(buf, "PASS %s\r\n", pass);
    #endif
    tcp_send(&control, (uint8_t*)buf, strlen(buf));
    len = tcp_receive(&control, (uint8_t*)buf, sizeof(buf));
    #ifdef DEBUG_FTP
    printf("FTP: %s", buf);
    #endif

    tcp_send(&control, (uint8_t*)"PASV\r\n", 6);
    len = tcp_receive(&control, (uint8_t*)buf, sizeof(buf));
    #ifdef DEBUG_FTP
    printf("FTP: %s", buf);
  
    sprintf(buf, "RETR %s\r\n", file);
    #endif
    tcp_send(&control, (uint8_t*)buf, strlen(buf));
    
    tcp_close(&control);
    return 0;
}

