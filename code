        ext4_create_dir("/.xattr");
    }
    
                             
    char xattr_path[512];
    make_xattr_path(path, name, xattr_path);
    
                          
    Vector* data = vector_create(sizeof(uint8_t), size);
    for (uint32_t i = 0; i < size; i++) {
        data->push(data, &((uint8_t*)value)[i]);
