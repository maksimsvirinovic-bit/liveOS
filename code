int dns_encode_domain(uint8_t* buffer, int offset, const char* domain) {
    const char* start = domain;
    int pos = offset;
    
    while (*start) {
        const char* end = start;
        while (*end && *end != '.') end++;
        
        int len = end - start;
        if (len > 63) return -1;
        
        buffer[pos++] = (uint8_t)len;
        for (int i = 0; i < len; i++) {
            buffer[pos++] = start[i];
        }
        
        if (*end == '.') start = end + 1;
        else break;
    }
    
    buffer[pos++] = 0;
    return pos - offset;
}

                                     
int dns_build_query(const char* domain, uint8_t* buffer, int max_len) {
    if (strlen(domain) > 253) {
        printf("DNS: Domain too long\n");
        return -1;
    }
    static uint16_t dns_id = 0x1234;
    int pos = 0;
    
             
    buffer[pos++] = (dns_id >> 8) & 0xFF;
    buffer[pos++] = dns_id & 0xFF;
    dns_id++;
    
    buffer[pos++] = 0x01;           
    buffer[pos++] = 0x00;
    
    buffer[pos++] = 0x00;
    buffer[pos++] = 0x01;                
    
    buffer[pos++] = 0x00;
    buffer[pos++] = 0x00;            
    buffer[pos++] = 0x00;
    buffer[pos++] = 0x00;            
    buffer[pos++] = 0x00;
    buffer[pos++] = 0x00;            
    
               
    int enc_len = dns_encode_domain(buffer, pos, domain);
    if (enc_len < 0) return -1;
    pos += enc_len;
    
    buffer[pos++] = 0x00;
    buffer[pos++] = 0x01;           
    
    buffer[pos++] = 0x00;
    buffer[pos++] = 0x01;             
    
    return pos;
}

                                
static int dns_parse_name(const uint8_t* data, int pos, int len, char* name, int max_len) {
    int name_pos = 0;
    
    while (pos < len) {
        if (data[pos] == 0) {
            pos++;
            break;
        } else if (data[pos] & 0xC0) {
            int ptr = ((data[pos] & 0x3F) << 8) | data[pos+1];
            pos += 2;
            dns_parse_name(data, ptr, len, name + name_pos, max_len - name_pos);
            break;
        } else {
            int seg_len = data[pos++];
            if (name_pos > 0 && name_pos < max_len - 1) {
                name[name_pos++] = '.';
            }
            for (int i = 0; i < seg_len && name_pos < max_len - 1; i++) {
                name[name_pos++] = data[pos++];
            }
        }
    }
    
    name[name_pos] = '\0';
    return pos;
}

                                 
int dns_parse_response(const uint8_t* data, int len, uint32_t* resolved_ip) {
    if (len < 12) return -1;

    if (len < 2) return -1;
    uint16_t flags = (data[2] << 8) | data[3];
    uint16_t ancount = (data[6] << 8) | data[7];
    
    if ((flags & 0xF) != 0) {
        printf("DNS: Error code %d\n", flags & 0xF);
        return -1;
    }
    
    if (ancount == 0) {
        return -1;
    }
    
    int pos = 12;
    char name[256];
    
                        
    pos = dns_parse_name(data, pos, len, name, sizeof(name));
    pos += 4;                 
    
                    
    for (int i = 0; i < ancount; i++) {
        pos = dns_parse_name(data, pos, len, name, sizeof(name));
        if (pos + 10 > len) break;
        
        uint16_t type = (data[pos] << 8) | data[pos+1];
        pos += 2;
        
        pos += 2;          
        pos += 4;        
        
        uint16_t rdlength = (data[pos] << 8) | data[pos+1];
        pos += 2;
        
        if (type == 1 && rdlength == 4) {
            *resolved_ip = (data[pos] << 24) | (data[pos+1] << 16) |
                           (data[pos+2] << 8) | data[pos+3];
            return 0;
        }
        
        pos += rdlength;
    }
    
    return -1;
}

                                 

static int dns_skip_name(const uint8_t* response, int pos, int len) {
    while (pos < len) {
        if (response[pos] == 0) {
                          
            return pos + 1;
        } else if (response[pos] & 0xC0) {
                                 
            return pos + 2;
        } else {
                            
            pos += response[pos] + 1;
        }
    }
    return pos;
}

                               

int dns_resolve(uint32_t dns_server, const char* domain, uint32_t* resolved_ip) {
    #ifdef DEBUG_DNS
    printf("DNS: Resolving %s via ", domain);
    print_ip(dns_server);
    printf("\n");
    #endif
                           
    uint8_t query[512];
    memset(query, 0, sizeof(query));
    
                           
    query[0] = 0x12;             
    query[1] = 0x34;            
    query[2] = 0x01;                           
    query[3] = 0x00;                                       
    query[4] = 0x00;                 
    query[5] = 0x01;
    
                     
    int pos = 12;
    int encoded_len = dns_encode_domain(query, pos, domain);
    if (encoded_len < 0) {
        printf("DNS: Invalid domain name\n");
        return -1;
    }
    pos += encoded_len;
    
                               
    query[pos++] = 0x00;
    query[pos++] = 0x01;
    query[pos++] = 0x00;
    query[pos++] = 0x01;
    #ifdef DEBUG_DNS
    printf("DNS: Query size = %d bytes\n", pos);
    #endif
    
                                
    udp_send(dns_server, 12346, 53, query, pos);
    
                 
    for (int attempt = 0; attempt < 500; attempt++) {
        uint8_t resp[512];
        uint32_t src_ip;
        uint16_t src_port;
        
        int len = udp_receive(resp, sizeof(resp), &src_ip, &src_port);
        
        if (len > 0) {
            if (src_port == 53 && resp[0] == 0x12 && resp[1] == 0x34) {
                                         
                uint16_t flags = (resp[2] << 8) | resp[3];
                uint16_t qdcount = (resp[4] << 8) | resp[5];
                uint16_t ancount = (resp[6] << 8) | resp[7];
                uint16_t nscount = (resp[8] << 8) | resp[9];
                uint16_t arcount = (resp[10] << 8) | resp[11];
                #ifdef DEBUG_DNS
                printf("DNS: Response - QR=%d, AA=%d, TC=%d, RD=%d, RA=%d, RCODE=%d\n",
                       (flags >> 15) & 1,
                       (flags >> 10) & 1,
                       (flags >> 9) & 1,
                       (flags >> 8) & 1,
                       (flags >> 7) & 1,
                       flags & 0xF);
                #endif
                                           
                if ((flags & 0xF) != 0) {
                    printf("DNS: Error code %d\n", flags & 0xF);
                    return -1;
                }
                
                if (ancount > 0) {
                                        
                    int pos = 12;
                    if (pos >= len) return -1;
                    pos = dns_skip_name(resp, pos, len);
                    if (pos + 4 > len) return -1;
                    pos += 4;                
                    
                                        
                    for (int i = 0; i < ancount; i++) {
                              
                        pos = dns_skip_name(resp, pos, len);
                        if (pos >= len || pos + 10 > len) break;

                                                     
                        if (pos + 2 > len) break;
                        uint16_t type = (resp[pos] << 8) | resp[pos+1];
                        pos += 2;

                        if (pos + 2 > len) break;
                        uint16_t class = (resp[pos] << 8) | resp[pos+1];
                        pos += 2;

                        if (pos + 4 > len) break;
                        uint32_t ttl = (resp[pos] << 24) | (resp[pos+1] << 16) |
                                       (resp[pos+2] << 8) | resp[pos+3];
                        pos += 4;

                        if (pos + 2 > len) break;
                        uint16_t rdlength = (resp[pos] << 8) | resp[pos+1];
                        pos += 2;
                        #ifdef DEBUG_DNS
                        printf("DNS: Answer #%d - Type=%d, Class=%d, TTL=%d, RDLENGTH=%d\n",
                               i + 1, type, class, ttl, rdlength);
                        #endif
                                              
                        if (type == 5) {
                            #ifdef DEBUG_DNS
                            printf("DNS: CNAME found, skipping...\n");
                            #endif
                            pos += rdlength;
                            continue;
                        }
                        
                                          
                        if (type == 1 && rdlength == 4) {
                            uint32_t ip = (resp[pos] << 24) | 
                                         (resp[pos+1] << 16) |
                                         (resp[pos+2] << 8) | 
                                         resp[pos+3];
                            
                            *resolved_ip = ip;
                            #ifdef DEBUG_DNS
                            printf("DNS: Resolved to ");
                            print_ip(ip);
                            printf(" (TTL=%d)\n", ttl);
                            #endif
                            
                            return 0;
                        }
                        
                                                            
                        pos += rdlength;
                    }
                }
            }
        }
        
        for (volatile int j = 0; j < 1000; j++);
    }
    
    printf("DNS: Timeout!\n");
    return -1;
}

