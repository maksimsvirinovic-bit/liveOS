                    break;
                }
                
                case 'x':
                case 'X': {
                    if (alt_form) print("0x");
                    
                    if (long_arg == 2) {
                        uint64_t num = va_arg(args, uint64_t);
                        print_uint64(num, 16, width, zero_pad);
                    } else if (long_arg == 1) {
                        uint64_t num = va_arg(args, uint64_t);
                        print_uint64(num, 16, width, zero_pad);
                    } else {
                        uint32_t num = va_arg(args, uint32_t);
                        print_uint32(num, 16, width, zero_pad);
                    }
                    break;
                }
                
                case 'p': {
                    void* ptr = va_arg(args, void*);
                    print_ptr(ptr);
                    break;
                }
                
                case 's': {
                    const char* str = va_arg(args, const char*);
                    print_string(str, width, left_align);
                    break;
                }
                
                case 'c': {
                    char c = (char)va_arg(args, int);
                    putc(c);
                    break;
                }
                
                case '%': {
                    putc('%');
                    break;
                }
                
                default: {
                    putc('%');
                    putc(*format);
                }
            }
            format++;
        } else {
            putc(*format++);
        }
    }
}

static void printf(const char* format, ...) {
    va_list args;
    va_start(args, format);
    vprintf(format, args);
    va_end(args);
}

static int format_into_buffer(char* buffer, const char* format, va_list args) {
    int pos = 0;
    
    while (*format) {
        if (*format == '%') {
            format++;
            
            int width = 0;
            int zero_pad = 0;
            int left_align = 0;
            int long_arg = 0;
            
            while (1) {
                if (*format == '0') {
                    zero_pad = 1;
                    format++;
                } else if (*format == '-') {
                    left_align = 1;
                    format++;
                } else if (*format >= '0' && *format <= '9') {
                    width = 0;
                    while (*format >= '0' && *format <= '9') {
                        width = width * 10 + (*format - '0');
                        format++;
                    }
                } else {
                    break;
                }
            }
            
            if (*format == 'l') {
                long_arg = 1;
                format++;
            }
            
            switch (*format) {
                case 'd':
                case 'i': {
                    int32_t num = va_arg(args, int32_t);
                    if (num < 0) {
                        buffer[pos++] = '-';
                        num = -num;
                    }
                                            
                    char temp[32];
                    int temp_pos = 0;
                    if (num == 0) {
                        temp[temp_pos++] = '0';
                    } else {
                        while (num > 0) {
                            temp[temp_pos++] = '0' + (num % 10);
                            num /= 10;
                        }
                    }
                             
                    for (int i = temp_pos - 1; i >= 0; i--) {
                        buffer[pos++] = temp[i];
                    }
                    break;
                }

                case 'l': {
                    if (*(format + 1) == 'l') {
                        format++;
                        uint64_t num = va_arg(args, uint64_t);
                        print_uint64(num, 10, width, zero_pad);
                    }
                    break;
                }
                
                case 'u': {
                    uint32_t num = va_arg(args, uint32_t);
                    char temp[32];
                    int temp_pos = 0;
                    if (num == 0) {
                        temp[temp_pos++] = '0';
                    } else {
                        while (num > 0) {
                            temp[temp_pos++] = '0' + (num % 10);
                            num /= 10;
                        }
                    }
                    for (int i = temp_pos - 1; i >= 0; i--) {
                        buffer[pos++] = temp[i];
                    }
                    break;
                }
                
                case 'x': {
                    uint32_t num = va_arg(args, uint32_t);
                    const char hex[] = "0123456789abcdef";
                    if (num == 0) {
                        buffer[pos++] = '0';
                    } else {
                        char temp[16];
                        int temp_pos = 0;
                        while (num > 0) {
                            temp[temp_pos++] = hex[num & 0xF];
                            num >>= 4;
                        }
                        for (int i = temp_pos - 1; i >= 0; i--) {
                            buffer[pos++] = temp[i];
                        }
                    }
                    break;
                }
                
                case 'X': {
                    uint32_t num = va_arg(args, uint32_t);
                    const char hex[] = "0123456789ABCDEF";
                    if (num == 0) {
                        buffer[pos++] = '0';
                    } else {
                        char temp[16];
                        int temp_pos = 0;
                        while (num > 0) {
                            temp[temp_pos++] = hex[num & 0xF];
                            num >>= 4;
                        }
                        for (int i = temp_pos - 1; i >= 0; i--) {
                            buffer[pos++] = temp[i];
                        }
                    }
                    break;
                }
                
                case 'p': {
                    void* ptr = va_arg(args, void*);
                    uintptr_t num = (uintptr_t)ptr;
                    buffer[pos++] = '0';
                    buffer[pos++] = 'x';
                    const char hex[] = "0123456789ABCDEF";
                    for (int i = sizeof(uintptr_t) * 2 - 1; i >= 0; i--) {
                        buffer[pos++] = hex[(num >> (i * 4)) & 0xF];
                    }
                    break;
                }
                
                case 's': {
                    const char* str = va_arg(args, const char*);
                    while (*str) {
                        buffer[pos++] = *str++;
                    }
                    break;
                }
                
                case 'c': {
                    char c = (char)va_arg(args, int);
                    buffer[pos++] = c;
                    break;
                }
                
                case '%': {
                    buffer[pos++] = '%';
                    break;
                }
                
                default: {
                    buffer[pos++] = '%';
                    buffer[pos++] = *format;
                }
            }
            format++;
        } else {
            buffer[pos++] = *format++;
        }
    }
    
    buffer[pos] = '\0';
    return pos;
}

                      

static int sprintf(char* buffer, const char* format, ...) {
    if (!buffer) return -1;
    
    va_list args;
    va_start(args, format);
    int result = format_into_buffer(buffer, format, args);
    va_end(args);
    return result;
}

                       

static int snprintf(char* buffer, size_t size, const char* format, ...) {
    if (!buffer || size == 0) return -1;
    
    va_list args;
    va_start(args, format);
    
                              
    char temp[4096];
    int result = format_into_buffer(temp, format, args);
    va_end(args);
    
                                         
    int copy_len = (result < size - 1) ? result : size - 1;
    for (int i = 0; i < copy_len; i++) {
        buffer[i] = temp[i];
    }
    buffer[copy_len] = '\0';
    
    return result;
}

                       

static int vsprintf(char* buffer, const char* format, va_list args) {
    if (!buffer) return -1;
    return format_into_buffer(buffer, format, args);
}

                        

static int vsnprintf(char* buffer, size_t size, const char* format, va_list args) {
    if (!buffer || size == 0) return -1;
    
    char temp[4096];
    int result = format_into_buffer(temp, format, args);
    
