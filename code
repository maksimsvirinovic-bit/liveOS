static int read_inode(uint32_t inode_num, Ext4_Inode* inode) {
                                
    uint32_t group = (inode_num - 1) / superblock.s_inodes_per_group;
    uint32_t index = (inode_num - 1) % superblock.s_inodes_per_group;
    
                                  
    uint8_t gd_buf[4096];
    uint64_t gd_block = 2;                                       
    read_block(gd_block, gd_buf);
    
    Ext4_GroupDesc* gd = (Ext4_GroupDesc*)(gd_buf + group * superblock.s_desc_size);
    
                     
    uint64_t inode_table = gd->bg_inode_table_lo;
    
                          
    uint64_t inode_offset = (inode_num - 1) * superblock.s_inode_size;
    uint64_t block_offset = inode_table + inode_offset / block_size;
    uint32_t offset_in_block = inode_offset % block_size;
    
    uint8_t inode_buf[4096];
    if (read_block(block_offset, inode_buf) != 0) {
        print("ext4: Cannot read inode!\n");
        return -1;
    }
    
                     
    memcpy(inode, inode_buf + offset_in_block, sizeof(Ext4_Inode));
    
    return 0;
}

static int ext4_write_inode(uint32_t inode_num, Ext4_Inode* inode) {
    uint32_t group = (inode_num - 1) / superblock.s_inodes_per_group;
    uint32_t index = (inode_num - 1) % superblock.s_inodes_per_group;
    
    uint8_t gd_buf[4096];
    read_block(2, gd_buf);
    Ext4_GroupDesc* gd = (Ext4_GroupDesc*)(gd_buf + group * superblock.s_desc_size);
    
    uint64_t inode_table = gd->bg_inode_table_lo;
    uint64_t inode_offset = (inode_num - 1) * superblock.s_inode_size;
    uint64_t block_offset = inode_table + inode_offset / block_size;
    uint32_t offset_in_block = inode_offset % block_size;
    
    uint8_t inode_buf[4096];
    read_block(block_offset, inode_buf);
    memcpy(inode_buf + offset_in_block, inode, sizeof(Ext4_Inode));
    write_block(block_offset, inode_buf);
    
    return 0;
}

static uint32_t ext4_allocate_block(void) {
    if (!ext4_initialized) return 0;
    
                                  
    uint8_t gd_buf[4096];
    read_block(2, gd_buf);
    Ext4_GroupDesc* gd = (Ext4_GroupDesc*)gd_buf;
    
                           
    uint8_t bitmap[4096];
    if (read_block(gd->bg_block_bitmap_lo, bitmap) != 0) {
        print("  ERROR: Cannot read block bitmap!\n");
        return 0;
    }
    
                                                           
    for (uint32_t i = 101; i < superblock.s_blocks_per_group && i < superblock.s_blocks_count_lo; i++) {
        uint32_t byte_idx = i / 8;
        uint32_t bit_idx = i % 8;
        
        if (!(bitmap[byte_idx] & (1 << bit_idx))) {
                                    
            bitmap[byte_idx] |= (1 << bit_idx);
            
                                            
            write_block(gd->bg_block_bitmap_lo, bitmap);
            
                                                 
            gd->bg_free_blocks_count_lo--;
            write_block(2, gd_buf);
            
            return i;
        }
    }
    
    print("  No free blocks!\n");
    return 0;
}

static uint32_t ext4_allocate_inode(void) {
    if (!ext4_initialized) return 0;
    
                                  
    uint8_t gd_buf[4096];
    read_block(2, gd_buf);
    Ext4_GroupDesc* gd = (Ext4_GroupDesc*)gd_buf;
    
                           
    uint8_t bitmap[4096];
    if (read_block(gd->bg_inode_bitmap_lo, bitmap) != 0) {
        print("  ERROR: Cannot read inode bitmap!\n");
        return 0;
    }
    
                                              
    for (uint32_t i = 10; i < superblock.s_inodes_per_group; i++) {
        uint32_t byte_idx = i / 8;
        uint32_t bit_idx = i % 8;
        
        if (!(bitmap[byte_idx] & (1 << bit_idx))) {
                                     
            bitmap[byte_idx] |= (1 << bit_idx);
            
            write_block(gd->bg_inode_bitmap_lo, bitmap);
            
            gd->bg_free_inodes_count_lo--;
            write_block(2, gd_buf);
            
            return i + 1;
        }
    }
    
    print("  No free inodes!\n");
    return 0;
}

static int ext4_find_in_dir(uint32_t dir_inode_num, const char* name, uint32_t* out_inode_num) {
    Ext4_Inode dir_inode;
    if (read_inode(dir_inode_num, &dir_inode) != 0) return -1;
    
    if ((dir_inode.i_mode & EXT4_S_IFMT) != EXT4_S_IFDIR) {
        print("ext4: Not a directory!\n");
        return -1;
    }
    
    uint32_t file_size = dir_inode.i_size_lo;
    uint8_t dir_buf[4096];
    
                       
    uint32_t blocks = (file_size + block_size - 1) / block_size;
    if (blocks == 0) blocks = 1;
    
    for (uint32_t b = 0; b < blocks && b < 12; b++) {
        uint32_t data_block = dir_inode.i_block[b];
        if (data_block == 0) break;
        
        read_block(data_block, dir_buf);
        
        int offset = 0;
        uint32_t remaining = file_size;
        
        while (offset < (int)block_size && remaining > 0) {
            Ext4_DirEntry* entry = (Ext4_DirEntry*)(dir_buf + offset);
            
            if (entry->rec_len == 0) break;
            
            if (entry->inode != 0) {
                char entry_name[256];
                for (int i = 0; i < entry->name_len && i < 255; i++) {
                    entry_name[i] = entry->name[i];
                }
                entry_name[entry->name_len] = '\0';
                
                if (strcmp(entry_name, name) == 0) {
                    *out_inode_num = entry->inode;
                    return 0;
                }
            }
            
            offset += entry->rec_len;
            remaining -= entry->rec_len;
        }
        
        file_size -= block_size;
        if (file_size <= 0) break;
    }
    
    return -1;
}

static int ext4_find_path_with_num(const char* path, Ext4_Inode* out_inode, uint32_t* out_inode_num) {
    if (!ext4_initialized || !path || path[0] == '\0') return -1;

    char resolved_path[512];
    resolved_path[0] = '\0';

                                            
    if (path[0] == '/') {
        strncpy(resolved_path, path, sizeof(resolved_path) - 1);
        resolved_path[sizeof(resolved_path) - 1] = '\0';
    } else {
                                                                                 
        if (current_path_ext4 && current_path_ext4->size > 0) {
            int pos = 0;
            for (uint32_t i = 0; i < current_path_ext4->size; i++) {
                if (pos < (int)(sizeof(resolved_path) - 1)) {
                    resolved_path[pos++] = current_path_ext4->data[i];
                }
            }
            if (pos == 0 || resolved_path[pos - 1] != '/') {
                if (pos < (int)(sizeof(resolved_path) - 1)) {
                    resolved_path[pos++] = '/';
                }
            }
            int path_len = strlen(path);
            if (path_len > 0 && pos + path_len < (int)sizeof(resolved_path)) {
                memcpy(&resolved_path[pos], path, path_len + 1);
            }
        } else {
            if (strlen(path) + 2 < sizeof(resolved_path)) {
                strcpy(resolved_path, "/");
                strcat(resolved_path, path);
            }
        }
    }

    if (resolved_path[0] == '\0' || strcmp(resolved_path, "/") == 0) {
        *out_inode_num = 2;
        return read_inode(2, out_inode);
    }

                             
    const char* actual = resolved_path;
    if (*actual == '/') actual++;

    uint32_t current_num = 2;
    Ext4_Inode current_inode;
    read_inode(current_num, &current_inode);

                     
    char temp[512];
    strncpy(temp, actual, sizeof(temp) - 1);
    temp[sizeof(temp) - 1] = '\0';
    char* part = temp;

    while (*part) {
                                
        char* slash = strchr(part, '/');
        if (slash) *slash = '\0';

                                  
        if (*part != '\0') {
            uint32_t found_num = 0;
            if (ext4_find_in_dir(current_num, part, &found_num) != 0) {
                return -1;
            }

            current_num = found_num;
            read_inode(current_num, &current_inode);
        }

        if (!slash) break;
        part = slash + 1;
    }

    *out_inode_num = current_num;
    memcpy(out_inode, &current_inode, sizeof(current_inode));

    return 0;
}

static int ext4_find_path(const char* path, Ext4_Inode* out_inode) {
    uint32_t inode_num;
    return ext4_find_path_with_num(path, out_inode, &inode_num);
}

int ext4_read_file(const char* path, Vector* output) {
    if (!ext4_initialized) return -1;
    if (block_size == 0) return -1;
    
    uint32_t inode_num;
    Ext4_Inode file_inode;
    if (ext4_find_path_with_num(path, &file_inode, &inode_num) != 0) {
        print("ext4: File not found!\n");
        return -1;
    }
    
    if ((file_inode.i_mode & EXT4_S_IFMT) != EXT4_S_IFREG) {
        print("ext4: Not a regular file!\n");
        return -1;
    }
    
    uint64_t file_size = file_inode.i_size_lo;
    output->clear(output);
    
    uint32_t bytes_read = 0;
    uint32_t block_index = 0;
    
                              
    for (; block_index < 12 && bytes_read < file_size; block_index++) {
        uint32_t block_num = file_inode.i_block[block_index];
        if (block_num == 0) break;
        
        uint8_t block_data[4096];
        read_block(block_num, block_data);
        
        uint32_t to_copy = block_size;
        if (bytes_read + to_copy > file_size) to_copy = file_size - bytes_read;
        
        for (uint32_t i = 0; i < to_copy; i++) {
            output->push(output, &block_data[i]);
        }
        bytes_read += to_copy;
    }
    
                                
    if (bytes_read < file_size) {
        uint32_t indirect_block = file_inode.i_block[12];
        if (indirect_block != 0) {
            uint32_t* indirect_table = (uint32_t*)kmalloc(block_size);
            if (indirect_table) {
                read_block(indirect_block, (uint8_t*)indirect_table);
                
                uint32_t max_entries = block_size / 4;
                for (uint32_t i = 0; i < max_entries && bytes_read < file_size; i++) {
                    uint32_t block_num = indirect_table[i];
                    if (block_num == 0) break;
                    
                    uint8_t block_data[4096];
                    read_block(block_num, block_data);
                    
                    uint32_t to_copy = block_size;
                    if (bytes_read + to_copy > file_size) to_copy = file_size - bytes_read;
                    
                    for (uint32_t j = 0; j < to_copy; j++) {
                        output->push(output, &block_data[j]);
                    }
                    bytes_read += to_copy;
                    block_index++;
                }
                
                kfree(indirect_table);
            }
        }
    }
    
                                        
    if (bytes_read < file_size) {
        uint32_t double_indirect_block = file_inode.i_block[13];
        if (double_indirect_block != 0) {
            uint32_t* double_indirect_table = (uint32_t*)kmalloc(block_size);
            if (double_indirect_table) {
                read_block(double_indirect_block, (uint8_t*)double_indirect_table);
                
                uint32_t max_entries = block_size / 4;
                for (uint32_t i = 0; i < max_entries && bytes_read < file_size; i++) {
                    uint32_t sub_block = double_indirect_table[i];
                    if (sub_block == 0) break;
                    
                    uint32_t* sub_table = (uint32_t*)kmalloc(block_size);
                    if (!sub_table) {
                        printf("ext4: Out of memory\n");
                        break;
                    }
                    if (sub_table) {
                        read_block(sub_block, (uint8_t*)sub_table);

                        for (uint32_t j = 0; j < max_entries && bytes_read < file_size; j++) {
                            uint32_t block_num = sub_table[j];
                            if (block_num == 0) break;
                            
                            uint8_t block_data[4096];
                            read_block(block_num, block_data);
                            
                            uint32_t to_copy = block_size;
                            if (bytes_read + to_copy > file_size) to_copy = file_size - bytes_read;
                            
                            for (uint32_t k = 0; k < to_copy; k++) {
                                output->push(output, &block_data[k]);
                            }
                            bytes_read += to_copy;
                            block_index++;
                        }
                        
                        kfree(sub_table);
                    }
                }
                
                kfree(double_indirect_table);
            }
        }
    }
    
    #ifdef DEBUG_EXT4
    printf("ext4: Read %d bytes from %s (%d blocks)\n", bytes_read, path, block_index);
    #endif
    
    return bytes_read;
}

const char* ext4_get_current_path(void) {
    if (current_path_ext4 && current_path_ext4->size > 0) {
                                 
        char null_char = '\0';
        current_path_ext4->push(current_path_ext4, &null_char);
        const char* result = (const char*)current_path_ext4->data;
        current_path_ext4->pop(current_path_ext4);
        return result;
    }
    return "/";
}

                                                     
static int ext4_find_path_resolve(const char* path, Ext4_Inode* out_inode, int depth) {
    if (depth > 8) return -1;                                    
    
    if (ext4_find_path(path, out_inode) != 0) return -1;
    
                              
    if ((out_inode->i_mode & EXT4_S_IFMT) == EXT4_S_IFLNK) {
        char target[256];
        uint32_t target_len = out_inode->i_size_lo;
        
        if (target_len < 60) {
            memcpy(target, out_inode->i_block, target_len);
        } else {
            uint8_t buf[4096];
            read_block(out_inode->i_block[0], buf);
            memcpy(target, buf, target_len);
        }
        target[target_len] = '\0';
        
                                    
        return ext4_find_path_resolve(target, out_inode, depth + 1);
    }
    
    return 0;
}

                                           
static int ext4_extend_directory(uint32_t dir_inode_num, Ext4_Inode* dir_inode) {
                                
    uint32_t new_block = ext4_allocate_block();
    if (new_block == 0) {
        print("ext4: No free blocks for directory extension!\n");
        return -1;
    }
    
                                                    
    int block_idx = -1;
    for (int i = 0; i < 12; i++) {
        if (dir_inode->i_block[i] == 0) {
            block_idx = i;
            break;
        }
    }
    
    if (block_idx == -1) {
                                                             
                                             
        print("ext4: Directory too large (need indirect blocks)!\n");
        ext4_free_block(new_block);
        return -1;
    }
    
                            
    uint8_t zero_block[4096];
    memset(zero_block, 0, 4096);
    write_block(new_block, zero_block);
    
                                  
    dir_inode->i_block[block_idx] = new_block;
    dir_inode->i_blocks_lo++;
    dir_inode->i_size_lo += block_size;
    
                                      
    ext4_write_inode(dir_inode_num, dir_inode);
    
    #ifdef DEBUG_EXT4
    printf("ext4: Directory extended with block %d (index %d)\n", new_block, block_idx);
    #endif
    
    return 0;
}

                                
void ext4_list_dir(const char* path, int show_all, int long_format) {
    if (!ext4_initialized) return;
    
                                 
    const char* actual_path;
    char resolved_path[512];
    
    if (!path || path[0] == '\0') {
        if (current_path_ext4 && current_path_ext4->size > 0) {
            int pos = 0;
            for (uint32_t i = 0; i < current_path_ext4->size; i++) {
                resolved_path[pos++] = current_path_ext4->data[i];
            }
            if (pos > 0 && resolved_path[pos-1] == '/') pos--;
            resolved_path[pos] = '\0';
            actual_path = resolved_path;
        } else {
            actual_path = "/";
        }
    } else {
        actual_path = path;
    }
    
    if (actual_path[0] == '\0') actual_path = "/";
    
                               
    Ext4_Inode dir_inode;
    uint32_t dir_inode_num;
    
    if (ext4_find_path_with_num(actual_path, &dir_inode, &dir_inode_num) != 0) {
        printf("ls: cannot access '%s': No such file or directory\n", actual_path);
        return;
    }
    
                                                
    if ((dir_inode.i_mode & EXT4_S_IFMT) == EXT4_S_IFREG) {
        if (long_format) {
            printf("-rw-r--r-- 1 0 0 %d %s\n", dir_inode.i_size_lo, actual_path);
        } else {
            printf("%s\n", actual_path);
        }
        return;
    }
    
    if ((dir_inode.i_mode & EXT4_S_IFMT) == EXT4_S_IFLNK) {
        if (long_format) {
            printf("lrwxrwxrwx 1 0 0 %d %s\n", dir_inode.i_size_lo, actual_path);
        } else {
            printf("%s@\n", actual_path);
        }
        return;
    }
    
    if ((dir_inode.i_mode & EXT4_S_IFMT) != EXT4_S_IFDIR) {
        printf("ls: not a directory: %s\n", actual_path);
        return;
    }
    
                                   
    typedef struct {
        char name[256];
        uint32_t inode;
        int is_dir;
        int is_link;
        int is_exec;
        uint32_t size;
        uint16_t mode;
    } EntryInfo;
    
    Vector* entries = vector_create(sizeof(EntryInfo), 64);
    
    uint32_t file_size = dir_inode.i_size_lo;
    uint8_t dir_buf[4096];
    
    uint32_t blocks = (file_size + block_size - 1) / block_size;
    if (blocks == 0) blocks = 1;
    
    for (uint32_t b = 0; b < blocks && b < 12; b++) {
        uint32_t data_block = dir_inode.i_block[b];
        if (data_block == 0) break;
        
        read_block(data_block, dir_buf);
        
        int offset = 0;
        uint32_t remaining = file_size;
        
        while (offset < (int)block_size && remaining > 0) {
            Ext4_DirEntry* entry = (Ext4_DirEntry*)(dir_buf + offset);
            if (entry->rec_len == 0) break;
            
            if (entry->inode != 0) {
                char name[256];
                int name_len = entry->name_len;
                if (name_len > 255) name_len = 255;
                for (int i = 0; i < name_len; i++) {
                    name[i] = entry->name[i];
                }
                name[name_len] = '\0';
                
                if (!show_all && (strcmp(name, ".") == 0 || strcmp(name, "..") == 0)) {
                    offset += entry->rec_len;
                    remaining -= entry->rec_len;
                    continue;
                }
                
                Ext4_Inode inode;
                read_inode(entry->inode, &inode);
                
                EntryInfo info;
                strcpy(info.name, name);
                info.inode = entry->inode;
                info.is_dir = ((inode.i_mode & EXT4_S_IFMT) == EXT4_S_IFDIR);
                info.is_link = ((inode.i_mode & EXT4_S_IFMT) == EXT4_S_IFLNK);
                info.is_exec = (inode.i_mode & 0111);
                info.size = inode.i_size_lo;
                info.mode = inode.i_mode;
                
                entries->push(entries, &info);
            }
            
            offset += entry->rec_len;
            remaining -= entry->rec_len;
        }
        
        file_size -= block_size;
        if (file_size <= 0) break;
    }
    
                            
    for (int i = 0; i < (int)entries->size - 1; i++) {
        for (int j = i + 1; j < (int)entries->size; j++) {
            EntryInfo* a = (EntryInfo*)entries->at(entries, i);
            EntryInfo* b = (EntryInfo*)entries->at(entries, j);
            
            int a_priority = a->is_dir ? 0 : 1;
            int b_priority = b->is_dir ? 0 : 1;
            
            if (a_priority != b_priority) {
                if (a_priority > b_priority) {
                    EntryInfo temp = *a;
                    *a = *b;
                    *b = temp;
                }
            } else {
                if (strcmp(a->name, b->name) > 0) {
                    EntryInfo temp = *a;
                    *a = *b;
                    *b = temp;
                }
            }
        }
    }
    
                       
    if (!long_format) {
                                      
        printf("\n=== %s ===\n", actual_path);
        
        int file_count = 0, dir_count = 0, link_count = 0;
        
        for (uint32_t i = 0; i < entries->size; i++) {
            EntryInfo* info = (EntryInfo*)entries->at(entries, i);
            
            if (info->is_dir) {
                dir_count++;
                set_color(COLOR_CYAN, COLOR_BLACK);
                printf("  %s/\n", info->name);
                reset_color();
            } else if (info->is_link) {
                link_count++;
                set_color(COLOR_MAGENTA, COLOR_BLACK);
                printf("  %s@\n", info->name);
                reset_color();
            } else if (info->is_exec) {
                file_count++;
                set_color(COLOR_GREEN, COLOR_BLACK);
                printf("  %s*  (%d bytes)\n", info->name, info->size);
                reset_color();
            } else {
                file_count++;
                printf("  %s  (%d bytes)\n", info->name, info->size);
            }
        }
        
        if (entries->size == 0) {
            printf("  [empty]\n");
        } else {
            printf("\n  %d files, %d directories, %d links\n", 
                   file_count, dir_count, link_count);
        }
    } else {
                              
        printf("\n=== %s ===\n", actual_path);
        printf("total %d\n", entries->size);
        
        for (uint32_t i = 0; i < entries->size; i++) {
            EntryInfo* info = (EntryInfo*)entries->at(entries, i);
            
                  
            if (info->is_dir) putc('d');
            else if (info->is_link) putc('l');
            else putc('-');
            
                    
            putc(info->mode & 0400 ? 'r' : '-');
            putc(info->mode & 0200 ? 'w' : '-');
            putc(info->mode & 0100 ? 'x' : '-');
            putc(info->mode & 0040 ? 'r' : '-');
            putc(info->mode & 0020 ? 'w' : '-');
            putc(info->mode & 0010 ? 'x' : '-');
            putc(info->mode & 0004 ? 'r' : '-');
            putc(info->mode & 0002 ? 'w' : '-');
            putc(info->mode & 0001 ? 'x' : '-');
            
                     
            printf(" 1 0 0 %6d %s\n", info->size, info->name);
        }
    }
    
    entries->destroy(entries);
}

int ext4_foreach_entry(const char* path, Ext4EntryCallback callback, void* user_data) {
    if (!ext4_initialized || !callback) return -1;
    Ext4_Inode dir_inode;
    uint32_t dir_inode_num;
    if (ext4_find_path_with_num(path ? path : "/", &dir_inode, &dir_inode_num) != 0) return -1;
    if ((dir_inode.i_mode & EXT4_S_IFMT) != EXT4_S_IFDIR) return -1;
    uint32_t file_size = dir_inode.i_size_lo;
    uint8_t dir_buf[4096];
    uint32_t blocks = (file_size + block_size - 1) / block_size;
    if (blocks == 0) blocks = 1;
    for (uint32_t b = 0; b < blocks && b < 12; b++) {
        if (!dir_inode.i_block[b]) break;
        read_block(dir_inode.i_block[b], dir_buf);
        int offset = 0;
        uint32_t remaining = file_size;
        while (offset < (int)block_size && remaining > 0) {
            Ext4_DirEntry* entry = (Ext4_DirEntry*)(dir_buf + offset);
            if (!entry->rec_len) break;
            if (entry->inode && entry->name_len > 0) {
                Vector* name = vector_create(sizeof(char), entry->name_len + 1);
                for (int i = 0; i < entry->name_len; i++) name->push(name, &entry->name[i]);
                char zero = '\0'; name->push(name, &zero);
                Ext4_Inode inode;
                read_inode(entry->inode, &inode);
                callback((char*)name->data, (inode.i_mode & EXT4_S_IFMT) == EXT4_S_IFDIR, user_data);
                name->destroy(name);
            }
            offset += entry->rec_len;
            remaining -= entry->rec_len;
        }
    }
    return 0;
}

                             
int ext4_create_file(const char* path) {
    if (!ext4_initialized) return -1;
    
                                
    char parent_path[512];
    char file_name[256];
    
    char* last_slash = NULL;
    for (char* p = (char*)path; *p; p++) {
        if (*p == '/') last_slash = p;
    }
    
    if (last_slash) {
        int len = last_slash - path;
        for (int i = 0; i < len; i++) parent_path[i] = path[i];
        parent_path[len] = '\0';
        strcpy(file_name, last_slash + 1);
    } else {
        if (current_path_ext4 && current_path_ext4->size > 1) {
            int pos = 0;
            for (uint32_t i = 0; i < current_path_ext4->size; i++) {
                parent_path[pos++] = current_path_ext4->data[i];
            }
            if (pos > 0 && parent_path[pos-1] == '/') pos--;
            parent_path[pos] = '\0';
        } else {
            strcpy(parent_path, "/");
        }
        strcpy(file_name, path);
    }
    
    if (parent_path[0] == '\0') strcpy(parent_path, "/");
    
                                  
    Ext4_Inode parent_inode;
    uint32_t parent_inode_num;
    if (ext4_find_path_with_num(parent_path, &parent_inode, &parent_inode_num) != 0) {
        printf("ext4: Parent directory not found!\n");
        return -1;
    }
    
                                                    
    uint8_t dir_buf[4096];
    uint32_t data_block = parent_inode.i_block[0];
    read_block(data_block, dir_buf);
    
    int offset = 0;
    while (offset < (int)parent_inode.i_size_lo) {
        Ext4_DirEntry* entry = (Ext4_DirEntry*)(dir_buf + offset);
        if (entry->rec_len == 0) break;
        if (entry->inode != 0) {
            char name[256];
            for (int i = 0; i < entry->name_len && i < 255; i++) {
                name[i] = entry->name[i];
            }
            name[entry->name_len] = '\0';
            if (strcmp(name, file_name) == 0) {
                printf("ext4: File already exists!\n");
                return -1;
            }
        }
        offset += entry->rec_len;
    }
    
                                  
    uint32_t new_inode_num = ext4_allocate_inode();
    if (new_inode_num == 0) {
        printf("ext4: No free inodes!\n");
        return -1;
    }
    
                               
    Ext4_Inode new_inode;
    memset(&new_inode, 0, sizeof(new_inode));
    new_inode.i_mode = EXT4_S_IFREG | 0644;
    new_inode.i_uid = 0;
    new_inode.i_gid = 0;
    new_inode.i_links_count = 1;
    new_inode.i_size_lo = 0;
    new_inode.i_blocks_lo = 0;
    new_inode.i_flags = 0;
    ext4_write_inode(new_inode_num, &new_inode);
    
                              
                                    
    int new_rec_len = ((strlen(file_name) + 8 + 3) & ~3);
    if (new_rec_len < 12) new_rec_len = 12;
    
                                                      
                                         
    offset = 0;
    while (offset < (int)parent_inode.i_size_lo) {
        Ext4_DirEntry* entry = (Ext4_DirEntry*)(dir_buf + offset);
        if (entry->rec_len == 0) break;
        offset += entry->rec_len;
    }
    
                                       
    int free_space = block_size - offset;
    
    if (free_space < new_rec_len) {
                                                 
        printf("ext4: No space in block! free_space=%d, need=%d\n", free_space, new_rec_len);
        ext4_free_inode(new_inode_num);
        return -1;
    }
    
                               
    Ext4_DirEntry* new_entry = (Ext4_DirEntry*)(dir_buf + offset);
    new_entry->inode = new_inode_num;
    new_entry->name_len = strlen(file_name);
    new_entry->file_type = 1;
    new_entry->rec_len = new_rec_len;
    for (int i = 0; i < new_entry->name_len; i++) {
        new_entry->name[i] = file_name[i];
    }
    
                                  
    parent_inode.i_size_lo = offset + new_rec_len;
    
                 
    write_block(data_block, dir_buf);
    ext4_write_inode(parent_inode_num, &parent_inode);
    
    printf("ext4: File created: %s (added at end)\n", path);
    return 0;
}

                            
int ext4_write_file(const char* path, Vector* data) {
    if (!ext4_initialized) return -1;
    if (!data || data->size == 0) {
        print("ext4: No data to write\n");
        return -1;
    }
    
                              
    uint32_t file_inode_num;
    Ext4_Inode file_inode;
    
    char parent_path[512];
    char file_name[256];
    char* last_slash = NULL;
    for (char* p = (char*)path; *p; p++) {
        if (*p == '/') last_slash = p;
    }
    
    if (last_slash) {
        int len = last_slash - path;
        for (int i = 0; i < len; i++) parent_path[i] = path[i];
        parent_path[len] = '\0';
        strcpy(file_name, last_slash + 1);
    } else {
                             
        if (current_path_ext4 && current_path_ext4->size > 1) {
            int pos = 0;
            for (uint32_t i = 0; i < current_path_ext4->size; i++) {
                parent_path[pos++] = current_path_ext4->data[i];
            }
            if (pos > 0 && parent_path[pos-1] == '/') pos--;
            parent_path[pos] = '\0';
        } else {
            strcpy(parent_path, "/");
        }
        strcpy(file_name, path);
    }
    if (parent_path[0] == '\0') strcpy(parent_path, "/");
    
                       
    Ext4_Inode parent_inode;
    uint32_t parent_inode_num;
    if (ext4_find_path_with_num(parent_path, &parent_inode, &parent_inode_num) != 0) {
        print("ext4: Parent not found!\n");
        return -1;
    }
    
                
    uint8_t dir_buf[4096];
    uint32_t parent_block = parent_inode.i_block[0];
    read_block(parent_block, dir_buf);
    
    int offset = 0;
    int found = 0;
    
    while (offset < (int)parent_inode.i_size_lo) {
        Ext4_DirEntry* entry = (Ext4_DirEntry*)(dir_buf + offset);
        if (entry->inode != 0) {
            char name[256];
            for (int i = 0; i < entry->name_len && i < 255; i++) {
                name[i] = entry->name[i];
            }
            name[entry->name_len] = '\0';
            
            if (strcmp(name, file_name) == 0) {
                file_inode_num = entry->inode;
                found = 1;
                break;
            }
        }
        offset += entry->rec_len;
    }
    
    if (!found) {
        #ifdef DEBUG_EXT4
        print("File not found. Creating...");
        #endif
        ext4_create_file(path);
        return ext4_write_file(path, data);
    }
    
    read_inode(file_inode_num, &file_inode);
    
                                          
    ext4_free_all_blocks(&file_inode);
    
                                        
    for (int i = 0; i < 15; i++) {
        file_inode.i_block[i] = 0;
    }
    
                                
    uint32_t total_bytes = data->size;
    uint32_t bytes_written = 0;
    uint32_t block_count = 0;
    uint32_t block_index = 0;
    
                           
    uint32_t indirect_block = 0;
    uint32_t* indirect_table = NULL;
    uint32_t indirect_count = 0;
    
                            
    uint32_t double_indirect_block = 0;
    uint32_t* double_indirect_table = NULL;
    uint32_t* double_indirect_subtable = NULL;
    uint32_t double_indirect_count = 0;
    
    while (bytes_written < total_bytes) {
        uint32_t new_block = ext4_allocate_block();
        if (new_block == 0) {
            print("ext4: Failed to allocate block!\n");
            return -1;
        }
        
                                            
        if (block_index < 12) {
                          
            file_inode.i_block[block_index] = new_block;
        } else if (block_index < 12 + (block_size / 4)) {
                                              
            if (indirect_table == NULL) {
                indirect_block = ext4_allocate_block();
                if (indirect_block == 0) {
                    print("ext4: Failed to allocate indirect block!\n");
                    return -1;
                }
                file_inode.i_block[12] = indirect_block;
                
                indirect_table = (uint32_t*)kmalloc(block_size);
                if (!indirect_table) {
                    print("ext4: No memory for indirect table!\n");
                    return -1;
                }
                memset(indirect_table, 0, block_size);
                indirect_count = 0;
            }
            
            indirect_table[indirect_count++] = new_block;
        } else if (block_index < 12 + (block_size / 4) + (block_size / 4) * (block_size / 4)) {
                                                      
            if (double_indirect_table == NULL) {
                double_indirect_block = ext4_allocate_block();
                if (double_indirect_block == 0) {
                    print("ext4: Failed to allocate double indirect block!\n");
                    return -1;
                }
                file_inode.i_block[13] = double_indirect_block;
                
                double_indirect_table = (uint32_t*)kmalloc(block_size);
                if (!double_indirect_table) {
                    print("ext4: No memory for double indirect table!\n");
                    return -1;
                }
                memset(double_indirect_table, 0, block_size);
                double_indirect_count = 0;
            }
            
                                                   
            uint32_t blocks_per_indirect = block_size / 4;
            uint32_t rel_index = block_index - 12 - blocks_per_indirect;
            uint32_t idx1 = rel_index / blocks_per_indirect;
            uint32_t idx2 = rel_index % blocks_per_indirect;
            
            if (double_indirect_subtable == NULL) {
                                     
                uint32_t sub_block = ext4_allocate_block();
                if (sub_block == 0) {
                    print("ext4: Failed to allocate sub-table!\n");
                    return -1;
                }
                double_indirect_table[double_indirect_count++] = sub_block;
                double_indirect_subtable = (uint32_t*)kmalloc(block_size);
                if (!double_indirect_subtable) {
                    print("ext4: No memory for sub-table!\n");
                    return -1;
                }
                memset(double_indirect_subtable, 0, block_size);
            }
            
            double_indirect_subtable[idx2] = new_block;
        } else {
                                                                   
            print("ext4: Triple indirect not yet implemented!\n");
            return -1;
        }
        
                                    
        uint8_t block_data[4096];
        memset(block_data, 0, 4096);
        
        uint32_t to_write = total_bytes - bytes_written;
        if (to_write > block_size) to_write = block_size;
        
        for (uint32_t i = 0; i < to_write; i++) {
            block_data[i] = data->data[bytes_written + i];
        }
        
        write_block(new_block, block_data);
        
        bytes_written += to_write;
        block_count++;
        block_index++;
    }
    
                                             
    if (indirect_table) {
        write_block(indirect_block, (uint8_t*)indirect_table);
        kfree(indirect_table);
    }
    
    if (double_indirect_table) {
                               
        for (uint32_t i = 0; i < double_indirect_count; i++) {
            if (double_indirect_subtable) {
                write_block(double_indirect_table[i], (uint8_t*)double_indirect_subtable);
            }
        }
        write_block(double_indirect_block, (uint8_t*)double_indirect_table);
        kfree(double_indirect_table);
        if (double_indirect_subtable) {
            kfree(double_indirect_subtable);
        }
    }
    
                                 
    file_inode.i_size_lo = total_bytes;
    file_inode.i_blocks_lo = block_count;
    file_inode.i_links_count = 1;
    
    ext4_write_inode(file_inode_num, &file_inode);
    
    #ifdef DEBUG_EXT4
    printf("ext4: Written %d bytes (%d blocks) to %s\n", bytes_written, block_count, path);
    #endif
    
    return bytes_written;
}

                             
int ext4_delete_file(const char* path) {
    if (!ext4_initialized) return -1;
    
                                       
    char parent_path[512];
    char file_name[256];
    
    char* last_slash = NULL;
    for (char* p = (char*)path; *p; p++) {
        if (*p == '/') last_slash = p;
    }
    
    if (last_slash) {
        int parent_len = last_slash - path;
        for (int i = 0; i < parent_len; i++) parent_path[i] = path[i];
        parent_path[parent_len] = '\0';
        strcpy(file_name, last_slash + 1);
    } else {
        if (current_path_ext4 && current_path_ext4->size > 1) {
            int pos = 0;
            for (uint32_t i = 0; i < current_path_ext4->size; i++) {
                parent_path[pos++] = current_path_ext4->data[i];
            }
            if (pos > 0 && parent_path[pos-1] == '/') pos--;
            parent_path[pos] = '\0';
        } else {
            strcpy(parent_path, "/");
        }
        strcpy(file_name, path);
    }
    
    if (parent_path[0] == '\0') strcpy(parent_path, "/");
    
                                      
    Ext4_Inode parent_inode;
    uint32_t parent_inode_num;
    
    if (ext4_find_path_with_num(parent_path, &parent_inode, &parent_inode_num) != 0) {
        print("ext4: Parent directory not found!\n");
        return -1;
    }
    
                                            
    uint8_t dir_buf[4096];
    uint32_t data_block = parent_inode.i_block[0];
    if (read_block(data_block, dir_buf) != 0) return -1;
    
                
    int offset = 0;
    int found = 0;
    uint32_t deleted_inode_num = 0;
    
    while (offset < (int)parent_inode.i_size_lo) {
        Ext4_DirEntry* entry = (Ext4_DirEntry*)(dir_buf + offset);
        
        if (entry->rec_len == 0) break;
        
        if (entry->inode != 0) {
            char name[256];
            for (int i = 0; i < entry->name_len && i < 255; i++) {
                name[i] = entry->name[i];
            }
            name[entry->name_len] = '\0';
            
            if (strcmp(name, file_name) == 0) {
                deleted_inode_num = entry->inode;
                found = 1;
                break;
            }
        }
        
        offset += entry->rec_len;
    }
    
    if (!found) {
        print("ext4: File not found!\n");
        return -1;
    }
    
                                     
    Ext4_Inode file_inode;
    if (read_inode(deleted_inode_num, &file_inode) != 0) return -1;
    
                                             
    if ((file_inode.i_mode & EXT4_S_IFMT) == EXT4_S_IFDIR) {
        print("ext4: Use rmdir for directories!\n");
        return -1;
    }
    
                              
    for (int b = 0; b < 12; b++) {
        if (file_inode.i_block[b] != 0) {
            ext4_free_block(file_inode.i_block[b]);
        }
    }
    
                                   
    ext4_free_inode(deleted_inode_num);
    
                                   
    Ext4_DirEntry* entry = (Ext4_DirEntry*)(dir_buf + offset);
    entry->inode = 0;
    
                                                     
    int next_offset = offset + entry->rec_len;
    int remaining = parent_inode.i_size_lo - next_offset;
    
    if (remaining > 0) {
        memmove(dir_buf + offset, dir_buf + next_offset, remaining);
    }
    
                                  
    parent_inode.i_size_lo = offset + remaining;
    
                                        
    write_block(data_block, dir_buf);
    
                                            
    ext4_write_inode(parent_inode_num, &parent_inode);
    
    return 0;
}

int ext4_create_dir(const char* path) {
    if (!ext4_initialized) return -1;

                                         
    Ext4_Stat stat;
    if (ext4_stat(path, &stat) == 0) {
        #ifdef DEBUG_EXT4
        printf("ext4: Directory '%s' already exists\n", path);
        #endif
        return 0;                   
    }

                                
    char parent_path[512];
    char dir_name[256];

    char* last_slash = NULL;
    for (char* p = (char*)path; *p; p++) {
        if (*p == '/') last_slash = p;
    }
    
    if (last_slash) {
        int len = last_slash - path;
        if (len == 0) {
            strcpy(parent_path, "/");
        } else {
            for (int i = 0; i < len; i++) parent_path[i] = path[i];
            parent_path[len] = '\0';
        }
        strcpy(dir_name, last_slash + 1);
    } else {
                                                                        
        if (path[0] == '\0') return -1;
        strcpy(parent_path, "/");
        strcpy(dir_name, path);
    }

    if (dir_name[0] == '\0') return -1;
    if (parent_path[0] == '\0') strcpy(parent_path, "/");

    #ifdef DEBUG_EXT4
    printf("ext4: create_dir path='%s' parent='%s' name='%s'\n", path, parent_path, dir_name);
    #endif

                                  
    Ext4_Inode parent_inode;
    uint32_t parent_inode_num;
    if (ext4_find_path_with_num(parent_path, &parent_inode, &parent_inode_num) != 0) {
        printf("ext4: Parent directory not found!\n");
        return -1;
    }
    
                                  
    uint32_t new_inode_num = ext4_allocate_inode();
    if (new_inode_num == 0) {
        printf("ext4: No free inodes!\n");
        return -1;
    }
    
                                 
    uint32_t new_block = ext4_allocate_block();
    if (new_block == 0) {
        ext4_free_inode(new_inode_num);
        printf("ext4: No free blocks!\n");
        return -1;
    }
    
                               
    Ext4_Inode dir_inode;
    memset(&dir_inode, 0, sizeof(dir_inode));
    dir_inode.i_mode = EXT4_S_IFDIR | 0755;
    dir_inode.i_links_count = 2;
    dir_inode.i_block[0] = new_block;
    dir_inode.i_blocks_lo = 1;
                     
                                                             
                                                      
    dir_inode.i_size_lo = 28;                       
    
    ext4_write_inode(new_inode_num, &dir_inode);
    
                                
    uint8_t dir_buf[4096];
    memset(dir_buf, 0, 4096);
    
                               
    Ext4_DirEntry* dot = (Ext4_DirEntry*)dir_buf;
    dot->inode = new_inode_num;
    dot->name_len = 1;
    dot->file_type = 2;
    dot->rec_len = 12;               
    dot->name[0] = '.';
    
                                                   
    Ext4_DirEntry* dotdot = (Ext4_DirEntry*)(dir_buf + 12);
    dotdot->inode = parent_inode_num;
    dotdot->name_len = 2;
    dotdot->file_type = 2;
    dotdot->rec_len = 16;                               
    dotdot->name[0] = '.';
    dotdot->name[1] = '.';
    
    write_block(new_block, dir_buf);
    
                                             
    uint8_t parent_buf[4096];
    uint32_t parent_block = parent_inode.i_block[0];
    read_block(parent_block, parent_buf);
    
                                      
    int offset = 0;
    int insert_offset = -1;
    
                                 
    while (offset < (int)parent_inode.i_size_lo) {
        Ext4_DirEntry* entry = (Ext4_DirEntry*)(parent_buf + offset);
        if (entry->rec_len == 0) break;
        if (entry->inode == 0) {
            insert_offset = offset;
            break;
        }
        offset += entry->rec_len;
    }
    
                                          
    if (insert_offset == -1) {
                                  
        int free_space = block_size - offset;
        int rec_len = ((strlen(dir_name) + 8 + 3) & ~3);
        if (rec_len < 12) rec_len = 12;
        
        if (free_space < rec_len) {
            printf("ext4: Parent directory full!\n");
            ext4_free_inode(new_inode_num);
            ext4_free_block(new_block);
            return -1;
        }
        
        insert_offset = offset;
    }
    
                     
    Ext4_DirEntry* new_entry = (Ext4_DirEntry*)(parent_buf + insert_offset);
    new_entry->inode = new_inode_num;
    new_entry->name_len = strlen(dir_name);
    new_entry->file_type = 2;
    
    int rec_len = ((strlen(dir_name) + 8 + 3) & ~3);
    if (rec_len < 12) rec_len = 12;
    new_entry->rec_len = rec_len;
    
    for (int i = 0; i < new_entry->name_len; i++) {
        new_entry->name[i] = dir_name[i];
    }
    
                                
    if (insert_offset + rec_len > (int)parent_inode.i_size_lo) {
        parent_inode.i_size_lo = insert_offset + rec_len;
    }
    
    write_block(parent_block, parent_buf);
    ext4_write_inode(parent_inode_num, &parent_inode);
    
    printf("ext4: Directory created: %s\n", path);
    return 0;
}

int ext4_delete_dir(const char* path) {
    if (!ext4_initialized) return -1;

                     
    char parent_path[512];
    char dir_name[256];
    
    char* last_slash = NULL;
    for (char* p = (char*)path; *p; p++) {
        if (*p == '/') last_slash = p;
    }
    
    if (last_slash) {
        int parent_len = last_slash - path;
        for (int i = 0; i < parent_len; i++) parent_path[i] = path[i];
        parent_path[parent_len] = '\0';
        strcpy(dir_name, last_slash + 1);
    } else {
        if (current_path_ext4 && current_path_ext4->size > 1) {
            int pos = 0;
            for (uint32_t i = 0; i < current_path_ext4->size; i++) {
                parent_path[pos++] = current_path_ext4->data[i];
            }
            if (pos > 0 && parent_path[pos-1] == '/') pos--;
            parent_path[pos] = '\0';
        } else {
            strcpy(parent_path, "/");
        }
        strcpy(dir_name, path);
    }
    
    if (parent_path[0] == '\0') strcpy(parent_path, "/");
    
                                      
    Ext4_Inode parent_inode;
    uint32_t parent_inode_num;
    
    if (ext4_find_path_with_num(parent_path, &parent_inode, &parent_inode_num) != 0) {
        print("ext4: Parent directory not found!\n");
        return -1;
    }
    
                                 
    uint8_t parent_buf[4096];
    uint32_t parent_block = parent_inode.i_block[0];
    read_block(parent_block, parent_buf);
    
    int parent_offset = 0;
    int found = 0;
    uint32_t dir_inode_num = 0;
    
    while (parent_offset < (int)parent_inode.i_size_lo) {
        Ext4_DirEntry* entry = (Ext4_DirEntry*)(parent_buf + parent_offset);
        
        if (entry->rec_len == 0) break;
        
        if (entry->inode != 0) {
            char name[256];
            for (int i = 0; i < entry->name_len && i < 255; i++) {
                name[i] = entry->name[i];
            }
            name[entry->name_len] = '\0';
            
            if (strcmp(name, dir_name) == 0) {
                dir_inode_num = entry->inode;
                found = 1;
                break;
            }
        }
        
        parent_offset += entry->rec_len;
    }
    
    if (!found) {
        print("ext4: Directory not found!\n");
        return -1;
    }
    
                              
    Ext4_Inode dir_inode;
    if (read_inode(dir_inode_num, &dir_inode) != 0) return -1;
    
                                   
    if ((dir_inode.i_mode & EXT4_S_IFMT) != EXT4_S_IFDIR) {
        print("ext4: Not a directory!\n");
        return -1;
    }
    
                                           
    uint8_t dir_buf[4096];
    uint32_t dir_data_block = dir_inode.i_block[0];
    read_block(dir_data_block, dir_buf);
    
    int dir_offset = 0;
    while (dir_offset < (int)dir_inode.i_size_lo) {
        Ext4_DirEntry* entry = (Ext4_DirEntry*)(dir_buf + dir_offset);
        
        if (entry->inode != 0) {
            char name[256];
            for (int i = 0; i < entry->name_len && i < 255; i++) {
                name[i] = entry->name[i];
            }
            name[entry->name_len] = '\0';
            
            if (strcmp(name, ".") != 0 && strcmp(name, "..") != 0) {
                print("ext4: Directory not empty!\n");
                return -1;
            }
        }
        
        dir_offset += entry->rec_len;
    }
    
                                   
    for (int b = 0; b < 12; b++) {
        if (dir_inode.i_block[b] != 0) {
            ext4_free_block(dir_inode.i_block[b]);
        }
    }
    
                                   
    ext4_free_inode(dir_inode_num);
    
                                 
    Ext4_DirEntry* entry = (Ext4_DirEntry*)(parent_buf + parent_offset);
    entry->inode = 0;
    
    int next_offset = parent_offset + entry->rec_len;
    int remaining = parent_inode.i_size_lo - next_offset;
    
    if (remaining > 0) {
        memmove(parent_buf + parent_offset, parent_buf + next_offset, remaining);
    }
    
    parent_inode.i_size_lo = parent_offset + remaining;
    
    write_block(parent_block, parent_buf);
    ext4_write_inode(parent_inode_num, &parent_inode);
    
    return 0;
} 

int ext4_format(void) {
    print("ext4: Formatting...\n");
    
    uint8_t zero_block[4096];
    memset(zero_block, 0, 4096);
    
                                         
    for (int i = 0; i < 10; i++) {
        write_block(i, zero_block);
    }
    
                            
    Ext4_Superblock sb;
    memset(&sb, 0, sizeof(sb));
    
    sb.s_inodes_count = 1024;
    sb.s_blocks_count_lo = 8192;               
    sb.s_free_blocks_count_lo = 8192 - 100;
    sb.s_free_inodes_count = 1024 - 10;
    sb.s_first_data_block = 0;
    sb.s_log_block_size = 2;                     
    sb.s_blocks_per_group = 32768;
    sb.s_inodes_per_group = 1024;
    sb.s_magic = 0xEF53;
    sb.s_state = 1;           
    sb.s_errors = 1;                           
    sb.s_rev_level = 1;
    sb.s_first_ino = 11;
    sb.s_inode_size = 256;
    
                                                      
    sb.s_feature_compat = EXT4_FEATURE_COMPAT_EXT_ATTR | 
                          EXT4_FEATURE_COMPAT_RESIZE_INODE | 
                          EXT4_FEATURE_COMPAT_DIR_INDEX;
    sb.s_feature_incompat = EXT4_FEATURE_INCOMPAT_FILETYPE | 
                            EXT4_FEATURE_INCOMPAT_EXTENTS | 
                            EXT4_FEATURE_INCOMPAT_FLEX_BG;
    sb.s_feature_ro_compat = 0;
    sb.s_volume_name[0] = 'l';
    sb.s_volume_name[1] = 'i';
    sb.s_volume_name[2] = 'v';
    sb.s_volume_name[3] = 'e';
    sb.s_volume_name[4] = 'O';
    sb.s_volume_name[5] = 'S';
    sb.s_volume_name[6] = '\0';
    
                                                         
    uint8_t block0[4096];
    memset(block0, 0, 4096);
    memcpy(block0 + 1024, &sb, sizeof(sb));
    write_block(0, block0);
    
                                      
    Ext4_GroupDesc gd;
    memset(&gd, 0, sizeof(gd));
    gd.bg_block_bitmap_lo = 3;
    gd.bg_inode_bitmap_lo = 4;
    gd.bg_inode_table_lo = 5;
    gd.bg_free_blocks_count_lo = 8192 - 100;
    gd.bg_free_inodes_count_lo = 1024 - 10;
    gd.bg_used_dirs_count_lo = 1;
    
    uint8_t gd_block[4096];
    memset(gd_block, 0, 4096);
    memcpy(gd_block, &gd, sizeof(gd));
    write_block(2, gd_block);
    
                         
    uint8_t bitmap[4096];
    memset(bitmap, 0, 4096);               
                            

    for (int i = 0; i < 101; i++) {
        bitmap[i / 8] |= (1 << (i % 8));
    }

    write_block(3, bitmap);                  

    memset(bitmap, 0x00, 4096);                 
                                     
    for (int i = 0; i < 11; i++) {
        bitmap[i / 8] |= (1 << (i % 8));
    }
    write_block(4, bitmap);                  
    
                                      
    Ext4_Inode root_inode;
    memset(&root_inode, 0, sizeof(root_inode));
    root_inode.i_mode = EXT4_S_IFDIR | 0755;
    root_inode.i_links_count = 2;
    root_inode.i_size_lo = 28;
    root_inode.i_blocks_lo = 1;
    root_inode.i_block[0] = 100;                          
    
                                      
    uint8_t inode_table[4096];
    memset(inode_table, 0, 4096);
    memcpy(inode_table + 1 * 256, &root_inode, sizeof(root_inode));            
    write_block(5, inode_table);
    
                                     
    uint8_t root_dir[4096];
    memset(root_dir, 0, 4096);
    
    Ext4_DirEntry* dot = (Ext4_DirEntry*)root_dir;
    dot->inode = 2;
    dot->name_len = 1;
    dot->file_type = 2;
    dot->rec_len = 12;
    dot->name[0] = '.';
    
    Ext4_DirEntry* dotdot = (Ext4_DirEntry*)(root_dir + 12);
    dotdot->inode = 2;
    dotdot->name_len = 2;
    dotdot->file_type = 2;
    dotdot->rec_len = 16;
    dotdot->name[0] = '.';
    dotdot->name[1] = '.';
    
    write_block(100, root_dir);
    
                              
    memcpy(&superblock, &sb, sizeof(sb));
    block_size = 4096;
    ext4_initialized = 1;
    
    print("ext4: Format complete!\n");
    print("  Inodes: ");
    print_int(sb.s_inodes_count);
    print(", Blocks: ");
    print_int(sb.s_blocks_count_lo);
    putc('\n');
    
                                      
    uint8_t journal_buf[4096];
    memset(journal_buf, 0, 4096);
    
    JournalHeader* header = (JournalHeader*)journal_buf;
    header->j_magic = EXT4_JOURNAL_MAGIC;
    header->j_blocktype = JFS_SUPERBLOCK_V2;
    header->j_sequence = 1;
    
    write_block(journal_block_start, journal_buf);

    current_path_ext4 = vector_create(sizeof(char), 256);
    char root = '/';
    current_path_ext4->push(current_path_ext4, &root);

    ext4_create_dir("/bin");
    ext4_create_dir("/home");
    ext4_create_dir("/etc");
    ext4_create_dir("/usr");
    ext4_create_dir("/var");
    ext4_create_dir("/tmp");
    
    return 0;
}

int ext4_rename_file(const char* old_path, const char* new_path) {
    if (!ext4_initialized) return -1;
    
                         
    char old_parent[512], old_name[256];
    char new_parent[512], new_name[256];
    
                  
    char* last_slash = NULL;
    for (char* p = (char*)old_path; *p; p++) {
        if (*p == '/') last_slash = p;
    }
    if (last_slash) {
        int len = last_slash - old_path;
        for (int i = 0; i < len; i++) old_parent[i] = old_path[i];
        old_parent[len] = '\0';
        strcpy(old_name, last_slash + 1);
    } else {
                                                  
        if (current_path_ext4 && current_path_ext4->size > 1) {
            int pos = 0;
            for (uint32_t i = 0; i < current_path_ext4->size; i++) {
                new_parent[pos++] = current_path_ext4->data[i];
            }
            if (pos > 0 && new_parent[pos-1] == '/') pos--;
            new_parent[pos] = '\0';
        } else {
            strcpy(new_parent, "/");
        }
        strcpy(new_name, new_path);
    }
    if (old_parent[0] == '\0') strcpy(old_parent, "/");
    
                 
    last_slash = NULL;
    for (char* p = (char*)new_path; *p; p++) {
        if (*p == '/') last_slash = p;
    }
    if (last_slash) {
        int len = last_slash - new_path;
        for (int i = 0; i < len; i++) new_parent[i] = new_path[i];
        new_parent[len] = '\0';
        strcpy(new_name, last_slash + 1);
    } else {
                                                  
        if (current_path_ext4 && current_path_ext4->size > 1) {
            int pos = 0;
            for (uint32_t i = 0; i < current_path_ext4->size; i++) {
                old_parent[pos++] = current_path_ext4->data[i];
            }
            if (pos > 0 && old_parent[pos-1] == '/') pos--;
            old_parent[pos] = '\0';
        } else {
            strcpy(old_parent, "/");
        }
        strcpy(old_name, old_path);
    }
    if (new_parent[0] == '\0') strcpy(new_parent, "/");
    
                                             
    Ext4_Inode old_parent_inode;
    uint32_t old_parent_num;
    if (ext4_find_path_with_num(old_parent, &old_parent_inode, &old_parent_num) != 0) {
        print("ext4: Old parent not found!\n");
        return -1;
    }
    
                               
    uint8_t old_buf[4096];
    uint32_t old_block = old_parent_inode.i_block[0];
    read_block(old_block, old_buf);
    
                                    
    int old_offset = 0;
    int found = 0;
    uint32_t file_inode_num = 0;
    
    while (old_offset < (int)old_parent_inode.i_size_lo) {
        Ext4_DirEntry* entry = (Ext4_DirEntry*)(old_buf + old_offset);
        if (entry->rec_len == 0) break;
        
        if (entry->inode != 0) {
            char name[256];
            for (int i = 0; i < entry->name_len && i < 255; i++) {
                name[i] = entry->name[i];
            }
            name[entry->name_len] = '\0';
            
            if (strcmp(name, old_name) == 0) {
                file_inode_num = entry->inode;
                found = 1;
                break;
            }
        }
        old_offset += entry->rec_len;
    }
    
    if (!found) {
        print("ext4: File not found!\n");
        return -1;
    }
    
                                            
    Ext4_Inode new_parent_inode;
    uint32_t new_parent_num;
    if (ext4_find_path_with_num(new_parent, &new_parent_inode, &new_parent_num) != 0) {
        print("ext4: New parent not found!\n");
        return -1;
    }
    
                              
    uint8_t new_buf[4096];
    uint32_t new_block = new_parent_inode.i_block[0];
    read_block(new_block, new_buf);
    
                                         
    int new_offset = 0;
    while (new_offset < (int)new_parent_inode.i_size_lo) {
        Ext4_DirEntry* entry = (Ext4_DirEntry*)(new_buf + new_offset);
        if (entry->rec_len == 0) break;
        
        if (entry->inode != 0) {
            char name[256];
            for (int i = 0; i < entry->name_len && i < 255; i++) {
                name[i] = entry->name[i];
            }
            name[entry->name_len] = '\0';
            
            if (strcmp(name, new_name) == 0) {
                print("ext4: Name already exists!\n");
                return -1;
            }
        }
        new_offset += entry->rec_len;
    }
    
                                                                  
    if (strcmp(old_parent, new_parent) == 0) {
        Ext4_DirEntry* entry = (Ext4_DirEntry*)(old_buf + old_offset);
        entry->name_len = strlen(new_name);
        for (int i = 0; i < entry->name_len; i++) {
            entry->name[i] = new_name[i];
        }
        write_block(old_block, old_buf);
        
        return 0;
    }
    
                                      
                                           
    int insert_offset = new_parent_inode.i_size_lo;
    
                                
    if (insert_offset + 12 > (int)block_size) {
        print("ext4: New directory full!\n");
        return -1;
    }
    
    Ext4_DirEntry* new_entry = (Ext4_DirEntry*)(new_buf + insert_offset);
    new_entry->inode = file_inode_num;
    new_entry->name_len = strlen(new_name);
    new_entry->file_type = 1;
    
    int rec_len = ((strlen(new_name) + 8 + 3) & ~3);
    if (rec_len < 12) rec_len = 12;
    new_entry->rec_len = rec_len;
    
    for (int i = 0; i < new_entry->name_len; i++) {
        new_entry->name[i] = new_name[i];
    }
    
                                                       
    new_parent_inode.i_size_lo = insert_offset + rec_len;
    
                                           
    write_block(new_block, new_buf);
    ext4_write_inode(new_parent_num, &new_parent_inode);
    
                                        
    Ext4_DirEntry* old_entry = (Ext4_DirEntry*)(old_buf + old_offset);
    old_entry->inode = 0;
    
    int next_off = old_offset + old_entry->rec_len;
    int remaining = old_parent_inode.i_size_lo - next_off;
    if (remaining > 0) {
        memmove(old_buf + old_offset, old_buf + next_off, remaining);
    }
    old_parent_inode.i_size_lo = old_offset + remaining;
    
                                                  
    write_block(old_block, old_buf);
    ext4_write_inode(old_parent_num, &old_parent_inode);
    
    return 0;
}

int ext4_move_file(const char* src, const char* dst) {
                                    
    return ext4_rename_file(src, dst);
}

int ext4_copy_file(const char* src, const char* dst) {
    if (!ext4_initialized) return -1;
    
                           
    Vector* content = vector_create(sizeof(uint8_t), 256);
    int size = ext4_read_file(src, content);
    
    if (size <= 0) {
        print("ext4: Source not found or empty!\n");
        content->destroy(content);
        return -1;
    }
    
                         
    if (ext4_create_file(dst) != 0) {
        content->destroy(content);
        return -1;
    }
    
                        
    ext4_write_file(dst, content);
    
    content->destroy(content);
    
    print("ext4: Copied ");
    print_int(size);
    print(" bytes\n");
    
    return 0;
}

int ext4_create_symlink(const char* target, const char* link_path) {
    if (!ext4_initialized) return -1;
    
    print("ext4: Creating symlink ");
    print(link_path);
    print(" -> ");
    print(target);
    print("\n");
    
                     
    char parent_path[512];
    char link_name[256];
    
    char* last_slash = NULL;
    for (char* p = (char*)link_path; *p; p++) {
        if (*p == '/') last_slash = p;
    }
    
    if (last_slash) {
        int len = last_slash - link_path;
        for (int i = 0; i < len; i++) parent_path[i] = link_path[i];
        parent_path[len] = '\0';
        strcpy(link_name, last_slash + 1);
    } else {
        strcpy(parent_path, "/");
        strcpy(link_name, link_path);
    }
    if (parent_path[0] == '\0') strcpy(parent_path, "/");
    
                       
    Ext4_Inode parent_inode;
    uint32_t parent_inode_num;
    if (ext4_find_path_with_num(parent_path, &parent_inode, &parent_inode_num) != 0) {
        print("ext4: Parent not found!\n");
        return -1;
    }
    
                       
    uint32_t new_inode_num = ext4_allocate_inode();
    if (new_inode_num == 0) return -1;
    
                             
    Ext4_Inode link_inode;
    memset(&link_inode, 0, sizeof(link_inode));
    link_inode.i_mode = EXT4_S_IFLNK | 0777;
    link_inode.i_links_count = 1;
    link_inode.i_size_lo = strlen(target);
    
                                                              
    if (strlen(target) < 60) {
                                        
        memcpy(link_inode.i_block, target, strlen(target));
    } else {
                                            
        uint32_t new_block = ext4_allocate_block();
        if (new_block == 0) {
            ext4_free_inode(new_inode_num);
            return -1;
        }
        
        link_inode.i_block[0] = new_block;
        link_inode.i_blocks_lo = 1;
        
        uint8_t buf[4096];
        memset(buf, 0, 4096);
        for (int i = 0; i < (int)strlen(target); i++) {
            buf[i] = target[i];
        }
        write_block(new_block, buf);
    }
    
    ext4_write_inode(new_inode_num, &link_inode);
    
                                    
    uint8_t dir_buf[4096];
    uint32_t dir_block = parent_inode.i_block[0];
    read_block(dir_block, dir_buf);
    
    int insert_offset = parent_inode.i_size_lo;
    Ext4_DirEntry* new_entry = (Ext4_DirEntry*)(dir_buf + insert_offset);
    
    new_entry->inode = new_inode_num;
    new_entry->name_len = strlen(link_name);
    new_entry->file_type = 7;                         
    
    int rec_len = ((strlen(link_name) + 8 + 3) & ~3);
    if (rec_len < 12) rec_len = 12;
    new_entry->rec_len = rec_len;
    
    for (int i = 0; i < new_entry->name_len; i++) {
        new_entry->name[i] = link_name[i];
    }
    
    parent_inode.i_size_lo = insert_offset + rec_len;
    
    write_block(dir_block, dir_buf);
    ext4_write_inode(parent_inode_num, &parent_inode);
    
    print("ext4: Symlink created!\n");
    return 0;
}

int ext4_read_symlink(const char* link_path, char* target, int max_len) {
    if (!ext4_initialized) return -1;
    
                      
    Ext4_Inode link_inode;
    if (ext4_find_path(link_path, &link_inode) != 0) {
        return -1;
    }
    
                                
    if ((link_inode.i_mode & EXT4_S_IFMT) != EXT4_S_IFLNK) {
        return -1;
    }
    
    uint32_t target_len = link_inode.i_size_lo;
    if (target_len > (uint32_t)max_len) target_len = max_len;
    
    if (target_len < 60) {
                                        
        memcpy(target, link_inode.i_block, target_len);
    } else {
                                          
        uint8_t buf[4096];
        read_block(link_inode.i_block[0], buf);
        memcpy(target, buf, target_len);
    }
    
    target[target_len] = '\0';
    
    return target_len;
}

                                                          
static uint32_t ext4_get_block(Ext4_Inode* inode, uint32_t block_index) {
                         
    if (block_index < 12) {
        return inode->i_block[block_index];
    }
    
                                               
    if (block_index < 12 + (block_size / 4)) {
        uint32_t indirect_block = inode->i_block[12];
        if (indirect_block == 0) return 0;
        
        uint8_t buf[4096];
        read_block(indirect_block, buf);
        
        uint32_t* indices = (uint32_t*)buf;
        uint32_t offset = block_index - 12;
        
        return indices[offset];
    }
    
                                                       
    uint32_t blocks_per_indirect = block_size / 4;
    uint32_t single_start = 12;
    uint32_t double_start = single_start + blocks_per_indirect;
    uint32_t double_count = blocks_per_indirect * blocks_per_indirect;
    
    if (block_index < double_start + double_count) {
        uint32_t double_block = inode->i_block[13];
        if (double_block == 0) return 0;
        
        uint8_t buf1[4096];
        read_block(double_block, buf1);
        uint32_t* indirect1 = (uint32_t*)buf1;
        
        uint32_t rel = block_index - double_start;
        uint32_t idx1 = rel / blocks_per_indirect;
        uint32_t idx2 = rel % blocks_per_indirect;
        
        uint32_t single_block = indirect1[idx1];
        if (single_block == 0) return 0;
        
        uint8_t buf2[4096];
        read_block(single_block, buf2);
        uint32_t* indirect2 = (uint32_t*)buf2;
        
        return indirect2[idx2];
    }
    
                                            
    print("ext4: Triple indirect not supported!\n");
    return 0;
}

int ext4_create_hardlink(const char* target, const char* link_path) {
    if (!ext4_initialized) return -1;
    
    print("ext4: Creating hard link ");
    print(link_path);
    print(" -> ");
    print(target);
    print("\n");
    
                           
    Ext4_Inode target_inode;
    uint32_t target_inode_num;
    
                                      
    char target_parent[512], target_name[256];
    char* last_slash = NULL;
    for (char* p = (char*)target; *p; p++) {
        if (*p == '/') last_slash = p;
    }
    
    if (last_slash) {
        int len = last_slash - target;
        for (int i = 0; i < len; i++) target_parent[i] = target[i];
        target_parent[len] = '\0';
        strcpy(target_name, last_slash + 1);
    } else {
        strcpy(target_parent, "/");
        strcpy(target_name, target);
    }
    if (target_parent[0] == '\0') strcpy(target_parent, "/");
    
                       
    Ext4_Inode parent_inode;
    uint32_t parent_num;
    if (ext4_find_path_with_num(target_parent, &parent_inode, &parent_num) != 0) {
        print("ext4: Target parent not found!\n");
        return -1;
    }
    
                
    uint8_t dir_buf[4096];
    uint32_t dir_block = parent_inode.i_block[0];
    read_block(dir_block, dir_buf);
    
    int offset = 0;
    int found = 0;
    
    while (offset < (int)parent_inode.i_size_lo) {
        Ext4_DirEntry* entry = (Ext4_DirEntry*)(dir_buf + offset);
        if (entry->inode != 0) {
            char name[256];
            for (int i = 0; i < entry->name_len && i < 255; i++) {
                name[i] = entry->name[i];
            }
            name[entry->name_len] = '\0';
            
            if (strcmp(name, target_name) == 0) {
                target_inode_num = entry->inode;
                found = 1;
                break;
            }
        }
        offset += entry->rec_len;
    }
    
    if (!found) {
        print("ext4: Target not found!\n");
        return -1;
    }
    
                   
    read_inode(target_inode_num, &target_inode);
    
                                             
    if ((target_inode.i_mode & EXT4_S_IFMT) == EXT4_S_IFDIR) {
        print("ext4: Hard links to directories are not allowed!\n");
        return -1;
    }
    
                                 
    target_inode.i_links_count++;
    ext4_write_inode(target_inode_num, &target_inode);
    
                                        
    char link_parent[512], link_name[256];
    last_slash = NULL;
    for (char* p = (char*)link_path; *p; p++) {
        if (*p == '/') last_slash = p;
    }
    
    if (last_slash) {
        int len = last_slash - link_path;
        for (int i = 0; i < len; i++) link_parent[i] = link_path[i];
        link_parent[len] = '\0';
        strcpy(link_name, last_slash + 1);
    } else {
        strcpy(link_parent, "/");
        strcpy(link_name, link_path);
    }
    if (link_parent[0] == '\0') strcpy(link_parent, "/");
    
                                  
    Ext4_Inode link_parent_inode;
    uint32_t link_parent_num;
    if (ext4_find_path_with_num(link_parent, &link_parent_inode, &link_parent_num) != 0) {
        print("ext4: Link parent not found!\n");
        return -1;
    }
    
                       
    uint8_t link_buf[4096];
    uint32_t link_block = link_parent_inode.i_block[0];
    read_block(link_block, link_buf);
    
    int insert_off = link_parent_inode.i_size_lo;
    Ext4_DirEntry* new_entry = (Ext4_DirEntry*)(link_buf + insert_off);
    
    new_entry->inode = target_inode_num;                  
    new_entry->name_len = strlen(link_name);
    new_entry->file_type = 1;
    
    int rec_len = ((strlen(link_name) + 8 + 3) & ~3);
    if (rec_len < 12) rec_len = 12;
    new_entry->rec_len = rec_len;
    
    for (int i = 0; i < new_entry->name_len; i++) {
        new_entry->name[i] = link_name[i];
    }
    
    link_parent_inode.i_size_lo = insert_off + rec_len;
    
    write_block(link_block, link_buf);
    ext4_write_inode(link_parent_num, &link_parent_inode);
    
    print("ext4: Hard link created!\n");
    return 0;
}

int ext4_chmod(const char* path, uint16_t mode) {
    if (!ext4_initialized) return -1;
    
    Ext4_Inode inode;
    uint32_t inode_num;
    
                    
    char parent[512], name[256];
    char* last_slash = NULL;
    for (char* p = (char*)path; *p; p++) {
        if (*p == '/') last_slash = p;
    }
    
    if (last_slash) {
        int len = last_slash - path;
        for (int i = 0; i < len; i++) parent[i] = path[i];
        parent[len] = '\0';
        strcpy(name, last_slash + 1);
    } else {
        if (current_path_ext4 && current_path_ext4->size > 1) {
            int pos = 0;
            for (uint32_t i = 0; i < current_path_ext4->size; i++) {
                parent[pos++] = current_path_ext4->data[i];
            }
            if (pos > 0 && parent[pos-1] == '/') pos--;
            parent[pos] = '\0';
        } else {
            strcpy(parent, "/");
        }
        strcpy(name, path);
    }
    if (parent[0] == '\0') strcpy(parent, "/");
    
    Ext4_Inode parent_inode;
    uint32_t parent_num;
    if (ext4_find_path_with_num(parent, &parent_inode, &parent_num) != 0) {
        return -1;
    }
    
                
    uint8_t dir_buf[4096];
    read_block(parent_inode.i_block[0], dir_buf);
    
    int offset = 0;
    while (offset < (int)parent_inode.i_size_lo) {
        Ext4_DirEntry* entry = (Ext4_DirEntry*)(dir_buf + offset);
        if (entry->inode != 0) {
            char entry_name[256];
            for (int i = 0; i < entry->name_len && i < 255; i++) {
                entry_name[i] = entry->name[i];
            }
            entry_name[entry->name_len] = '\0';
            
            if (strcmp(entry_name, name) == 0) {
                inode_num = entry->inode;
                break;
            }
        }
        offset += entry->rec_len;
    }
    
                   
    read_inode(inode_num, &inode);
    
                                   
    inode.i_mode = (inode.i_mode & ~0x0FFF) | (mode & 0x0FFF);
    
    ext4_write_inode(inode_num, &inode);
    
    printf("chmod: 0%o on %s\n", mode & 0777, path);
    return 0;
}

