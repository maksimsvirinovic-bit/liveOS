#ifndef CRC32_H
#define CRC32_H

#include "fs.h"
#include "heap.h"
#include "console.h"
#include "str.h"

                          
static uint32_t crc32_table[256];
static int crc32_initialized = 0;

                                    
static void crc32_init_table(void) {
    if (crc32_initialized) return;
    
    for (int i = 0; i < 256; i++) {
        uint32_t crc = i;
        for (int j = 0; j < 8; j++) {
            if (crc & 1) {
                crc = (crc >> 1) ^ 0xEDB88320;
            } else {
                crc >>= 1;
            }
        }
        crc32_table[i] = crc;
    }
    crc32_initialized = 1;
}

                                                       
static uint32_t crc32_update(uint32_t crc, const uint8_t* data, uint32_t len) {
    crc32_init_table();
    
    for (uint32_t i = 0; i < len; i++) {
        crc = crc32_table[(crc ^ data[i]) & 0xFF] ^ (crc >> 8);
    }
    return crc;
}

                                        
static uint32_t crc32_compute(const uint8_t* data, uint32_t len) {
    return crc32_update(0xFFFFFFFF, data, len) ^ 0xFFFFFFFF;
}

                                       
static uint32_t crc32_file(const char* path) {
    Vector* content = vector_create(sizeof(uint8_t), 256);
    int size = read_file(path, content);
    
    if (size <= 0) {
        content->destroy(content);
        return 0;
    }
    
    uint32_t crc = crc32_compute(content->data, size);
    content->destroy(content);
    
    return crc;
}

                               
static uint32_t crc32_string(const char* str) {
    return crc32_compute((const uint8_t*)str, strlen(str));
}

                                
static uint32_t crc32_vector(Vector* vec) {
    if (!vec || vec->size == 0) return 0;
    return crc32_compute(vec->data, vec->size);
}

