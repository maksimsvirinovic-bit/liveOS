}

static void desktop_render_dirty_rect(Desktop* d, DesktopDirtyRect* dirty) {
    int taskbar_y = h - 56;
    graphics_fill_rect(dirty->x, dirty->y, dirty->width, dirty->height, 0x001B2942);

    if (desktop_rects_intersect(dirty->x, dirty->y, dirty->width, dirty->height,
                                0, taskbar_y, w, 56)) {
        desktop_render_taskbar(d);
    }

    if (d->config.show_icons) {
        for (uint32_t i = 0; i < d->icons->size; i++) {
            DesktopIcon* icon = *(DesktopIcon**)d->icons->at(d->icons, i);
            if (desktop_rects_intersect(dirty->x, dirty->y, dirty->width, dirty->height,
                                        icon->x, icon->y, 64, 82)) {
                desktop_render_icon(icon, d->selected_icon == (int)i);
            }
        }
    }
}

void desktop_render_dirty(Desktop* d) {
    if (!d || !graphics_is_ready()) return;

    if (d->dirty_all) {
        desktop_render(d);
        d->dirty_all = 0;
        d->dirty_count = 0;
        return;
    }

    for (uint32_t i = 0; i < d->dirty_count; i++) {
        desktop_render_dirty_rect(d, &d->dirty[i]);
    }
    if (d->dirty_count > 0) {
        graphics_cursor(d->mouse_x, d->mouse_y);
    }
    d->dirty_count = 0;
}

int desktop_run(Desktop* d) {
    if (!d || !graphics_is_ready()) return -1;
    d->running = 1;
    desktop_mark_all_dirty(d);
    while (d->running) {
        MouseState pointer;
        if (mouse_get_state(&pointer)) {
            d->previous_mouse_x = d->mouse_x;
            d->previous_mouse_y = d->mouse_y;
            d->mouse_x = pointer.x;
            d->mouse_y = pointer.y;
            if (d->previous_mouse_x != d->mouse_x || d->previous_mouse_y != d->mouse_y) {
                desktop_mark_dirty(d, d->previous_mouse_x, d->previous_mouse_y,
                                   input_cursor_width(), input_cursor_height());
                desktop_mark_dirty(d, d->mouse_x, d->mouse_y,
                                   input_cursor_width(), input_cursor_height());
            }
            if (pointer.changed && (pointer.buttons & 1)) {
                desktop_on_click(d, d->mouse_x, d->mouse_y);
            }
        }
        if (kbhit()) {
            int key = getchar();
            if (key == 27) d->running = 0;
        }
        desktop_render_dirty(d);
    }
    return 0;
}

// Input handling
void desktop_on_click(Desktop* d, int x, int y) {
    if (!d) return;
    
    // Check if click is in icon area
    for (uint32_t i = 0; i < d->icons->size; i++) {
        DesktopIcon* icon = *(DesktopIcon**)d->icons->at(d->icons, i);
        
        if (x >= icon->x && x <= icon->x + icon->width &&
            y >= icon->y && y <= icon->y + icon->height) {
            
            if (d->selected_icon != (int)i) {
                int old_selected = d->selected_icon;
                d->selected_icon = i;
                if (old_selected >= 0 && old_selected < (int)d->icons->size) {
                    DesktopIcon* old_icon = *(DesktopIcon**)d->icons->at(d->icons, old_selected);
                    desktop_mark_dirty(d, old_icon->x, old_icon->y, 64, 82);
                }
                desktop_mark_dirty(d, icon->x, icon->y, 64, 82);
            }
            return;
        }
    }
    
    // Click elsewhere deselects
    if (d->selected_icon >= 0 && d->selected_icon < (int)d->icons->size) {
        DesktopIcon* old_icon = *(DesktopIcon**)d->icons->at(d->icons, d->selected_icon);
        desktop_mark_dirty(d, old_icon->x, old_icon->y, 64, 82);
    }
    d->selected_icon = -1;
}

void desktop_on_key(Desktop* d, int key) {
    if (!d) return;
    
    printf("[Desktop] Key: %d\n", key);
    
    if (key == 13 && d->selected_icon >= 0) {
        // Enter on selected icon
        DesktopIcon* icon = *(DesktopIcon**)d->icons->at(d->icons, d->selected_icon);
        printf("[Desktop] Executing: %s\n", icon->path);
    }
}


