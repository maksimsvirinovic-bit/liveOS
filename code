#include "driver_api.h"

#define DATA 0x60
#define STATUS 0x64
#define COMMAND 0x64
#define IRQ 12

static void* (*sym)(const char*) = driver_get_symbol;
static int (*read_file)(const char*, Vector*);
static Vector* (*make_vector)(uint32_t, uint32_t);
static void (*outb)(uint16_t, uint8_t);
static uint8_t (*inb)(uint16_t);
static void (*unmask)(uint8_t);
static void (*mask)(uint8_t);
static void (*eoi)(uint8_t);
static void (*register_irq)(void (*)(void));
static int (*register_mouse_device)(const MouseDevice*);
static uint32_t* width;
static uint32_t* height;
static MouseState pointer;
static uint8_t packet[3];
static int packet_index;
static int active;
static int sensitivity = 1;
static int invert_buttons;
static Vector* cursor;
static int cursor_w = 16;
static int cursor_h = 20;

static int same(const char* a, const char* b) { while (*a && *b && *a == *b) { a++; b++; } return *a == *b; }
static int integer(const char* s) { int n = 0; while (*s >= '0' && *s <= '9') n = n * 10 + (*s++ - '0'); return n; }
static int wait_write(void) { for (int i = 0; i < 10000; i++) if (!(inb(STATUS) & 2)) return 1; return 0; }
static int wait_read(void) { for (int i = 0; i < 10000; i++) if (inb(STATUS) & 1) return 1; return 0; }
static int read_data(uint8_t* value) { if (!wait_read()) return 0; *value = inb(DATA); return 1; }
static int send(uint8_t value) { if (!wait_write()) return 0; outb(COMMAND, 0xD4); if (!wait_write()) return 0; outb(DATA, value); return 1; }
static int command(uint8_t value) { uint8_t response; return send(value) && read_data(&response) && response == 0xFA; }

static void default_cursor(void) {
    static const char* rows[] = {
        "#...............", "##..............", "#B#.............", "#BB#............",
        "#BBB#...........", "#BBBB#..........", "#BBBBB#.........", "#BBBBBB#........",
        "#BBBBBBB#.......", "#BBBBBBBB#......", "#BBBBBBBBB#.....", "#BBBBBBBBBB#....",
        "#BBBBBBBBBBB#...", "#BBBBBBBBBBBB#..", "#BBBBBBBBBBBBB#.", "#BBBBBBBBBBBBBB#",
        "#BBBBBBBB#######", "#BBBBB#.........", "#BBBBBB#........", "########........"
    };
    cursor = make_vector(sizeof(uint32_t), cursor_w * cursor_h);
    for (int y = 0; y < cursor_h; y++) for (int x = 0; x < cursor_w; x++) {
        char p = rows[y][x]; uint32_t color = p == '#' ? 0x00000000 : p == 'B' ? 0x00E9F1F7 : 0xFFFFFFFF;
        cursor->push(cursor, &color);
    }
}

static void load_cursor(Vector* path) {
    Vector* image = make_vector(sizeof(char), 512);
    Vector* replacement = make_vector(sizeof(uint32_t), cursor_w * cursor_h);
    if (!image || !replacement || read_file((char*)path->data, image) <= 0) { if (image) image->destroy(image); if (replacement) replacement->destroy(replacement); return; }
    char* line = (char*)image->data; int row = 0;
    while (*line && row < cursor_h) {
        char* end = line; while (*end && *end != '\n' && *end != '\r') end++;
        for (int x = 0; x < cursor_w; x++) { char p = x < end - line ? line[x] : '.'; uint32_t color = p == '#' ? 0x00000000 : p == 'B' ? 0x00E9F1F7 : 0xFFFFFFFF; replacement->push(replacement, &color); }
        row++; line = end; while (*line == '\n' || *line == '\r') line++;
    }
    while (row++ < cursor_h) for (int x = 0; x < cursor_w; x++) { uint32_t color = 0xFFFFFFFF; replacement->push(replacement, &color); }
    if (cursor) cursor->destroy(cursor); cursor = replacement; image->destroy(image);
}

static void load_config(void) {
    Vector* config = make_vector(sizeof(char), 256);
    if (!config || read_file("/etc/mouse.cfg", config) <= 0) { if (config) config->destroy(config); return; }
    char* line = (char*)config->data;
    while (*line) {
        char* end = line; while (*end && *end != '\n' && *end != '\r') end++;
        char* eq = line; while (eq < end && *eq != '=') eq++;
        if (eq < end) {
            *eq = 0; char* value = eq + 1; while (*value == ' ' || *value == '\t') value++;
            if (same(line, "sensitivity")) sensitivity = integer(value);
            else if (same(line, "invert_buttons")) invert_buttons = value[0] == '1' || value[0] == 't';
            else if (same(line, "texture")) { Vector* path = make_vector(sizeof(char), 32); while (value < end) path->push(path, value++); char zero = 0; path->push(path, &zero); load_cursor(path); path->destroy(path); }
        }
        line = end; while (*line == '\n' || *line == '\r') line++;
    }
    if (sensitivity < 1) sensitivity = 1; if (sensitivity > 8) sensitivity = 8; config->destroy(config);
}

static void process(void) {
    int dx = packet[1]; int dy = packet[2]; if (packet[0] & 0x10) dx |= ~0xFF; if (packet[0] & 0x20) dy |= ~0xFF;
    pointer.x += dx * sensitivity; pointer.y -= dy * sensitivity;
    if (pointer.x < 0) pointer.x = 0; if (pointer.y < 0) pointer.y = 0;
    if (pointer.x >= (int)*width) pointer.x = *width - 1; if (pointer.y >= (int)*height) pointer.y = *height - 1;
    pointer.dx = dx * sensitivity; pointer.dy = -dy * sensitivity; pointer.buttons = packet[0] & 7;
    if (invert_buttons) { uint8_t l = pointer.buttons & 1; uint8_t r = pointer.buttons & 2; pointer.buttons = (l ? 2 : 0) | (r ? 1 : 0) | (pointer.buttons & 4); }
    pointer.changed = 1;
}

void pointer_irq(void) { if (!active) { eoi(IRQ); return; } uint8_t value = inb(DATA); if (!packet_index && !(value & 8)) { eoi(IRQ); return; } packet[packet_index++] = value; if (packet_index == 3) { packet_index = 0; process(); } eoi(IRQ); }
int pointer_read(MouseState* result) { if (!result || !active || !pointer.changed) return 0; *result = pointer; pointer.changed = 0; return 1; }
int pointer_pixel(int x, int y) { if (!cursor || x < 0 || y < 0 || x >= cursor_w || y >= cursor_h) return -1; return *(uint32_t*)cursor->at(cursor, y * cursor_w + x); }
int pointer_width(void) { return cursor_w; }
int pointer_height(void) { return cursor_h; }

int driver_init(void) {
    read_file = sym("read_file"); make_vector = sym("vector_create"); outb = sym("outb"); inb = sym("inb"); unmask = sym("pic_unmask_irq"); mask = sym("pic_mask_irq"); eoi = sym("pic_send_eoi");
    register_irq = sym("input_register_irq"); register_mouse_device = sym("mouse_register_device"); width = sym("w"); height = sym("h");
    if (!read_file || !make_vector || !outb || !inb || !unmask || !eoi || !register_irq || !register_mouse_device || !width || !height) return -1;
    default_cursor(); load_config();
    uint8_t response;
    if (!send(0xF5) || !read_data(&response) || response != 0xFA) return -1;
    if (!command(0xF4)) return -1;
    pointer.x = *width / 2; pointer.y = *height / 2; active = 1;
    MouseDevice device = { pointer_read, pointer_pixel, pointer_width, pointer_height };
    register_irq(pointer_irq); register_mouse_device(&device); unmask(2); unmask(IRQ); return 0;
}

void driver_exit(void) { if (mask) mask(IRQ); active = 0; }

