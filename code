#include "tls.h"
#include "console.h"
#include "str.h"
#include "netutils.h"
#include "heap.h"
#include "random.h"
#include "aes.h"

                               

static uint16_t read_be16(const uint8_t* data) {
    return (data[0] << 8) | data[1];
}

static void write_be16(uint8_t* data, uint16_t value) {
    data[0] = (value >> 8) & 0xFF;
    data[1] = value & 0xFF;
}

static void write_be24(uint8_t* data, uint32_t value) {
    data[0] = (value >> 16) & 0xFF;
    data[1] = (value >> 8) & 0xFF;
    data[2] = value & 0xFF;
}

static void write_be32(uint8_t* data, uint32_t value) {
    data[0] = (value >> 24) & 0xFF;
    data[1] = (value >> 16) & 0xFF;
    data[2] = (value >> 8) & 0xFF;
    data[3] = value & 0xFF;
}

static void tls_gen_random(uint8_t* buf, int len) {
    RandomState rnd;
    random_init(&rnd);
    for (int i = 0; i < len; i++) {
        buf[i] = random_byte(&rnd);
    }
}

static void tls_sha256(const uint8_t* data, uint32_t len, uint8_t* digest) {
                           
    memset(digest, 0, 32);
    for (uint32_t i = 0; i < len && i < 32; i++) {
        digest[i] = data[i];
    }
}

static void tls_prf(const uint8_t* secret, uint32_t secret_len,
                    const char* label, const uint8_t* seed, uint32_t seed_len,
                    uint8_t* output, uint32_t output_len) {
                                  
    uint32_t label_len = strlen(label);
    for (uint32_t i = 0; i < output_len; i++) {
        output[i] = secret[i % secret_len] ^ label[i % label_len] ^ seed[i % seed_len];
    }
}

static int tls_send_client_hello(TlsConnection* conn, const char* host) {
    uint8_t packet[512];
    int pos = 0;
    
                            
    packet[pos++] = TLS_HANDSHAKE;
    packet[pos++] = 0x03;
    packet[pos++] = 0x03;            
    pos += 2;                       
    
                               
    packet[pos++] = TLS_CLIENT_HELLO;
    pos += 3;                       
    
                          
              
    packet[pos++] = 0x03;
    packet[pos++] = 0x03;
    
                        
    tls_gen_random(packet + pos, 32);
    memcpy(conn->client_random, packet + pos, 32);
    pos += 32;
    
                         
    packet[pos++] = 0x00;
    
                    
    packet[pos++] = 0x00;
    packet[pos++] = 0x06;             
    
                                            
    packet[pos++] = 0xC0; packet[pos++] = 0x2F;
                                   
    packet[pos++] = 0x00; packet[pos++] = 0x2F;
                                   
    packet[pos++] = 0x00; packet[pos++] = 0x35;
    
                  
    packet[pos++] = 0x01;
    packet[pos++] = 0x00;
    
                         
    int ext_len_pos = pos;
    pos += 2;
    int ext_start = pos;
    
                    
    if (host) {
        packet[pos++] = 0x00;
        packet[pos++] = 0x00;                
        int sni_len_pos = pos;
        pos += 2;
        int sni_start = pos;
        
        packet[pos++] = 0x00;              
        int host_len_pos = pos;
        pos += 2;
        int host_start = pos;
        
        int host_len = strlen(host);
        for (int i = 0; i < host_len; i++) {
            packet[pos++] = host[i];
        }
        
        uint16_t host_name_len = pos - host_start;
        write_be16(packet + host_len_pos, host_name_len);
        uint16_t sni_len = pos - sni_start;
        write_be16(packet + sni_len_pos, sni_len);
    }
    
                         
    packet[pos++] = 0x00;
    packet[pos++] = 0x2B;                       
    packet[pos++] = 0x00;
    packet[pos++] = 0x03;           
    packet[pos++] = 0x02;           
    packet[pos++] = 0x03;
    packet[pos++] = 0x03;            
    
                   
    uint16_t ext_len = pos - ext_start;
    write_be16(packet + ext_len_pos, ext_len);
    
    uint16_t record_len = pos - 5;
    write_be16(packet + 3, record_len);
    
    uint32_t handshake_len = pos - 9;
    write_be24(packet + 5, handshake_len);
    
    #ifdef DEBUG_TLS
    printf("TLS: ClientHello size: %d bytes\n", pos);
    printf("TLS: SNI: %s\n", host ? host : "(none)");
    #endif
    
    return tcp_send(conn->tcp, packet, pos);
}

                                 

static int tls_parse_server_hello(TlsConnection* conn, const uint8_t* data, int len) {
    int pos = 0;
    
              
    uint16_t version = read_be16(data + pos);
    pos += 2;
    #ifdef DEBUG_TLS
    printf("TLS: Server version: 0x%04X\n", version);
    #endif
    
             
    memcpy(conn->server_random, data + pos, 32);
    pos += 32;
    
                 
    uint8_t sid_len = data[pos++];
    pos += sid_len;
    
                   
    uint16_t cipher = read_be16(data + pos);
    pos += 2;
    #ifdef DEBUG_TLS
    printf("TLS: Cipher: 0x%04X\n", cipher);
    #endif
    
                  
    pos++;
    
                        
    if (pos < len) {
        uint16_t ext_len = read_be16(data + pos);
        pos += 2 + ext_len;
    }
    
    return pos;
}

                                     

static void tls_generate_master_secret(TlsConnection* conn) {
    uint8_t premaster[48];
    premaster[0] = 0x03;
    premaster[1] = 0x03;
    tls_gen_random(premaster + 2, 46);
    
    uint8_t seed[64];
    memcpy(seed, conn->client_random, 32);
    memcpy(seed + 32, conn->server_random, 32);
    
    tls_prf(premaster, 48, "master secret", seed, 64, conn->master_secret, 48);
    
    #ifdef DEBUG_TLS
    printf("TLS: Master secret generated\n");
    #endif
}

                            

static void tls_generate_keys(TlsConnection* conn) {
    uint8_t seed[64];
    memcpy(seed, conn->server_random, 32);
    memcpy(seed + 32, conn->client_random, 32);
    
    uint8_t key_block[64];
    tls_prf(conn->master_secret, 48, "key expansion", seed, 64, key_block, 64);
    
                                                  
                                                  
    memcpy(conn->client_write_key, key_block + 40, 16);
    memcpy(conn->server_write_key, key_block + 56, 16);
    memcpy(conn->client_write_iv, key_block + 72, 12);
    memcpy(conn->server_write_iv, key_block + 84, 12);
    
    #ifdef DEBUG_TLS
    printf("TLS: Keys generated\n");
    #endif
}

                                   

static int tls_send_finished(TlsConnection* conn) {
                                            
    uint8_t packet[64];
    int pos = 0;
    
    packet[pos++] = TLS_HANDSHAKE;
    packet[pos++] = 0x03;
    packet[pos++] = 0x03;
    pos += 2;                       
    
    packet[pos++] = TLS_FINISHED;
    pos += 3;                       
    
                                      
    for (int i = 0; i < 12; i++) {
        packet[pos++] = 0x00;
    }
    
    uint16_t record_len = pos - 5;
    write_be16(packet + 3, record_len);
    uint32_t handshake_len = pos - 9;
    write_be24(packet + 5, handshake_len);
    
    #ifdef DEBUG_TLS
    printf("TLS: Sending Finished\n");
    #endif
    
    return tcp_send(conn->tcp, packet, pos);
}

                                      

static int tls_send_change_cipher_spec(TlsConnection* conn) {
    uint8_t packet[6];
    packet[0] = TLS_CHANGE_CIPHER_SPEC;
    packet[1] = 0x03;
    packet[2] = 0x03;
    packet[3] = 0x00;
    packet[4] = 0x01;
    packet[5] = 0x01;
    
    #ifdef DEBUG_TLS
    printf("TLS: Sending ChangeCipherSpec\n");
    #endif
    
    return tcp_send(conn->tcp, packet, 6);
}

                               

int tls_connect(TlsConnection* conn, TcpConnection* tcp, const char* host) {
    if (!conn || !tcp) return -1;
    
    memset(conn, 0, sizeof(TlsConnection));
    conn->tcp = tcp;
    conn->state = 0;
    conn->client_seq = 0;
    conn->server_seq = 0;
    conn->recv_len = 0;
    conn->recv_pos = 0;
    #ifdef DEBUG_TLS
    printf("TLS: Connecting to %s\n", host ? host : "remote");
    #endif
    
                          
    if (tls_send_client_hello(conn, host) < 0) {
        #ifdef DEBUG_TLS
        printf("TLS: ClientHello failed\n");
        #endif
        return -1;
    }
    
                             
    uint8_t buffer[4096];
    int len = tcp_receive(tcp, buffer, sizeof(buffer));
    
    if (len < 5) {
        #ifdef DEBUG_TLS
        printf("TLS: No ServerHello\n");
        #endif
        return -1;
    }
    
                           
    if (buffer[0] != TLS_HANDSHAKE) {
        #ifdef DEBUG_TLS
        printf("TLS: Expected Handshake, got 0x%02X\n", buffer[0]);
        #endif
        return -1;
    }
    
    uint16_t record_len = read_be16(buffer + 3);
    if (record_len < 5) {
        #ifdef DEBUG_TLS
        printf("TLS: Invalid record length\n");
        #endif
        return -1;
    }
    
    const uint8_t* handshake = buffer + 5;
    if (handshake[0] != TLS_SERVER_HELLO) {
        #ifdef DEBUG_TLS
        printf("TLS: Expected ServerHello, got 0x%02X\n", handshake[0]);
        #endif
        return -1;
    }
    
    uint32_t hs_len = (handshake[1] << 16) | (handshake[2] << 8) | handshake[3];
    tls_parse_server_hello(conn, handshake + 4, hs_len);
    
                                
    tls_generate_master_secret(conn);
    
                               
    tls_send_change_cipher_spec(conn);
    
                       
    tls_send_finished(conn);
    
                       
    tls_generate_keys(conn);
    
    conn->state = 1;
    #ifdef DEBUG_TLS
    printf("TLS: Connected!\n");
    #endif
    return 0;
}

                       

int tls_send(TlsConnection* conn, const uint8_t* data, uint16_t len) {
    if (!conn || conn->state != 1) return -1;
    if (len == 0) return 0;
    
    #ifdef DEBUG_TLS
    printf("TLS: Sending %d bytes\n", len);
    #endif
    
                                                   
    return tcp_send(conn->tcp, data, len);
}

                          

int tls_receive(TlsConnection* conn, uint8_t* buffer, uint16_t max_len) {
    if (!conn || conn->state != 1) return -1;
    
                                
    if (conn->recv_pos < conn->recv_len) {
        uint32_t to_copy = conn->recv_len - conn->recv_pos;
        if (to_copy > max_len) to_copy = max_len;
        memcpy(buffer, conn->recv_buffer + conn->recv_pos, to_copy);
        conn->recv_pos += to_copy;
        return to_copy;
    }
    
                          
    uint8_t temp[4096];
    int len = tcp_receive(conn->tcp, temp, sizeof(temp));
    
    if (len <= 0) return 0;
    
    #ifdef DEBUG_TLS
    printf("TLS: Received %d bytes\n", len);
    #endif
    
                                                           
    if (len > max_len) len = max_len;
    memcpy(buffer, temp, len);
    
    return len;
}

                        

void tls_close(TlsConnection* conn) {
    if (!conn) return;
    conn->state = 2;
    if (conn->tcp) {
        tcp_close(conn->tcp);
    }
}

