#include "dhcp.h"
#include "../e1000.h"
#include "udp.h"
#include "ip.h"
#include "arp.h"
#include "console.h"
#include "str.h"
#include "netutils.h"
#include "heap.h"
#include "random.h"

static uint32_t dhcp_xid = 0x12345678;
static DhcpConfig dhcp_config;

                            
static uint32_t dhcp_generate_xid(void) {
    RandomState rnd;
    random_init(&rnd);
    return random_next(&rnd) ^ (rdtsc() & 0xFFFFFFFF);
}

                                   
static void dhcp_create_packet(DhcpPacket* packet, uint8_t type,
                               uint32_t xid, uint32_t requested_ip) {
    memset(packet, 0, sizeof(DhcpPacket));
    
    packet->op = 1;            
    packet->htype = 1;             
    packet->hlen = 6;
    packet->xid = xid;
    packet->secs = 0;
    packet->flags = htons(0x8000);                   
    
                
    uint8_t* mac = e1000_get_mac();
    memcpy(packet->chaddr, mac, 6);
    
                   
    packet->magic = htonl(0x63825363);
    
            
    int pos = 0;
    
                        
    packet->options[pos++] = DHCP_OPTION_MSG_TYPE;
    packet->options[pos++] = 1;
    packet->options[pos++] = type;
    
                              
    packet->options[pos++] = 61;              
    packet->options[pos++] = 7;            
    packet->options[pos++] = 1;                    
    for (int i = 0; i < 6; i++) {
        packet->options[pos++] = mac[i];
    }
    
                                 
    if (type == DHCP_REQUEST && requested_ip != 0) {
        packet->options[pos++] = DHCP_OPTION_REQUESTED_IP;
        packet->options[pos++] = 4;
        packet->options[pos++] = (requested_ip >> 24) & 0xFF;
        packet->options[pos++] = (requested_ip >> 16) & 0xFF;
        packet->options[pos++] = (requested_ip >> 8) & 0xFF;
        packet->options[pos++] = requested_ip & 0xFF;
    }
    
                             
    packet->options[pos++] = DHCP_OPTION_PARAM_LIST;
    packet->options[pos++] = 5;
    packet->options[pos++] = DHCP_OPTION_SUBNET_MASK;
    packet->options[pos++] = DHCP_OPTION_ROUTER;
    packet->options[pos++] = DHCP_OPTION_DNS;
    packet->options[pos++] = DHCP_OPTION_DOMAIN;
    packet->options[pos++] = DHCP_OPTION_BROADCAST;
    
          
    packet->options[pos++] = DHCP_OPTION_END;
}

                                  
static int dhcp_parse_response(DhcpPacket* packet, int len, DhcpConfig* config) {
    if (len < sizeof(DhcpPacket) - 312) return -1;
    
                             
    if (ntohl(packet->magic) != 0x63825363) {
        #ifdef DEBUG_DHCP
        printf("DHCP: Invalid magic cookie\n");
        #endif
        return -1;
    }
    
             
    config->ip = ntohl(packet->yiaddr);
    
                   
    int pos = 0;
    while (pos < 312) {
        uint8_t option = packet->options[pos++];
        
        if (option == DHCP_OPTION_END) break;
        if (option == DHCP_OPTION_PAD) continue;
        
        uint8_t len = packet->options[pos++];
        
        switch (option) {
            case DHCP_OPTION_SUBNET_MASK:
                if (len >= 4) {
                    config->netmask = (packet->options[pos] << 24) |
                                      (packet->options[pos+1] << 16) |
                                      (packet->options[pos+2] << 8) |
                                      packet->options[pos+3];
                }
                break;
                
            case DHCP_OPTION_ROUTER:
                if (len >= 4) {
                    config->gateway = (packet->options[pos] << 24) |
                                      (packet->options[pos+1] << 16) |
                                      (packet->options[pos+2] << 8) |
                                      packet->options[pos+3];
                }
                break;
                
            case DHCP_OPTION_DNS:
                if (len >= 4) {
                    config->dns[0] = (packet->options[pos] << 24) |
                                     (packet->options[pos+1] << 16) |
                                     (packet->options[pos+2] << 8) |
                                     packet->options[pos+3];
                }
                if (len >= 8) {
                    config->dns[1] = (packet->options[pos+4] << 24) |
                                     (packet->options[pos+5] << 16) |
                                     (packet->options[pos+6] << 8) |
                                     packet->options[pos+7];
                }
                break;
                
            case DHCP_OPTION_SERVER_ID:
                if (len >= 4) {
                    config->server_ip = (packet->options[pos] << 24) |
                                        (packet->options[pos+1] << 16) |
                                        (packet->options[pos+2] << 8) |
                                        packet->options[pos+3];
                }
                break;
                
            case DHCP_OPTION_LEASE_TIME:
                if (len >= 4) {
                    config->lease_time = (packet->options[pos] << 24) |
                                         (packet->options[pos+1] << 16) |
                                         (packet->options[pos+2] << 8) |
                                         packet->options[pos+3];
                }
                break;
        }
        
        pos += len;
    }
    
    config->valid = 1;
    return 0;
}

                                     
static int dhcp_send_discover(DhcpPacket* packet, uint32_t xid) {
    DhcpPacket discover;
    dhcp_create_packet(&discover, DHCP_DISCOVER, xid, 0);
    
    #ifdef DEBUG_DHCP
    printf("DHCP: Sending DISCOVER (xid=0x%08X)\n", xid);
    #endif
    
                                                    
    return udp_send(0xFFFFFFFF, DHCP_CLIENT_PORT, DHCP_SERVER_PORT,
                    (uint8_t*)&discover, sizeof(DhcpPacket));
}

                                    
static int dhcp_send_request(uint32_t xid, uint32_t requested_ip, uint32_t server_ip) {
    DhcpPacket request;
    dhcp_create_packet(&request, DHCP_REQUEST, xid, requested_ip);
    
                          
    int pos = 0;
    while (request.options[pos] != DHCP_OPTION_END && pos < 312) {
        if (request.options[pos] == DHCP_OPTION_MSG_TYPE) {
            pos += 3;
        } else {
            pos++;
            pos += request.options[pos] + 1;
        }
    }
    
                                    
    request.options[pos++] = DHCP_OPTION_SERVER_ID;
    request.options[pos++] = 4;
    request.options[pos++] = (server_ip >> 24) & 0xFF;
    request.options[pos++] = (server_ip >> 16) & 0xFF;
    request.options[pos++] = (server_ip >> 8) & 0xFF;
    request.options[pos++] = server_ip & 0xFF;
    request.options[pos++] = DHCP_OPTION_END;
    
    #ifdef DEBUG_DHCP
    printf("DHCP: Sending REQUEST for ", requested_ip);
    print_ip(requested_ip);
    printf(" (xid=0x%08X)\n", xid);
    #endif
    
    return udp_send(0xFFFFFFFF, DHCP_CLIENT_PORT, DHCP_SERVER_PORT,
                    (uint8_t*)&request, sizeof(DhcpPacket));
}

                                    
int dhcp_request(DhcpConfig* config) {
    if (!config) return -1;
    
    memset(config, 0, sizeof(DhcpConfig));
    
    #ifdef DEBUG_DHCP
    printf("DHCP: Discovering...\n");
    #endif
                     
    uint32_t xid = dhcp_generate_xid();
    
                             
    if (dhcp_send_discover(NULL, xid) < 0) {
        #ifdef DEBUG_DHCP
        printf("DHCP: Failed to send DISCOVER\n");
        #endif
        return -1;
    }
    
                    
    uint8_t buffer[1024];
    uint32_t src_ip;
    uint16_t src_port;
    
    int offer_received = 0;
    DhcpPacket offer_packet;
    uint32_t offered_ip = 0;
    uint32_t server_ip = 0;
    
    for (int attempt = 0; attempt < 50; attempt++) {
        int len = udp_receive(buffer, sizeof(buffer), &src_ip, &src_port);
        
        if (len > 0 && src_port == DHCP_SERVER_PORT) {
            DhcpPacket* packet = (DhcpPacket*)buffer;
            
                            
            if (packet->xid != xid) continue;
            
                            
            uint8_t* mac = e1000_get_mac();
            if (memcmp(packet->chaddr, mac, 6) != 0) continue;
            
                            
            int msg_type = -1;
            int pos = 0;
            while (pos < 312) {
                uint8_t opt = packet->options[pos++];
                if (opt == DHCP_OPTION_END) break;
                if (opt == DHCP_OPTION_PAD) continue;
                uint8_t len = packet->options[pos++];
                if (opt == DHCP_OPTION_MSG_TYPE) {
                    msg_type = packet->options[pos];
                    break;
                }
                pos += len;
            }
            
            if (msg_type == DHCP_OFFER) {
                #ifdef DEBUG_DHCP
                printf("DHCP: Received OFFER from ");
                print_ip(src_ip);
                printf(" -> ");
                print_ip(ntohl(packet->yiaddr));
                printf("\n");
                #endif
                
                memcpy(&offer_packet, packet, sizeof(DhcpPacket));
                offered_ip = ntohl(packet->yiaddr);
                server_ip = src_ip;
                offer_received = 1;
                break;
            }
        }
        
        for (volatile int j = 0; j < 100000; j++);
    }
    
    if (!offer_received) {
        #ifdef DEBUG_DHCP
        printf("DHCP: No OFFER received\n");
        #endif
        return -1;
    }
    
                            
    if (dhcp_send_request(xid, offered_ip, server_ip) < 0) {
        #ifdef DEBUG_DHCP
        printf("DHCP: Failed to send REQUEST\n");
        #endif
        return -1;
    }
    
                  
    for (int attempt = 0; attempt < 50; attempt++) {
        int len = udp_receive(buffer, sizeof(buffer), &src_ip, &src_port);
        
        if (len > 0 && src_port == DHCP_SERVER_PORT) {
            DhcpPacket* packet = (DhcpPacket*)buffer;
            
            if (packet->xid != xid) continue;
            
            uint8_t* mac = e1000_get_mac();
            if (memcmp(packet->chaddr, mac, 6) != 0) continue;
            
            int msg_type = -1;
            int pos = 0;
            while (pos < 312) {
                uint8_t opt = packet->options[pos++];
                if (opt == DHCP_OPTION_END) break;
                if (opt == DHCP_OPTION_PAD) continue;
                uint8_t len = packet->options[pos++];
                if (opt == DHCP_OPTION_MSG_TYPE) {
                    msg_type = packet->options[pos];
                    break;
                }
                pos += len;
            }
            
            if (msg_type == DHCP_ACK) {
                #ifdef DEBUG_DHCP
                printf("DHCP: Received ACK\n");
                #endif
                
                                      
                if (dhcp_parse_response(packet, len, config) == 0) {
                    printf("\n=== DHCP CONFIG ===\n");
                    printf("IP: ");
                    print_ip(config->ip);
                    printf("\n");
                    
                    printf("Netmask: ");
                    print_ip(config->netmask);
                    printf("\n");
                    
                    printf("Gateway: ");
                    print_ip(config->gateway);
                    printf("\n");
                    
                    printf("DNS: ");
                    print_ip(config->dns[0]);
                    if (config->dns[1]) {
                        printf(", ");
                        print_ip(config->dns[1]);
                    }
                    printf("\n");
                    
                    printf("Lease: %d seconds\n", config->lease_time);
                    printf("===================\n\n");
                    
                    return 0;
                }
            }
        }
        
        for (volatile int j = 0; j < 100000; j++);
    }
    
    printf("DHCP: No ACK received\n");
    return -1;
}

                            
int dhcp_init(void) {
    #ifdef DEBUG_DHCP
    printf("DHCP: Initializing...\n");
    #endif
    
                          
    if (dhcp_request(&dhcp_config) == 0) {
                              
        our_ip = dhcp_config.ip;
