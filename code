#include "heap.h"
#include "str.h"
#include "console.h"

#define HEAP_SIZE (1024 * 1024 * 1024)          
#define ALIGNMENT 16
#define MIN_BLOCK_SIZE 32

typedef struct BlockHeader {
    uint32_t size;                                             
    uint32_t flags;                                     
    struct BlockHeader* next;                    
    struct BlockHeader* prev;                     
} BlockHeader;

#define BLOCK_FLAG_USED 1

static uint8_t* heap_memory = NULL;
static BlockHeader* heap_start = NULL;

static int heap_ready = 0;
static uint32_t heap_used = 0;

static uint32_t align_up(uint32_t size) {
    return (size + ALIGNMENT - 1) & ~(ALIGNMENT - 1);
}

static BlockHeader* get_next_block(BlockHeader* block) {
    return (BlockHeader*)((uint8_t*)block + sizeof(BlockHeader) + block->size);
}

void* kmalloc(uint32_t size) {
    if (!heap_ready) {
        
        extern char __kernel_end[];
        
        heap_memory = (uint8_t*)__kernel_end;
        heap_start = (BlockHeader*)heap_memory;
        heap_start->size = HEAP_SIZE - sizeof(BlockHeader);
        heap_start->flags = 0;
        heap_start->next = NULL;
        heap_start->prev = NULL;
        heap_ready = 1;
        #ifdef DEBUG_HEAP
        printf("Heap: Initialized at 0x%p (%d MB)\n", heap_start, HEAP_SIZE / (1024 * 1024));
        #endif
    }
    
    if (size == 0) return NULL;
    
    size = align_up(size);
    if (size < MIN_BLOCK_SIZE) size = MIN_BLOCK_SIZE;
    
    BlockHeader* current = heap_start;
    
    while (current) {
        if (!(current->flags & BLOCK_FLAG_USED) && current->size >= size) {
            if (current->size >= size + sizeof(BlockHeader) + MIN_BLOCK_SIZE) {
                BlockHeader* new_block = (BlockHeader*)((uint8_t*)current + sizeof(BlockHeader) + size);
                new_block->size = current->size - size - sizeof(BlockHeader);
                new_block->flags = 0;
                new_block->next = current->next;
                new_block->prev = current;
                
                if (current->next) current->next->prev = new_block;
                current->next = new_block;
                current->size = size;
            }
            
            current->flags = BLOCK_FLAG_USED;
            heap_used += current->size + sizeof(BlockHeader);
            
            return (void*)((uint8_t*)current + sizeof(BlockHeader));
        }
        
        current = current->next;
    }
    
    printf("Heap: Out of memory!\n");
    return NULL;
}

void* kcalloc(uint32_t num, uint32_t size) {
    if (!heap_ready) {
        
        extern char __kernel_end[];
        
        heap_memory = (uint8_t*)__kernel_end;
        heap_start = (BlockHeader*)heap_memory;
        heap_start->size = HEAP_SIZE - sizeof(BlockHeader);
        heap_start->flags = 0;
        heap_start->next = NULL;
        heap_start->prev = NULL;
        heap_ready = 1;
        #ifdef DEBUG_HEAP
        printf("Heap: Initialized at 0x%p (%d MB)\n", heap_start, HEAP_SIZE / (1024 * 1024));
        #endif
    }
    uint32_t total = num * size;
    void* ptr = kmalloc(total);
    if (ptr) {
        memset(ptr, 0, total);
    }
    return ptr;
}

void kfree(void* ptr) {
    if (!heap_ready) {
        
        extern char __kernel_end[];
        
        heap_memory = (uint8_t*)__kernel_end;
        heap_start = (BlockHeader*)heap_memory;
        heap_start->size = HEAP_SIZE - sizeof(BlockHeader);
        heap_start->flags = 0;
        heap_start->next = NULL;
        heap_start->prev = NULL;
        heap_ready = 1;
        #ifdef DEBUG_HEAP
        printf("Heap: Initialized at 0x%p (%d MB)\n", heap_start, HEAP_SIZE / (1024 * 1024));
        #endif
    }

    if (!ptr) return;
    
    BlockHeader* block = (BlockHeader*)((uint8_t*)ptr - sizeof(BlockHeader));
    
    if (!(block->flags & BLOCK_FLAG_USED)) {
        #ifdef DEBUG_HEAP
        printf("Heap: Double free!\n");
        #endif
        return;
    }
    
    block->flags = 0;             
    heap_used -= block->size + sizeof(BlockHeader);
    
    if (block->next && !(block->next->flags & BLOCK_FLAG_USED)) {
        block->size += sizeof(BlockHeader) + block->next->size;
        block->next = block->next->next;
        if (block->next) block->next->prev = block;
    }
    
    if (block->prev && !(block->prev->flags & BLOCK_FLAG_USED)) {
        block->prev->size += sizeof(BlockHeader) + block->size;
        block->prev->next = block->next;
        if (block->next) block->next->prev = block->prev;
    }
}

void* krealloc(void* ptr, uint32_t new_size) {
    if (!heap_ready) {
        
        extern char __kernel_end[];
        
        heap_memory = (uint8_t*)__kernel_end;
        heap_start = (BlockHeader*)heap_memory;
        heap_start->size = HEAP_SIZE - sizeof(BlockHeader);
        heap_start->flags = 0;
        heap_start->next = NULL;
        heap_start->prev = NULL;
        heap_ready = 1;
        
        #ifdef DEBUG_HEAP
        printf("Heap: Initialized at 0x%p (%d MB)\n", heap_start, HEAP_SIZE / (1024 * 1024));
        #endif
    }
    
    if (!ptr) return kmalloc(new_size);
    if (new_size == 0) {
        kfree(ptr);
        return NULL;
    }
    
    BlockHeader* block = (BlockHeader*)((uint8_t*)ptr - sizeof(BlockHeader));
    uint32_t old_size = block->size;
    
    void* new_ptr = kmalloc(new_size);
    if (!new_ptr) return NULL;
    
    uint32_t copy_size = (old_size < new_size) ? old_size : new_size;
    memcpy(new_ptr, ptr, copy_size);
    
    kfree(ptr);
    return new_ptr;
}

uint32_t heap_get_used(void) { return heap_used; }
uint32_t heap_get_total(void) { return HEAP_SIZE; }
uint32_t heap_get_free(void) { return HEAP_SIZE - heap_used; }

