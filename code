#ifndef X25519_H
#define X25519_H

#include "types.h"
#include "str.h"

typedef uint64_t fe[10];

static void fe_0(fe h) { memset(h, 0, sizeof(fe)); }
static void fe_1(fe h) { fe_0(h); h[0] = 1; }

static void fe_add(fe h, const fe f, const fe g) {
    for (int i = 0; i < 10; i++) h[i] = f[i] + g[i];
}

static void fe_sub(fe h, const fe f, const fe g) {
    for (int i = 0; i < 10; i++) h[i] = f[i] + 0x7fffda000000000ULL - g[i];
}

static void fe_mul(fe h, const fe f, const fe g) {
    uint64_t t[19] = {0};
    for (int i = 0; i < 10; i++) {
        for (int j = 0; j < 10; j++) t[i+j] += f[i] * g[j];
    }
    for (int i = 0; i < 9; i++) t[i] += t[i+10] * 38;
    h[0] = t[0] & 0x3ffffff; uint64_t c = t[0] >> 26;
    for (int i = 1; i < 9; i++) {
        t[i] += c; h[i] = t[i] & 0x3ffffff; c = t[i] >> 26;
    }
    h[9] = (t[9] + c) & 0x1ffffff;
    h[0] += ((t[9] + c) >> 25) * 38;
}

static void fe_invert(fe out, const fe z) {
    fe t0, t1, t2, t3; int i;
    fe_mul(t0, z, z);
    for (i = 1; i < 2; ++i) fe_mul(t0, t0, t0);
    fe_mul(t1, t0, t0); fe_mul(t0, z, t1); fe_mul(t1, t0, t0);
    for (i = 1; i < 5; ++i) fe_mul(t1, t1, t1);
    fe_mul(t0, t1, t0); fe_mul(t1, t0, t0);
    for (i = 1; i < 10; ++i) fe_mul(t1, t1, t1);
    fe_mul(t1, t1, t0); fe_mul(t2, t1, t1);
    for (i = 1; i < 20; ++i) fe_mul(t2, t2, t2);
    fe_mul(t1, t2, t1); fe_mul(t2, t1, t1);
    for (i = 1; i < 10; ++i) fe_mul(t2, t2, t2);
    fe_mul(t0, t2, t0); fe_mul(t2, t0, t0);
    for (i = 1; i < 50; ++i) fe_mul(t2, t2, t2);
    fe_mul(t1, t2, t1); fe_mul(t2, t1, t1);
    for (i = 1; i < 100; ++i) fe_mul(t2, t2, t2);
    fe_mul(t1, t2, t1); fe_mul(t2, t1, t1);
    for (i = 1; i < 50; ++i) fe_mul(t2, t2, t2);
    fe_mul(t0, t2, t0); fe_mul(t2, t0, t0);
    for (i = 1; i < 5; ++i) fe_mul(t2, t2, t2);
    fe_mul(out, t2, z);
}

static void fe_frombytes(fe h, const uint8_t *s) {
    int i; uint64_t t = 0; int b = 0;
    for (i = 0; i < 32; i++) {
        t |= ((uint64_t)s[i]) << b; b += 8;
        if (b >= 26) { h[i*4/13] = t & 0x3ffffff; t >>= 26; b -= 26; }
    }
    h[9] = t & 0x1ffffff;
}

static void fe_tobytes(uint8_t *s, const fe h) {
    int i; uint64_t t = 0; int b = 0;
    for (i = 0; i < 10; i++) {
        t |= h[i] << b; b += (i == 9 ? 25 : 26);
        while (b >= 8) { *s++ = t & 0xff; t >>= 8; b -= 8; }
    }
}

static void x25519(uint8_t *out, const uint8_t *scalar, const uint8_t *base) {
    uint8_t s[32]; memcpy(s, scalar, 32);
    s[0] &= 248; s[31] &= 127; s[31] |= 64;
    
    fe x1, x2, z2, x3, z3, tmp0, tmp1;
    fe_frombytes(x1, base);
    fe_1(x2); fe_0(z2); fe_frombytes(x3, base); fe_1(z3);

    for (int pos = 254; pos >= 0; --pos) {
        int bit = (s[pos >> 3] >> (pos & 7)) & 1;
        fe *p_x2 = bit ? &x3 : &x2, *p_z2 = bit ? &z3 : &z2;
        fe *p_x3 = bit ? &x2 : &x3, *p_z3 = bit ? &z2 : &z3;
        
        fe_add(tmp0, *p_x2, *p_z2); fe_sub(tmp1, *p_x2, *p_z2);
        fe_add(tmp1, *p_x3, *p_z3); fe_sub(tmp0, *p_x3, *p_z3);
        fe_mul(tmp0, tmp0, tmp1); fe_mul(tmp1, tmp1, tmp0);
        
        fe_add(*p_x3, tmp0, tmp1); fe_sub(*p_z3, tmp0, tmp1);
        fe_mul(*p_x3, *p_x3, *p_x3); fe_mul(*p_z3, *p_z3, *p_z3);
        fe_mul(*p_z3, *p_z3, x1);
    }
    fe_invert(tmp0, z2); fe_mul(x2, x2, tmp0);
    fe_tobytes(out, x2);
}

