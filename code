// ===== ГЛОБАЛЬНЫЕ =====
static Vector* tasks = NULL;
static Task* current = NULL;
static Task* idle_task = NULL;
static uint32_t task_count = 0;

// ===== IDLE TASK (работает, когда нечего делать) =====
static void idle_entry(void) {
    while (1) {
        __asm__ volatile("hlt");
    }
}

// ===== ИНИЦИАЛИЗАЦИЯ =====
void scheduler_init(void) {
    tasks = vector_create(sizeof(Task*), 16);
    current = NULL;
    task_count = 0;
    
    // Создаём idle task
    idle_task = task_create("idle", idle_entry, 0);
    
    printf("[Scheduler] Initialized\n");
}

// ===== СОЗДАНИЕ ЗАДАЧИ =====
Task* task_create(const char* name, void (*entry)(void), uint32_t priority) {
    Task* task = (Task*)kmalloc(sizeof(Task));
    memset(task, 0, sizeof(Task));
    
    strcpy(task->name, name);
    task->state = TASK_READY;
    task->priority = priority;
    task->next = NULL;
    
    // Выделяем стек (16 KB)
    task->stack_size = 16384;
    task->stack = kmalloc(task->stack_size);
    task->stack_top = (void*)(((uint64_t)task->stack + task->stack_size) & ~0xFULL);
    
    // Настраиваем начальный контекст
    // RIP = entry, RSP = stack_top
    task->context.rip = (uint64_t)entry;
    task->context.rsp = (uint64_t)task->stack_top;
    task->context.rflags = 0x202;  // IF = 1
    task->context.cs = 0x38;
    task->context.ss = 0x30;
    task->context.ds = 0x30;
    task->context.es = 0x30;
    
    tasks->push(tasks, &task);
    task_count++;
    
    printf("[Scheduler] Task created: %s (priority=%d)\n", name, priority);
    return task;
}

// ===== УНИЧТОЖЕНИЕ ЗАДАЧИ =====
void task_destroy(Task* task) {
    if (!task) return;
    
    // Находим и удаляем
    for (uint32_t i = 0; i < tasks->size; i++) {
        Task** t = (Task**)tasks->at(tasks, i);
        if (*t == task) {
            tasks->remove(tasks, i);
            break;
        }
    }
    
    if (task->stack) kfree(task->stack);
    kfree(task);
    task_count--;
}

// ===== ПЕРЕКЛЮЧЕНИЕ КОНТЕКСТА (АССЕМБЛЕР) =====
extern void context_switch(TaskContext* old, TaskContext* new);

// ===== ВЫБОР СЛЕДУЮЩЕЙ ЗАДАЧИ =====
static Task* scheduler_pick_next(void) {
    if (tasks->size == 0) return idle_task;
    
    // Round-robin с приоритетами
    static uint32_t last_index = 0;
    
    // Ищем следующую ready-задачу
    for (uint32_t i = 0; i < tasks->size; i++) {
        uint32_t idx = (last_index + i + 1) % tasks->size;
        Task* task = *(Task**)tasks->at(tasks, idx);
        
        if (task->state == TASK_READY) {
            last_index = idx;
            return task;
        }
    }
    
    return idle_task;
}

// ===== ТИК ПЛАНИРОВЩИКА (из таймера) =====
void scheduler_tick(void) {
    // Обновляем спящие задачи
    uint64_t now = apic_timer_get_ms();
    
    for (uint32_t i = 0; i < tasks->size; i++) {
        Task* task = *(Task**)tasks->at(tasks, i);
        
        if (task->state == TASK_SLEEPING && now >= task->sleep_until) {
            task->state = TASK_READY;
        }
    }
    
    // Вытесняем текущую задачу
    if (current && current->state == TASK_RUNNING) {
        current->state = TASK_READY;
    }
    
    Task* next = scheduler_pick_next();
    if (next != current) {
        Task* old = current;
        current = next;
        current->state = TASK_RUNNING;
        current->switch_count++;
        
        if (old) {
            context_switch(&old->context, &current->context);
        } else {
            // Первый запуск
            context_switch(NULL, &current->context);
        }
    }
}

// ===== КООПЕРАТИВНОЕ ПЕРЕКЛЮЧЕНИЕ =====
void task_yield(void) {
    if (!current) return;
    
    current->state = TASK_READY;
    
    Task* next = scheduler_pick_next();
    if (next != current) {
        Task* old = current;
        current = next;
        current->state = TASK_RUNNING;
        
        context_switch(&old->context, &current->context);
    }
}

// ===== СОН =====
void task_sleep(uint32_t ms) {
    if (!current) return;
    
    current->sleep_until = apic_timer_get_ms() + ms;
    current->state = TASK_SLEEPING;
    
    Task* next = scheduler_pick_next();
    Task* old = current;
    current = next;
    current->state = TASK_RUNNING;
    
    context_switch(&old->context, &current->context);
}

// ===== ЗАВЕРШЕНИЕ =====
void task_exit(void) {
    if (!current) return;
    
    current->state = TASK_DEAD;
    
    Task* next = scheduler_pick_next();
    Task* old = current;
    current = next;
    current->state = TASK_RUNNING;
    
    context_switch(&old->context, &current->context);
    // Сюда не вернёмся
}

// ===== ЗАПУСК ПЛАНИРОВЩИКА =====
void scheduler_start(void) {
    printf("[Scheduler] Starting...\n");
    
    // Запускаем первую задачу
    current = scheduler_pick_next();
    current->state = TASK_RUNNING;
    
    printf("[Scheduler] First task: %s\n", current->name);
    
    // Прыгаем в первую задачу
    context_switch(NULL, &current->context);
}

// ===== СПИСОК ЗАДАЧ =====
void scheduler_list(void) {
    printf("\n=== Tasks ===\n");
    printf("%-20s %-10s %-6s %-8s %s\n", 
           "Name", "State", "Prio", "Switches", "Sleep(ms)");
    printf("-------------------------------------------------------\n");
    
    for (uint32_t i = 0; i < tasks->size; i++) {
        Task* task = *(Task**)tasks->at(tasks, i);
        const char* state_str = 
            task->state == TASK_READY ? "ready" :
            task->state == TASK_RUNNING ? "running" :
            task->state == TASK_SLEEPING ? "sleeping" :
            task->state == TASK_DEAD ? "dead" : "unknown";
        
        printf("%-20s %-10s %-6d %-8d %llu\n", 
               task->name, state_str, task->priority, 
               task->switch_count, task->sleep_until);
    }
    printf("Total: %d tasks\n", task_count);
}

Task* scheduler_current(void) {
    return current;
}

